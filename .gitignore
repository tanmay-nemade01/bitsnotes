# ─── Astro ────────────────────────────────────────────────────────────────────
# Build output
dist/
# Generated Astro types
.astro/

# ─── Node.js ──────────────────────────────────────────────────────────────────
node_modules/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Cloudflare / Wrangler ────────────────────────────────────────────────────
# Local Wrangler state, deploy cache, and temp files
.wrangler/

# ─── Notes content ────────────────────────────────────────────────────────────
# Notes live in src/content/notes/ and are fully tracked in git.
# Only HTML and JSON files are committed; ignore other binary assets.
src/content/notes/**/*
!src/content/notes/**/
!src/content/notes/**/*.html
!src/content/notes/**/*.json



# ─── Environment variables ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Security: Never commit real secrets to tracked files ─────────────────────
# Use Cloudflare Worker secrets or .env (already git-ignored) instead.
# If you must document credentials, use placeholders like <YOUR_KEY_HERE>.
# Check git history before pushing if a secret was ever committed.

# ─── Editor & OS ──────────────────────────────────────────────────────────────
# JetBrains IDEs
.idea/

# VS Code (uncomment if you don't want to share editor settings)
# .vscode/

# macOS
.DS_Store
.DS_Store?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
agent_transcript_conversion_guidelines.md

# Ignore all .md files except README.md
*.md
!README.md
