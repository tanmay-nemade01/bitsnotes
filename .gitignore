.wrangler/

# ─── Python uploader ──────────────────────────────────────────────────────────
# Virtual environment
.venv/
local_uploader/.venv/

# Processed and watch folder contents (PDFs + generated JSONs are large/transient)
# Keep the .gitkeep placeholder files so the folder structure is preserved
local_uploader/processed_folder/**
!local_uploader/processed_folder/.gitkeep

local_uploader/watch_folder/**
!local_uploader/watch_folder/.gitkeep

# ─── Environment variables ────────────────────────────────────────────────────
.env
.env.*
!.env.example

