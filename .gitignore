# ─── Astro ────────────────────────────────────────────────────────────────────
# Build output
dist/
# Generated Astro types
.astro/

# ─── Node.js ──────────────────────────────────────────────────────────────────
node_modules/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Cloudflare / Wrangler ────────────────────────────────────────────────────
