{
	"compatibility_date": "2026-05-31",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "bitsnotes",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "bitsnotes.com",
			"custom_domain": true
		},
		{
			"pattern": "www.bitsnotes.com",
			"custom_domain": true
		}
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "bitsnotes"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "5324dba0c40447cab20c99f52ea1476b"
		}
	],
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	"observability": {
		"enabled": true
	}
}