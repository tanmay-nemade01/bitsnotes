{
	"compatibility_date": "2026-05-31",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "bitsnotes",
	"workers_dev": false,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "bitsnotes.com",
			"custom_domain": true
		},
		{
			"pattern": "www.bitsnotes.com",
			"custom_domain": true
		}
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	"vars": {
		"APP_BASE_URL": "https://bitsnotes.com",
		"GOOGLE_CLIENT_ID": "620085380283-2e21l8rpj8pekjksp4j2rb6blto33sr8.apps.googleusercontent.com",
		"GITHUB_CLIENT_ID": "Ov23lizwuZfFbzWlv4m5",
		"TURNSTILE_SITE_KEY": "0x4AAAAAADppFS9QSkR8ltXc"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bitsnotes_auth",
			"database_id": "a712208b-689c-474c-863a-89b85f2ff82b"
		}
	],
	"observability": {
		"enabled": true
	}
}