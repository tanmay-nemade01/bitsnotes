{
	"compatibility_date": "2026-05-31",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "bitsnotes",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "bitsnotes.com",
			"custom_domain": true
		},
		{
			"pattern": "www.bitsnotes.com",
			"custom_domain": true
		}
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	"observability": {
		"enabled": true
	}
}