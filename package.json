{
  "name": "bitsnotes",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/audit-theme-colors.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "audit:theme": "node scripts/audit-theme-colors.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "blog:new": "node scripts/new-blog-post.mjs",
    "test:e2e": "playwright test",
    "generate-types": "wrangler types",
    "deploy": "node scripts/guard-deploy.mjs && astro build && wrangler deploy --config dist/server/wrangler.json",
    "upload-notes": "node scripts/upload-notes.mjs",
    "db:migrate:local": "wrangler d1 execute bitsnotes_auth --file=src/db/schema.sql --local",
    "db:migrate:remote": "wrangler d1 execute bitsnotes_auth --file=src/db/schema.sql --remote",
    "db:migrate": "npm run db:migrate:local && npm run db:migrate:remote",
    "postinstall": "node scripts/patch-wrangler.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@cloudflare/vite-plugin": "^1.51.3",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.2.1",
    "obscenity": "^0.4.6",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.95.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "better-sqlite3": "^12.11.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^3.2.7"
  }
}
