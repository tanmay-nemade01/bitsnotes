---
/**
 * Admin Overview — the /backstage landing page.
 * Surfaces top-line metrics and quick links into each admin section.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';

export const prerender = false;

const quickLinks = [
  { href: '/backstage/comments', label: 'Comments', desc: 'Moderate and reply', icon: 'chat' },
  { href: '/backstage/tags', label: 'Subjects & Tags', desc: 'Homepage sections', icon: 'tag' },
  { href: '/backstage/supporters', label: 'Supporters', desc: 'Wall of Gratitude', icon: 'heart' },
];

const quickIcons: Record<string, string> = {
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/>',
  tag: '<path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L3 13V3h10l7.59 7.59a2 2 0 0 1 0 2.82z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.5 1-1a5.5 5.5 0 0 0 0-7.8z"/>',
};
---

<AdminLayout title="Overview" subtitle="Site health at a glance">
  <div data-admin-overview class="space-y-8">
    <div>
      <h2 class="font-display text-2xl font-bold text-[var(--text)]">Welcome back</h2>
      <p class="mt-1 text-sm text-[var(--text-muted)]">A quick snapshot of activity across BitsNotes.</p>
    </div>

    <section>
      <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-faint)] mb-3">Needs attention</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <StatCard id="ov-pending" label="Pending Comments" tone="warning" hint="Awaiting moderation" />
        <StatCard id="ov-comments" label="Total Comments" />
        <StatCard id="ov-supporters" label="Supporters" hint="On the Wall of Gratitude" />
      </div>
    </section>

    <section>
      <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-faint)] mb-3">Manage</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {quickLinks.map((link) => (
          <a
            href={link.href}
            class="group border border-[var(--border)] rounded-[var(--r-md)] p-5 bg-[var(--bg-elevated)] hover:border-[var(--accent)] transition-colors no-underline"
          >
            <div class="flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-[var(--r-sm)] bg-[var(--accent-subtle)] text-[var(--accent)] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true" set:html={quickIcons[link.icon]} />
              </span>
              <span class="font-display font-bold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">{link.label}</span>
            </div>
            <p class="mt-2 text-xs text-[var(--text-muted)]">{link.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </div>

  <p id="ov-status" class="mt-6 text-xs text-[var(--text-faint)]" role="status" aria-live="polite"></p>
</AdminLayout>

<script is:inline data-astro-rerun>
  (function () {
    var root = document.querySelector('[data-admin-overview]');
    var A = window.__bnAdmin;
    if (!root || !A) return;

    function set(id, value) {
      var el = root.querySelector('#' + id);
      if (el) el.textContent = typeof value === 'number' ? value.toLocaleString() : value;
    }

    var status = document.getElementById('ov-status');
    var failures = 0;

    // Comments
    A.getJSON('/api/admin/comments/overview')
      .then(function (data) {
        var total = 0,
          pending = 0;
        (data.pages || []).forEach(function (p) {
          total += p.total;
          pending += p.pending;
        });
        set('ov-comments', total);
        set('ov-pending', pending);
      })
      .catch(function () {
        failures++;
        set('ov-comments', '—');
        set('ov-pending', '—');
      });

    // Supporters
    A.getJSON('/api/admin/supporters')
      .then(function (data) {
        set('ov-supporters', data.total != null ? data.total : (data.supporters || []).length);
      })
      .catch(function () {
        failures++;
        set('ov-supporters', '—');
      });

    if (status) {
      setTimeout(function () {
        status.textContent = failures ? 'Some metrics could not be loaded.' : '';
      }, 1500);
    }
  })();
</script>
