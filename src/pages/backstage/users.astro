---
/**
 * Admin Users — the account roster.
 *
 * Read-only for now: lists every account with its email, status, tier and
 * account creation date/time, newest first. Backed by GET /api/admin/users.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';

export const prerender = false;

const statusFilters = [
  { value: 'all', label: 'All' },
  { value: 'active', label: 'Active' },
  { value: 'pending', label: 'Pending' },
  { value: 'suspended', label: 'Suspended' },
  { value: 'deleted', label: 'Deleted' },
];
---

<AdminLayout title="Users" subtitle="Every account registered on BitsNotes">
  <div data-admin-users class="space-y-6">
    <!-- Headline counters -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <StatCard id="users-total" label="Total Users" hint="All registered accounts" />
      <StatCard id="users-active" label="Active" tone="accent" hint="Verified email" />
      <StatCard id="users-new" label="New (7 days)" tone="warning" hint="Recently joined" />
      <StatCard id="users-admins" label="Admins" hint="Admin allowlist" />
    </section>

    <!-- Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter users by status">
        {statusFilters.map((f) => (
          <button
            type="button"
            data-user-filter={f.value}
            class="px-3 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer data-[active=true]:bg-[var(--accent)] data-[active=true]:text-[var(--accent-contrast)] data-[active=true]:border-[var(--accent)]"
            data-active={f.value === 'all' ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <div class="relative">
          <svg
            class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-faint)] pointer-events-none"
            fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input
            id="users-search"
            type="search"
            placeholder="Search email or name…"
            autocomplete="off"
            aria-label="Search users by email or name"
            class="w-full sm:w-64 rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] pl-9 pr-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
          />
        </div>

        <button
          type="button"
          id="users-sort"
          class="px-3 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer"
          title="Toggle sort order"
        >
          Newest first
        </button>

        <button
          type="button"
          id="users-refresh"
          class="p-1.5 rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer"
          title="Refresh"
          aria-label="Refresh users"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </button>
      </div>
    </div>

    <!-- Roster -->
    <div class="border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden shadow-sm">
      <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] px-5 py-4">
        <h2 class="font-display font-bold text-lg text-[var(--text)]">Accounts</h2>
        <span
          id="users-result-count"
          class="shrink-0 rounded-full border border-[var(--accent)]/20 bg-[var(--accent-subtle)] px-2.5 py-0.5 text-xs font-semibold text-[var(--accent)]"
        >—</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[58rem]">
          <thead>
            <tr class="border-b border-[var(--border)] text-left">
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">User</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Status</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Tag</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Access</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Tier</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Chat Limit</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Provider</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Joined</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Last sign-in</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Actions / ID</th>
            </tr>
          </thead>
          <tbody id="users-table-body">
            <tr>
              <td colspan="10" class="px-4 py-6 text-sm text-[var(--text-muted)]">Loading users…</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border)] px-5 py-3">
        <p id="users-page-label" class="text-xs text-[var(--text-muted)]">—</p>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="users-prev"
            class="px-3 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Previous
          </button>
          <button
            type="button"
            id="users-next"
            class="px-3 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Next
          </button>
        </div>
      </div>
    </div>

    <!-- Dialog for Editing User Access & Tag -->
    <dialog
      id="user-edit-dialog"
      class="backdrop:bg-black/60 rounded-[var(--r-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-0 shadow-2xl max-w-md w-full text-[var(--text)] m-auto"
    >
      <div class="p-5 border-b border-[var(--border)] flex items-center justify-between">
        <h3 class="font-display font-bold text-base text-[var(--text)]">Edit User Access & Tags</h3>
        <button type="button" id="user-edit-close" class="text-[var(--text-muted)] hover:text-[var(--text)] p-1 rounded transition-colors cursor-pointer" aria-label="Close dialog">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form id="user-edit-form" class="p-5 space-y-4">
        <input type="hidden" id="user-edit-id" />
        <div>
          <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1">User Account</label>
          <div id="user-edit-email" class="text-sm font-semibold text-[var(--text)] truncate"></div>
        </div>

        <div>
          <label for="user-edit-tag" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Tag</label>
          <select
            id="user-edit-tag"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          >
            <option value="batchmate">batchmate (BITS Pilani cohort)</option>
            <option value="normal">normal (Standard user)</option>
          </select>
        </div>

        <div>
          <label for="user-edit-access-date" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Access Valid Until</label>
          <input
            type="date"
            id="user-edit-access-date"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          />
          <div class="flex flex-wrap gap-1.5 mt-2">
            <button type="button" data-access-preset="default" class="text-[11px] px-2 py-0.5 rounded border border-[var(--border)] hover:border-[var(--accent)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer">15 Mar 2027 (Default Free)</button>
            <button type="button" data-access-preset="1year" class="text-[11px] px-2 py-0.5 rounded border border-[var(--border)] hover:border-[var(--accent)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer">+1 Year</button>
            <button type="button" data-access-preset="revoke" class="text-[11px] px-2 py-0.5 rounded border border-[var(--danger-border)] text-[var(--danger-text)] hover:bg-[var(--danger-bg)] transition-colors cursor-pointer">Revoke Now (Expired)</button>
            <button type="button" data-access-preset="indefinite" class="text-[11px] px-2 py-0.5 rounded border border-[var(--border)] hover:border-[var(--accent)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer">No Expiry</button>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="user-edit-chatbot-limit" class="block text-xs font-semibold text-[var(--text-muted)]">Monthly Chatbot Limit</label>
            <button type="button" id="user-edit-reset-usage-btn" class="text-[11px] text-[var(--danger-text)] hover:underline cursor-pointer">Reset this month's usage</button>
          </div>
          <input
            type="number"
            id="user-edit-chatbot-limit"
            min="0"
            max="100000"
            placeholder="20 (Default)"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          />
          <p class="text-[11px] text-[var(--text-muted)] mt-1">Leave blank for default (20/mo). Enter 0 to disable chat.</p>
          <div class="flex flex-wrap gap-1.5 mt-2">
            <button type="button" data-limit-preset="default" class="text-[11px] px-2 py-0.5 rounded border border-[var(--border)] hover:border-[var(--accent)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer">Default (20)</button>
            <button type="button" data-limit-preset="50" class="text-[11px] px-2 py-0.5 rounded border border-[var(--border)] hover:border-[var(--accent)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer">50/mo</button>
            <button type="button" data-limit-preset="100" class="text-[11px] px-2 py-0.5 rounded border border-[var(--border)] hover:border-[var(--accent)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer">100/mo</button>
            <button type="button" data-limit-preset="0" class="text-[11px] px-2 py-0.5 rounded border border-[var(--danger-border)] text-[var(--danger-text)] hover:bg-[var(--danger-bg)] transition-colors cursor-pointer">0 (Disable)</button>
          </div>
        </div>

        <div id="user-edit-status" class="text-xs min-h-4 hidden" role="status"></div>

        <div class="flex justify-end gap-2 pt-3 border-t border-[var(--border)]">
          <button
            type="button"
            id="user-edit-cancel"
            class="px-3.5 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="user-edit-submit"
            class="px-4 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] bg-[var(--accent)] text-[var(--accent-contrast)] hover:opacity-90 transition-opacity cursor-pointer"
          >
            Save Changes
          </button>
        </div>
      </form>
    </dialog>

    <p id="users-status" role="status" aria-live="polite" class="text-xs min-h-4 text-[var(--text-faint)]"></p>
  </div>
</AdminLayout>

<script is:inline data-astro-rerun>
  (function () {
    var root = document.querySelector('[data-admin-users]');
    var A = window.__bnAdmin;
    if (!root || !A) return;

    var tableBody = root.querySelector('#users-table-body');
    var resultCount = root.querySelector('#users-result-count');
    var pageLabel = root.querySelector('#users-page-label');
    var statusLine = root.querySelector('#users-status');
    var searchInput = root.querySelector('#users-search');
    var sortBtn = root.querySelector('#users-sort');
    var refreshBtn = root.querySelector('#users-refresh');
    var prevBtn = root.querySelector('#users-prev');
    var nextBtn = root.querySelector('#users-next');
    var filterBtns = root.querySelectorAll('[data-user-filter]');

    var PAGE_SIZE = 25;
    var state = { search: '', status: 'all', order: 'desc', offset: 0, total: 0 };
    var debounceTimer = null;

    function setStat(id, value) {
      var el = root.querySelector('#' + id);
      if (el) el.textContent = typeof value === 'number' ? value.toLocaleString() : value;
    }

    function renderStats(stats) {
      if (!stats) return;
      setStat('users-total', stats.total || 0);
      setStat('users-active', stats.active || 0);
      setStat('users-new', stats.newLast7Days || 0);
      setStat('users-admins', stats.admins || 0);
    }

    function buildQuery() {
      var qs = new URLSearchParams();
      qs.set('limit', String(PAGE_SIZE));
      qs.set('offset', String(state.offset));
      qs.set('order', state.order);
      if (state.search) qs.set('search', state.search);
      if (state.status && state.status !== 'all') qs.set('status', state.status);
      return '/api/admin/users?' + qs.toString();
    }

    function load() {
      if (tableBody) {
        tableBody.innerHTML =
          '<tr><td colspan="10" class="px-4 py-6 text-sm text-[var(--text-muted)]">Loading users…</td></tr>';
      }
      return A.getJSON(buildQuery())
        .then(function (data) {
          state.total = data.total || 0;
          renderStats(data.stats);
          renderRows(data.users || []);
          renderPagination();
          if (statusLine) {
            statusLine.textContent = 'Updated just now';
            statusLine.className = 'text-xs min-h-4 text-[var(--text-faint)]';
          }
        })
        .catch(function (err) {
          console.error('[admin/users] Failed to load users:', err);
          if (tableBody) {
            var errMsg = (err && err.message) ? A.esc(err.message) : 'Please try again.';
            tableBody.innerHTML =
              '<tr><td colspan="10" class="px-4 py-6 text-sm text-[var(--danger-text)]">Failed to load users (' + errMsg + ').</td></tr>';
          }
          if (statusLine) {
            statusLine.textContent = 'Could not load users.';
            statusLine.className = 'text-xs min-h-4 text-[var(--danger-text)]';
          }
        });
    }

    // ── Row rendering ───────────────────────────────────────────────────────

    function badge(text, className) {
      var el = document.createElement('span');
      el.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ' + className;
      el.textContent = text;
      return el;
    }

    function statusBadge(status) {
      if (status === 'active') {
        return badge('Active', 'bg-[var(--success-bg)] text-[var(--success-text)] border border-[var(--success-border)]');
      }
      if (status === 'pending') {
        return badge('Pending', 'bg-[var(--warning-bg)] text-[var(--warning-text)] border border-[var(--warning-border)]');
      }
      if (status === 'suspended') {
        return badge('Suspended', 'bg-[var(--danger-bg)] text-[var(--danger-text)] border border-[var(--danger-border)]');
      }
      return badge(status || 'Unknown', 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border)]');
    }

    function tierBadge(tier) {
      if (tier && tier !== 'free') {
        return badge(tier, 'bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent)]/30');
      }
      return badge(tier || 'free', 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border)]');
    }

    function tagBadge(tag) {
      if (tag === 'batchmate') {
        return badge('Batchmate', 'bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent)]/30');
      }
      return badge(tag || 'normal', 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border)]');
    }

    function accessCell(u) {
      var wrap = document.createElement('div');
      wrap.className = 'flex flex-col gap-1 items-start';
      var badgeEl;
      if (u.accessExpiresAt) {
        if (u.isAccessExpired) {
          badgeEl = badge('Expired (' + A.formatDate(u.accessExpiresAt) + ')', 'bg-[var(--danger-bg)] text-[var(--danger-text)] border border-[var(--danger-border)]');
        } else {
          badgeEl = badge('Until ' + A.formatDate(u.accessExpiresAt), 'bg-[var(--success-bg)] text-[var(--success-text)] border border-[var(--success-border)]');
        }
      } else {
        badgeEl = badge('No Expiry', 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border)]');
      }
      wrap.appendChild(badgeEl);
      return wrap;
    }

    function initials(u) {
      var source = u.displayName || u.email || '?';
      return source.trim().charAt(0).toUpperCase();
    }

    function timeCell(ts, fallback) {
      var wrap = document.createElement('div');
      var main = document.createElement('div');
      main.className = 'text-[var(--text)] whitespace-nowrap';
      main.textContent = ts ? A.formatDateTime(ts) : fallback;
      var sub = document.createElement('div');
      sub.className = 'text-[11px] text-[var(--text-faint)]';
      sub.textContent = ts ? A.timeAgo(ts) : '—';
      wrap.appendChild(main);
      wrap.appendChild(sub);
      return wrap;
    }

    function renderRows(users) {
      if (!tableBody) return;
      tableBody.innerHTML = '';

      if (!users.length) {
        var empty = document.createElement('tr');
        var emptyCell = document.createElement('td');
        emptyCell.colSpan = 10;
        emptyCell.className = 'px-4 py-6 text-sm text-[var(--text-muted)]';
        emptyCell.textContent = state.search
          ? 'No users match “' + state.search + '”.'
          : 'No users in this view.';
        empty.appendChild(emptyCell);
        tableBody.appendChild(empty);
        return;
      }

      users.forEach(function (u) {
        var tr = document.createElement('tr');
        tr.className = 'hover:bg-[var(--bg-subtle)] transition-colors';

        // User — avatar, display name, email
        var tdUser = document.createElement('td');
        tdUser.className = 'px-4 py-3';
        var userWrap = document.createElement('div');
        userWrap.className = 'flex items-center gap-3';

        if (u.avatarUrl) {
          var img = document.createElement('img');
          img.src = u.avatarUrl;
          img.alt = '';
          img.referrerPolicy = 'no-referrer';
          img.loading = 'lazy';
          img.className = 'w-8 h-8 rounded-full shrink-0';
          userWrap.appendChild(img);
        } else {
          var avatar = document.createElement('span');
          avatar.className = 'w-8 h-8 rounded-full shrink-0 bg-[var(--accent-subtle)] text-[var(--accent)] flex items-center justify-center text-xs font-bold';
          avatar.textContent = initials(u);
          userWrap.appendChild(avatar);
        }

        var userMeta = document.createElement('div');
        userMeta.className = 'min-w-0';

        var nameLine = document.createElement('div');
        nameLine.className = 'flex items-center gap-2';
        var name = document.createElement('span');
        name.className = 'font-semibold text-[var(--text)] truncate';
        name.textContent = u.displayName || '—';
        nameLine.appendChild(name);
        if (u.isAdmin) {
          nameLine.appendChild(badge('Admin', 'bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent)]/30'));
        }
        if (!u.emailVerified && u.status === 'active') {
          nameLine.appendChild(badge('Unverified', 'bg-[var(--warning-bg)] text-[var(--warning-text)] border border-[var(--warning-border)]'));
        }
        userMeta.appendChild(nameLine);

        var email = document.createElement('div');
        email.className = 'text-xs text-[var(--text-muted)] truncate';
        email.textContent = u.email;
        email.title = u.email;
        userMeta.appendChild(email);

        userWrap.appendChild(userMeta);
        tdUser.appendChild(userWrap);
        tr.appendChild(tdUser);

        // Status
        var tdStatus = document.createElement('td');
        tdStatus.className = 'px-4 py-3';
        tdStatus.appendChild(statusBadge(u.status));
        tr.appendChild(tdStatus);

        // Tag
        var tdTag = document.createElement('td');
        tdTag.className = 'px-4 py-3';
        tdTag.appendChild(tagBadge(u.tags));
        tr.appendChild(tdTag);

        // Access
        var tdAccess = document.createElement('td');
        tdAccess.className = 'px-4 py-3';
        tdAccess.appendChild(accessCell(u));
        tr.appendChild(tdAccess);

        // Tier
        var tdTier = document.createElement('td');
        tdTier.className = 'px-4 py-3';
        tdTier.appendChild(tierBadge(u.tier));
        tr.appendChild(tdTier);

        // Chat Limit
        var tdChat = document.createElement('td');
        tdChat.className = 'px-4 py-3';
        if (u.isAdmin) {
          tdChat.appendChild(badge('Admin (∞)', 'bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent)]/30'));
        } else if (u.chatbotLimit !== null && u.chatbotLimit !== undefined) {
          tdChat.appendChild(badge(u.chatbotLimit + '/mo', 'bg-[var(--bg-subtle)] text-[var(--text)] border border-[var(--border)] font-mono'));
        } else {
          var defChat = document.createElement('span');
          defChat.className = 'text-xs text-[var(--text-muted)]';
          defChat.textContent = '20/mo (default)';
          tdChat.appendChild(defChat);
        }
        tr.appendChild(tdChat);

        // Provider
        var tdProvider = document.createElement('td');
        tdProvider.className = 'px-4 py-3';
        if (u.providers && u.providers.length) {
          var providerWrap = document.createElement('div');
          providerWrap.className = 'flex flex-wrap gap-1';
          u.providers.forEach(function (p) {
            providerWrap.appendChild(
              badge(p, 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border)]'),
            );
          });
          tdProvider.appendChild(providerWrap);
        } else {
          var none = document.createElement('span');
          none.className = 'text-xs text-[var(--text-faint)]';
          none.textContent = '—';
          tdProvider.appendChild(none);
        }
        tr.appendChild(tdProvider);

        // Joined
        var tdJoined = document.createElement('td');
        tdJoined.className = 'px-4 py-3';
        tdJoined.appendChild(timeCell(u.createdAt, '—'));
        tr.appendChild(tdJoined);

        // Last sign-in
        var tdLast = document.createElement('td');
        tdLast.className = 'px-4 py-3';
        tdLast.appendChild(timeCell(u.lastLoginAt, 'Never'));
        tr.appendChild(tdLast);

        // Actions & ID
        var tdId = document.createElement('td');
        tdId.className = 'px-4 py-3';
        var idWrap = document.createElement('div');
        idWrap.className = 'flex items-center gap-2';

        var editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'px-2 py-0.5 text-[11px] font-semibold rounded border border-[var(--border)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors cursor-pointer';
        editBtn.textContent = 'Edit';
        editBtn.title = 'Edit user access and tags';
        editBtn.addEventListener('click', function () {
          openEditDialog(u);
        });
        idWrap.appendChild(editBtn);

        var idCode = document.createElement('code');
        idCode.className = 'text-[11px] text-[var(--text-muted)] font-mono';
        idCode.textContent = u.id ? u.id.slice(0, 8) : '—';
        idCode.title = u.id || '';
        idWrap.appendChild(idCode);

        var copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'text-[11px] font-semibold text-[var(--text-faint)] hover:text-[var(--accent)] transition-colors cursor-pointer';
        copy.textContent = 'Copy';
        copy.title = 'Copy full user id';
        copy.addEventListener('click', function () {
          if (!u.id || !navigator.clipboard) return;
          navigator.clipboard.writeText(u.id).then(function () {
            copy.textContent = 'Copied';
            setTimeout(function () { copy.textContent = 'Copy'; }, 1500);
          });
        });
        idWrap.appendChild(copy);

        tdId.appendChild(idWrap);
        tr.appendChild(tdId);

        tableBody.appendChild(tr);
      });
    }

    // ── Pagination ──────────────────────────────────────────────────────────

    function renderPagination() {
      var shownFrom = state.total === 0 ? 0 : state.offset + 1;
      var shownTo = Math.min(state.offset + PAGE_SIZE, state.total);

      if (pageLabel) {
        pageLabel.textContent =
          'Showing ' + shownFrom + '–' + shownTo + ' of ' + state.total.toLocaleString() +
          (state.total === 1 ? ' user' : ' users');
      }
      if (resultCount) resultCount.textContent = state.total.toLocaleString();
      if (prevBtn) prevBtn.disabled = state.offset <= 0;
      if (nextBtn) nextBtn.disabled = state.offset + PAGE_SIZE >= state.total;
    }

    // ── Events ──────────────────────────────────────────────────────────────

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) { b.dataset.active = 'false'; });
        btn.dataset.active = 'true';
        state.status = btn.dataset.userFilter || 'all';
        state.offset = 0;
        load();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var value = searchInput.value || '';
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
          state.search = value.trim();
          state.offset = 0;
          load();
        }, 300);
      });
    }

    if (sortBtn) {
      sortBtn.addEventListener('click', function () {
        state.order = state.order === 'desc' ? 'asc' : 'desc';
        sortBtn.textContent = state.order === 'desc' ? 'Newest first' : 'Oldest first';
        state.offset = 0;
        load();
      });
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', function () { load(); });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        if (state.offset <= 0) return;
        state.offset = Math.max(0, state.offset - PAGE_SIZE);
        load();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        if (state.offset + PAGE_SIZE >= state.total) return;
        state.offset += PAGE_SIZE;
        load();
      });
    }

    // ── Edit Access & Tag Dialog ─────────────────────────────────────────

    var editDialog = root.querySelector('#user-edit-dialog');
    var editForm = root.querySelector('#user-edit-form');
    var editUserId = root.querySelector('#user-edit-id');
    var editUserEmail = root.querySelector('#user-edit-email');
    var editUserTag = root.querySelector('#user-edit-tag');
    var editUserAccessDate = root.querySelector('#user-edit-access-date');
    var editCloseBtn = root.querySelector('#user-edit-close');
    var editCancelBtn = root.querySelector('#user-edit-cancel');
    var editSubmitBtn = root.querySelector('#user-edit-submit');
    var editStatus = root.querySelector('#user-edit-status');
    var accessPresets = root.querySelectorAll('[data-access-preset]');
    var editChatbotLimit = root.querySelector('#user-edit-chatbot-limit');
    var editResetUsageBtn = root.querySelector('#user-edit-reset-usage-btn');
    var limitPresets = root.querySelectorAll('[data-limit-preset]');
    var shouldResetUsageFlag = false;

    function openEditDialog(u) {
      if (!editDialog) return;
      if (editUserId) editUserId.value = u.id;
      if (editUserEmail) editUserEmail.textContent = (u.displayName ? u.displayName + ' (' + u.email + ')' : u.email);
      if (editUserTag) editUserTag.value = u.tags || 'normal';
      shouldResetUsageFlag = false;
      if (editResetUsageBtn) { editResetUsageBtn.textContent = "Reset this month's usage"; editResetUsageBtn.classList.remove('opacity-50'); }
      if (editChatbotLimit) editChatbotLimit.value = u.chatbotLimit != null ? u.chatbotLimit : '';

      if (editUserAccessDate) {
        if (u.accessExpiresAt) {
          var d = new Date(u.accessExpiresAt);
          editUserAccessDate.value = d.toISOString().slice(0, 10);
        } else {
          editUserAccessDate.value = '';
        }
      }

      if (editStatus) {
        editStatus.className = 'text-xs min-h-4 hidden';
        editStatus.textContent = '';
      }
      if (editSubmitBtn) {
        editSubmitBtn.disabled = false;
        editSubmitBtn.textContent = 'Save Changes';
      }

      if (typeof editDialog.showModal === 'function') {
        editDialog.showModal();
      } else {
        editDialog.setAttribute('open', '');
      }
    }

    function closeEditDialog() {
      if (!editDialog) return;
      if (typeof editDialog.close === 'function') {
        editDialog.close();
      } else {
        editDialog.removeAttribute('open');
      }
    }

    if (editCloseBtn) editCloseBtn.addEventListener('click', closeEditDialog);
    if (editCancelBtn) editCancelBtn.addEventListener('click', closeEditDialog);
    if (editResetUsageBtn) {
      editResetUsageBtn.addEventListener('click', function () {
        shouldResetUsageFlag = true;
        editResetUsageBtn.textContent = "Usage will reset to 0 on save";
        editResetUsageBtn.classList.add('opacity-50');
      });
    }

    limitPresets.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var preset = btn.dataset.limitPreset;
        if (!editChatbotLimit) return;
        if (preset === 'default') {
          editChatbotLimit.value = '';
        } else {
          editChatbotLimit.value = preset;
        }
      });
    });

    accessPresets.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var preset = btn.dataset.accessPreset;
        if (!editUserAccessDate) return;
        if (preset === 'default') {
          editUserAccessDate.value = '2027-03-15';
        } else if (preset === '1year') {
          var nextYear = new Date();
          nextYear.setFullYear(nextYear.getFullYear() + 1);
          editUserAccessDate.value = nextYear.toISOString().slice(0, 10);
        } else if (preset === 'revoke') {
          var yesterday = new Date(Date.now() - 24 * 60 * 60 * 1000);
          editUserAccessDate.value = yesterday.toISOString().slice(0, 10);
        } else if (preset === 'indefinite') {
          editUserAccessDate.value = '';
        }
      });
    });

    if (editForm) {
      editForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var id = editUserId ? editUserId.value : '';
        if (!id) return;
        var tag = editUserTag ? editUserTag.value : 'normal';
        var dateVal = editUserAccessDate ? editUserAccessDate.value : '';
        var limitVal = editChatbotLimit ? editChatbotLimit.value.trim() : '';
        var chatbotLimit = limitVal === '' ? null : Number(limitVal);
        var accessExpiresAt = null;

        if (dateVal) {
          var d = new Date(dateVal + 'T23:59:59.999Z');
          if (isNaN(d.getTime())) {
            if (editStatus) {
              editStatus.className = 'text-xs min-h-4 text-[var(--danger-text)] block';
              editStatus.textContent = 'Invalid date format';
            }
            return;
          }
          accessExpiresAt = d.getTime();
        }

        if (editSubmitBtn) {
          editSubmitBtn.disabled = true;
          editSubmitBtn.textContent = 'Saving…';
        }
        if (editStatus) {
          editStatus.className = 'text-xs min-h-4 text-[var(--text-faint)] block';
          editStatus.textContent = 'Saving updates…';
        }

        A.postJSON('/api/admin/users/' + encodeURIComponent(id), {
          tags: tag,
          accessExpiresAt: accessExpiresAt,
          chatbotLimit: chatbotLimit,
          resetChatbotUsage: shouldResetUsageFlag,
        }).then(function (res) {
          if (res.ok) {
            if (editStatus) {
              editStatus.className = 'text-xs min-h-4 text-[var(--success-text)] block';
              editStatus.textContent = 'Saved successfully!';
            }
            setTimeout(function () {
              closeEditDialog();
              load();
            }, 600);
          } else {
            if (editSubmitBtn) {
              editSubmitBtn.disabled = false;
              editSubmitBtn.textContent = 'Save Changes';
            }
            if (editStatus) {
              editStatus.className = 'text-xs min-h-4 text-[var(--danger-text)] block';
              editStatus.textContent = (res.data && res.data.error) || 'Failed to save';
            }
          }
        }).catch(function () {
          if (editSubmitBtn) {
            editSubmitBtn.disabled = false;
            editSubmitBtn.textContent = 'Save Changes';
          }
          if (editStatus) {
            editStatus.className = 'text-xs min-h-4 text-[var(--danger-text)] block';
            editStatus.textContent = 'Network error. Please try again.';
          }
        });
      });
    }

    load();
  })();
</script>
