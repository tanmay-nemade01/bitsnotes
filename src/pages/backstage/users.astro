---
/**
 * Admin Users — the account roster.
 *
 * Read-only for now: lists every account with its email, status, tier and
 * account creation date/time, newest first. Backed by GET /api/admin/users.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';

export const prerender = false;

const statusFilters = [
  { value: 'all', label: 'All' },
  { value: 'active', label: 'Active' },
  { value: 'pending', label: 'Pending' },
  { value: 'suspended', label: 'Suspended' },
  { value: 'deleted', label: 'Deleted' },
];
---

<AdminLayout title="Users" subtitle="Every account registered on BitsNotes">
  <div data-admin-users class="space-y-6">
    <!-- Headline counters -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <StatCard id="users-total" label="Total Users" hint="All registered accounts" />
      <StatCard id="users-active" label="Active" tone="accent" hint="Verified email" />
      <StatCard id="users-new" label="New (7 days)" tone="warning" hint="Recently joined" />
      <StatCard id="users-admins" label="Admins" hint="Admin allowlist" />
    </section>

    <!-- Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter users by status">
        {statusFilters.map((f) => (
          <button
            type="button"
            data-user-filter={f.value}
            class="px-3 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer data-[active=true]:bg-[var(--accent)] data-[active=true]:text-[var(--accent-contrast)] data-[active=true]:border-[var(--accent)]"
            data-active={f.value === 'all' ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <div class="relative">
          <svg
            class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-faint)] pointer-events-none"
            fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input
            id="users-search"
            type="search"
            placeholder="Search email or name…"
            autocomplete="off"
            aria-label="Search users by email or name"
            class="w-full sm:w-64 rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] pl-9 pr-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
          />
        </div>

        <button
          type="button"
          id="users-sort"
          class="px-3 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer"
          title="Toggle sort order"
        >
          Newest first
        </button>

        <button
          type="button"
          id="users-refresh"
          class="p-1.5 rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer"
          title="Refresh"
          aria-label="Refresh users"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </button>
      </div>
    </div>

    <!-- Roster -->
    <div class="border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden shadow-sm">
      <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] px-5 py-4">
        <h2 class="font-display font-bold text-lg text-[var(--text)]">Accounts</h2>
        <span
          id="users-result-count"
          class="shrink-0 rounded-full border border-[var(--accent)]/20 bg-[var(--accent-subtle)] px-2.5 py-0.5 text-xs font-semibold text-[var(--accent)]"
        >—</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[52rem]">
          <thead>
            <tr class="border-b border-[var(--border)] text-left">
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">User</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Status</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Tier</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Provider</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Joined</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">Last sign-in</th>
              <th scope="col" class="px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">ID</th>
            </tr>
          </thead>
          <tbody id="users-table-body">
            <tr>
              <td colspan="7" class="px-4 py-6 text-sm text-[var(--text-muted)]">Loading users…</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border)] px-5 py-3">
        <p id="users-page-label" class="text-xs text-[var(--text-muted)]">—</p>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="users-prev"
            class="px-3 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Previous
          </button>
          <button
            type="button"
            id="users-next"
            class="px-3 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Next
          </button>
        </div>
      </div>
    </div>

    <p id="users-status" role="status" aria-live="polite" class="text-xs min-h-4 text-[var(--text-faint)]"></p>
  </div>
</AdminLayout>

<script is:inline data-astro-rerun>
  (function () {
    var root = document.querySelector('[data-admin-users]');
    var A = window.__bnAdmin;
    if (!root || !A) return;

    var tableBody = root.querySelector('#users-table-body');
    var resultCount = root.querySelector('#users-result-count');
    var pageLabel = root.querySelector('#users-page-label');
    var statusLine = root.querySelector('#users-status');
    var searchInput = root.querySelector('#users-search');
    var sortBtn = root.querySelector('#users-sort');
    var refreshBtn = root.querySelector('#users-refresh');
    var prevBtn = root.querySelector('#users-prev');
    var nextBtn = root.querySelector('#users-next');
    var filterBtns = root.querySelectorAll('[data-user-filter]');

    var PAGE_SIZE = 25;
    var state = { search: '', status: 'all', order: 'desc', offset: 0, total: 0 };
    var debounceTimer = null;

    function setStat(id, value) {
      var el = root.querySelector('#' + id);
      if (el) el.textContent = typeof value === 'number' ? value.toLocaleString() : value;
    }

    function renderStats(stats) {
      if (!stats) return;
      setStat('users-total', stats.total || 0);
      setStat('users-active', stats.active || 0);
      setStat('users-new', stats.newLast7Days || 0);
      setStat('users-admins', stats.admins || 0);
    }

    function buildQuery() {
      var qs = new URLSearchParams();
      qs.set('limit', String(PAGE_SIZE));
      qs.set('offset', String(state.offset));
      qs.set('order', state.order);
      if (state.search) qs.set('search', state.search);
      if (state.status && state.status !== 'all') qs.set('status', state.status);
      return '/api/admin/users?' + qs.toString();
    }

    function load() {
      if (tableBody) {
        tableBody.innerHTML =
          '<tr><td colspan="7" class="px-4 py-6 text-sm text-[var(--text-muted)]">Loading users…</td></tr>';
      }
      return A.getJSON(buildQuery())
        .then(function (data) {
          state.total = data.total || 0;
          renderStats(data.stats);
          renderRows(data.users || []);
          renderPagination();
          if (statusLine) {
            statusLine.textContent = 'Updated just now';
            statusLine.className = 'text-xs min-h-4 text-[var(--text-faint)]';
          }
        })
        .catch(function () {
          if (tableBody) {
            tableBody.innerHTML =
              '<tr><td colspan="7" class="px-4 py-6 text-sm text-[var(--danger-text)]">Failed to load users. Please try again.</td></tr>';
          }
          if (statusLine) {
            statusLine.textContent = 'Could not load users.';
            statusLine.className = 'text-xs min-h-4 text-[var(--danger-text)]';
          }
        });
    }

    // ── Row rendering ───────────────────────────────────────────────────────

    function badge(text, className) {
      var el = document.createElement('span');
      el.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ' + className;
      el.textContent = text;
      return el;
    }

    function statusBadge(status) {
      if (status === 'active') {
        return badge('Active', 'bg-[var(--success-bg)] text-[var(--success-text)] border border-[var(--success-border)]');
      }
      if (status === 'pending') {
        return badge('Pending', 'bg-[var(--warning-bg)] text-[var(--warning-text)] border border-[var(--warning-border)]');
      }
      if (status === 'suspended') {
        return badge('Suspended', 'bg-[var(--danger-bg)] text-[var(--danger-text)] border border-[var(--danger-border)]');
      }
      return badge(status || 'Unknown', 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border)]');
    }

    function tierBadge(tier) {
      if (tier && tier !== 'free') {
        return badge(tier, 'bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent)]/30');
      }
      return badge(tier || 'free', 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border)]');
    }

    function initials(u) {
      var source = u.displayName || u.email || '?';
      return source.trim().charAt(0).toUpperCase();
    }

    function timeCell(ts, fallback) {
      var wrap = document.createElement('div');
      var main = document.createElement('div');
      main.className = 'text-[var(--text)] whitespace-nowrap';
      main.textContent = ts ? A.formatDateTime(ts) : fallback;
      var sub = document.createElement('div');
      sub.className = 'text-[11px] text-[var(--text-faint)]';
      sub.textContent = ts ? A.timeAgo(ts) : '—';
      wrap.appendChild(main);
      wrap.appendChild(sub);
      return wrap;
    }

    function renderRows(users) {
      if (!tableBody) return;
      tableBody.innerHTML = '';

      if (!users.length) {
        var empty = document.createElement('tr');
        var emptyCell = document.createElement('td');
        emptyCell.colSpan = 7;
        emptyCell.className = 'px-4 py-6 text-sm text-[var(--text-muted)]';
        emptyCell.textContent = state.search
          ? 'No users match “' + state.search + '”.'
          : 'No users in this view.';
        empty.appendChild(emptyCell);
        tableBody.appendChild(empty);
        return;
      }

      users.forEach(function (u) {
        var tr = document.createElement('tr');
        tr.className = 'hover:bg-[var(--bg-subtle)] transition-colors';

        // User — avatar, display name, email
        var tdUser = document.createElement('td');
        tdUser.className = 'px-4 py-3';
        var userWrap = document.createElement('div');
        userWrap.className = 'flex items-center gap-3';

        if (u.avatarUrl) {
          var img = document.createElement('img');
          img.src = u.avatarUrl;
          img.alt = '';
          img.referrerPolicy = 'no-referrer';
          img.loading = 'lazy';
          img.className = 'w-8 h-8 rounded-full shrink-0';
          userWrap.appendChild(img);
        } else {
          var avatar = document.createElement('span');
          avatar.className = 'w-8 h-8 rounded-full shrink-0 bg-[var(--accent-subtle)] text-[var(--accent)] flex items-center justify-center text-xs font-bold';
          avatar.textContent = initials(u);
          userWrap.appendChild(avatar);
        }

        var userMeta = document.createElement('div');
        userMeta.className = 'min-w-0';

        var nameLine = document.createElement('div');
        nameLine.className = 'flex items-center gap-2';
        var name = document.createElement('span');
        name.className = 'font-semibold text-[var(--text)] truncate';
        name.textContent = u.displayName || '—';
        nameLine.appendChild(name);
        if (u.isAdmin) {
          nameLine.appendChild(badge('Admin', 'bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent)]/30'));
        }
        if (!u.emailVerified && u.status === 'active') {
          nameLine.appendChild(badge('Unverified', 'bg-[var(--warning-bg)] text-[var(--warning-text)] border border-[var(--warning-border)]'));
        }
        userMeta.appendChild(nameLine);

        var email = document.createElement('div');
        email.className = 'text-xs text-[var(--text-muted)] truncate';
        email.textContent = u.email;
        email.title = u.email;
        userMeta.appendChild(email);

        userWrap.appendChild(userMeta);
        tdUser.appendChild(userWrap);
        tr.appendChild(tdUser);

        // Status
        var tdStatus = document.createElement('td');
        tdStatus.className = 'px-4 py-3';
        tdStatus.appendChild(statusBadge(u.status));
        tr.appendChild(tdStatus);

        // Tier
        var tdTier = document.createElement('td');
        tdTier.className = 'px-4 py-3';
        tdTier.appendChild(tierBadge(u.tier));
        tr.appendChild(tdTier);

        // Provider
        var tdProvider = document.createElement('td');
        tdProvider.className = 'px-4 py-3';
        if (u.providers && u.providers.length) {
          var providerWrap = document.createElement('div');
          providerWrap.className = 'flex flex-wrap gap-1';
          u.providers.forEach(function (p) {
            providerWrap.appendChild(
              badge(p, 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border)]'),
            );
          });
          tdProvider.appendChild(providerWrap);
        } else {
          var none = document.createElement('span');
          none.className = 'text-xs text-[var(--text-faint)]';
          none.textContent = '—';
          tdProvider.appendChild(none);
        }
        tr.appendChild(tdProvider);

        // Joined
        var tdJoined = document.createElement('td');
        tdJoined.className = 'px-4 py-3';
        tdJoined.appendChild(timeCell(u.createdAt, '—'));
        tr.appendChild(tdJoined);

        // Last sign-in
        var tdLast = document.createElement('td');
        tdLast.className = 'px-4 py-3';
        tdLast.appendChild(timeCell(u.lastLoginAt, 'Never'));
        tr.appendChild(tdLast);

        // ID
        var tdId = document.createElement('td');
        tdId.className = 'px-4 py-3';
        var idWrap = document.createElement('div');
        idWrap.className = 'flex items-center gap-2';

        var idCode = document.createElement('code');
        idCode.className = 'text-[11px] text-[var(--text-muted)] font-mono';
        idCode.textContent = u.id ? u.id.slice(0, 8) : '—';
        idCode.title = u.id || '';
        idWrap.appendChild(idCode);

        var copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'text-[11px] font-semibold text-[var(--text-faint)] hover:text-[var(--accent)] transition-colors cursor-pointer';
        copy.textContent = 'Copy';
        copy.title = 'Copy full user id';
        copy.addEventListener('click', function () {
          if (!u.id || !navigator.clipboard) return;
          navigator.clipboard.writeText(u.id).then(function () {
            copy.textContent = 'Copied';
            setTimeout(function () { copy.textContent = 'Copy'; }, 1500);
          });
        });
        idWrap.appendChild(copy);

        tdId.appendChild(idWrap);
        tr.appendChild(tdId);

        tableBody.appendChild(tr);
      });
    }

    // ── Pagination ──────────────────────────────────────────────────────────

    function renderPagination() {
      var shownFrom = state.total === 0 ? 0 : state.offset + 1;
      var shownTo = Math.min(state.offset + PAGE_SIZE, state.total);

      if (pageLabel) {
        pageLabel.textContent =
          'Showing ' + shownFrom + '–' + shownTo + ' of ' + state.total.toLocaleString() +
          (state.total === 1 ? ' user' : ' users');
      }
      if (resultCount) resultCount.textContent = state.total.toLocaleString();
      if (prevBtn) prevBtn.disabled = state.offset <= 0;
      if (nextBtn) nextBtn.disabled = state.offset + PAGE_SIZE >= state.total;
    }

    // ── Events ──────────────────────────────────────────────────────────────

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) { b.dataset.active = 'false'; });
        btn.dataset.active = 'true';
        state.status = btn.dataset.userFilter || 'all';
        state.offset = 0;
        load();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var value = searchInput.value || '';
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
          state.search = value.trim();
          state.offset = 0;
          load();
        }, 300);
      });
    }

    if (sortBtn) {
      sortBtn.addEventListener('click', function () {
        state.order = state.order === 'desc' ? 'asc' : 'desc';
        sortBtn.textContent = state.order === 'desc' ? 'Newest first' : 'Oldest first';
        state.offset = 0;
        load();
      });
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', function () { load(); });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        if (state.offset <= 0) return;
        state.offset = Math.max(0, state.offset - PAGE_SIZE);
        load();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        if (state.offset + PAGE_SIZE >= state.total) return;
        state.offset += PAGE_SIZE;
        load();
      });
    }

    load();
  })();
</script>
