---
/**
 * Admin Supporters — manage the public Wall of Gratitude.
 * Backed by GET/POST /api/admin/supporters.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Supporters" subtitle="Manage the Wall of Gratitude shown on /support">
  <div data-admin-supporters class="grid grid-cols-1 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] gap-6 items-start">
    <!-- Add form -->
    <form id="supporter-form" class="border border-[var(--border)] rounded-[var(--r-md)] p-6 bg-[var(--bg-elevated)] space-y-4">
      <div>
        <h2 class="font-display font-bold text-xl text-[var(--text)]">Add a supporter</h2>
        <p class="mt-1 text-xs text-[var(--text-muted)]">
          Appears on the
          <a href="/support" target="_blank" rel="noopener" class="underline hover:text-[var(--text)]">Wall of Gratitude</a>
          within seconds — no rebuild or deploy needed.
        </p>
      </div>

      <div>
        <label for="supporter-name" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
          Name <span class="text-[var(--danger)]">*</span>
        </label>
        <input
          id="supporter-name"
          name="name"
          type="text"
          required
          maxlength="60"
          autocomplete="off"
          placeholder="Chinmay Das"
          class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="supporter-tier" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Tier</label>
          <select
            id="supporter-tier"
            name="tier"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          >
            <option value="supporter">Supporter</option>
            <option value="chai">Chai</option>
            <option value="fuel">Fuel</option>
            <option value="meal">Meal</option>
            <option value="sponsor">Sponsor</option>
          </select>
        </div>
        <div>
          <label for="supporter-tier-label" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Label</label>
          <input
            id="supporter-tier-label"
            name="tierLabel"
            type="text"
            maxlength="60"
            autocomplete="off"
            placeholder="Optional"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label for="supporter-message" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
          Message <span class="text-[var(--text-faint)] font-normal">(optional, shown publicly)</span>
        </label>
        <textarea
          id="supporter-message"
          name="message"
          rows="2"
          maxlength="280"
          placeholder="Thank you for the notes!"
          class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none resize-y"
        ></textarea>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="supporter-lectures" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
            Lectures Contributed
          </label>
          <input
            id="supporter-lectures"
            name="lecturesContributed"
            type="number"
            min="0"
            max="10000"
            step="1"
            placeholder="0"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
          />
        </div>
        <div>
          <label for="supporter-date" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
            Date <span class="text-[var(--text-faint)] font-normal">(optional)</span>
          </label>
          <input
            id="supporter-date"
            name="date"
            type="text"
            maxlength="40"
            autocomplete="off"
            placeholder="2026-09"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
          />
        </div>
      </div>

      <p id="supporter-form-status" role="status" aria-live="polite" class="text-xs min-h-4"></p>

      <button
        type="submit"
        id="supporter-submit"
        class="w-full rounded-[var(--r-md)] bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-[var(--accent-contrast)] transition-opacity hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
      >
        Add supporter
      </button>
    </form>

    <!-- Roster -->
    <div class="border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden">
      <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] px-5 py-4">
        <h2 class="font-display font-bold text-lg text-[var(--text)]">Wall of Gratitude</h2>
        <span
          id="supporters-count-badge"
          class="shrink-0 rounded-full border border-[var(--accent)]/20 bg-[var(--accent-subtle)] px-2.5 py-0.5 text-xs font-semibold text-[var(--accent)]"
        >—</span>
      </div>
      <div id="supporters-list" class="max-h-[32rem] overflow-y-auto divide-y divide-[var(--border)]">
        <p class="p-6 text-sm text-[var(--text-muted)]">Loading supporters…</p>
      </div>
    </div>
  </div>

  <!-- Edit Supporter Dialog -->
  <dialog id="edit-supporter-dialog" class="rounded-[var(--r-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-6 shadow-xl backdrop:bg-black/50 max-w-md w-full text-[var(--text)] m-auto">
    <form id="edit-supporter-form" method="dialog" class="space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="font-display font-bold text-lg text-[var(--text)]">Edit Supporter</h3>
        <button type="button" id="edit-dialog-close" class="text-sm text-[var(--text-muted)] hover:text-[var(--text)] p-1 cursor-pointer">✕</button>
      </div>

      <input type="hidden" id="edit-supporter-id" />

      <div>
        <label for="edit-supporter-name" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
          Name <span class="text-[var(--danger)]">*</span>
        </label>
        <input
          id="edit-supporter-name"
          name="name"
          type="text"
          required
          maxlength="60"
          class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="edit-supporter-tier" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Tier</label>
          <select
            id="edit-supporter-tier"
            name="tier"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          >
            <option value="supporter">Supporter</option>
            <option value="chai">Chai</option>
            <option value="fuel">Fuel</option>
            <option value="meal">Meal</option>
            <option value="sponsor">Sponsor</option>
          </select>
        </div>
        <div>
          <label for="edit-supporter-tier-label" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Label</label>
          <input
            id="edit-supporter-tier-label"
            name="tierLabel"
            type="text"
            maxlength="60"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="edit-supporter-lectures" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
            Lectures Contributed
          </label>
          <input
            id="edit-supporter-lectures"
            name="lecturesContributed"
            type="number"
            min="0"
            max="10000"
            step="1"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          />
        </div>
        <div>
          <label for="edit-supporter-date" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Date</label>
          <input
            id="edit-supporter-date"
            name="date"
            type="text"
            maxlength="40"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label for="edit-supporter-message" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Message</label>
        <textarea
          id="edit-supporter-message"
          name="message"
          rows="2"
          maxlength="280"
          class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none resize-y"
        ></textarea>
      </div>

      <p id="edit-supporter-status" role="status" aria-live="polite" class="text-xs min-h-4"></p>

      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          type="button"
          id="edit-supporter-cancel"
          class="rounded-[var(--r-sm)] border border-[var(--border)] px-4 py-2 text-xs font-semibold text-[var(--text)] hover:border-[var(--border-strong)] cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="edit-supporter-save"
          class="rounded-[var(--r-sm)] bg-[var(--accent)] px-4 py-2 text-xs font-semibold text-[var(--accent-contrast)] hover:opacity-90 disabled:opacity-50 cursor-pointer"
        >
          Save Changes
        </button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<script is:inline data-astro-rerun>
  (function () {
    var root = document.querySelector('[data-admin-supporters]');
    var A = window.__bnAdmin;
    if (!root || !A) return;

    var supportersList = root.querySelector('#supporters-list');
    var supportersCountBadge = root.querySelector('#supporters-count-badge');
    var supporterForm = root.querySelector('#supporter-form');
    var supporterFormStatus = root.querySelector('#supporter-form-status');
    var supporterSubmit = root.querySelector('#supporter-submit');

    function loadSupporters() {
      if (!supportersList) return;
      supportersList.innerHTML = '<p class="p-6 text-sm text-[var(--text-muted)]">Loading supporters…</p>';
      A.getJSON('/api/admin/supporters')
        .then(function (data) {
          var list = data.supporters || [];
          if (supportersCountBadge) supportersCountBadge.textContent = String(data.total != null ? data.total : list.length);
          if (!list.length) {
            supportersList.innerHTML = '<p class="p-6 text-sm text-[var(--text-muted)]">No supporters yet. Add the first one using the form.</p>';
            return;
          }
          renderSupporters(list);
        })
        .catch(function () {
          supportersList.innerHTML = '<p class="p-6 text-sm text-[var(--danger-text)]">Failed to load supporters. Is migration 007 applied?</p>';
        });
    }

    function renderSupporters(list) {
      supportersList.innerHTML = '';
      list.forEach(function (s) {
        var row = document.createElement('div');
        row.className = 'flex items-start justify-between gap-4 px-5 py-3';

        var left = document.createElement('div');
        left.className = 'min-w-0 flex-1';

        var nameLine = document.createElement('div');
        nameLine.className = 'flex items-center gap-2 flex-wrap';
        var nameEl = document.createElement('span');
        nameEl.className = 'font-semibold text-sm text-[var(--text)]';
        nameEl.textContent = s.name;
        nameLine.appendChild(nameEl);

        var tierEl = document.createElement('span');
        tierEl.className = 'rounded-full border border-[var(--border)] bg-[var(--bg-subtle)] px-2 py-0.5 text-[11px] text-[var(--text-muted)]';
        tierEl.textContent = s.tierLabel || s.tier || 'Supporter';
        nameLine.appendChild(tierEl);

        if (s.lecturesContributed && s.lecturesContributed > 0) {
          var lecEl = document.createElement('span');
          lecEl.className = 'rounded-full border border-[var(--accent)]/30 bg-[var(--accent-subtle)] px-2 py-0.5 text-[11px] font-semibold text-[var(--accent)]';
          lecEl.textContent = s.lecturesContributed + (s.lecturesContributed === 1 ? ' lecture contributed' : ' lectures contributed');
          nameLine.appendChild(lecEl);
        }

        if (s.date) {
          var dateEl = document.createElement('span');
          dateEl.className = 'text-[11px] text-[var(--text-faint)]';
          dateEl.textContent = s.date;
          nameLine.appendChild(dateEl);
        }
        left.appendChild(nameLine);

        if (s.message) {
          var msgEl = document.createElement('p');
          msgEl.className = 'mt-1 text-xs text-[var(--text-muted)] italic truncate';
          msgEl.textContent = '\u201C' + s.message + '\u201D';
          left.appendChild(msgEl);
        }

        var actions = document.createElement('div');
        actions.className = 'shrink-0 flex items-center gap-2';

        var editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'rounded-[var(--r-sm)] border border-[var(--border)] px-2.5 py-1 text-xs font-semibold text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors cursor-pointer';
        editBtn.textContent = 'Edit';
        editBtn.addEventListener('click', function () {
          openEditModal(s);
        });

        var del = document.createElement('button');
        del.type = 'button';
        del.className = 'rounded-[var(--r-sm)] border border-[var(--border)] px-2.5 py-1 text-xs font-semibold text-[var(--danger-text)] hover:border-[var(--danger-text)] transition-colors cursor-pointer disabled:opacity-50';
        del.textContent = 'Remove';
        del.addEventListener('click', function () {
          if (!confirm('Remove ' + s.name + ' from the Wall of Gratitude?')) return;
          del.disabled = true;
          A.postJSON('/api/admin/supporters/' + encodeURIComponent(s.id), { action: 'delete' })
            .then(function (res) {
              if (!res.ok) throw new Error('HTTP ' + res.status);
              loadSupporters();
            })
            .catch(function () {
              del.disabled = false;
              alert('Could not remove supporter.');
            });
        });

        actions.appendChild(editBtn);
        actions.appendChild(del);
        row.appendChild(left);
        row.appendChild(actions);
        supportersList.appendChild(row);
      });
    }

    function setStatus(text, isError) {
      if (!supporterFormStatus) return;
      supporterFormStatus.textContent = text;
      supporterFormStatus.className = 'text-xs min-h-4 ' + (isError ? 'text-[var(--danger-text)]' : 'text-[var(--success)]');
    }

    if (supporterForm) {
      supporterForm.addEventListener('submit', function (e) {
        e.preventDefault();
        if (supporterSubmit) supporterSubmit.disabled = true;
        setStatus('Adding…', false);

        var lecturesInput = root.querySelector('#supporter-lectures');
        var payload = {
          name: (root.querySelector('#supporter-name') || {}).value || '',
          tier: (root.querySelector('#supporter-tier') || {}).value || 'supporter',
          tierLabel: (root.querySelector('#supporter-tier-label') || {}).value || '',
          message: (root.querySelector('#supporter-message') || {}).value || '',
          date: (root.querySelector('#supporter-date') || {}).value || '',
          lecturesContributed: lecturesInput && lecturesInput.value ? parseInt(lecturesInput.value, 10) : 0,
        };

        A.postJSON('/api/admin/supporters', payload)
          .then(function (res) {
            if (!res.ok) {
              setStatus(res.data && res.data.error ? res.data.error : 'Could not add supporter.', true);
              return;
            }
            supporterForm.reset();
            setStatus('Added ' + (res.data.supporter ? res.data.supporter.name : '') + ' — live on /support.', false);
            loadSupporters();
          })
          .catch(function () {
            setStatus('Network error. Please try again.', true);
          })
          .then(function () {
            if (supporterSubmit) supporterSubmit.disabled = false;
          });
      });
    }

    var editDialog = document.getElementById('edit-supporter-dialog');
    var editForm = document.getElementById('edit-supporter-form');
    var editStatus = document.getElementById('edit-supporter-status');
    var editSaveBtn = document.getElementById('edit-supporter-save');
    var editCancelBtn = document.getElementById('edit-supporter-cancel');
    var editCloseBtn = document.getElementById('edit-dialog-close');

    function openEditModal(s) {
      if (!editDialog) return;
      document.getElementById('edit-supporter-id').value = s.id || '';
      document.getElementById('edit-supporter-name').value = s.name || '';
      document.getElementById('edit-supporter-tier').value = s.tier || 'supporter';
      document.getElementById('edit-supporter-tier-label').value = s.tierLabel || '';
      document.getElementById('edit-supporter-lectures').value = (s.lecturesContributed != null) ? s.lecturesContributed : 0;
      document.getElementById('edit-supporter-date').value = s.date || '';
      document.getElementById('edit-supporter-message').value = s.message || '';
      if (editStatus) {
        editStatus.textContent = '';
        editStatus.className = 'text-xs min-h-4';
      }
      if (typeof editDialog.showModal === 'function') {
        editDialog.showModal();
      } else {
        editDialog.setAttribute('open', '');
      }
    }

    function closeEditModal() {
      if (!editDialog) return;
      if (typeof editDialog.close === 'function') {
        editDialog.close();
      } else {
        editDialog.removeAttribute('open');
      }
    }

    if (editCancelBtn) editCancelBtn.addEventListener('click', closeEditModal);
    if (editCloseBtn) editCloseBtn.addEventListener('click', closeEditModal);

    if (editForm) {
      editForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var id = document.getElementById('edit-supporter-id').value;
        if (!id) return;

        if (editSaveBtn) editSaveBtn.disabled = true;
        if (editStatus) {
          editStatus.textContent = 'Saving…';
          editStatus.className = 'text-xs min-h-4 text-[var(--text-muted)]';
        }

        var lecturesVal = document.getElementById('edit-supporter-lectures').value;
        var updatePayload = {
          action: 'update',
          name: document.getElementById('edit-supporter-name').value,
          tier: document.getElementById('edit-supporter-tier').value,
          tierLabel: document.getElementById('edit-supporter-tier-label').value,
          message: document.getElementById('edit-supporter-message').value,
          date: document.getElementById('edit-supporter-date').value,
          lecturesContributed: lecturesVal ? parseInt(lecturesVal, 10) : 0,
        };

        A.postJSON('/api/admin/supporters/' + encodeURIComponent(id), updatePayload)
          .then(function (res) {
            if (!res.ok) {
              if (editStatus) {
                editStatus.textContent = (res.data && res.data.error) ? res.data.error : 'Could not update supporter.';
                editStatus.className = 'text-xs min-h-4 text-[var(--danger-text)]';
              }
              return;
            }
            closeEditModal();
            loadSupporters();
          })
          .catch(function () {
            if (editStatus) {
              editStatus.textContent = 'Network error. Please try again.';
              editStatus.className = 'text-xs min-h-4 text-[var(--danger-text)]';
            }
          })
          .then(function () {
            if (editSaveBtn) editSaveBtn.disabled = false;
          });
      });
    }

    loadSupporters();
  })();
</script>
