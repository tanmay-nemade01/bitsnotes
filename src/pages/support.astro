---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.ts';
import { supporters } from '../data/supporters.ts';
import { getUser, getEnv } from '../lib/apiHelpers';
import { countSupporters, listSupporters } from '../lib/supporters';

export const prerender = false;

const user = getUser(Astro);
const isLoggedIn = Boolean(user);

const { support } = site;

const upi = support.upi;

const upiParams = isLoggedIn ? new URLSearchParams({
  pa: upi.upiId,
  pn: upi.payeeName,
  ...(upi.note ? { tn: upi.note } : {}),
  cu: 'INR',
}) : null;
const upiLink = upiParams ? `upi://pay?${upiParams.toString()}` : '';

const widgetConfig = isLoggedIn ? {
  payeeName: upi.payeeName,
  upiId: upi.upiId,
  defaultNote: upi.note ?? '',
  maxMessageLength: upi.maxMessageLength ?? 50,
} : null;

const buymeacoffee = support.buymeacoffee;

// The wall is a sticky rail, so the number of rendered nodes has to stay
// bounded no matter how many supporters accumulate: full cards for the most
// recent backers, compact name chips beyond that, then a "+N more" summary.
const CARD_LIMIT = 12;
const CHIP_LIMIT = 300;

// Resolve total count and (if logged in) the supporter list.
// If the user is NOT logged in, we strictly ensure NO names or personal details
// are leaked into the SSR HTML.
let totalCount = supporters.length;
let allSupporters = [...supporters];

try {
  const env = await getEnv(Astro);
  if (env?.DB) {
    totalCount = await countSupporters(env.DB);
    if (isLoggedIn) {
      allSupporters = await listSupporters(env.DB, undefined, 'asc');
    }
  }
} catch {
  // Fall back to static counts/data
}

// Only populate supporter arrays when the user is authenticated.
const orderedSupporters = isLoggedIn ? allSupporters : [];
const featuredSupporters = isLoggedIn ? orderedSupporters.slice(0, CARD_LIMIT) : [];
const chipSupporters = isLoggedIn ? orderedSupporters.slice(CARD_LIMIT, CARD_LIMIT + CHIP_LIMIT) : [];
const hiddenSupporterCount = isLoggedIn ? Math.max(0, orderedSupporters.length - CARD_LIMIT - CHIP_LIMIT) : 0;
const latestSupporters = isLoggedIn ? [...allSupporters].slice(-3).reverse() : [];

const initialsOf = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<BaseLayout
  title="Support BitsNotes | BitsNotes"
  description="BitsNotes remains fully free for everyone. If these notes have helped you, voluntary support is deeply appreciated, but only if you can comfortably afford to."
  keywords="support bitsnotes, upi, contribute, voluntary support, free lecture notes"
  robots="index, follow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Support BitsNotes",
      "description": "Voluntary support for BitsNotes — free lecture notes for postgraduate students.",
      "url": "https://bitsnotes.com/support"
    })} />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex-grow w-full lg:grid lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-start lg:gap-x-10 lg:gap-y-10">
    <header class="mb-8 lg:col-start-1 lg:row-start-1">
      <h1 class="font-display text-4xl md:text-5xl font-extrabold text-[var(--text)] tracking-tight leading-tight">
        Support BitsNotes
      </h1>
      <p class="mt-2 text-[var(--text-muted)] text-lg">
        BitsNotes will always remain free. If these notes have been helpful in your studies, and you are in a position to do so, any voluntary contribution is deeply appreciated—but please, only if you can comfortably afford it.
      </p>

      <!-- Kept in the DOM even when the static fallback list is empty, so the
           live roster can reveal it without a server round-trip. -->
      <div
        class="mt-4 flex flex-wrap items-center gap-3 pt-1"
        data-supporters-hero
        style={totalCount === 0 ? 'display:none' : undefined}
      >
        <a
          href="#wall-of-gratitude"
          class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-[var(--border)] bg-[var(--bg-elevated)] hover:border-[var(--accent)] text-xs font-medium text-[var(--text-muted)] transition-colors no-underline group"
        >
          <span class="flex -space-x-1.5 overflow-hidden" data-supporters-hero-stack>
            {isLoggedIn ? (
              featuredSupporters.slice(0, 3).map((s, i) => (
                <span class={`inline-flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-bold ring-2 ring-[var(--bg)] ${
                  i % 2 === 0 ? 'bg-[var(--accent)] text-[var(--accent-contrast)]' : 'bg-[var(--bg-interactive)] text-[var(--text)]'
                }`}>
                  {initialsOf(s.name)}
                </span>
              ))
            ) : (
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-bold ring-2 ring-[var(--bg)] bg-[var(--accent-subtle)] text-[var(--accent)]">
                💛
              </span>
            )}
          </span>
          <span class="group-hover:text-[var(--text)]" data-supporters-hero-text>
            {isLoggedIn && orderedSupporters.length > 0 ? (
              <>
                Backed by <strong class="text-[var(--text)]">{totalCount} supporters</strong> including <span class="text-[var(--text)] font-semibold">{orderedSupporters[0]?.name ?? 'our earliest backers'}</span>{orderedSupporters[1] ? ` & ${orderedSupporters[1].name}` : ''}
              </>
            ) : (
              <>
                Backed by <strong class="text-[var(--text)]">{totalCount} supporters</strong>
              </>
            )}
          </span>
          <svg class="w-3.5 h-3.5 text-[var(--accent)] group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
      </div>
    </header>

    <aside
      id="wall-of-gratitude"
      aria-labelledby="wall-of-gratitude-heading"
      class="mb-10 scroll-mt-24 rounded-[var(--r-md)] border border-[var(--border)] bg-[var(--bg-elevated)] p-4 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:mb-0 lg:flex lg:max-h-[calc(100vh-6.5rem)] lg:flex-col lg:sticky lg:top-20"
    >
      <div class="flex items-center justify-between gap-3">
        <h2 id="wall-of-gratitude-heading" class="font-display text-xl font-bold text-[var(--text)]">
          Wall of Gratitude
        </h2>
        <span
          class="shrink-0 rounded-full border border-[var(--accent)]/20 bg-[var(--accent-subtle)] px-2.5 py-0.5 font-sans text-xs font-semibold text-[var(--accent)]"
          data-supporters-count
        >
          {totalCount}
        </span>
      </div>

      <!-- Scrollable list: capped height + own scrollbar so a large roster can
           never stretch the page. Focusable + labelled for keyboard users.
           Server-rendered for authenticated users, or replaced in place by
           `renderWall()` once /api/supporters responds.
           Unauthenticated users receive an in-place login prompt with zero names leaked. -->
      <div
        class="mt-3 max-h-[70vh] space-y-2 overflow-y-auto overscroll-contain pr-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] lg:mt-4 lg:max-h-none lg:min-h-0 lg:flex-1"
        role="region"
        aria-label="Supporter list"
        tabindex="0"
        data-supporters-list
        data-card-limit={CARD_LIMIT}
        data-chip-limit={CHIP_LIMIT}
      >
        {isLoggedIn ? (
          <>
            {featuredSupporters.map((s) => (
              <div class="flex flex-col justify-between rounded-[var(--r-md)] border border-[var(--border)] bg-[var(--bg)] p-3 transition-colors duration-200 hover:border-[var(--border-strong)]">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full bg-[var(--accent-subtle)] border border-[var(--accent)]/30 text-[var(--accent)] flex items-center justify-center font-bold text-xs flex-shrink-0">
                    {initialsOf(s.name)}
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-1.5">
                      <span class="font-bold text-sm text-[var(--text)] truncate">{s.name}</span>
                      <svg class="w-3.5 h-3.5 text-[var(--accent)] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-label="Verified Supporter">
                        <title>Verified Supporter</title>
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <span class="inline-block text-[11px] font-medium text-[var(--text-muted)]">
                      {s.tierLabel || 'Supporter'}
                    </span>
                  </div>
                </div>
                {s.message && (
                  <p class="mt-2 text-xs text-[var(--text-muted)] italic line-clamp-2">
                    &ldquo;{s.message}&rdquo;
                  </p>
                )}
              </div>
            ))}

            {chipSupporters.length > 0 && (
              <div class="border-t border-[var(--border)] pt-3">
                <h3 class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-faint)]">
                  More supporters
                </h3>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {chipSupporters.map((s) => (
                    <li
                      class="rounded-full border border-[var(--border)] bg-[var(--bg-subtle)] px-2 py-0.5 text-[11px] text-[var(--text-muted)]"
                      title={s.message || undefined}
                    >
                      {s.name}
                    </li>
                  ))}
                </ul>
                {hiddenSupporterCount > 0 && (
                  <p class="mt-2 text-[11px] text-[var(--text-faint)]">
                    and {hiddenSupporterCount} more supporters.
                  </p>
                )}
              </div>
            )}
          </>
        ) : (
          <div
            class="rounded-[var(--r-md)] border border-[var(--border)] bg-[var(--bg)] p-5 text-center flex flex-col items-center justify-center space-y-3.5 my-auto"
            data-supporter-login-prompt
          >
            <div class="w-11 h-11 rounded-full bg-[var(--accent-subtle)] border border-[var(--accent)]/30 text-[var(--accent)] flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <div class="space-y-1">
              <h3 class="font-display text-sm font-bold text-[var(--text)]">
                Supporters list is private
              </h3>
              <p class="text-xs text-[var(--text-muted)] leading-relaxed max-w-[240px]">
                Please log in to view the Wall of Gratitude and our community supporters.
              </p>
            </div>
            <a
              href="/auth/signin?redirect=/support#wall-of-gratitude"
              class="inline-flex items-center justify-center gap-1.5 w-full px-4 py-2 rounded-[var(--r-sm)] bg-[var(--accent)] text-[var(--accent-contrast)] hover:bg-[var(--accent-hover)] font-semibold text-xs transition-colors shadow-xs no-underline"
            >
              <span>Sign in to view</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
            <p class="text-[11px] text-[var(--text-faint)]">
              Don't have an account? <a href="/auth/signup?redirect=/support#wall-of-gratitude" class="text-[var(--accent)] hover:underline font-medium">Sign up</a>
            </p>
          </div>
        )}
      </div>

      <!-- Separate bar below: Latest 3 supporters -->
      <div
        class="mt-3 pt-3 border-t border-[var(--border)] bg-[var(--bg-subtle)]/70 -mx-4 -mb-4 px-4 py-3 rounded-b-[var(--r-md)]"
        data-latest-supporters-bar
        style={!isLoggedIn || latestSupporters.length === 0 ? 'display:none' : undefined}
      >
        <div class="flex items-center justify-between gap-2 mb-2">
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            <h3 class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-muted)]">
              Latest Supporters
            </h3>
          </div>
          <span class="text-[10px] text-[var(--text-faint)] font-medium">Recent 3</span>
        </div>
        <div class="space-y-1.5" data-latest-supporters-list>
          {isLoggedIn && latestSupporters.map((s) => (
            <div class="flex items-center justify-between gap-2 px-2.5 py-1.5 rounded-[var(--r-sm)] bg-[var(--bg-elevated)] border border-[var(--border)] text-xs transition-colors hover:border-[var(--border-strong)]">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-5 h-5 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] font-bold text-[10px] flex items-center justify-center shrink-0">
                  {initialsOf(s.name)}
                </span>
                <span class="font-medium text-[var(--text)] truncate">{s.name}</span>
              </div>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] text-[var(--text-muted)] shrink-0 font-medium">
                {s.tierLabel || 'Supporter'}
              </span>
            </div>
          ))}
        </div>
      </div>
    </aside>

    <div class="mt-10 space-y-10 lg:col-start-1 lg:row-start-2 lg:mt-0">
      <section>
        <h2 class="font-display text-2xl font-bold text-[var(--text)] mb-3">Why I started this project</h2>
        <p class="text-[var(--text-muted)] leading-relaxed">
          I started BitsNotes as a personal project to keep my own lecture notes organized, hoping they might also help others in their studies. My goal has always been simple: to share clear, well-structured notes that anyone can freely access, read, and use, without any barriers, sign-ups, or paywalls.
        </p>
      </section>
      <section>
        <h2 class="font-display text-2xl font-bold text-[var(--text)] mb-3">How your contributions help</h2>
        <p class="text-[var(--text-muted)] leading-relaxed mb-4">
          While I am glad to host and keep this site running, there are real costs involved in maintaining it. If you choose to support my work, your contributions directly help cover:
        </p>
        <ul class="space-y-2">
          {[
            ['Cloudflare hosting', 'Running the site on Cloudflare Workers, storage, and CDN so the notes load quickly and reliably for everyone.'],
            ['Domain costs', 'Keeping the BitsNotes domains registered and renewing them each year.'],
            ['AI costs', 'Powering AI features like the chatbot, which rely on paid model usage.'],
          ].map(([title, body]) => (
            <li class="flex gap-3">
              <svg class="w-5 h-5 text-[var(--accent)] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-[var(--text-muted)] leading-relaxed">
                <span class="font-semibold text-[var(--text)]">{title}.</span> {body}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="p-6 border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)]">
        <h2 class="font-display text-2xl font-bold text-[var(--text)] mb-2">Voluntary support</h2>
        <p class="text-[var(--text-muted)] leading-relaxed mb-6">
          There is absolutely no obligation and no locked content. The notes will always remain fully free. If you have the means and wish to support my work, any contribution is received with sincere gratitude. Please prioritize your own needs first.
        </p>

        {isLoggedIn ? (
          <>
            {upi.enabled && (
              <div
                id="donate-widget"
                data-config={JSON.stringify(widgetConfig)}
                data-upi-id={upi.upiId}
                data-payee-name={upi.payeeName}
              >
                <div
                  class="mb-5 rounded-[var(--r-sm)] border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm leading-relaxed text-[var(--text)]"
                  role="note"
                  aria-label="Verify payee before paying"
                  data-verify-payee-notice
                >
                  <strong class="font-bold">Verify before you pay:</strong>
                  {' '}your UPI app must show payee <strong class="font-bold" data-payee-name-text>{upi.payeeName}</strong>.
                  If it shows any other name, do not pay — the QR may have been tampered with.
                  {' '}<a href="/contact" class="underline font-semibold">Report it here</a>.
                </div>
                <p class="mb-5 text-sm text-[var(--text-muted)] leading-relaxed">
                  UPI ID (visible so anyone can spot tampering):{' '}
                  <code
                    class="font-mono font-bold text-[var(--text)] break-all"
                    data-upi-id-text
                  >{upi.upiId}</code>
                </p>
                <p
                  id="donate-tamper-warning"
                  class="hidden mb-5 rounded-[var(--r-sm)] border border-red-500/50 bg-red-500/10 px-4 py-3 text-sm font-semibold text-red-700 dark:text-red-300"
                  role="alert"
                >
                  Warning: this page's payment details look inconsistent. Do not pay until this is resolved — please report it via the contact page.
                </p>
                <div class="flex flex-col md:flex-row gap-8 items-start">
                  <div class="flex-1 w-full space-y-5">
                    <div>
                      <h3 class="font-bold text-sm text-[var(--text)] uppercase tracking-wider mb-1">Pick an amount</h3>
                      <p class="text-xs text-[var(--text-faint)] mb-3">Or leave it empty and choose any amount in your UPI app.</p>
                      <div class="grid grid-cols-2 gap-2" role="group" aria-label="Preset amounts">
                        {(upi.presets ?? []).map((preset) => (
                          <button
                            type="button"
                            class="donate-chip flex flex-col items-start gap-0.5 px-3.5 py-2.5 border border-[var(--border)] bg-[var(--bg-input)] rounded-[var(--r-sm)] transition-colors duration-150 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
                            data-amount={preset.amount}
                            aria-pressed="false"
                          >
                            <span class="donate-chip-amount font-display font-bold text-base leading-tight text-[var(--text)]">&#8377;{preset.amount}</span>
                            <span class="donate-chip-label text-xs text-[var(--text-muted)]">{preset.label}</span>
                          </button>
                        ))}
                      </div>
                    </div>

                    <div>
                      <label for="donate-amount" class="block font-bold text-sm text-[var(--text)] uppercase tracking-wider mb-1.5">Custom amount (&#8377;)</label>
                      <input
                        type="number"
                        id="donate-amount"
                        inputmode="decimal"
                        min="1"
                        max="100000"
                        step="any"
                        placeholder="Any amount"
                        class="block w-full px-4 py-2.5 border border-[var(--border)] text-[var(--text)] bg-[var(--bg-input)] placeholder-[var(--input-placeholder)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150"
                      />
                      <p id="amount-hint" class="hidden mt-1.5 text-xs text-[var(--danger-text)]"></p>
                    </div>

                    <div>
                      <label for="donate-message" class="block font-bold text-sm text-[var(--text)] uppercase tracking-wider mb-1.5">Message (optional)</label>
                      <input
                        type="text"
                        id="donate-message"
                        maxlength={widgetConfig?.maxMessageLength ?? 50}
                        placeholder={widgetConfig?.defaultNote ?? ''}
                        class="block w-full px-4 py-2.5 border border-[var(--border)] text-[var(--text)] bg-[var(--bg-input)] placeholder-[var(--input-placeholder)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150"
                      />
                      <p class="mt-1.5 text-xs text-[var(--text-faint)]">Appears in your UPI app as the payment note.</p>
                    </div>

                    <div class="space-y-2 pt-1">
                      <a
                        href={upiLink}
                        id="upi-pay-btn"
                        aria-disabled="false"
                        class="flex items-center justify-center gap-2 w-full px-5 py-3 bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-contrast)] text-sm font-bold rounded-[var(--r-sm)] transition-colors active:scale-[0.97] no-underline"
                      >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                        </svg>
                        Pay <span id="pay-amount-label">via UPI</span>
                      </a>
                      <button
                        type="button"
                        id="copy-upi-btn"
                        class="flex items-center justify-center gap-2 w-full px-5 py-3 border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm font-medium rounded-[var(--r-sm)] hover:border-[var(--border-strong)] transition-colors active:scale-[0.97] cursor-pointer"
                      >
                        Copy UPI ID
                      </button>
                      <p id="upi-copy-status" class="text-xs text-[var(--success-text)]" role="status" aria-live="polite"></p>
                    </div>
                  </div>

                  <div class="w-full md:w-64 flex flex-col items-center gap-3 md:flex-none mx-auto md:mx-0">
                    <div class="w-full max-w-64 p-4 bg-[var(--bg)] border border-[var(--border)] rounded-[var(--r-md)]">
                      <canvas id="donate-qr" width="512" height="512" class="w-full h-auto block" role="img" aria-label={`UPI QR code for ${upi.upiId}. Scan with any UPI app and verify payee ${upi.payeeName}.`}></canvas>
                    </div>
                    <p id="donate-summary" class="text-xs text-center text-[var(--text-muted)]" aria-live="polite"></p>
                  </div>
                </div>

              </div>
            )}

            {buymeacoffee?.url && (
              <div class="mt-8 pt-8 border-t border-[var(--border)]">
                <div class="rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] p-5 transition-colors hover:border-[var(--border-strong)]">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
                    <div class="space-y-1.5 min-w-0 flex-1">
                      <div class="flex items-center gap-2">
                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[#FFDD00]/20 text-[#1E1E1E] dark:text-[#FFDD00] text-sm shrink-0 font-bold">
                          ☕
                        </span>
                        <h3 class="font-display text-base sm:text-lg font-bold text-[var(--text)]">
                          International Supporters &amp; Cards
                        </h3>
                      </div>
                      <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
