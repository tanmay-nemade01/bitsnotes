<style>
  .donate-chip[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }
  .donate-chip[aria-pressed='true'] .donate-chip-amount {
    color: var(--accent-hover);
  }
  .donate-chip[aria-pressed='true'] .donate-chip-label {
    color: var(--accent);
  }
  #upi-pay-btn[aria-disabled='true'] {
    opacity: 0.5;
    pointer-events: none;
  }
</style>

<script>
  import QRCode from 'qrcode';

  interface WidgetConfig {
    payeeName: string;
    upiId: string;
    defaultNote: string;
    maxMessageLength: number;
  }

  function initDonateWidget() {
    const root = document.getElementById('donate-widget');
    if (!root || !root.dataset.config) return;

    let config: WidgetConfig;
    try {
      config = JSON.parse(root.dataset.config);
    } catch {
      return;
    }

    const amountInput = document.getElementById('donate-amount') as HTMLInputElement | null;
    const messageInput = document.getElementById('donate-message') as HTMLInputElement | null;
    const amountHint = document.getElementById('amount-hint');
    const payBtn = document.getElementById('upi-pay-btn') as HTMLAnchorElement | null;
    const payLabel = document.getElementById('pay-amount-label');
    const copyBtn = document.getElementById('copy-upi-btn');
    const copyStatus = document.getElementById('upi-copy-status');
    const canvas = document.getElementById('donate-qr') as HTMLCanvasElement | null;
    const summary = document.getElementById('donate-summary');
    const tamperWarning = document.getElementById('donate-tamper-warning');
    if (!amountInput || !messageInput || !payBtn || !payLabel || !copyBtn || !canvas || !summary) return;

    // Runtime tamper-evidence: the same VPA is rendered in 4 places
    // (data-config, data-upi-id, visible text, pay-button href). An XSS or
    // extension that rewrites only one of them triggers a visible warning.
    // This does NOT replace CI + external monitoring — a full redeploy with
    // a new VPA passes this check, which is why the monitor workflow exists.
    function checkIntegrity() {
      try {
        const attrId = (root!.dataset.upiId || '').trim();
        const attrName = (root!.dataset.payeeName || '').trim();
        const visibleId = (root!.querySelector('[data-upi-id-text]')?.textContent || '').trim();
        const visibleName = (root!.querySelector('[data-payee-name-text]')?.textContent || '').trim();
        const hrefPa = new URL(payBtn!.href, location.origin).searchParams.get('pa')?.trim() ?? '';
        const mismatch =
          !config.upiId ||
          !attrId ||
          config.upiId !== attrId ||
          (visibleId && visibleId !== config.upiId) ||
          (hrefPa && hrefPa !== config.upiId) ||
          (attrName && attrName !== config.payeeName) ||
          (visibleName && visibleName !== config.payeeName);
        if (mismatch && tamperWarning) {
          tamperWarning.classList.remove('hidden');
          payBtn!.setAttribute('aria-disabled', 'true');
          return false;
        }
        return true;
      } catch {
        return true;
      }
    }

    let lastGoodUri = '';

    function parseAmount(raw: string): { ok: boolean; value: number | null } {
      const trimmed = raw.trim().replace(/[₹,\s]/g, '');
      if (!trimmed) return { ok: true, value: null };
      if (!/^\d{1,6}(\.\d{1,2})?$/.test(trimmed)) return { ok: false, value: null };
      const n = Number(trimmed);
      if (!(n >= 1 && n <= 100000)) return { ok: false, value: null };
      return { ok: true, value: Math.round(n * 100) / 100 };
    }

    function buildUpiUri(amount: number | null, message: string): string {
      const params = new URLSearchParams({
        pa: config.upiId,
        pn: config.payeeName,
        cu: 'INR',
      });
      if (amount !== null) params.set('am', String(amount));
      const note = (message || config.defaultNote).slice(0, config.maxMessageLength).trim();
      if (note) params.set('tn', note);
      return `upi://pay?${params.toString()}`;
    }

    async function renderQr(uri: string) {
      try {
        const rootStyles = getComputedStyle(document.documentElement);
        const bodyStyles = getComputedStyle(document.body);
        await QRCode.toCanvas(canvas!, uri, {
          width: 512,
          margin: 1,
          errorCorrectionLevel: 'M',
          color: {
            dark: rootStyles.getPropertyValue('--text').trim() || bodyStyles.color,
            light: rootStyles.getPropertyValue('--bg').trim() || bodyStyles.backgroundColor,
          },
        });
        // The library sets inline width/height (512px), which overrides our CSS
        // and makes the QR overflow its container. Let CSS control the size.
        canvas!.style.width = '100%';
        canvas!.style.height = 'auto';
        lastGoodUri = uri;
      } catch {
        lastGoodUri = '';
      }
    }

    function clearChipSelection() {
      root!.querySelectorAll<HTMLButtonElement>('.donate-chip').forEach((chip) => {
        chip.setAttribute('aria-pressed', 'false');
      });
    }

    function updateHint(ok: boolean) {
      if (!amountHint) return;
      if (ok) {
        amountHint.classList.add('hidden');
        amountHint.textContent = '';
      } else {
        amountHint.classList.remove('hidden');
        amountHint.textContent = 'Enter an amount between \u20B91 and \u20B91,00,000.';
      }
    }

    function update() {
      const { ok, value } = parseAmount(amountInput!.value);
      const message = messageInput!.value.trim().slice(0, config.maxMessageLength);

      updateHint(ok);
      payBtn!.setAttribute('aria-disabled', ok ? 'false' : 'true');
      if (value !== null) {
        const formatted = Number.isInteger(value) ? String(value) : value.toFixed(2);
        payLabel!.textContent = `\u20B9${formatted} via UPI`;
      } else {
        payLabel!.textContent = 'via UPI';
      }

      if (ok) {
        const uri = buildUpiUri(value, message);
        void renderQr(uri);
        summary!.textContent =
          value !== null
            ? `Scan to pay \u20B9${Number.isInteger(value) ? value : value.toFixed(2)} to ${config.payeeName}`
            : `Scan with any UPI app\u2014you choose the amount`;
      }
    }

    root.querySelectorAll<HTMLButtonElement>('.donate-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        clearChipSelection();
        chip.setAttribute('aria-pressed', 'true');
        amountInput!.value = chip.dataset.amount ?? '';
        update();
      });
    });

    let debounceTimer: ReturnType<typeof setTimeout>;
    const debouncedUpdate = () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(update, 120);
    };

    amountInput.addEventListener('input', () => {
      clearChipSelection();
      debouncedUpdate();
    });
    messageInput.addEventListener('input', debouncedUpdate);

    if (copyBtn && copyStatus) {
      copyBtn.addEventListener('click', function () {
        function done(msg: string) {
          copyStatus!.textContent = msg;
          setTimeout(function () {
            copyStatus!.textContent = '';
          }, 2500);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(config.upiId).then(
            function () {
              done('UPI ID copied.');
            },
            function () {
              done('Could not copy the UPI ID.');
            }
          );
        } else {
          try {
            var ta = document.createElement('textarea');
            ta.value = config.upiId;
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            done('UPI ID copied.');
          } catch (e) {
            done('Could not copy the UPI ID.');
          }
        }
      });
    }

    let themeObserver: MutationObserver | undefined;
    themeObserver?.disconnect();
    themeObserver = new MutationObserver(() => {
      if (lastGoodUri) void renderQr(lastGoodUri);
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    update();
    checkIntegrity();
  }

  initDonateWidget();
  document.addEventListener('astro:after-swap', initDonateWidget);
</script>

<!--
  Live Wall of Gratitude.

  The page is statically generated, so the wall is first painted from
  `src/data/supporters.ts`. This script then swaps in the authoritative roster
  from `/api/supporters` (D1 `supporters` table, editable in /admin), which is
  what makes a new supporter appear within seconds instead of waiting for the
  next deploy.

  Deliberately inline (no bundler, no dependencies) and fail-safe: any error
  simply leaves the server-rendered list in place.
-->
<script is:inline>
  (function () {
    var listEl = document.querySelector('[data-supporters-list]');
    if (!listEl || typeof fetch !== 'function') return;

    var countEl = document.querySelector('[data-supporters-count]');
    var heroEl = document.querySelector('[data-supporters-hero]');
    var heroStackEl = document.querySelector('[data-supporters-hero-stack]');
    var heroTextEl = document.querySelector('[data-supporters-hero-text]');
    var latestBarEl = document.querySelector('[data-latest-supporters-bar]');
    var latestListEl = document.querySelector('[data-latest-supporters-list]');

    var CARD_LIMIT = parseInt(listEl.dataset.cardLimit || '12', 10);
    var CHIP_LIMIT = parseInt(listEl.dataset.chipLimit || '300', 10);

    function esc(value) {
      return String(value).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function initialsOf(name) {
      return String(name)
        .split(' ')
        .filter(Boolean)
        .map(function (part) { return part[0]; })
        .join('')
        .slice(0, 2)
        .toUpperCase();
    }

    var VERIFIED_SVG =
      '<svg class="w-3.5 h-3.5 text-[var(--accent)] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-label="Verified Supporter">' +
      '<title>Verified Supporter</title>' +
      '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>' +
      '</svg>';

    function cardHtml(s) {
      return (
        '<div class="flex flex-col justify-between rounded-[var(--r-md)] border border-[var(--border)] bg-[var(--bg)] p-3 transition-colors duration-200 hover:border-[var(--border-strong)]">' +
          '<div class="flex items-center gap-3">' +
            '<div class="w-9 h-9 rounded-full bg-[var(--accent-subtle)] border border-[var(--accent)]/30 text-[var(--accent)] flex items-center justify-center font-bold text-xs flex-shrink-0">' +
              esc(initialsOf(s.name)) +
            '</div>' +
            '<div class="min-w-0 flex-1">' +
              '<div class="flex items-center gap-1.5">' +
                '<span class="font-bold text-sm text-[var(--text)] truncate">' + esc(s.name) + '</span>' +
                VERIFIED_SVG +
              '</div>' +
              '<span class="inline-block text-[11px] font-medium text-[var(--text-muted)]">' +
                esc(s.tierLabel || 'Supporter') +
              '</span>' +
            '</div>' +
          '</div>' +
          (s.message
            ? '<p class="mt-2 text-xs text-[var(--text-muted)] italic line-clamp-2">&ldquo;' + esc(s.message) + '&rdquo;</p>'
            : '') +
        '</div>'
      );
    }

    function chipHtml(s) {
      return (
        '<li class="rounded-full border border-[var(--border)] bg-[var(--bg-subtle)] px-2 py-0.5 text-[11px] text-[var(--text-muted)]"' +
          (s.message ? ' title="' + esc(s.message) + '"' : '') +
        '>' + esc(s.name) + '</li>'
      );
    }

    function renderWall(supporters) {
      var cards = supporters.slice(0, CARD_LIMIT);
      var chips = supporters.slice(CARD_LIMIT, CARD_LIMIT + CHIP_LIMIT);
      var hidden = Math.max(0, supporters.length - CARD_LIMIT - CHIP_LIMIT);

      var html = cards.map(cardHtml).join('');

      if (chips.length) {
        html +=
          '<div class="border-t border-[var(--border)] pt-3">' +
            '<h3 class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-faint)]">More supporters</h3>' +
            '<ul class="mt-2 flex flex-wrap gap-1.5">' + chips.map(chipHtml).join('') + '</ul>' +
            (hidden > 0
              ? '<p class="mt-2 text-[11px] text-[var(--text-faint)]">and ' + hidden + ' more supporters.</p>'
              : '') +
          '</div>';
      }

      if (!supporters.length) {
        html = '<p class="text-sm text-[var(--text-muted)]">No supporters yet — be the first to help out.</p>';
      }

      listEl.innerHTML = html;
    }

    function renderLatest(latestSupporters) {
      if (!latestBarEl || !latestListEl) return;
      if (!latestSupporters || !latestSupporters.length) {
        latestBarEl.style.display = 'none';
        return;
      }
      latestBarEl.style.display = '';
      latestListEl.innerHTML = latestSupporters.map(function (s) {
        return (
          '<div class="flex items-center justify-between gap-2 px-2.5 py-1.5 rounded-[var(--r-sm)] bg-[var(--bg-elevated)] border border-[var(--border)] text-xs transition-colors hover:border-[var(--border-strong)]">' +
            '<div class="flex items-center gap-2 min-w-0">' +
              '<span class="w-5 h-5 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] font-bold text-[10px] flex items-center justify-center shrink-0">' +
                esc(initialsOf(s.name)) +
              '</span>' +
              '<span class="font-medium text-[var(--text)] truncate">' + esc(s.name) + '</span>' +
            '</div>' +
            '<span class="text-[10px] px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] text-[var(--text-muted)] shrink-0 font-medium">' +
              esc(s.tierLabel || 'Supporter') +
            '</span>' +
          '</div>'
        );
      }).join('');
    }

    function renderLoginPrompt() {
      if (latestBarEl) latestBarEl.style.display = 'none';
      if (latestListEl) latestListEl.innerHTML = '';
      listEl.innerHTML =
        '<div class="rounded-[var(--r-md)] border border-[var(--border)] bg-[var(--bg)] p-5 text-center flex flex-col items-center justify-center space-y-3.5 my-auto" data-supporter-login-prompt>' +
          '<div class="w-11 h-11 rounded-full bg-[var(--accent-subtle)] border border-[var(--accent)]/30 text-[var(--accent)] flex items-center justify-center">' +
            '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">' +
              '<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>' +
            '</svg>' +
          '</div>' +
          '<div class="space-y-1">' +
            '<h3 class="font-display text-sm font-bold text-[var(--text)]">' +
              'Supporters list is private' +
            '</h3>' +
            '<p class="text-xs text-[var(--text-muted)] leading-relaxed max-w-[240px]">' +
              'Please log in to view the Wall of Gratitude and our community supporters.' +
            '</p>' +
          '</div>' +
          '<a href="/auth/signin?redirect=/support#wall-of-gratitude" class="inline-flex items-center justify-center gap-1.5 w-full px-4 py-2 rounded-[var(--r-sm)] bg-[var(--accent)] text-[var(--accent-contrast)] hover:bg-[var(--accent-hover)] font-semibold text-xs transition-colors shadow-xs no-underline">' +
            '<span>Sign in to view</span>' +
            '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>' +
          '</a>' +
          '<p class="text-[11px] text-[var(--text-faint)]">' +
            'Don&#39;t have an account? <a href="/auth/signup?redirect=/support#wall-of-gratitude" class="text-[var(--accent)] hover:underline font-medium">Sign up</a>' +
          '</p>' +
        '</div>';
    }

    function renderSummary(supporters, total, isAuthenticated) {
      var count = typeof total === 'number' && total >= 0 ? total : supporters.length;
      if (countEl) countEl.textContent = String(count);

      if (!heroEl) return;
      if (count === 0) {
        heroEl.style.display = 'none';
        return;
      }
      heroEl.style.display = '';

      if (!isAuthenticated) {
        if (heroStackEl) {
          heroStackEl.innerHTML =
            '<span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-bold ring-2 ring-[var(--bg)] bg-[var(--accent-subtle)] text-[var(--accent)]">' +
              '💛' +
            '</span>';
        }
        if (heroTextEl) {
          heroTextEl.innerHTML =
            'Backed by <strong class="text-[var(--text)]">' + count + ' supporters</strong>';
        }
        return;
      }

      if (heroStackEl && supporters.length) {
        heroStackEl.innerHTML = supporters.slice(0, 3).map(function (s, i) {
          var tone = i % 2 === 0
            ? 'bg-[var(--accent)] text-[var(--accent-contrast)]'
            : 'bg-[var(--bg-interactive)] text-[var(--text)]';
          return '<span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-bold ring-2 ring-[var(--bg)] ' + tone + '">' +
            esc(initialsOf(s.name)) +
          '</span>';
        }).join('');
      }

      if (heroTextEl) {
        heroTextEl.innerHTML =
          'Backed by <strong class="text-[var(--text)]">' + count + ' supporters</strong>' +
          (supporters.length ? ' including <span class="text-[var(--text)] font-semibold">' + esc(supporters[0].name) + '</span>' +
          (supporters[1] ? ' &amp; ' + esc(supporters[1].name) : '') : '');
      }
    }

    function refresh() {
      fetch('/api/supporters', { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        })
        .then(function (data) {
          if (!data || data.authenticated === false) {
            renderLoginPrompt();
            renderSummary([], data ? data.total : undefined, false);
            return;
          }
          var supporters = Array.isArray(data.supporters) ? data.supporters : [];
          var latest = Array.isArray(data.latest) && data.latest.length > 0
            ? data.latest
            : supporters.slice(-3).reverse();
          renderWall(supporters);
          renderLatest(latest);
          renderSummary(supporters, data.total, true);
        })
        .catch(function () {
          // Keep current rendered state on network failure
        });
    }

    refresh();

    // Re-run after a view-transition (client-side) navigation back to /support.
    document.addEventListener('astro:after-swap', refresh);

    // Re-evaluate whenever user authentication state changes in navbar/session.
    window.addEventListener('bitsnotes:user-updated', function (e) {
      if (!e.detail) {
        renderLoginPrompt();
        renderSummary([], undefined, false);
        if (document.getElementById('donate-widget')) {
          window.location.reload();
        }
      } else {
        if (!document.getElementById('donate-widget')) {
          window.location.reload();
        } else {
          refresh();
        }
      }
    });

    // Pick up a supporter added in another tab without a manual reload.
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') refresh();
    });
  })();
</script>
