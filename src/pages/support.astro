---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.ts';

const { support } = site;

const upi = support.upi;

const upiParams = new URLSearchParams({
  pa: upi.upiId,
  pn: upi.payeeName,
  ...(upi.note ? { tn: upi.note } : {}),
  cu: 'INR',
});
const upiLink = `upi://pay?${upiParams.toString()}`;

const widgetConfig = {
  payeeName: upi.payeeName,
  upiId: upi.upiId,
  defaultNote: upi.note ?? '',
  maxMessageLength: upi.maxMessageLength ?? 50,
};
---

<BaseLayout
  title="Support BitsNotes | BitsNotes"
  description="BitsNotes remains fully free for everyone. If these notes have helped you, voluntary support is deeply appreciated, but only if you can comfortably afford to."
  keywords="support bitsnotes, buy me a coffee, contribute, voluntary support, free lecture notes"
  robots="index, follow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Support BitsNotes",
      "description": "Voluntary support for BitsNotes — free lecture notes for postgraduate students.",
      "url": "https://bitsnotes.com/support"
    })} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex-grow w-full">
    <header class="mb-10">
      <h1 class="font-display text-4xl md:text-5xl font-extrabold text-[var(--text)] tracking-tight leading-tight">
        Support BitsNotes
      </h1>
      <p class="mt-2 text-[var(--text-muted)] text-lg">
        BitsNotes will always remain free. If these notes have been helpful in your studies, and you are in a position to do so, any voluntary contribution is deeply appreciated—but please, only if you can comfortably afford it.
      </p>
    </header>

    <div class="space-y-10">
      <section>
        <h2 class="font-display text-2xl font-bold text-[var(--text)] mb-3">Why I started this project</h2>
        <p class="text-[var(--text-muted)] leading-relaxed">
          I started BitsNotes as a personal project to keep my own lecture notes organized, hoping they might also help others in their studies. My goal has always been simple: to share clear, well-structured notes that anyone can freely access, read, and use, without any barriers, sign-ups, or paywalls.
        </p>
      </section>

      <section>
        <h2 class="font-display text-2xl font-bold text-[var(--text)] mb-3">How your contributions help</h2>
        <p class="text-[var(--text-muted)] leading-relaxed mb-4">
          While I am glad to host and keep this site running, there are real costs involved in maintaining it. If you choose to support my work, your contributions directly help cover:
        </p>
        <ul class="space-y-2">
          {[
            ['Hosting & server costs', 'Keeping the servers, storage, and CDN running so the notes load quickly and reliably for everyone.'],
            ['Study resources & content', 'Allowing me to dedicate more time to researching, writing, and refining these lecture notes.'],
            ['Maintenance & updates', 'Keeping the site fast, accessible, secure, and running smoothly as technologies evolve.'],
          ].map(([title, body]) => (
            <li class="flex gap-3">
              <svg class="w-5 h-5 text-[var(--accent)] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-[var(--text-muted)] leading-relaxed">
                <span class="font-semibold text-[var(--text)]">{title}.</span> {body}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="p-6 border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)]">
        <h2 class="font-display text-2xl font-bold text-[var(--text)] mb-2">Voluntary support</h2>
        <p class="text-[var(--text-muted)] leading-relaxed mb-6">
          There is absolutely no obligation and no locked content. The notes will always remain fully free. If you have the means and wish to support my work, any contribution is received with sincere gratitude. Please prioritize your own needs first.
        </p>

        {support.buymeacoffee?.url && (
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-6 pb-6 border-b border-[var(--border)]">
            <a
              href={support.buymeacoffee.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-contrast)] text-sm font-bold rounded-[var(--r-sm)] transition-colors active:scale-[0.97] no-underline"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 19h13v2H4v-2zm13.5-8.5c0 .8-.7 1.5-1.5 1.5h-1v3h-2v-7h3.5c1.4 0 2.5 1.1 2.5 2.5 0 .3 0 .6-.1.9.6.4 1.1 1.1 1.1 1.9 0 1.2-1 2.2-2.2 2.2H15v-2h1.3c.1 0 .2-.1.2-.2 0-.1-.1-.2-.2-.2h-1.3V11h1.5c.4 0 .5-.6.1-.9zM5 11V6h7v5H5zm9-3h2.5c.3 0 .5-.2.5-.5s-.2-.5-.5-.5H14V8zm-9 1h7V7H5v2z"/>
              </svg>
              Support via Buy Me a Coffee
            </a>
            <span class="text-xs text-[var(--text-faint)]">Opens in a new tab. No sign-up or account is required to read the notes.</span>
          </div>
        )}

        {upi.enabled && (
          <div id="donate-widget" data-config={JSON.stringify(widgetConfig)}>
            <div class="flex flex-col md:flex-row gap-8 items-start">
              <div class="flex-1 w-full space-y-5">
                <div>
                  <h3 class="font-bold text-sm text-[var(--text)] uppercase tracking-wider mb-1">Pick an amount</h3>
                  <p class="text-xs text-[var(--text-faint)] mb-3">Or leave it empty and choose any amount in your UPI app.</p>
                  <div class="grid grid-cols-2 gap-2" role="group" aria-label="Preset amounts">
                    {(upi.presets ?? []).map((preset) => (
                      <button
                        type="button"
                        class="donate-chip flex flex-col items-start gap-0.5 px-3.5 py-2.5 border border-[var(--border)] bg-[var(--bg-input)] rounded-[var(--r-sm)] transition-colors duration-150 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
                        data-amount={preset.amount}
                        aria-pressed="false"
                      >
                        <span class="donate-chip-amount font-display font-bold text-base leading-tight text-[var(--text)]">&#8377;{preset.amount}</span>
                        <span class="donate-chip-label text-xs text-[var(--text-muted)]">{preset.label}</span>
                      </button>
                    ))}
                  </div>
                </div>

                <div>
                  <label for="donate-amount" class="block font-bold text-sm text-[var(--text)] uppercase tracking-wider mb-1.5">Custom amount (&#8377;)</label>
                  <input
                    type="number"
                    id="donate-amount"
                    inputmode="decimal"
                    min="1"
                    max="100000"
                    step="any"
                    placeholder="Any amount"
                    class="block w-full px-4 py-2.5 border border-[var(--border)] text-[var(--text)] bg-[var(--bg-input)] placeholder-[var(--input-placeholder)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150"
                  />
                  <p id="amount-hint" class="hidden mt-1.5 text-xs text-[var(--danger-text)]"></p>
                </div>

                <div>
                  <label for="donate-message" class="block font-bold text-sm text-[var(--text)] uppercase tracking-wider mb-1.5">Message (optional)</label>
                  <input
                    type="text"
                    id="donate-message"
                    maxlength={widgetConfig.maxMessageLength}
                    placeholder={widgetConfig.defaultNote}
                    class="block w-full px-4 py-2.5 border border-[var(--border)] text-[var(--text)] bg-[var(--bg-input)] placeholder-[var(--input-placeholder)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150"
                  />
                  <p class="mt-1.5 text-xs text-[var(--text-faint)]">Appears in your UPI app as the payment note.</p>
                </div>

                <div class="space-y-2 pt-1">
                  <a
                    href={upiLink}
                    id="upi-pay-btn"
                    aria-disabled="false"
                    class="flex items-center justify-center gap-2 w-full px-5 py-3 bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-contrast)] text-sm font-bold rounded-[var(--r-sm)] transition-colors active:scale-[0.97] no-underline"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                    </svg>
                    Pay <span id="pay-amount-label">via UPI</span>
                  </a>
                  <button
                    type="button"
                    id="copy-upi-btn"
                    class="flex items-center justify-center gap-2 w-full px-5 py-3 border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm font-medium rounded-[var(--r-sm)] hover:border-[var(--border-strong)] transition-colors active:scale-[0.97] cursor-pointer"
                    data-upi={upi.upiId}
                  >
                    Copy UPI ID
                  </button>
                  <p id="upi-copy-status" class="text-xs text-[var(--success-text)]" role="status" aria-live="polite"></p>
                  <p class="text-xs text-[var(--text-faint)] break-all">
                    UPI ID: <span class="font-mono">{upi.upiId}</span>
                  </p>
                </div>
              </div>

              <div class="w-full md:w-64 flex flex-col items-center gap-3 md:flex-none mx-auto md:mx-0">
                <div class="w-full max-w-64 p-4 bg-[var(--bg)] border border-[var(--border)] rounded-[var(--r-md)]">
                  <canvas id="donate-qr" width="512" height="512" class="w-full h-auto block" role="img" aria-label="UPI QR code. Scan with any UPI app to support BitsNotes."></canvas>
                </div>
                <p id="donate-summary" class="text-xs text-center text-[var(--text-muted)]" aria-live="polite"></p>
              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-[var(--border)]">
              <p class="text-xs text-[var(--text-faint)] leading-relaxed">
                Payments go directly from your UPI app to me&mdash;no platform, no commission, nothing stored. UPI has no confirmation callback, so this page cannot show a &ldquo;payment received&rdquo; message. If your UPI app refuses to open from the browser (some apps restrict deeplinks), just scan the QR or copy the UPI ID instead&mdash;those work everywhere.
              </p>
            </div>
          </div>
        )}
      </section>

      <section>
        <h2 class="font-display text-2xl font-bold text-[var(--text)] mb-3">A sincere thank you</h2>
        <p class="text-[var(--text-muted)] leading-relaxed">
          Whether or not you are able to support the site financially, I am incredibly grateful that you use BitsNotes. Knowing that these notes are helpful to students is the greatest reward. Thank you for your time, your feedback, and for being part of this journey.
        </p>
      </section>

      <section>
        <h2 class="font-display text-2xl font-bold text-[var(--text)] mb-3">Supporters</h2>
        <p class="text-[var(--text-muted)] leading-relaxed">
          This section is currently empty, but I hope to list and thank those who wish to be mentioned. If you have supported the project and would like your name here, please reach out via the contact page—with sincere thanks, and absolutely no obligation.
        </p>
      </section>

      <section class="p-6 border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-subtle)]">
        <h2 class="font-display text-xl font-bold text-[var(--text)] mb-2">Suggestions or feedback?</h2>
        <p class="text-[var(--text-muted)] leading-relaxed mb-4">
          Found a typo, want a topic covered, or have an idea to make the notes better? I would love to hear it.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 text-sm font-bold text-[var(--accent)] hover:text-[var(--accent-hover)] transition-colors"
        >
          Get in touch
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .donate-chip[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }
  .donate-chip[aria-pressed='true'] .donate-chip-amount {
    color: var(--accent-hover);
  }
  .donate-chip[aria-pressed='true'] .donate-chip-label {
    color: var(--accent);
  }
  #upi-pay-btn[aria-disabled='true'] {
    opacity: 0.5;
    pointer-events: none;
  }
</style>

<script>
  import QRCode from 'qrcode';

  interface WidgetConfig {
    payeeName: string;
    upiId: string;
    defaultNote: string;
    maxMessageLength: number;
  }

  function initDonateWidget() {
    const root = document.getElementById('donate-widget');
    if (!root || !root.dataset.config) return;

    let config: WidgetConfig;
    try {
      config = JSON.parse(root.dataset.config);
    } catch {
      return;
    }

    const amountInput = document.getElementById('donate-amount') as HTMLInputElement | null;
    const messageInput = document.getElementById('donate-message') as HTMLInputElement | null;
    const amountHint = document.getElementById('amount-hint');
    const payBtn = document.getElementById('upi-pay-btn') as HTMLAnchorElement | null;
    const payLabel = document.getElementById('pay-amount-label');
    const copyBtn = document.getElementById('copy-upi-btn');
    const copyStatus = document.getElementById('upi-copy-status');
    const canvas = document.getElementById('donate-qr') as HTMLCanvasElement | null;
    const summary = document.getElementById('donate-summary');
    if (!amountInput || !messageInput || !payBtn || !payLabel || !copyBtn || !canvas || !summary) return;

    let lastGoodUri = '';

    function parseAmount(raw: string): { ok: boolean; value: number | null } {
      const trimmed = raw.trim().replace(/[₹,\s]/g, '');
      if (!trimmed) return { ok: true, value: null };
      if (!/^\d{1,6}(\.\d{1,2})?$/.test(trimmed)) return { ok: false, value: null };
      const n = Number(trimmed);
      if (!(n >= 1 && n <= 100000)) return { ok: false, value: null };
      return { ok: true, value: Math.round(n * 100) / 100 };
    }

    function buildUpiUri(amount: number | null, message: string): string {
      const params = new URLSearchParams({
        pa: config.upiId,
        pn: config.payeeName,
        cu: 'INR',
      });
      if (amount !== null) params.set('am', String(amount));
      const note = (message || config.defaultNote).slice(0, config.maxMessageLength).trim();
      if (note) params.set('tn', note);
      return `upi://pay?${params.toString()}`;
    }

    async function renderQr(uri: string) {
      try {
        const rootStyles = getComputedStyle(document.documentElement);
        const bodyStyles = getComputedStyle(document.body);
        await QRCode.toCanvas(canvas!, uri, {
          width: 512,
          margin: 1,
          errorCorrectionLevel: 'M',
          color: {
            dark: rootStyles.getPropertyValue('--text').trim() || bodyStyles.color,
            light: rootStyles.getPropertyValue('--bg').trim() || bodyStyles.backgroundColor,
          },
        });
        lastGoodUri = uri;
      } catch {
        lastGoodUri = '';
      }
    }

    function clearChipSelection() {
      root!.querySelectorAll<HTMLButtonElement>('.donate-chip').forEach((chip) => {
        chip.setAttribute('aria-pressed', 'false');
      });
    }

    function updateHint(ok: boolean) {
      if (!amountHint) return;
      if (ok) {
        amountHint.classList.add('hidden');
        amountHint.textContent = '';
      } else {
        amountHint.classList.remove('hidden');
        amountHint.textContent = 'Enter an amount between \u20B91 and \u20B91,00,000.';
      }
    }

    function update() {
      const { ok, value } = parseAmount(amountInput!.value);
      const message = messageInput!.value.trim().slice(0, config.maxMessageLength);

      updateHint(ok);
      payBtn!.setAttribute('aria-disabled', ok ? 'false' : 'true');
      if (value !== null) {
        const formatted = Number.isInteger(value) ? String(value) : value.toFixed(2);
        payLabel!.textContent = `\u20B9${formatted} via UPI`;
      } else {
        payLabel!.textContent = 'via UPI';
      }

      if (ok) {
        const uri = buildUpiUri(value, message);
        void renderQr(uri);
        summary!.textContent =
          value !== null
            ? `Scan to pay \u20B9${Number.isInteger(value) ? value : value.toFixed(2)} to ${config.payeeName}`
            : `Scan with any UPI app\u2014you choose the amount`;
      }
    }

    root.querySelectorAll<HTMLButtonElement>('.donate-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        clearChipSelection();
        chip.setAttribute('aria-pressed', 'true');
        amountInput!.value = chip.dataset.amount ?? '';
        update();
      });
    });

    let debounceTimer: ReturnType<typeof setTimeout>;
    const debouncedUpdate = () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(update, 120);
    };

    amountInput.addEventListener('input', () => {
      clearChipSelection();
      debouncedUpdate();
    });
    messageInput.addEventListener('input', debouncedUpdate);

    if (copyBtn && copyStatus) {
      copyBtn.addEventListener('click', function () {
        function done(msg: string) {
          copyStatus!.textContent = msg;
          setTimeout(function () {
            copyStatus!.textContent = '';
          }, 2500);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(config.upiId).then(
            function () {
              done('UPI ID copied.');
            },
            function () {
              done('Could not copy \u2014 ' + config.upiId);
            }
          );
        } else {
          try {
            var ta = document.createElement('textarea');
            ta.value = config.upiId;
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            done('UPI ID copied.');
          } catch (e) {
            done('Could not copy \u2014 ' + config.upiId);
          }
        }
      });
    }

    let themeObserver: MutationObserver | undefined;
    themeObserver?.disconnect();
    themeObserver = new MutationObserver(() => {
      if (lastGoodUri) void renderQr(lastGoodUri);
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    update();
  }

  initDonateWidget();
  document.addEventListener('astro:after-swap', initDonateWidget);
</script>
