---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listCollections, listBookmarks } from '../lib/bookmarks';
import type { Collection, Bookmark } from '../lib/bookmarks';
import { getEnv } from '../lib/getEnv';

export const prerender = false;

const user = (Astro.locals as any).user ?? null;

if (!user) {
  return Astro.redirect('/auth/signin');
}

const env = await getEnv();
const db = (env as any).DB;
let collections: Collection[] = [];
let bookmarks: Bookmark[] = [];

if (db) {
  collections = await listCollections(db, user.id);
  bookmarks = await listBookmarks(db, user.id);
}

// Group by collection
const grouped: Record<string, Bookmark[]> = {};
const uncategorized: Bookmark[] = [];
for (const bm of bookmarks) {
  if (!grouped[bm.collection_id]) grouped[bm.collection_id] = [];
  grouped[bm.collection_id].push(bm);
}

const colMap: Record<string, Collection> = {};
for (const c of collections) colMap[c.id] = c;
---

<BaseLayout
  title="Bookmarks — BitsNotes"
  description="Your saved lectures and collections."
  robots="noindex, nofollow"
  hideChrome={false}
>
  <div class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <header class="mb-8">
      <h1 class="font-display text-3xl md:text-4xl font-extrabold text-[var(--text)] leading-tight">
        Bookmarks
      </h1>
      <p class="mt-1 text-sm text-[var(--text-muted)]">
        {bookmarks.length} {bookmarks.length === 1 ? 'saved lecture' : 'saved lectures'}
      </p>
    </header>

    {bookmarks.length === 0 ? (
      <div class="text-center py-16 border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)]">
        <svg class="mx-auto h-10 w-10 text-[var(--text-faint)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <h3 class="mt-3 text-sm font-bold text-[var(--text)]">No bookmarks yet</h3>
        <p class="mt-1 text-xs text-[var(--text-muted)]">Star any lecture to save it here.</p>
      </div>
    ) : (
      <div class="space-y-8">
        {/* Uncategorized */}
        {uncategorized.length > 0 && (
          <section>
            <h2 class="text-sm font-bold text-[var(--text-muted)] uppercase tracking-widest mb-3">Uncategorized</h2>
            <div class="space-y-2">
              {uncategorized.map((bm) => (
                <a href={`/view/${encodeURIComponent(bm.subject)}/${encodeURIComponent(bm.lecture)}`} class="bookmark-row group">
                  <div class="bm-icon">
                    <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="bm-title">{bm.display_name}</div>
                    <div class="bm-subject">{bm.subject}</div>
                  </div>
                  <svg class="w-4 h-4 text-[var(--text-faint)] shrink-0 group-hover:text-[var(--accent)] transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
                </a>
              ))}
            </div>
          </section>
        )}

        {/* Per collection */}
        {collections.map((col) => {
          const items = grouped[col.id] || [];
          if (items.length === 0) return null;
          return (
            <section>
              <div class="flex items-center justify-between mb-3">
                <h2 class="text-sm font-bold text-[var(--text-muted)] uppercase tracking-widest">{col.name}</h2>
                <button data-action="delete-collection" data-collection-id={col.id} class="text-[10px] text-[var(--text-faint)] hover:text-red-500 transition-colors" title="Delete collection">Delete</button>
              </div>
              <div class="space-y-2">
                {items.map((bm) => (
                  <a href={`/view/${encodeURIComponent(bm.subject)}/${encodeURIComponent(bm.lecture)}`} class="bookmark-row group">
                    <div class="bm-icon">
                      <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="bm-title">{bm.display_name}</div>
                      <div class="bm-subject">{bm.subject}</div>
                    </div>
                    <svg class="w-4 h-4 text-[var(--text-faint)] shrink-0 group-hover:text-[var(--accent)] transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>

<!-- BookmarkRow helper component -->
{/*
  We define the row inline since Astro doesn't support component-as-props
  in SSG pages without a wrapper. Each row is a link to the viewer.
*/}

<script is:inline data-astro-rerun>
  // Collection management
  document.querySelectorAll('[data-action="delete-collection"]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (!confirm('Delete this collection? Bookmarks will move to Uncategorized.')) return;
      fetch('/api/collections/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ collectionId: btn.dataset.collectionId }),
      }).then(function() { window.location.reload(); });
    });
  });
</script>

<style>
  .bookmark-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--bg-elevated);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, background 0.15s;
  }
  .bookmark-row:hover {
    border-color: var(--accent);
    background: var(--bg-subtle);
  }
  .bookmark-row .bm-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--accent-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bookmark-row .bm-icon svg {
    width: 14px;
    height: 14px;
    color: var(--accent);
  }
  .bookmark-row .bm-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bookmark-row:hover .bm-title {
    color: var(--accent);
  }
  .bookmark-row .bm-subject {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }
</style>
