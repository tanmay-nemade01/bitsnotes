---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Unsubscribed | BitsNotes" 
  description="You have successfully unsubscribed from the BitsNotes newsletter."
  robots="noindex, nofollow"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 flex-grow w-full flex items-center justify-center">
    <div class="p-8 md:p-12 border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] max-w-md w-full text-center relative overflow-hidden">
      <!-- Top Accent Line -->
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-[var(--border-strong)]"></div>

      <!-- Info/Unsubscribe Icon -->
      <div class="mx-auto w-16 h-16 rounded-[var(--r-md)] bg-[var(--bg-subtle)] border border-[var(--border)] flex items-center justify-center text-[var(--text-muted)] mb-6">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>

      <h1 class="font-display text-3xl font-extrabold text-[var(--text)] tracking-tight leading-tight mb-4">
        Unsubscribed Successfully
      </h1>
      <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-8">
        We're sorry to see you go! Your email address has been successfully removed from our newsletter list. You will not receive any more updates.
      </p>

      <a href="/" 
        class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--bg-subtle)] hover:bg-[var(--border)] text-[var(--text)] border border-[var(--border)] text-sm font-bold rounded-[var(--r-sm)] transition-colors duration-150 cursor-pointer active:scale-[0.97] w-full justify-center">
        Return to Homepage
      </a>
    </div>
  </div>
</BaseLayout>
