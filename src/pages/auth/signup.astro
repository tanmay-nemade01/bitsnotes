---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

const turnstileSiteKey = (env as any).TURNSTILE_SITE_KEY || '';
---

<BaseLayout
  title="Create Account — BitsNotes"
  description="Create a free BitsNotes account to save bookmarks, highlight lectures, and track your reading progress."
  robots="noindex, nofollow"
  hideChrome={false}
>
  <div class="mx-auto max-w-md px-4 py-16">
    <h1 class="text-3xl font-display font-semibold text-center mb-2">Create your account</h1>
    <p class="text-center text-[var(--color-text-muted)] mb-8">Free forever. No passwords needed.</p>

    <!-- Provider buttons -->
    <div class="space-y-3 mb-8">
      <button
        id="google-btn"
        type="button"
        class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-subtle)] transition font-medium text-sm"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Continue with Google
      </button>

      <button
        id="github-btn"
        type="button"
        class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[#24292f] text-white hover:bg-[#2f3337] transition font-medium text-sm"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        Continue with GitHub
      </button>
    </div>

    <!-- Turnstile widget -->
    <div id="turnstile-container" class="flex justify-center mb-6">
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-theme="auto"
      ></div>
    </div>

    <!-- Error display -->
    <div id="auth-error" class="hidden text-center text-sm text-red-600 mb-4"></div>

    <!-- Footer links -->
    <p class="text-center text-sm text-[var(--color-text-muted)]">
      Already have an account? <a href="/auth/signin" class="text-[var(--color-accent)] hover:underline">Sign in</a>
    </p>

    <p class="text-center text-xs text-[var(--color-text-muted)] mt-6">
      By creating an account, you agree to our <a href="/terms" class="underline">Terms</a> and <a href="/privacy" class="underline">Privacy Policy</a>.
    </p>
  </div>

  <script is:inline>
    let turnstileToken = '';

    function onTurnstileSuccess(token) {
      turnstileToken = token;
      document.getElementById('auth-error').classList.add('hidden');
    }

    function onTurnstileExpired() {
      turnstileToken = '';
    }

    function onTurnstileError() {
      turnstileToken = '';
      console.warn('Turnstile widget failed to load — proceeding without captcha verification.');
    }

    function renderTurnstile() {
      var el = document.querySelector('#turnstile-container .cf-turnstile');
      if (!el || typeof window.turnstile === 'undefined') return;
      try {
        window.turnstile.render('#turnstile-container .cf-turnstile', {
          sitekey: sitekey,
          callback: onTurnstileSuccess,
          'expired-callback': onTurnstileExpired,
          'error-callback': onTurnstileError,
          theme: 'auto',
        });
      } catch (e) {
        console.warn('Turnstile render failed:', e);
        onTurnstileError();
      }
    }

    // Re-render Turnstile when the site theme changes so the widget matches.
    window.addEventListener('bitsnotes:theme-changed', function () {
      var el = document.querySelector('#turnstile-container .cf-turnstile');
      if (!el || typeof window.turnstile === 'undefined') return;
      try {
        window.turnstile.remove(el);
        renderTurnstile();
      } catch (e) {
        console.warn('Turnstile re-render failed:', e);
      }
    });

    function handleSignUp(provider) {
      document.getElementById('auth-error').classList.add('hidden');

      const body = { provider: provider };
      if (turnstileToken) {
        body['cf-turnstile-response'] = turnstileToken;
      }

      // For signup, we use the same signin endpoint which handles both new + existing users
      fetch('/api/auth/signin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }).then(async (res) => {
        if (res.redirected) {
          window.location.href = res.url;
        } else if (res.ok) {
          const data = await res.json();
          if (data.url) window.location.href = data.url;
        } else {
          const data = await res.json().catch(() => ({}));
          document.getElementById('auth-error').textContent = data.error || 'Sign up failed. Please try again.';
          document.getElementById('auth-error').classList.remove('hidden');
        }
      }).catch(() => {
        document.getElementById('auth-error').textContent = 'Network error. Please try again.';
        document.getElementById('auth-error').classList.remove('hidden');
      });
    }

    document.getElementById('google-btn').addEventListener('click', () => handleSignUp('google'));
    document.getElementById('github-btn').addEventListener('click', () => handleSignUp('github'));

    // Load Turnstile script and render widget explicitly
    (function() {
      var container = document.querySelector('.cf-turnstile');
      var sitekey = container ? container.getAttribute('data-sitekey') : '';
      var s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = function() {
        if (window.turnstile && sitekey) {
          renderTurnstile();
        } else {
          onTurnstileError();
        }
      };
      s.onerror = function() { onTurnstileError(); };
      document.head.appendChild(s);
    })();
  </script>
</BaseLayout>
