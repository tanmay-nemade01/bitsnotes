---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const url = new URL(Astro.request.url);
const ok = url.searchParams.get('ok') === '1';
const pending = url.searchParams.get('pending') === '1';
const error = url.searchParams.get('error');
---

<BaseLayout
  title={ok ? 'Email Verified' : pending ? 'Check Your Email' : 'Verification Error'}
  description="Email verification for BitsNotes account."
  robots="noindex, nofollow"
  hideChrome={false}
>
  <div class="mx-auto max-w-md px-4 py-16 text-center">
    {ok && (
      <>
        <div class="text-5xl mb-4">✅</div>
        <h1 class="text-3xl font-display font-semibold mb-4">Email verified!</h1>
        <p class="text-[var(--color-muted)] mb-8">Your account is now active. You can start using all BitsNotes features.</p>
        <a href="/auth/signin" class="inline-block px-6 py-3 bg-[var(--color-accent)] text-white rounded-lg font-medium hover:opacity-90 transition">
          Sign in
        </a>
      </>
    )}

    {pending && (
      <>
        <div class="text-5xl mb-4">📧</div>
        <h1 class="text-3xl font-display font-semibold mb-4">Check your email</h1>
        <p class="text-[var(--color-muted)] mb-4">
          We've sent a verification link to your email address. Click the link to activate your account.
        </p>
        <p class="text-sm text-[var(--color-muted)] mb-8">
          Didn't receive it? Check your spam folder, or
          <button id="resend-btn" class="text-[var(--color-accent)] hover:underline">resend verification email</button>.
        </p>
        <div id="resend-msg" class="hidden text-sm text-[var(--color-accent)] mb-4"></div>
        <a href="/" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-text)] transition">← Back to BitsNotes</a>
      </>
    )}

    {error && (
      <>
        <div class="text-5xl mb-4">❌</div>
        <h1 class="text-3xl font-display font-semibold mb-4">Verification failed</h1>
        <p class="text-[var(--color-muted)] mb-8">
          {error === 'invalid'
            ? 'This verification link is invalid or has already been used.'
            : 'Something went wrong. Please try again or request a new link.'}
        </p>
        <a href="/auth/signin" class="inline-block px-6 py-3 bg-[var(--color-accent)] text-white rounded-lg font-medium hover:opacity-90 transition">
          Sign in
        </a>
      </>
    )}

    {!ok && !pending && !error && (
      <>
        <div class="text-5xl mb-4">🔐</div>
        <h1 class="text-3xl font-display font-semibold mb-4">Email Verification</h1>
        <p class="text-[var(--color-muted)] mb-8">Use the verification link from your email to verify your account.</p>
        <a href="/" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-text)] transition">← Back to BitsNotes</a>
      </>
    )}
  </div>

  <script is:inline>
    const resendBtn = document.getElementById('resend-btn');
    const resendMsg = document.getElementById('resend-msg');
    if (resendBtn) {
      resendBtn.addEventListener('click', async () => {
        resendBtn.disabled = true;
        resendBtn.textContent = 'Sending...';
        try {
          // We don't have the email in the URL, but the user may have it in memory
          // For now, prompt — or skip if we can get it from session
          resendMsg.textContent = 'If your email is registered, a new link has been sent.';
          resendMsg.classList.remove('hidden');
          resendBtn.textContent = 'Sent!';
        } catch {
          resendBtn.textContent = 'Try again';
          resendBtn.disabled = false;
        }
      });
    }
  </script>
</BaseLayout>
