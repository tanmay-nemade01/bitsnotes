---
/**
 * Admin Dashboard UI Page.
 * Offers unified views statistics and comments overview with inline moderation actions.
 * Access is gated to admin users only.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUser, getEnv } from '../../lib/apiHelpers';
import { logAuthEvent } from '../../lib/auth';

export const prerender = false;

const user = getUser(Astro);
if (!user) {
  return Astro.redirect('/auth/signin?redirect=/admin');
}

const env = await getEnv(Astro);
const isAdminUser = await env.DB.prepare('SELECT user_id FROM admin_users WHERE user_id = ?').bind(user.id).first();

if (!isAdminUser) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

try {
  await logAuthEvent(env.DB, {
    userId: user.id,
    event: 'admin_dashboard_view',
    ip: Astro.request.headers.get('CF-Connecting-IP') || '',
    ua: Astro.request.headers.get('User-Agent') || '',
  });
} catch (e) {
  // best-effort
}
---

<BaseLayout
  title="Admin Dashboard — BitsNotes"
  description="Consolidated admin statistics and comments moderation."
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow">
    <header class="mb-8">
      <h1 class="font-display text-4xl font-extrabold text-[var(--text)]">Admin Dashboard</h1>
      <p class="mt-2 text-sm text-[var(--text-muted)]">Consolidated views metrics and comments overview across all content.</p>
    </header>

    <div data-admin-dashboard>
        <!-- Tab selector -->
        <div class="flex gap-4 border-b border-[var(--border)] mb-8 animate-fade-in" role="tablist" aria-label="Dashboard sections">
          <button
            type="button"
            data-tab-btn="views"
            class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text)] transition-all duration-200 cursor-pointer data-[active=true]:border-[var(--accent)] data-[active=true]:text-[var(--accent)]"
            data-active="true"
          >
            Views Analytics
          </button>
          <button
            type="button"
            data-tab-btn="comments"
            class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text)] transition-all duration-200 cursor-pointer data-[active=true]:border-[var(--accent)] data-[active=true]:text-[var(--accent)]"
            data-active="false"
          >
            Comments Overview
          </button>
          <button
            type="button"
            data-tab-btn="supporters"
            class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text)] transition-all duration-200 cursor-pointer data-[active=true]:border-[var(--accent)] data-[active=true]:text-[var(--accent)]"
            data-active="false"
          >
            Supporters
          </button>
          <button
            type="button"
            data-tab-btn="tags"
            class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text)] transition-all duration-200 cursor-pointer data-[active=true]:border-[var(--accent)] data-[active=true]:text-[var(--accent)]"
            data-active="false"
          >
            Subject Tags &amp; Sections
          </button>
        </div>

        <!-- Views Tab Panel -->
        <div data-tab-panel="views" class="space-y-8">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="border border-[var(--border)] rounded-[var(--r-md)] p-6 bg-[var(--bg-elevated)] shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Home Page Views</h3>
              <p class="mt-2 text-3xl font-bold font-display text-[var(--text)]" id="stat-home">—</p>
            </div>
            <div class="border border-[var(--border)] rounded-[var(--r-md)] p-6 bg-[var(--bg-elevated)] shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Total Blog Views</h3>
              <p class="mt-2 text-3xl font-bold font-display text-[var(--text)]" id="stat-blog">—</p>
            </div>
            <div class="border border-[var(--border)] rounded-[var(--r-md)] p-6 bg-[var(--bg-elevated)] shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Total Lecture Views</h3>
              <p class="mt-2 text-3xl font-bold font-display text-[var(--text)]" id="stat-lecture">—</p>
            </div>
          </div>

          <div class="border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden shadow-sm">
            <div class="p-4 border-b border-[var(--border)] bg-[var(--bg-subtle)] flex flex-wrap gap-4 items-center justify-between">
              <h2 class="font-display font-bold text-lg text-[var(--text)]">Views By Page</h2>
              <div class="flex gap-2">
                <select id="views-group-filter" class="px-3 py-1.5 text-xs rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg-interactive)] text-[var(--text)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] font-medium">
                  <option value="all">All Pages</option>
                  <option value="home">Home Page</option>
                  <option value="blog">Blog Posts</option>
                  <option value="lecture">Lecture Notes</option>
                </select>
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-[var(--border)] bg-[var(--bg-subtle)] text-xs text-[var(--text-muted)] uppercase tracking-wider">
                    <th class="p-4 font-semibold w-24">Type</th>
                    <th class="p-4 font-semibold">Page / Key</th>
                    <th class="p-4 font-semibold text-right w-36">Views</th>
                  </tr>
                </thead>
                <tbody id="views-table-body" class="divide-y divide-[var(--border)] text-sm">
                  <tr>
                    <td colspan="3" class="p-8 text-center text-[var(--text-muted)]">Loading views data…</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Comments Tab Panel -->
        <div data-tab-panel="comments" class="hidden space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <h2 class="font-display font-bold text-xl text-[var(--text)]">Comments by Page</h2>
            <div class="text-xs text-[var(--text-muted)] flex gap-3" id="comments-summary-stats">
              <!-- Summary statistics will be populated by JS -->
            </div>
          </div>

          <div class="space-y-4" id="comments-by-page-container">
            <p class="text-sm text-[var(--text-muted)]">Loading comments overview…</p>
          </div>
        </div>

        <!-- Supporters Tab Panel -->
        <div data-tab-panel="supporters" class="hidden space-y-6">
          <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] gap-6 items-start">
            <!-- Add form -->
            <form id="supporter-form" class="border border-[var(--border)] rounded-[var(--r-md)] p-6 bg-[var(--bg-elevated)] space-y-4">
              <div>
                <h2 class="font-display font-bold text-xl text-[var(--text)]">Add a supporter</h2>
                <p class="mt-1 text-xs text-[var(--text-muted)]">
                  Appears on the
                  <a href="/support" target="_blank" rel="noopener" class="underline hover:text-[var(--text)]">Wall of Gratitude</a>
                  within seconds — no rebuild or deploy needed.
                </p>
              </div>

              <div>
                <label for="supporter-name" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
                  Name <span class="text-[var(--danger)]">*</span>
                </label>
                <input
                  id="supporter-name"
                  name="name"
                  type="text"
                  required
                  maxlength="60"
                  autocomplete="off"
                  placeholder="Chinmay Das"
                  class="w-full rounded-[var(--r-sm,0.375rem)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
                />
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="supporter-tier" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Tier</label>
                  <select
                    id="supporter-tier"
                    name="tier"
                    class="w-full rounded-[var(--r-sm,0.375rem)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
                  >
                    <option value="supporter">Supporter</option>
                    <option value="chai">Chai</option>
                    <option value="fuel">Fuel</option>
                    <option value="meal">Meal</option>
                    <option value="sponsor">Sponsor</option>
                  </select>
                </div>
                <div>
                  <label for="supporter-tier-label" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Label</label>
                  <input
                    id="supporter-tier-label"
                    name="tierLabel"
                    type="text"
                    maxlength="60"
                    autocomplete="off"
                    placeholder="Optional"
                    class="w-full rounded-[var(--r-sm,0.375rem)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label for="supporter-message" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
                  Message <span class="text-[var(--text-faint)] font-normal">(optional, shown publicly)</span>
                </label>
                <textarea
                  id="supporter-message"
                  name="message"
                  rows="2"
                  maxlength="280"
                  placeholder="Thank you for the notes!"
                  class="w-full rounded-[var(--r-sm,0.375rem)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none resize-y"
                ></textarea>
              </div>

              <div>
                <label for="supporter-date" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
                  Date <span class="text-[var(--text-faint)] font-normal">(optional)</span>
                </label>
                <input
                  id="supporter-date"
                  name="date"
                  type="text"
                  maxlength="40"
                  autocomplete="off"
                  placeholder="2026-09"
                  class="w-full rounded-[var(--r-sm,0.375rem)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
                />
              </div>

              <p id="supporter-form-status" role="status" aria-live="polite" class="text-xs min-h-4"></p>

              <button
                type="submit"
                id="supporter-submit"
                class="w-full rounded-[var(--r-md)] bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-[var(--accent-contrast)] transition-opacity hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              >
                Add supporter
              </button>
            </form>

            <!-- Roster -->
            <div class="border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden">
              <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] px-5 py-4">
                <h2 class="font-display font-bold text-lg text-[var(--text)]">Wall of Gratitude</h2>
                <span
                  id="supporters-count-badge"
                  class="shrink-0 rounded-full border border-[var(--accent)]/20 bg-[var(--accent-subtle)] px-2.5 py-0.5 text-xs font-semibold text-[var(--accent)]"
                >—</span>
              </div>
              <div id="supporters-list" class="max-h-[32rem] overflow-y-auto divide-y divide-[var(--border)]">
                <p class="p-6 text-sm text-[var(--text-muted)]">Loading supporters…</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Subject Tags Tab Panel -->
        <div data-tab-panel="tags" class="hidden space-y-6">
          <!-- Overview Banner -->
          <div class="border border-[var(--border)] rounded-[var(--r-md)] p-5 bg-[var(--bg-elevated)] flex flex-wrap items-center justify-between gap-4 shadow-sm">
            <div>
              <h2 class="font-display font-bold text-lg text-[var(--text)] flex items-center gap-2">
                Subject Tags &amp; Homepage Section Ranking
              </h2>
              <p class="mt-1 text-xs text-[var(--text-muted)] max-w-2xl">
                Assign tags to subject folders to group them into homepage sections. Rank tags to decide what appears from top to bottom (e.g. Featured first, then Sem 2, Sem 1). A subject can have multiple tags.
              </p>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
              <div class="flex items-center gap-2 text-xs">
                <span class="px-2.5 py-1 rounded-[var(--r-sm)] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text)]">
                  Tags: <strong id="tags-count-stat" class="font-bold text-[var(--accent)]">—</strong>
                </span>
                <span class="px-2.5 py-1 rounded-[var(--r-sm)] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text)]">
                  Subjects: <strong id="subjects-count-stat" class="font-bold">—</strong>
                </span>
                <span id="untagged-badge-container" class="hidden">
                  <span class="px-2.5 py-1 rounded-[var(--r-sm)] bg-amber-500/10 border border-amber-500/30 text-amber-500 font-semibold flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <span id="untagged-count-stat">0</span> untagged
                  </span>
                </span>
              </div>
              <button
                type="button"
                id="tags-seed-btn"
                class="px-3 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg-interactive)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors cursor-pointer flex items-center gap-1.5"
                title="Populate default tags & assignments from notes catalog"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                Sync / Seed from Files
              </button>
            </div>
          </div>

          <!-- Main 2-column layout -->
          <div class="grid grid-cols-1 lg:grid-cols-[22rem_minmax(0,1fr)] gap-6 items-start">
            <!-- Left: Tag Manager -->
            <div class="space-y-6">
              <!-- Add Tag Form -->
              <form id="tag-form" class="border border-[var(--border)] rounded-[var(--r-md)] p-5 bg-[var(--bg-elevated)] space-y-4 shadow-sm">
                <div>
                  <h3 class="font-display font-bold text-base text-[var(--text)]">Create Tag</h3>
                  <p class="text-xs text-[var(--text-muted)] mt-0.5">Defines a homepage section or subject category.</p>
                </div>

                <div>
                  <label for="tag-name-input" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
                    Tag Name <span class="text-[var(--danger)]">*</span>
                  </label>
                  <input
                    id="tag-name-input"
                    name="name"
                    type="text"
                    required
                    maxlength="50"
                    placeholder="e.g. Featured, Semester 1"
                    class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
                  />
                </div>

                <div>
                  <label for="tag-color-select" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">Badge Color Theme</label>
                  <select
                    id="tag-color-select"
                    name="color"
                    class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none font-medium"
                  >
                    <option value="amber">★ Amber (Recommended for Featured)</option>
                    <option value="emerald">Emerald Green (e.g. Semester 2)</option>
                    <option value="blue">Blue (e.g. Semester 1)</option>
                    <option value="purple">Purple (e.g. Basics / Electives)</option>
                    <option value="rose">Rose Red (e.g. Core / Advanced)</option>
                    <option value="cyan">Cyan (e.g. Labs / Practicals)</option>
                    <option value="accent">Default Accent</option>
                  </select>
                </div>

                <div>
                  <label for="tag-desc-input" class="block text-xs font-semibold text-[var(--text-muted)] mb-1">
                    Section Subtitle <span class="text-[var(--text-faint)] font-normal">(optional)</span>
                  </label>
                  <input
                    id="tag-desc-input"
                    name="description"
                    type="text"
                    maxlength="160"
                    placeholder="Brief description shown on homepage"
                    class="w-full rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)] placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:outline-none"
                  />
                </div>

                <div class="flex items-center gap-2">
                  <input
                    id="tag-visible-checkbox"
                    name="isVisible"
                    type="checkbox"
                    checked
                    class="rounded border-[var(--border)] text-[var(--accent)] focus:ring-[var(--accent)]"
                  />
                  <label for="tag-visible-checkbox" class="text-xs text-[var(--text)] cursor-pointer">
                    Visible on homepage
                  </label>
                </div>

                <p id="tag-form-status" role="status" aria-live="polite" class="text-xs min-h-4"></p>

                <button
                  type="submit"
                  id="tag-submit-btn"
                  class="w-full rounded-[var(--r-md)] bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-[var(--accent-contrast)] hover:opacity-90 disabled:opacity-50 cursor-pointer transition-opacity"
                >
                  Create Tag
                </button>
              </form>

              <!-- Ranked Tags List -->
              <div class="border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden shadow-sm">
                <div class="p-4 border-b border-[var(--border)] bg-[var(--bg-subtle)] flex items-center justify-between">
                  <div>
                    <h3 class="font-display font-bold text-sm text-[var(--text)]">Section Order Ranking</h3>
                    <p class="text-[11px] text-[var(--text-muted)]">Ranks homepage sections top to bottom</p>
                  </div>
                </div>
                <div id="tags-rank-list" class="divide-y divide-[var(--border)] max-h-[30rem] overflow-y-auto">
                  <p class="p-4 text-xs text-[var(--text-muted)]">Loading tags…</p>
                </div>
              </div>
            </div>

            <!-- Right: Subject Tagging & Section Ordering -->
            <div class="border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden shadow-sm">
              <div class="p-4 border-b border-[var(--border)] bg-[var(--bg-subtle)] flex flex-wrap gap-3 items-center justify-between">
                <div>
                  <h3 class="font-display font-bold text-base text-[var(--text)]">Subject Folders &amp; Multi-Tagging</h3>
                  <p class="text-xs text-[var(--text-muted)] mt-0.5">Click tag pills to attach/detach tags. A subject can belong to multiple sections.</p>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                  <input
                    type="text"
                    id="subject-search-input"
                    placeholder="Search subject..."
                    class="rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-2.5 py-1 text-xs text-[var(--text)] focus:border-[var(--accent)] focus:outline-none w-36 sm:w-44"
                  />
                  <select
                    id="subject-tag-filter"
                    class="rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] px-2.5 py-1 text-xs text-[var(--text)] focus:border-[var(--accent)] focus:outline-none font-medium"
                  >
                    <option value="all">All Subjects</option>
                    <option value="__untagged__">⚠ Untagged Only</option>
                  </select>
                </div>
              </div>

              <!-- Reorder banner (active when filtering by a specific tag) -->
              <div id="tag-reorder-banner" class="hidden px-4 py-2 bg-[var(--accent-subtle)] text-[var(--accent)] border-b border-[var(--border)] text-xs flex items-center justify-between">
                <span>Ordering subjects inside: <strong id="reorder-tag-name">Tag</strong></span>
                <span class="text-[11px] opacity-80">Use ▲ / ▼ buttons on cards to adjust order</span>
              </div>

              <div id="subjects-assignment-list" class="divide-y divide-[var(--border)] max-h-[44rem] overflow-y-auto">
                <p class="p-6 text-sm text-[var(--text-muted)]">Loading subjects…</p>
              </div>
            </div>
          </div>
        </div>
      </div>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  (function () {
    var root = document.querySelector('[data-admin-dashboard]');
    if (!root) return;

    var tabButtons = root.querySelectorAll('[data-tab-btn]');
    var tabPanels = root.querySelectorAll('[data-tab-panel]');
    var viewsBody = root.querySelector('#views-table-body');
    var viewsFilter = root.querySelector('#views-group-filter');
    var commentsContainer = root.querySelector('#comments-by-page-container');
    var commentsSummary = root.querySelector('#comments-summary-stats');
    var supportersList = root.querySelector('#supporters-list');
    var supportersCountBadge = root.querySelector('#supporters-count-badge');
    var supporterForm = root.querySelector('#supporter-form');
    var supporterFormStatus = root.querySelector('#supporter-form-status');
    var supporterSubmit = root.querySelector('#supporter-submit');

    var cachedViews = [];
    var currentFilter = 'all';

    // Tabs navigation logic
    tabButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetTab = btn.dataset.tabBtn;
        tabButtons.forEach(function (b) {
          b.dataset.active = b === btn ? 'true' : 'false';
        });
        tabPanels.forEach(function (p) {
          p.classList.toggle('hidden', p.dataset.tabPanel !== targetTab);
        });

        // Fetch comments if switched to comments tab
        if (targetTab === 'comments') {
          loadCommentsOverview();
        }

        // Fetch the roster if switched to supporters tab
        if (targetTab === 'supporters') {
          loadSupporters();
        }

        // Fetch subject tags if switched to tags tab
        if (targetTab === 'tags') {
          loadTagsData();
        }
      });
    });

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function timeAgo(ts) {
      var diff = Date.now() - ts;
      var m = Math.floor(diff / 60000);
      if (m < 1) return 'just now';
      if (m < 60) return m + 'm ago';
      var h = Math.floor(m / 60);
      if (h < 24) return h + 'h ago';
      var d = Math.floor(h / 24);
      if (d < 30) return d + 'd ago';
      return new Date(ts).toLocaleDateString();
    }

    // ─── VIEWS TAB CODE ──────────────────────────────────────────
    function fetchViews() {
      viewsBody.innerHTML = '<tr><td colspan="3" class="p-8 text-center text-[var(--text-muted)]">Loading views data…</td></tr>';
      fetch('/api/admin/views', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.views || !data.views.length) {
            viewsBody.innerHTML = '<tr><td colspan="3" class="p-8 text-center text-[var(--text-muted)]">No views data available.</td></tr>';
            return;
          }
          cachedViews = data.views;
          renderViews();
          updateViewStats();
        })
        .catch(function () {
          viewsBody.innerHTML = '<tr><td colspan="3" class="p-8 text-center text-[var(--danger-text)]">Failed to load views data.</td></tr>';
        });
    }

    function updateViewStats() {
      var homeVal = 0;
      var blogVal = 0;
      var lecVal = 0;

      cachedViews.forEach(function (v) {
        if (v.pageKey === 'home') homeVal += v.views;
        else if (v.pageKey.indexOf('blog:') === 0) blogVal += v.views;
        else if (v.pageKey.indexOf('lecture:') === 0) lecVal += v.views;
      });

      var hEl = root.querySelector('#stat-home');
      var bEl = root.querySelector('#stat-blog');
      var lEl = root.querySelector('#stat-lecture');

      if (hEl) hEl.textContent = homeVal.toLocaleString();
      if (bEl) bEl.textContent = blogVal.toLocaleString();
      if (lEl) lEl.textContent = lecVal.toLocaleString();
    }

    function renderViews() {
      var filtered = cachedViews.filter(function (v) {
        if (currentFilter === 'all') return true;
        if (currentFilter === 'home') return v.pageKey === 'home';
        if (currentFilter === 'blog') return v.pageKey.indexOf('blog:') === 0;
        if (currentFilter === 'lecture') return v.pageKey.indexOf('lecture:') === 0;
        return true;
      });

      if (!filtered.length) {
        viewsBody.innerHTML = '<tr><td colspan="3" class="p-8 text-center text-[var(--text-muted)]">No matching rows found.</td></tr>';
        return;
      }

      viewsBody.innerHTML = '';
      filtered.forEach(function (v) {
        var tr = document.createElement('tr');
        tr.className = 'hover:bg-[var(--bg-subtle)] transition-colors';

        var typeTd = document.createElement('td');
        typeTd.className = 'p-4';
        var typeBadge = document.createElement('span');
        
        var cleanKey = v.pageKey;
        if (v.pageKey === 'home') {
          typeBadge.className = 'px-2 py-0.5 text-xs font-semibold rounded bg-[var(--accent-subtle)] text-[var(--accent)]';
          typeBadge.textContent = 'Home';
          cleanKey = 'Home Page';
        } else if (v.pageKey.indexOf('blog:') === 0) {
          typeBadge.className = 'px-2 py-0.5 text-xs font-semibold rounded bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
          typeBadge.textContent = 'Blog';
          cleanKey = v.pageKey.slice(5);
        } else if (v.pageKey.indexOf('lecture:') === 0) {
          typeBadge.className = 'px-2 py-0.5 text-xs font-semibold rounded bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
          typeBadge.textContent = 'Lecture';
          cleanKey = v.pageKey.slice(8);
        } else {
          typeBadge.className = 'px-2 py-0.5 text-xs font-semibold rounded bg-gray-100 text-gray-800';
          typeBadge.textContent = 'Other';
        }
        
        typeTd.appendChild(typeBadge);

        var keyTd = document.createElement('td');
        keyTd.className = 'p-4 font-mono text-xs text-[var(--text)]';
        keyTd.textContent = cleanKey;

        var countTd = document.createElement('td');
        countTd.className = 'p-4 text-right font-semibold font-variant-numeric tabular-nums text-[var(--text)]';
        countTd.textContent = v.views.toLocaleString();

        tr.appendChild(typeTd);
        tr.appendChild(keyTd);
        tr.appendChild(countTd);
        viewsBody.appendChild(tr);
      });
    }

    if (viewsFilter) {
      viewsFilter.addEventListener('change', function () {
        currentFilter = viewsFilter.value;
        renderViews();
      });
    }

    // ─── COMMENTS TAB CODE ────────────────────────────────────────
    var isCommentsLoaded = false;
    function loadCommentsOverview() {
      if (isCommentsLoaded) return; // avoid double fetch
      commentsContainer.innerHTML = '<p class="text-sm text-[var(--text-muted)]">Loading comments overview…</p>';
      
      fetch('/api/admin/comments/overview', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          isCommentsLoaded = true;
          if (!data.pages || !data.pages.length) {
            commentsContainer.innerHTML = '<p class="text-sm text-[var(--text-muted)]">No comments found in D1 database.</p>';
            if (commentsSummary) commentsSummary.innerHTML = '';
            return;
          }
          
          renderComments(data.pages);
          renderCommentsSummary(data.pages);
        })
        .catch(function () {
          commentsContainer.innerHTML = '<p class="text-sm text-[var(--danger-text)]">Failed to load comments overview.</p>';
        });
    }

    function renderCommentsSummary(pages) {
      var total = 0;
      var published = 0;
      var pending = 0;
      var hidden = 0;

      pages.forEach(function (p) {
        total += p.total;
        published += p.published;
        pending += p.pending;
        hidden += p.hidden;
      });

      commentsSummary.innerHTML = 
        '<span>Total: <strong>' + total + '</strong></span>' +
        '<span>Published: <strong class="text-[var(--success)]">' + published + '</strong></span>' +
        '<span>Pending: <strong class="text-[var(--warning)]">' + pending + '</strong></span>' +
        '<span>Hidden: <strong class="text-[var(--danger)]">' + hidden + '</strong></span>';
    }

    function renderComments(pages) {
      commentsContainer.innerHTML = '';

      pages.forEach(function (page) {
        var section = document.createElement('div');
        section.className = 'border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden shadow-sm';

        // Accordion header
        var header = document.createElement('button');
        header.type = 'button';
        header.className = 'w-full text-left p-4 bg-[var(--bg-subtle)] hover:bg-[var(--border-subtle)] flex items-center justify-between gap-4 focus:outline-none transition-colors cursor-pointer';
        
        var titleContainer = document.createElement('div');
        titleContainer.className = 'flex flex-col gap-1';
        
        var title = document.createElement('h3');
        title.className = 'font-display font-bold text-base text-[var(--text)]';
        title.textContent = page.label;
        
        var metaRow = document.createElement('div');
        metaRow.className = 'flex items-center gap-2 flex-wrap text-xs';
        
        var countBadge = document.createElement('span');
        countBadge.className = 'font-semibold text-[var(--text-muted)]';
        countBadge.textContent = page.total + (page.total === 1 ? ' comment' : ' comments');
        metaRow.appendChild(countBadge);

        if (page.pending > 0) {
          var pendingBadge = document.createElement('span');
          pendingBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-[var(--warning-bg)] text-[var(--warning)] border border-[var(--warning-border)]';
          pendingBadge.textContent = page.pending + ' pending';
          metaRow.appendChild(pendingBadge);
        }
        if (page.hidden > 0) {
          var hiddenBadge = document.createElement('span');
          hiddenBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-[var(--danger-bg)] text-[var(--danger)] border border-[var(--danger-border)]';
          hiddenBadge.textContent = page.hidden + ' hidden';
          metaRow.appendChild(hiddenBadge);
        }

        titleContainer.appendChild(title);
        titleContainer.appendChild(metaRow);

        var arrow = document.createElement('div');
        arrow.className = 'text-[var(--text-muted)] transition-transform duration-200 transform rotate-0';
        arrow.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>';

        header.appendChild(titleContainer);
        header.appendChild(arrow);

        // Accordion Content body
        var content = document.createElement('div');
        content.className = 'hidden border-t border-[var(--border)] p-4 space-y-4 bg-[var(--bg-elevated)]';

        page.comments.forEach(function (c) {
          var card = document.createElement('div');
          card.className = 'border border-[var(--border)] rounded-[var(--r-sm)] p-4 bg-[var(--bg-interactive)] relative hover:border-[var(--accent)] transition-colors';

          // Link card title/meta info to target URL
          var cardMeta = document.createElement('div');
          cardMeta.className = 'flex flex-wrap items-center justify-between gap-2 mb-2 text-xs text-[var(--text-muted)]';
          
          var authorLink = document.createElement('a');
          authorLink.href = c.pageUrl;
          authorLink.className = 'font-bold text-[var(--text)] hover:text-[var(--accent)] hover:underline flex items-center gap-1.5 transition-colors';
          authorLink.textContent = c.displayName;
          
          if (c.isAdmin) {
            var badge = document.createElement('span');
            badge.className = 'admin-badge';
            badge.textContent = 'Admin';
            authorLink.appendChild(badge);
          }

          var metaRight = document.createElement('div');
          metaRight.className = 'flex items-center gap-2';

          var statusBadge = document.createElement('span');
          statusBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider';
          if (c.status === 'published') {
            statusBadge.className += ' bg-[var(--success-bg)] text-[var(--success-text)] border border-[var(--success-border)]';
          } else if (c.status === 'pending') {
            statusBadge.className += ' bg-[var(--warning-bg)] text-[var(--warning-text)] border border-[var(--warning-border)]';
          } else {
            statusBadge.className += ' bg-[var(--danger-bg)] text-[var(--danger-text)] border border-[var(--danger-border)]';
          }
          statusBadge.textContent = c.status;

          var timeSpan = document.createElement('span');
          timeSpan.textContent = timeAgo(c.createdAt);

          metaRight.appendChild(statusBadge);
          metaRight.appendChild(timeSpan);

          cardMeta.appendChild(authorLink);
          cardMeta.appendChild(metaRight);

          var body = document.createElement('p');
          body.className = 'text-sm text-[var(--text)] whitespace-pre-wrap mb-3';
          body.textContent = c.body;

          if (c.moderationReason) {
            var reason = document.createElement('div');
            reason.className = 'text-xs italic bg-[var(--bg-subtle)] text-[var(--danger-text)] p-2 rounded mb-3 border border-[var(--border)]';
            reason.textContent = 'Moderation reason: ' + c.moderationReason;
            card.appendChild(reason);
          }

          var actions = document.createElement('div');
          actions.className = 'flex flex-wrap items-center justify-between gap-3';

          var leftBtns = document.createElement('div');
          leftBtns.className = 'flex flex-wrap gap-2';

          [
            { a: 'publish', label: 'Publish', show: c.status !== 'published' },
            { a: 'hide', label: 'Hide', show: c.status === 'published' },
            { a: 'restore', label: 'Restore', show: c.status === 'deleted' || c.status === 'hidden' },
            { a: 'delete', label: 'Delete', show: c.status !== 'deleted' },
          ].forEach(function (act) {
            if (!act.show) return;
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'px-2.5 py-1 text-xs font-medium rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg-elevated)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer';
            b.textContent = act.label;
            b.addEventListener('click', function (e) {
              e.stopPropagation();
              moderateComment(c.id, act.a, b);
            });
            leftBtns.appendChild(b);
          });

          // Action link button to jump to comment on page
          var replyLink = document.createElement('a');
          replyLink.href = c.pageUrl;
          replyLink.className = 'inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold rounded-[var(--r-sm)] bg-[var(--accent)] text-[var(--accent-contrast)] hover:bg-[var(--accent-hover)] transition-colors';
          replyLink.innerHTML = 'View & Reply <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>';

          actions.appendChild(leftBtns);
          actions.appendChild(replyLink);

          card.appendChild(cardMeta);
          card.appendChild(body);
          card.appendChild(actions);
          content.appendChild(card);
        });

        // Expand/collapse accordion click handler
        header.addEventListener('click', function () {
          var isHidden = content.classList.contains('hidden');
          content.classList.toggle('hidden');
          arrow.classList.toggle('rotate-180', isHidden);
        });

        section.appendChild(header);
        section.appendChild(content);
        commentsContainer.appendChild(section);
      });
    }

    function moderateComment(id, action, btn) {
      btn.disabled = true;
      fetch('/api/admin/comments/' + encodeURIComponent(id), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: action }),
      }).then(function (r) {
        if (r.ok) {
          isCommentsLoaded = false;
          loadCommentsOverview();
        } else {
          btn.disabled = false;
          alert('Action failed.');
        }
      });
    }

    // ─── SUPPORTERS TAB CODE ──────────────────────────────────────
    function loadSupporters() {
      if (!supportersList) return;
      supportersList.innerHTML = '<p class="p-6 text-sm text-[var(--text-muted)]">Loading supporters…</p>';

      fetch('/api/admin/supporters', { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        })
        .then(function (data) {
          var list = data.supporters || [];
          if (supportersCountBadge) supportersCountBadge.textContent = String(data.total != null ? data.total : list.length);
          if (!list.length) {
            supportersList.innerHTML = '<p class="p-6 text-sm text-[var(--text-muted)]">No supporters yet. Add the first one using the form.</p>';
            return;
          }
          renderSupporters(list);
        })
        .catch(function () {
          supportersList.innerHTML = '<p class="p-6 text-sm text-[var(--danger-text)]">Failed to load supporters. Is migration 007 applied?</p>';
        });
    }

    function renderSupporters(list) {
      supportersList.innerHTML = '';

      list.forEach(function (s) {
        var row = document.createElement('div');
        row.className = 'flex items-start justify-between gap-4 px-5 py-3';

        var left = document.createElement('div');
        left.className = 'min-w-0 flex-1';

        var nameLine = document.createElement('div');
        nameLine.className = 'flex items-center gap-2 flex-wrap';
        var nameEl = document.createElement('span');
        nameEl.className = 'font-semibold text-sm text-[var(--text)]';
        nameEl.textContent = s.name;
        nameLine.appendChild(nameEl);

        var tierEl = document.createElement('span');
        tierEl.className = 'rounded-full border border-[var(--border)] bg-[var(--bg-subtle)] px-2 py-0.5 text-[11px] text-[var(--text-muted)]';
        tierEl.textContent = s.tierLabel || s.tier || 'Supporter';
        nameLine.appendChild(tierEl);

        if (s.date) {
          var dateEl = document.createElement('span');
          dateEl.className = 'text-[11px] text-[var(--text-faint)]';
          dateEl.textContent = s.date;
          nameLine.appendChild(dateEl);
        }

        left.appendChild(nameLine);

        if (s.message) {
          var msgEl = document.createElement('p');
          msgEl.className = 'mt-1 text-xs text-[var(--text-muted)] italic truncate';
          msgEl.textContent = '\u201C' + s.message + '\u201D';
          left.appendChild(msgEl);
        }

        var del = document.createElement('button');
        del.type = 'button';
        del.className = 'shrink-0 rounded-[var(--r-sm,0.375rem)] border border-[var(--border)] px-2.5 py-1 text-xs font-semibold text-[var(--danger-text)] hover:border-[var(--danger-text)] transition-colors cursor-pointer disabled:opacity-50';
        del.textContent = 'Remove';
        del.addEventListener('click', function () {
          if (!confirm('Remove ' + s.name + ' from the Wall of Gratitude?')) return;
          del.disabled = true;
          fetch('/api/admin/supporters/' + encodeURIComponent(s.id), {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete' }),
          })
            .then(function (r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.json();
            })
            .then(function () {
              loadSupporters();
            })
            .catch(function () {
              del.disabled = false;
              alert('Could not remove supporter.');
            });
        });

        row.appendChild(left);
        row.appendChild(del);
        supportersList.appendChild(row);
      });
    }

    function setSupporterStatus(text, isError) {
      if (!supporterFormStatus) return;
      supporterFormStatus.textContent = text;
      supporterFormStatus.className = 'text-xs min-h-4 ' + (isError ? 'text-[var(--danger-text)]' : 'text-[var(--success)]');
    }

    if (supporterForm) {
      supporterForm.addEventListener('submit', function (e) {
        e.preventDefault();
        if (supporterSubmit) supporterSubmit.disabled = true;
        setSupporterStatus('Adding…', false);

        var payload = {
          name: (root.querySelector('#supporter-name') || {}).value || '',
          tier: (root.querySelector('#supporter-tier') || {}).value || 'supporter',
          tierLabel: (root.querySelector('#supporter-tier-label') || {}).value || '',
          message: (root.querySelector('#supporter-message') || {}).value || '',
          date: (root.querySelector('#supporter-date') || {}).value || '',
        };

        fetch('/api/admin/supporters', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (r) {
            return r.json().then(function (data) {
              return { ok: r.ok, data: data };
            });
          })
          .then(function (res) {
            if (!res.ok) {
              setSupporterStatus(res.data && res.data.error ? res.data.error : 'Could not add supporter.', true);
              return;
            }
            supporterForm.reset();
            setSupporterStatus('Added ' + res.data.supporter.name + ' — live on /support.', false);
            loadSupporters();
          })
          .catch(function () {
            setSupporterStatus('Network error. Please try again.', true);
          })
          .then(function () {
            if (supporterSubmit) supporterSubmit.disabled = false;
          });
      });
    }

    // ─── SUBJECT TAGS TAB CODE ────────────────────────────────────
    var cachedTags = [];
    var cachedAllSubjects = [];
    var cachedSubjectTagsMap = {};
    var isTagsLoaded = false;
    var currentSubjectSearch = '';
    var currentTagFilter = 'all';

    var tagsRankList = root.querySelector('#tags-rank-list');
    var subjectsListEl = root.querySelector('#subjects-assignment-list');
    var tagsCountStat = root.querySelector('#tags-count-stat');
    var subjectsCountStat = root.querySelector('#subjects-count-stat');
    var untaggedCountStat = root.querySelector('#untagged-count-stat');
    var untaggedBadgeContainer = root.querySelector('#untagged-badge-container');
    var subjectSearchInput = root.querySelector('#subject-search-input');
    var subjectTagFilter = root.querySelector('#subject-tag-filter');
    var tagReorderBanner = root.querySelector('#tag-reorder-banner');
    var reorderTagName = root.querySelector('#reorder-tag-name');
    var tagForm = root.querySelector('#tag-form');
    var tagFormStatus = root.querySelector('#tag-form-status');
    var tagSubmitBtn = root.querySelector('#tag-submit-btn');
    var tagsSeedBtn = root.querySelector('#tags-seed-btn');

    var COLOR_MAP = {
      accent: 'bg-[var(--accent-subtle)] text-[var(--accent)] border-[var(--accent)]/30',
      amber: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30',
      emerald: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30',
      blue: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/30',
      purple: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/30',
      rose: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/30',
      cyan: 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/30',
    };

    function loadTagsData(force) {
      if (isTagsLoaded && !force) return;
      if (tagsRankList) tagsRankList.innerHTML = '<p class="p-4 text-xs text-[var(--text-muted)]">Loading tags…</p>';
      if (subjectsListEl) subjectsListEl.innerHTML = '<p class="p-6 text-sm text-[var(--text-muted)]">Loading subjects…</p>';

      fetch('/api/admin/tags', { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        })
        .then(function (data) {
          isTagsLoaded = true;
          cachedTags = data.tags || [];
          cachedAllSubjects = data.allSubjects || [];
          cachedSubjectTagsMap = data.subjectTagsMap || {};

          if (tagsCountStat) tagsCountStat.textContent = String(cachedTags.length);
          if (subjectsCountStat) subjectsCountStat.textContent = String(cachedAllSubjects.length);

          var untaggedCount = data.untaggedCount || 0;
          if (untaggedCountStat) untaggedCountStat.textContent = String(untaggedCount);
          if (untaggedBadgeContainer) untaggedBadgeContainer.classList.toggle('hidden', untaggedCount === 0);

          updateFilterDropdown();
          renderTagsList();
          renderSubjectsList();
        })
        .catch(function () {
          if (tagsRankList) tagsRankList.innerHTML = '<p class="p-4 text-xs text-[var(--danger-text)]">Failed to load tags. Has migration 009 been applied?</p>';
          if (subjectsListEl) subjectsListEl.innerHTML = '<p class="p-6 text-sm text-[var(--danger-text)]">Failed to load subjects.</p>';
        });
    }

    function updateFilterDropdown() {
      if (!subjectTagFilter) return;
      var curVal = subjectTagFilter.value;
      subjectTagFilter.innerHTML = '<option value="all">All Subjects</option><option value="__untagged__">⚠ Untagged Only</option>';
      cachedTags.forEach(function (t) {
        var opt = document.createElement('option');
        opt.value = t.id;
        opt.textContent = t.name;
        subjectTagFilter.appendChild(opt);
      });
      subjectTagFilter.value = curVal;
    }

    function renderTagsList() {
      if (!tagsRankList) return;
      if (!cachedTags.length) {
        tagsRankList.innerHTML = '<p class="p-4 text-xs text-[var(--text-muted)]">No tags created yet. Use the form above or click "Sync / Seed from Files".</p>';
        return;
      }

      tagsRankList.innerHTML = '';
      cachedTags.forEach(function (t, idx) {
        var row = document.createElement('div');
        row.className = 'p-3 hover:bg-[var(--bg-subtle)] transition-colors flex items-center justify-between gap-3';

        var left = document.createElement('div');
        left.className = 'min-w-0 flex-1 flex items-center gap-2.5';

        // Rank badge
        var rankBadge = document.createElement('span');
        rankBadge.className = 'text-[11px] font-mono font-bold text-[var(--text-faint)] w-5 shrink-0 text-center';
        rankBadge.textContent = '#' + (idx + 1);
        left.appendChild(rankBadge);

        // Tag chip
        var chip = document.createElement('span');
        var colorStyle = COLOR_MAP[t.color] || COLOR_MAP.accent;
        chip.className = 'inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold border ' + colorStyle;
        chip.textContent = t.name;
        left.appendChild(chip);

        if (!t.isVisible) {
          var draftBadge = document.createElement('span');
          draftBadge.className = 'text-[10px] uppercase font-bold px-1.5 py-0.2 rounded bg-gray-500/10 text-gray-500 border border-gray-500/20';
          draftBadge.textContent = 'Hidden';
          left.appendChild(draftBadge);
        }

        var actions = document.createElement('div');
        actions.className = 'flex items-center gap-1 shrink-0';

        // Move Up
        if (idx > 0) {
          var upBtn = document.createElement('button');
          upBtn.type = 'button';
          upBtn.className = 'p-1 text-xs text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-interactive)] rounded cursor-pointer transition-colors';
          upBtn.title = 'Move section up';
          upBtn.innerHTML = '▲';
          upBtn.addEventListener('click', function () { moveTag(idx, -1); });
          actions.appendChild(upBtn);
        }

        // Move Down
        if (idx < cachedTags.length - 1) {
          var downBtn = document.createElement('button');
          downBtn.type = 'button';
          downBtn.className = 'p-1 text-xs text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-interactive)] rounded cursor-pointer transition-colors';
          downBtn.title = 'Move section down';
          downBtn.innerHTML = '▼';
          downBtn.addEventListener('click', function () { moveTag(idx, 1); });
          actions.appendChild(downBtn);
        }

        // Visibility Toggle
        var visBtn = document.createElement('button');
        visBtn.type = 'button';
        visBtn.className = 'px-1.5 py-0.5 text-[11px] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] rounded cursor-pointer transition-colors';
        visBtn.textContent = t.isVisible ? 'Hide' : 'Show';
        visBtn.title = t.isVisible ? 'Hide section from homepage' : 'Show section on homepage';
        visBtn.addEventListener('click', function () { toggleTagVisibility(t.id, t.isVisible); });
        actions.appendChild(visBtn);

        // Delete button
        var delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'px-1.5 py-0.5 text-[11px] text-[var(--danger-text)] hover:bg-[var(--danger-bg)] border border-[var(--border)] hover:border-[var(--danger)] rounded cursor-pointer transition-colors';
        delBtn.textContent = '×';
        delBtn.title = 'Delete tag';
        delBtn.addEventListener('click', function () { deleteTagItem(t.id, t.name); });
        actions.appendChild(delBtn);

        row.appendChild(left);
        row.appendChild(actions);
        tagsRankList.appendChild(row);
      });
    }

    function renderSubjectsList() {
      if (!subjectsListEl) return;

      var filtered = cachedAllSubjects.filter(function (s) {
        var sName = s.name.toLowerCase();
        if (currentSubjectSearch && !sName.includes(currentSubjectSearch.toLowerCase())) {
          return false;
        }

        var assignedTagIds = cachedSubjectTagsMap[s.name] || [];
        if (currentTagFilter === '__untagged__') {
          return assignedTagIds.length === 0;
        }
        if (currentTagFilter !== 'all') {
          return assignedTagIds.includes(currentTagFilter);
        }
        return true;
      });

      // Update reorder banner
      if (tagReorderBanner && reorderTagName) {
        if (currentTagFilter !== 'all' && currentTagFilter !== '__untagged__') {
          var matchedTag = cachedTags.find(function (t) { return t.id === currentTagFilter; });
          reorderTagName.textContent = matchedTag ? matchedTag.name : '';
          tagReorderBanner.classList.remove('hidden');
        } else {
          tagReorderBanner.classList.add('hidden');
        }
      }

      if (!filtered.length) {
        subjectsListEl.innerHTML = '<p class="p-6 text-sm text-[var(--text-muted)]">No matching subjects found.</p>';
        return;
      }

      subjectsListEl.innerHTML = '';
      filtered.forEach(function (s, idx) {
        var row = document.createElement('div');
        row.className = 'p-4 hover:bg-[var(--bg-subtle)] transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3';

        var left = document.createElement('div');
        left.className = 'min-w-0 flex-1';

        var titleRow = document.createElement('div');
        titleRow.className = 'flex items-center gap-2 flex-wrap';

        var title = document.createElement('h4');
        title.className = 'font-bold text-sm text-[var(--text)]';
        title.textContent = s.name;
        titleRow.appendChild(title);

        var countBadge = document.createElement('span');
        countBadge.className = 'text-xs text-[var(--text-muted)]';
        countBadge.textContent = '(' + s.lectureCount + ' ' + (s.lectureCount === 1 ? 'lecture' : 'lectures') + ')';
        titleRow.appendChild(countBadge);

        left.appendChild(titleRow);

        // Tags row
        var tagsContainer = document.createElement('div');
        tagsContainer.className = 'flex items-center gap-1.5 flex-wrap mt-2';

        var assignedIds = cachedSubjectTagsMap[s.name] || [];

        if (assignedIds.length === 0) {
          var untaggedSpan = document.createElement('span');
          untaggedSpan.className = 'text-[11px] text-amber-500 font-medium italic';
          untaggedSpan.textContent = 'Untagged (will appear under "Other Subjects")';
          tagsContainer.appendChild(untaggedSpan);
        } else {
          assignedIds.forEach(function (tagId) {
            var tagObj = cachedTags.find(function (t) { return t.id === tagId; });
            if (!tagObj) return;

            var tagBadge = document.createElement('span');
            var colorStyle = COLOR_MAP[tagObj.color] || COLOR_MAP.accent;
            tagBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold border ' + colorStyle;
            tagBadge.innerHTML = esc(tagObj.name) + ' <button type="button" class="text-xs hover:opacity-75 font-bold cursor-pointer" title="Remove tag">&times;</button>';

            var removeBtn = tagBadge.querySelector('button');
            if (removeBtn) {
              removeBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                detachTag(s.name, tagId);
              });
            }

            tagsContainer.appendChild(tagBadge);
          });
        }

        left.appendChild(tagsContainer);

        // Right side: "+ Add Tag" picker and Up/Down for inside-tag ranking
        var right = document.createElement('div');
        right.className = 'flex items-center gap-2 shrink-0 flex-wrap';

        // Reorder buttons when filtered by a specific tag
        if (currentTagFilter !== 'all' && currentTagFilter !== '__untagged__') {
          if (idx > 0) {
            var upBtn = document.createElement('button');
            upBtn.type = 'button';
            upBtn.className = 'px-2 py-1 text-xs border border-[var(--border)] rounded-[var(--r-sm)] bg-[var(--bg-interactive)] text-[var(--text)] hover:text-[var(--accent)] hover:border-[var(--accent)] cursor-pointer';
            upBtn.title = 'Rank higher in this section';
            upBtn.innerHTML = '▲';
            upBtn.addEventListener('click', function () {
              moveSubjectInSection(currentTagFilter, filtered, idx, -1);
            });
            right.appendChild(upBtn);
          }

          if (idx < filtered.length - 1) {
            var downBtn = document.createElement('button');
            downBtn.type = 'button';
            downBtn.className = 'px-2 py-1 text-xs border border-[var(--border)] rounded-[var(--r-sm)] bg-[var(--bg-interactive)] text-[var(--text)] hover:text-[var(--accent)] hover:border-[var(--accent)] cursor-pointer';
            downBtn.title = 'Rank lower in this section';
            downBtn.innerHTML = '▼';
            downBtn.addEventListener('click', function () {
              moveSubjectInSection(currentTagFilter, filtered, idx, 1);
            });
            right.appendChild(downBtn);
          }
        }

        // Available tags dropdown to attach
        var unassignedTags = cachedTags.filter(function (t) { return !assignedIds.includes(t.id); });
        if (unassignedTags.length > 0) {
          var attachSelect = document.createElement('select');
          attachSelect.className = 'px-2 py-1 text-xs rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] focus:border-[var(--accent)] cursor-pointer';
          attachSelect.innerHTML = '<option value="">+ Attach Tag…</option>';
          unassignedTags.forEach(function (t) {
            var opt = document.createElement('option');
            opt.value = t.id;
            opt.textContent = '+ ' + t.name;
            attachSelect.appendChild(opt);
          });
          attachSelect.addEventListener('change', function () {
            if (attachSelect.value) {
              attachTag(s.name, attachSelect.value);
            }
          });
          right.appendChild(attachSelect);
        }

        row.appendChild(left);
        row.appendChild(right);
        subjectsListEl.appendChild(row);
      });
    }

    function moveTag(idx, delta) {
      var newIdx = idx + delta;
      if (newIdx < 0 || newIdx >= cachedTags.length) return;

      var copy = cachedTags.slice();
      var temp = copy[idx];
      copy[idx] = copy[newIdx];
      copy[newIdx] = temp;

      var orderedIds = copy.map(function (t) { return t.id; });
      fetch('/api/admin/tags/reorder', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderedIds: orderedIds }),
      })
        .then(function (r) { return r.json(); })
        .then(function () {
          loadTagsData(true);
        });
    }

    function toggleTagVisibility(id, currentVal) {
      fetch('/api/admin/tags/' + encodeURIComponent(id), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'update', isVisible: !currentVal }),
      })
        .then(function (r) { return r.json(); })
        .then(function () {
          loadTagsData(true);
        });
    }

    function deleteTagItem(id, name) {
      if (!confirm('Are you sure you want to delete tag "' + name + '"?')) return;
      fetch('/api/admin/tags/' + encodeURIComponent(id), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete' }),
      })
        .then(function (r) { return r.json(); })
        .then(function () {
          loadTagsData(true);
        });
    }

    function attachTag(subjectName, tagId) {
      var currentTagIds = cachedSubjectTagsMap[subjectName] || [];
      if (currentTagIds.includes(tagId)) return;
      var newTagIds = currentTagIds.concat([tagId]);

      fetch('/api/admin/tags/subjects', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subjectName: subjectName, tagIds: newTagIds }),
      })
        .then(function (r) { return r.json(); })
        .then(function () {
          loadTagsData(true);
        });
    }

    function detachTag(subjectName, tagId) {
      var currentTagIds = cachedSubjectTagsMap[subjectName] || [];
      var newTagIds = currentTagIds.filter(function (id) { return id !== tagId; });

      fetch('/api/admin/tags/subjects', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subjectName: subjectName, tagIds: newTagIds }),
      })
        .then(function (r) { return r.json(); })
        .then(function () {
          loadTagsData(true);
        });
    }

    function moveSubjectInSection(tagId, filteredList, idx, delta) {
      var newIdx = idx + delta;
      if (newIdx < 0 || newIdx >= filteredList.length) return;

      var copy = filteredList.slice();
      var temp = copy[idx];
      copy[idx] = copy[newIdx];
      copy[newIdx] = temp;

      var orderedNames = copy.map(function (s) { return s.name; });
      fetch('/api/admin/tags/subjects', {
        method: 'PUT',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tagId: tagId, orderedSubjectNames: orderedNames }),
      })
        .then(function (r) { return r.json(); })
        .then(function () {
          loadTagsData(true);
        });
    }

    if (tagForm) {
      tagForm.addEventListener('submit', function (e) {
        e.preventDefault();
        if (tagSubmitBtn) tagSubmitBtn.disabled = true;
        if (tagFormStatus) {
          tagFormStatus.textContent = 'Creating tag…';
          tagFormStatus.className = 'text-xs text-[var(--accent)]';
        }

        var payload = {
          name: (root.querySelector('#tag-name-input') || {}).value || '',
          color: (root.querySelector('#tag-color-select') || {}).value || 'amber',
          description: (root.querySelector('#tag-desc-input') || {}).value || '',
          isVisible: !!(root.querySelector('#tag-visible-checkbox') || {}).checked,
        };

        fetch('/api/admin/tags', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (r) {
            return r.json().then(function (d) { return { ok: r.ok, data: d }; });
          })
          .then(function (res) {
            if (!res.ok) {
              if (tagFormStatus) {
                tagFormStatus.textContent = res.data && res.data.error ? res.data.error : 'Failed to create tag.';
                tagFormStatus.className = 'text-xs text-[var(--danger-text)]';
              }
              return;
            }
            tagForm.reset();
            if (tagFormStatus) {
              tagFormStatus.textContent = 'Tag created successfully!';
              tagFormStatus.className = 'text-xs text-[var(--success)]';
              setTimeout(function () { tagFormStatus.textContent = ''; }, 3000);
            }
            loadTagsData(true);
          })
          .catch(function () {
            if (tagFormStatus) {
              tagFormStatus.textContent = 'Network error.';
              tagFormStatus.className = 'text-xs text-[var(--danger-text)]';
            }
          })
          .then(function () {
            if (tagSubmitBtn) tagSubmitBtn.disabled = false;
          });
      });
    }

    if (tagsSeedBtn) {
      tagsSeedBtn.addEventListener('click', function () {
        if (!confirm('Sync default tags & assignments from existing notes catalog?')) return;
        tagsSeedBtn.disabled = true;
        fetch('/api/admin/tags/seed', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            alert('Synced! Created ' + data.tagsCreated + ' tags, assigned ' + data.assignmentsCreated + ' subjects.');
            loadTagsData(true);
          })
          .catch(function () {
            alert('Failed to seed tags.');
          })
          .then(function () {
            tagsSeedBtn.disabled = false;
          });
      });
    }

    if (subjectSearchInput) {
      subjectSearchInput.addEventListener('input', function () {
        currentSubjectSearch = subjectSearchInput.value.trim();
        renderSubjectsList();
      });
    }

    if (subjectTagFilter) {
      subjectTagFilter.addEventListener('change', function () {
        currentTagFilter = subjectTagFilter.value;
        renderSubjectsList();
      });
    }

    // Trigger initial fetch of views
    fetchViews();
  })();
</script>

<style>
  /* Tabs transition and style custom additions */
  [data-tab-btn] {
    position: relative;
    outline: none;
  }
  
  [data-tab-btn][data-active="true"] {
    transform: translateY(1px);
  }

  /* Admin Badge inside overview panel */
  .admin-badge {
    background: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid var(--accent);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    line-height: 1;
    height: 16px;
  }

  /* Simple animations */
  .animate-fade-in {
    animation: fadeIn 0.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
