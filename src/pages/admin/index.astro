---
/**
 * Admin Dashboard UI Page.
 * Offers unified views statistics and comments overview with inline moderation actions.
 * Access is gated to admin users only.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUser, getEnv } from '../../lib/apiHelpers';
import { logAuthEvent } from '../../lib/auth';

export const prerender = false;

const user = getUser(Astro);
if (!user) {
  return Astro.redirect('/auth/signin?redirect=/admin');
}

const env = await getEnv(Astro);
const isAdminUser = await env.DB.prepare('SELECT user_id FROM admin_users WHERE user_id = ?').bind(user.id).first();

if (!isAdminUser) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

try {
  await logAuthEvent(env.DB, {
    userId: user.id,
    event: 'admin_dashboard_view',
    ip: Astro.request.headers.get('CF-Connecting-IP') || '',
    ua: Astro.request.headers.get('User-Agent') || '',
  });
} catch (e) {
  // best-effort
}
---

<BaseLayout
  title="Admin Dashboard — BitsNotes"
  description="Consolidated admin statistics and comments moderation."
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow">
    <header class="mb-8">
      <h1 class="font-display text-4xl font-extrabold text-[var(--text)]">Admin Dashboard</h1>
      <p class="mt-2 text-sm text-[var(--text-muted)]">Consolidated views metrics and comments overview across all content.</p>
    </header>

    <div data-admin-dashboard>
        <!-- Tab selector -->
        <div class="flex gap-4 border-b border-[var(--border)] mb-8 animate-fade-in" role="tablist" aria-label="Dashboard sections">
          <button
            type="button"
            data-tab-btn="views"
            class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text)] transition-all duration-200 cursor-pointer data-[active=true]:border-[var(--accent)] data-[active=true]:text-[var(--accent)]"
            data-active="true"
          >
            Views Analytics
          </button>
          <button
            type="button"
            data-tab-btn="comments"
            class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text)] transition-all duration-200 cursor-pointer data-[active=true]:border-[var(--accent)] data-[active=true]:text-[var(--accent)]"
            data-active="false"
          >
            Comments Overview
          </button>
        </div>

        <!-- Views Tab Panel -->
        <div data-tab-panel="views" class="space-y-8">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="border border-[var(--border)] rounded-[var(--r-md)] p-6 bg-[var(--bg-elevated)] shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Home Page Views</h3>
              <p class="mt-2 text-3xl font-bold font-display text-[var(--text)]" id="stat-home">—</p>
            </div>
            <div class="border border-[var(--border)] rounded-[var(--r-md)] p-6 bg-[var(--bg-elevated)] shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Total Blog Views</h3>
              <p class="mt-2 text-3xl font-bold font-display text-[var(--text)]" id="stat-blog">—</p>
            </div>
            <div class="border border-[var(--border)] rounded-[var(--r-md)] p-6 bg-[var(--bg-elevated)] shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Total Lecture Views</h3>
              <p class="mt-2 text-3xl font-bold font-display text-[var(--text)]" id="stat-lecture">—</p>
            </div>
          </div>

          <div class="border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden shadow-sm">
            <div class="p-4 border-b border-[var(--border)] bg-[var(--bg-subtle)] flex flex-wrap gap-4 items-center justify-between">
              <h2 class="font-display font-bold text-lg text-[var(--text)]">Views By Page</h2>
              <div class="flex gap-2">
                <select id="views-group-filter" class="px-3 py-1.5 text-xs rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg-interactive)] text-[var(--text)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] font-medium">
                  <option value="all">All Pages</option>
                  <option value="home">Home Page</option>
                  <option value="blog">Blog Posts</option>
                  <option value="lecture">Lecture Notes</option>
                </select>
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-[var(--border)] bg-[var(--bg-subtle)] text-xs text-[var(--text-muted)] uppercase tracking-wider">
                    <th class="p-4 font-semibold w-24">Type</th>
                    <th class="p-4 font-semibold">Page / Key</th>
                    <th class="p-4 font-semibold text-right w-36">Views</th>
                  </tr>
                </thead>
                <tbody id="views-table-body" class="divide-y divide-[var(--border)] text-sm">
                  <tr>
                    <td colspan="3" class="p-8 text-center text-[var(--text-muted)]">Loading views data…</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Comments Tab Panel -->
        <div data-tab-panel="comments" class="hidden space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <h2 class="font-display font-bold text-xl text-[var(--text)]">Comments by Page</h2>
            <div class="text-xs text-[var(--text-muted)] flex gap-3" id="comments-summary-stats">
              <!-- Summary statistics will be populated by JS -->
            </div>
          </div>

          <div class="space-y-4" id="comments-by-page-container">
            <p class="text-sm text-[var(--text-muted)]">Loading comments overview…</p>
          </div>
        </div>
      </div>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  (function () {
    var root = document.querySelector('[data-admin-dashboard]');
    if (!root) return;

    var tabButtons = root.querySelectorAll('[data-tab-btn]');
    var tabPanels = root.querySelectorAll('[data-tab-panel]');
    var viewsBody = root.querySelector('#views-table-body');
    var viewsFilter = root.querySelector('#views-group-filter');
    var commentsContainer = root.querySelector('#comments-by-page-container');
    var commentsSummary = root.querySelector('#comments-summary-stats');

    var cachedViews = [];
    var currentFilter = 'all';

    // Tabs navigation logic
    tabButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetTab = btn.dataset.tabBtn;
        tabButtons.forEach(function (b) {
          b.dataset.active = b === btn ? 'true' : 'false';
        });
        tabPanels.forEach(function (p) {
          p.classList.toggle('hidden', p.dataset.tabPanel !== targetTab);
        });

        // Fetch comments if switched to comments tab
        if (targetTab === 'comments') {
          loadCommentsOverview();
        }
      });
    });

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function timeAgo(ts) {
      var diff = Date.now() - ts;
      var m = Math.floor(diff / 60000);
      if (m < 1) return 'just now';
      if (m < 60) return m + 'm ago';
      var h = Math.floor(m / 60);
      if (h < 24) return h + 'h ago';
      var d = Math.floor(h / 24);
      if (d < 30) return d + 'd ago';
      return new Date(ts).toLocaleDateString();
    }

    // ─── VIEWS TAB CODE ──────────────────────────────────────────
    function fetchViews() {
      viewsBody.innerHTML = '<tr><td colspan="3" class="p-8 text-center text-[var(--text-muted)]">Loading views data…</td></tr>';
      fetch('/api/admin/views', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.views || !data.views.length) {
            viewsBody.innerHTML = '<tr><td colspan="3" class="p-8 text-center text-[var(--text-muted)]">No views data available.</td></tr>';
            return;
          }
          cachedViews = data.views;
          renderViews();
          updateViewStats();
        })
        .catch(function () {
          viewsBody.innerHTML = '<tr><td colspan="3" class="p-8 text-center text-[var(--danger-text)]">Failed to load views data.</td></tr>';
        });
    }

    function updateViewStats() {
      var homeVal = 0;
      var blogVal = 0;
      var lecVal = 0;

      cachedViews.forEach(function (v) {
        if (v.pageKey === 'home') homeVal += v.views;
        else if (v.pageKey.indexOf('blog:') === 0) blogVal += v.views;
        else if (v.pageKey.indexOf('lecture:') === 0) lecVal += v.views;
      });

      var hEl = root.querySelector('#stat-home');
      var bEl = root.querySelector('#stat-blog');
      var lEl = root.querySelector('#stat-lecture');

      if (hEl) hEl.textContent = homeVal.toLocaleString();
      if (bEl) bEl.textContent = blogVal.toLocaleString();
      if (lEl) lEl.textContent = lecVal.toLocaleString();
    }

    function renderViews() {
      var filtered = cachedViews.filter(function (v) {
        if (currentFilter === 'all') return true;
        if (currentFilter === 'home') return v.pageKey === 'home';
        if (currentFilter === 'blog') return v.pageKey.indexOf('blog:') === 0;
        if (currentFilter === 'lecture') return v.pageKey.indexOf('lecture:') === 0;
        return true;
      });

      if (!filtered.length) {
        viewsBody.innerHTML = '<tr><td colspan="3" class="p-8 text-center text-[var(--text-muted)]">No matching rows found.</td></tr>';
        return;
      }

      viewsBody.innerHTML = '';
      filtered.forEach(function (v) {
        var tr = document.createElement('tr');
        tr.className = 'hover:bg-[var(--bg-subtle)] transition-colors';

        var typeTd = document.createElement('td');
        typeTd.className = 'p-4';
        var typeBadge = document.createElement('span');
        
        var cleanKey = v.pageKey;
        if (v.pageKey === 'home') {
          typeBadge.className = 'px-2 py-0.5 text-xs font-semibold rounded bg-[var(--accent-subtle)] text-[var(--accent)]';
          typeBadge.textContent = 'Home';
          cleanKey = 'Home Page';
        } else if (v.pageKey.indexOf('blog:') === 0) {
          typeBadge.className = 'px-2 py-0.5 text-xs font-semibold rounded bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
          typeBadge.textContent = 'Blog';
          cleanKey = v.pageKey.slice(5);
        } else if (v.pageKey.indexOf('lecture:') === 0) {
          typeBadge.className = 'px-2 py-0.5 text-xs font-semibold rounded bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
          typeBadge.textContent = 'Lecture';
          cleanKey = v.pageKey.slice(8);
        } else {
          typeBadge.className = 'px-2 py-0.5 text-xs font-semibold rounded bg-gray-100 text-gray-800';
          typeBadge.textContent = 'Other';
        }
        
        typeTd.appendChild(typeBadge);

        var keyTd = document.createElement('td');
        keyTd.className = 'p-4 font-mono text-xs text-[var(--text)]';
        keyTd.textContent = cleanKey;

        var countTd = document.createElement('td');
        countTd.className = 'p-4 text-right font-semibold font-variant-numeric tabular-nums text-[var(--text)]';
        countTd.textContent = v.views.toLocaleString();

        tr.appendChild(typeTd);
        tr.appendChild(keyTd);
        tr.appendChild(countTd);
        viewsBody.appendChild(tr);
      });
    }

    if (viewsFilter) {
      viewsFilter.addEventListener('change', function () {
        currentFilter = viewsFilter.value;
        renderViews();
      });
    }

    // ─── COMMENTS TAB CODE ────────────────────────────────────────
    var isCommentsLoaded = false;
    function loadCommentsOverview() {
      if (isCommentsLoaded) return; // avoid double fetch
      commentsContainer.innerHTML = '<p class="text-sm text-[var(--text-muted)]">Loading comments overview…</p>';
      
      fetch('/api/admin/comments/overview', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          isCommentsLoaded = true;
          if (!data.pages || !data.pages.length) {
            commentsContainer.innerHTML = '<p class="text-sm text-[var(--text-muted)]">No comments found in D1 database.</p>';
            if (commentsSummary) commentsSummary.innerHTML = '';
            return;
          }
          
          renderComments(data.pages);
          renderCommentsSummary(data.pages);
        })
        .catch(function () {
          commentsContainer.innerHTML = '<p class="text-sm text-[var(--danger-text)]">Failed to load comments overview.</p>';
        });
    }

    function renderCommentsSummary(pages) {
      var total = 0;
      var published = 0;
      var pending = 0;
      var hidden = 0;

      pages.forEach(function (p) {
        total += p.total;
        published += p.published;
        pending += p.pending;
        hidden += p.hidden;
      });

      commentsSummary.innerHTML = 
        '<span>Total: <strong>' + total + '</strong></span>' +
        '<span>Published: <strong class="text-[var(--success)]">' + published + '</strong></span>' +
        '<span>Pending: <strong class="text-[var(--warning)]">' + pending + '</strong></span>' +
        '<span>Hidden: <strong class="text-[var(--danger)]">' + hidden + '</strong></span>';
    }

    function renderComments(pages) {
      commentsContainer.innerHTML = '';

      pages.forEach(function (page) {
        var section = document.createElement('div');
        section.className = 'border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] overflow-hidden shadow-sm';

        // Accordion header
        var header = document.createElement('button');
        header.type = 'button';
        header.className = 'w-full text-left p-4 bg-[var(--bg-subtle)] hover:bg-[var(--border-subtle)] flex items-center justify-between gap-4 focus:outline-none transition-colors cursor-pointer';
        
        var titleContainer = document.createElement('div');
        titleContainer.className = 'flex flex-col gap-1';
        
        var title = document.createElement('h3');
        title.className = 'font-display font-bold text-base text-[var(--text)]';
        title.textContent = page.label;
        
        var metaRow = document.createElement('div');
        metaRow.className = 'flex items-center gap-2 flex-wrap text-xs';
        
        var countBadge = document.createElement('span');
        countBadge.className = 'font-semibold text-[var(--text-muted)]';
        countBadge.textContent = page.total + (page.total === 1 ? ' comment' : ' comments');
        metaRow.appendChild(countBadge);

        if (page.pending > 0) {
          var pendingBadge = document.createElement('span');
          pendingBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-[var(--warning-bg)] text-[var(--warning)] border border-[var(--warning-border)]';
          pendingBadge.textContent = page.pending + ' pending';
          metaRow.appendChild(pendingBadge);
        }
        if (page.hidden > 0) {
          var hiddenBadge = document.createElement('span');
          hiddenBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-[var(--danger-bg)] text-[var(--danger)] border border-[var(--danger-border)]';
          hiddenBadge.textContent = page.hidden + ' hidden';
          metaRow.appendChild(hiddenBadge);
        }

        titleContainer.appendChild(title);
        titleContainer.appendChild(metaRow);

        var arrow = document.createElement('div');
        arrow.className = 'text-[var(--text-muted)] transition-transform duration-200 transform rotate-0';
        arrow.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>';

        header.appendChild(titleContainer);
        header.appendChild(arrow);

        // Accordion Content body
        var content = document.createElement('div');
        content.className = 'hidden border-t border-[var(--border)] p-4 space-y-4 bg-[var(--bg-elevated)]';

        page.comments.forEach(function (c) {
          var card = document.createElement('div');
          card.className = 'border border-[var(--border)] rounded-[var(--r-sm)] p-4 bg-[var(--bg-interactive)] relative hover:border-[var(--accent)] transition-colors';

          // Link card title/meta info to target URL
          var cardMeta = document.createElement('div');
          cardMeta.className = 'flex flex-wrap items-center justify-between gap-2 mb-2 text-xs text-[var(--text-muted)]';
          
          var authorLink = document.createElement('a');
          authorLink.href = c.pageUrl;
          authorLink.className = 'font-bold text-[var(--text)] hover:text-[var(--accent)] hover:underline flex items-center gap-1.5 transition-colors';
          authorLink.textContent = c.displayName;
          
          if (c.isAdmin) {
            var badge = document.createElement('span');
            badge.className = 'admin-badge';
            badge.textContent = 'Admin';
            authorLink.appendChild(badge);
          }

          var metaRight = document.createElement('div');
          metaRight.className = 'flex items-center gap-2';

          var statusBadge = document.createElement('span');
          statusBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider';
          if (c.status === 'published') {
            statusBadge.className += ' bg-[var(--success-bg)] text-[var(--success-text)] border border-[var(--success-border)]';
          } else if (c.status === 'pending') {
            statusBadge.className += ' bg-[var(--warning-bg)] text-[var(--warning-text)] border border-[var(--warning-border)]';
          } else {
            statusBadge.className += ' bg-[var(--danger-bg)] text-[var(--danger-text)] border border-[var(--danger-border)]';
          }
          statusBadge.textContent = c.status;

          var timeSpan = document.createElement('span');
          timeSpan.textContent = timeAgo(c.createdAt);

          metaRight.appendChild(statusBadge);
          metaRight.appendChild(timeSpan);

          cardMeta.appendChild(authorLink);
          cardMeta.appendChild(metaRight);

          var body = document.createElement('p');
          body.className = 'text-sm text-[var(--text)] whitespace-pre-wrap mb-3';
          body.textContent = c.body;

          if (c.moderationReason) {
            var reason = document.createElement('div');
            reason.className = 'text-xs italic bg-[var(--bg-subtle)] text-[var(--danger-text)] p-2 rounded mb-3 border border-[var(--border)]';
            reason.textContent = 'Moderation reason: ' + c.moderationReason;
            card.appendChild(reason);
          }

          var actions = document.createElement('div');
          actions.className = 'flex flex-wrap items-center justify-between gap-3';

          var leftBtns = document.createElement('div');
          leftBtns.className = 'flex flex-wrap gap-2';

          [
            { a: 'publish', label: 'Publish', show: c.status !== 'published' },
            { a: 'hide', label: 'Hide', show: c.status === 'published' },
            { a: 'restore', label: 'Restore', show: c.status === 'deleted' || c.status === 'hidden' },
            { a: 'delete', label: 'Delete', show: c.status !== 'deleted' },
          ].forEach(function (act) {
            if (!act.show) return;
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'px-2.5 py-1 text-xs font-medium rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg-elevated)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition-colors cursor-pointer';
            b.textContent = act.label;
            b.addEventListener('click', function (e) {
              e.stopPropagation();
              moderateComment(c.id, act.a, b);
            });
            leftBtns.appendChild(b);
          });

          // Action link button to jump to comment on page
          var replyLink = document.createElement('a');
          replyLink.href = c.pageUrl;
          replyLink.className = 'inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold rounded-[var(--r-sm)] bg-[var(--accent)] text-[var(--accent-contrast)] hover:bg-[var(--accent-hover)] transition-colors';
          replyLink.innerHTML = 'View & Reply <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>';

          actions.appendChild(leftBtns);
          actions.appendChild(replyLink);

          card.appendChild(cardMeta);
          card.appendChild(body);
          card.appendChild(actions);
          content.appendChild(card);
        });

        // Expand/collapse accordion click handler
        header.addEventListener('click', function () {
          var isHidden = content.classList.contains('hidden');
          content.classList.toggle('hidden');
          arrow.classList.toggle('rotate-180', isHidden);
        });

        section.appendChild(header);
        section.appendChild(content);
        commentsContainer.appendChild(section);
      });
    }

    function moderateComment(id, action, btn) {
      btn.disabled = true;
      fetch('/api/admin/comments/' + encodeURIComponent(id), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: action }),
      }).then(function (r) {
        if (r.ok) {
          isCommentsLoaded = false;
          loadCommentsOverview();
        } else {
          btn.disabled = false;
          alert('Action failed.');
        }
      });
    }

    // Trigger initial fetch of views
    fetchViews();
  })();
</script>

<style>
  /* Tabs transition and style custom additions */
  [data-tab-btn] {
    position: relative;
    outline: none;
  }
  
  [data-tab-btn][data-active="true"] {
    transform: translateY(1px);
  }

  /* Admin Badge inside overview panel */
  .admin-badge {
    background: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid var(--accent);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    line-height: 1;
    height: 16px;
  }

  /* Simple animations */
  .animate-fade-in {
    animation: fadeIn 0.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
