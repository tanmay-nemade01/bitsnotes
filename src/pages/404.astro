---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | BitsNotes"
  description="The page you are looking for could not be found. Return to the BitsNotes dashboard to explore available lecture notes and study materials."
  theme="light"
>
  <main class="flex-grow flex items-center justify-center px-4 py-20">
    <div class="max-w-lg w-full text-center">

      <!-- Glowing number -->
      <div class="relative inline-block mb-6 select-none">
        <span class="text-[9rem] md:text-[11rem] font-black text-slate-100 leading-none tracking-tighter block">
          404
        </span>
        <span class="absolute inset-0 text-[9rem] md:text-[11rem] font-black leading-none tracking-tighter block
          bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent
          blur-[2px] opacity-70">
          404
        </span>
        <span class="absolute inset-0 text-[9rem] md:text-[11rem] font-black leading-none tracking-tighter block
          bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent">
          404
        </span>
      </div>

      <!-- Decorative icon -->
      <div class="w-16 h-16 bg-indigo-50 border border-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-indigo-100/50">
        <svg class="w-8 h-8 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>

      <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
        Page Not Found
      </h1>
      <p class="text-slate-500 text-sm md:text-base leading-relaxed mb-8 max-w-sm mx-auto">
        Oops! The lecture, subject, or page you're looking for doesn't exist or may have been moved. Double-check the URL or head back to the dashboard.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          id="go-home-btn"
          class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl shadow-lg shadow-indigo-600/25 hover:shadow-xl hover:shadow-indigo-600/35 transition-all"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Dashboard
        </a>
        <a
          href="/contact"
          id="report-404-btn"
          class="inline-flex items-center gap-2 px-6 py-3 bg-white hover:bg-slate-50 text-slate-700 text-sm font-bold rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all"
        >
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Report a Broken Link
        </a>
      </div>

      <!-- Helpful links -->
      <div class="mt-12 pt-8 border-t border-slate-100">
        <p class="text-xs text-slate-400 font-medium uppercase tracking-widest mb-4">Quick Links</p>
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
          <a href="/" class="text-indigo-600 hover:text-indigo-700 font-medium transition-colors">Dashboard</a>
          <a href="/about" class="text-indigo-600 hover:text-indigo-700 font-medium transition-colors">About</a>
          <a href="/contact" class="text-indigo-600 hover:text-indigo-700 font-medium transition-colors">Contact</a>
          <a href="/privacy" class="text-indigo-600 hover:text-indigo-700 font-medium transition-colors">Privacy Policy</a>
          <a href="/terms" class="text-indigo-600 hover:text-indigo-700 font-medium transition-colors">Terms</a>
        </div>
      </div>

    </div>
  </main>
</BaseLayout>
