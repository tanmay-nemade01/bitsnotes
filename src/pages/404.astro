---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | BitsNotes"
  description="The page you are looking for could not be found. Return to the BitsNotes dashboard to explore available lecture notes and study materials."
>
  <div class="flex-grow flex items-center justify-center px-4 py-20">
    <div class="max-w-md w-full text-center">
      <span class="font-display text-[7rem] md:text-[9rem] font-black text-[var(--bg-subtle)] leading-none tracking-tighter block select-none">
        404
      </span>

      <h1 class="text-xl md:text-2xl font-bold text-[var(--text)] mt-2 mb-3">
        Page not found
      </h1>
      <p class="text-sm text-[var(--text-muted)] leading-relaxed mb-8">
        The lecture, subject, or page you're looking for doesn't exist or may have been moved. Double-check the URL or head back to the dashboard.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-white text-sm font-bold rounded-[var(--r-sm)] transition-all active:scale-[0.97]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Back to Dashboard
        </a>
        <a href="/contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--border)] hover:bg-[var(--bg-subtle)] text-[var(--text)] text-sm font-bold rounded-[var(--r-sm)] transition-all">
          <svg class="w-4 h-4 text-[var(--text-muted)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Report a Broken Link
        </a>
      </div>

      <div class="mt-10 pt-6 border-t border-[var(--border)]">
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
          <a href="/" class="text-[var(--accent)] hover:underline font-medium">Dashboard</a>
          <a href="/about" class="text-[var(--accent)] hover:underline font-medium">About</a>
          <a href="/contact" class="text-[var(--accent)] hover:underline font-medium">Contact</a>
          <a href="/privacy" class="text-[var(--accent)] hover:underline font-medium">Privacy</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
