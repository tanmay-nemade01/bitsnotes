---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogPostCard from '../../../components/blog/BlogPostCard.astro';
import { getPostsByTag, getAllTags } from '../../../utils/blogLoader';
import '../../../styles/blog.css';

export async function getStaticPaths() {
  const tags = getAllTags();
  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = getPostsByTag(tag);
const allTags = getAllTags();
---

<BaseLayout
  title={`Posts tagged "${tag}" — BitsNotes Blog`}
  description={`Blog posts about ${tag} on BitsNotes.`}
  ogImage="/og-default.png"
>
  <div class="blog-page">
    <div class="blog-header">
      <a href="/blog" class="blog-hero__back">← Back to Blog</a>
      <h1>Tag: {tag}</h1>
      <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged with "{tag}"</p>
    </div>

    {allTags.length > 0 && (
      <div class="blog-tag-list">
        {allTags.map((t) => (
          <a
            href={`/blog/tag/${t}`}
            class={`blog-tag${t === tag ? ' blog-tag--active' : ''}`}
          >
            {t}
          </a>
        ))}
      </div>
    )}

    <section class="blog-listing" aria-label="Posts">
      {posts.length === 0 ? (
        <div class="blog-listing__empty">
          <p>No posts found for this tag.</p>
        </div>
      ) : (
        <div class="blog-listing__grid">
          {posts.map((post) => <BlogPostCard post={post} />)}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
