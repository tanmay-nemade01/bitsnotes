---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BitItem from '../../components/bits/BitItem.astro';
import BitReactionsScript from '../../components/bits/BitReactionsScript.astro';
import { getPublishedBits } from '../../utils/bitsLoader';
import '../../styles/bits.css';

export const prerender = false;

const bits = await getPublishedBits();
---

<BaseLayout
  title="Bits — BitsNotes"
  description="Short takes, links, and the occasional meme — not essays."
  ogImage="/og-default.png"
>
  <div class="bits-page">
    <header class="bits-header bits-header--feed">
      <p class="bits-header__kicker">Microblog</p>
      <h1>Bits</h1>
      <p>Short takes, links, and the occasional meme — not essays.</p>
    </header>

    <section class="bits-feed" aria-label="Bits">
      {bits.length === 0 && (
        <p class="bits-feed__empty">No bits yet. Check back soon.</p>
      )}
      {bits.map((bit) => <BitItem bit={bit} />)}
    </section>
  </div>
  <BitReactionsScript />
</BaseLayout>
