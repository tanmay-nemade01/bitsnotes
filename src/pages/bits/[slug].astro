---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BitItem from '../../components/bits/BitItem.astro';
import BitReactionsScript from '../../components/bits/BitReactionsScript.astro';
import { getBitBySlug, bitPreview, bitImageSrc } from '../../utils/bitsLoader';
import '../../styles/bits.css';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const bit = await getBitBySlug(slug);
if (!bit || bit.frontmatter.draft) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const preview = bitPreview(bit);
const ogImage = bit.frontmatter.image
  ? `https://bitsnotes.com${bitImageSrc(bit.slug, bit.frontmatter.image)}`
  : undefined;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SocialMediaPosting',
  headline: preview,
  articleBody: bit.frontmatter.text || preview,
  datePublished: bit.frontmatter.publishedAt,
  url: `https://bitsnotes.com/bits/${bit.slug}`,
  author: {
    '@type': 'Person',
    name: 'BitsNotes',
  },
};
---

<BaseLayout
  title={`${preview} — BitsNotes`}
  description={preview}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <div class="bits-page">
    <header class="bits-header">
      <a href="/bits" class="bits-header__back">← Back to Bits</a>
      <h1 class="sr-only">{preview}</h1>
    </header>
    <BitItem bit={bit} permalink />
  </div>
  <BitReactionsScript />
</BaseLayout>
