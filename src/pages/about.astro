---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="About the Project | BitsNotes" 
  description="Learn about the mission of BitsNotes - providing high-quality learning resources and lecture notes"
  keywords="about bitsnotes, lecture notes project, free study materials, educational platform"
  robots="index, follow"
  theme="light"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About BitsNotes",
      "description": "BitsNotes provides free, high-quality lecture notes, study guides, and practice quizzes for postgraduate students.",
      "url": "https://www.bitsnotes.com/about"
    })} />
  </Fragment>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex-grow">
    
    <!-- Title Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-block text-xs font-bold text-indigo-600 uppercase tracking-widest bg-indigo-50 px-3 py-1.5 rounded-lg mb-4">Our Mission</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        High-quality lecture notes
      </h1>
      <p class="mt-4 text-slate-600 leading-relaxed text-base md:text-lg">
        Accessible educational materials for All
      </p>
    </div>

    <!-- Main Content Section -->
    <div class="bg-white rounded-3xl border border-slate-100 p-8 md:p-12 shadow-xl shadow-slate-100/40 relative overflow-hidden mb-12 reveal-on-scroll">
      <!-- Decorative background glow -->
      <div class="absolute right-0 top-0 -mt-16 -mr-16 w-48 h-48 bg-indigo-50 rounded-full blur-3xl pointer-events-none"></div>

      <div class="prose prose-slate max-w-none space-y-6 text-slate-600 leading-relaxed">
        <h2 class="text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          Who We Are
        </h2>
        <p>
          Welcome to <strong>BitsNotes</strong>! This platform was created by a student to provide fellow students with free, high-quality, and instant access to detailed lecture notes, study guides, and exam preparation materials. 
        </p>

        <h2 class="text-2xl font-bold text-slate-900 mt-8 mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          What are these notes?
        </h2>
        <p>
          I've started this project to make the notes I make during my educational journey accessible to other students. The content is largely taken from my personal notes and I've used AI to refine and structure the notes and make them presentable.
        </p>

      </div>

      <!-- Feature Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10 pt-10 border-t border-slate-100">
        
        <div class="p-5 bg-slate-50 rounded-2xl border border-slate-100 reveal-on-scroll">
          <div class="w-10 h-10 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600 mb-3.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h4 class="font-bold text-slate-800 text-sm">Blazing Fast</h4>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">Powered by edge workers and R2 for rapid page rendering.</p>
        </div>

        <div class="p-5 bg-slate-50 rounded-2xl border border-slate-100 reveal-on-scroll">
          <div class="w-10 h-10 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600 mb-3.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <h4 class="font-bold text-slate-800 text-sm">Study Aids</h4>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">Integrated core concepts, breakdowns, and practice quizzes on pages.</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('revealed'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal-on-scroll').forEach(el => obs.observe(el));
</script>
