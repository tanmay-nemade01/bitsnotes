---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="About the Project | BitsNotes" 
  description="Learn about the mission of BitsNotes - providing high-quality learning resources and lecture notes"
  keywords="about bitsnotes, lecture notes project, free study materials, educational platform"
  robots="index, follow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About BitsNotes",
      "description": "BitsNotes provides free, high-quality lecture notes, study guides, and practice quizzes for postgraduate students.",
      "url": "https://bitsnotes.com/about"
    })} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex-grow">
    <!-- Editorial header — no badge, no blobs -->
    <header class="mb-10">
      <h1 class="font-display text-4xl md:text-5xl font-extrabold text-[var(--text)] tracking-tight leading-tight">
        High-quality lecture notes
      </h1>
      <p class="mt-2 text-[var(--text-muted)] text-lg">
        Accessible educational materials for all.
      </p>
    </header>

    <!-- Content -->
    <div class="space-y-8">
      <section class="space-y-4 text-[var(--text)] leading-relaxed">
        <h2 class="font-display text-2xl font-bold text-[var(--text)]">Our Mission</h2>
        <p>
          Welcome to <strong>BitsNotes</strong>! This platform was created to provide students with free, high-quality, and instant access to detailed lecture notes, study guides, and exam preparation materials. We believe that high-quality educational resources should be openly accessible to everyone, everywhere.
        </p>

        <div class="my-8 p-6 border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] flex flex-col sm:flex-row items-center gap-6">
          <div class="w-16 h-16 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] flex items-center justify-center font-display text-xl font-bold border border-[var(--border)] shrink-0 select-none">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <div class="space-y-2 text-center sm:text-left flex-grow">
            <h3 class="font-display text-lg font-bold text-[var(--text)]">Open & Accessible Education</h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">
              BitsNotes is an independent, community-oriented initiative. All content is completely free, open, and designed to help postgraduate students excel in their academic and professional journeys.
            </p>
            <div class="flex items-center justify-center sm:justify-start gap-4 pt-1 text-[var(--text-faint)]">
              <a href="mailto:support@bitsnotes.com" class="hover:text-[var(--accent)] transition-colors text-xs flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Contact Support
              </a>
              <span class="text-[var(--border)]">|</span>
              <a href="/contact" class="hover:text-[var(--accent)] transition-colors text-xs flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
                Contact Form
              </a>
            </div>
          </div>
        </div>

        <h2 class="font-display text-2xl font-bold text-[var(--text)] pt-4">How These Notes Are Compiled</h2>
        <p>
          This project compiles detailed and comprehensive study resources. Every topic, concept breakdown, and practice quiz is synthesized from lectures, reference textbooks, and structured study hours to provide an accurate, easy-to-use resource for self-study and exam preparation.
        </p>
      </section>

      <!-- Feature grid — simple two-up list -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-6 border-t border-[var(--border)]">
        <div class="p-5 border border-[var(--border)] rounded-[var(--r-md)]">
          <div class="w-8 h-8 rounded-[var(--r-sm)] bg-[var(--accent-subtle)] flex items-center justify-center text-[var(--accent)] mb-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h4 class="font-bold text-sm text-[var(--text)]">Blazing Fast</h4>
          <p class="text-xs text-[var(--text-muted)] mt-1 leading-relaxed">Powered by edge workers and R2 for rapid page rendering.</p>
        </div>
        <div class="p-5 border border-[var(--border)] rounded-[var(--r-md)]">
          <div class="w-8 h-8 rounded-[var(--r-sm)] bg-[var(--accent-subtle)] flex items-center justify-center text-[var(--accent)] mb-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <h4 class="font-bold text-sm text-[var(--text)]">Study Aids</h4>
          <p class="text-xs text-[var(--text-muted)] mt-1 leading-relaxed">Integrated core concepts, breakdowns, and practice quizzes on pages.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
