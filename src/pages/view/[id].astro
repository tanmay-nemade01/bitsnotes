---
import { parseLegacyLectureFolder } from '../../utils/r2Structure';

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/');
}

const decodedId = decodeURIComponent(id);
const legacy = parseLegacyLectureFolder(decodedId);

if (legacy) {
  return Astro.redirect(
    `/view/${encodeURIComponent(legacy.subject)}/${encodeURIComponent(legacy.lecture)}`
  );
}

// Old single-segment paths without " - Lecture " pattern are no longer supported
return Astro.redirect('/');
---
