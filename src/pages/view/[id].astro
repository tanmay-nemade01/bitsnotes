---
import { parseLegacyLectureFolder } from '../../utils/notesLoader';
import { slugify } from '../../utils/lectureDisplay';

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/');
}

const decodedId = decodeURIComponent(id);
const legacy = parseLegacyLectureFolder(decodedId);

if (legacy) {
  return Astro.redirect(
    `/view/${encodeURIComponent(slugify(legacy.subject))}/${encodeURIComponent(legacy.lecture)}`
  );
}

// Old single-segment paths without " - Lecture " pattern are no longer supported
return Astro.redirect('/');
---
