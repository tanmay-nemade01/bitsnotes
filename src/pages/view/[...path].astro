---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/lecture-notes.css';
import { getFallbackMetadata } from '../../utils/metadata';
import type { QuizQuestion } from '../../utils/metadata';
import { listSubjects, listLectures, getLectureContent, getSubjectByNameOrSlug } from '../../utils/notesLoader';
import { parseLectureHtml } from '../../utils/htmlParser';
import { splitLectureTopics } from '../../utils/topicSplitter';
import { getResourceKindLabel, slugify } from '../../utils/lectureDisplay';
import PomodoroTimer from '../../components/PomodoroTimer.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import UsefulnessFeedback from '../../components/UsefulnessFeedback.astro';
import ViewCounter from '../../components/ViewCounter.astro';

export const prerender = false;

const { path } = Astro.params;
if (!path) return Astro.redirect('/');

const segments = path.split('/').map(decodeURIComponent);
if (segments.length < 2) return Astro.redirect('/');

const subjectSlugOrFolderName = segments[0];
const lectureSlugOrFolderName = segments[1];

const matchedSubject = await getSubjectByNameOrSlug(subjectSlugOrFolderName);
if (!matchedSubject) {
  return Astro.redirect('/');
}
const subjectName = matchedSubject.name;

const lectures = await listLectures(subjectName);
const matchedLecture = lectures.find(
  (l) => l.slug === lectureSlugOrFolderName ||
         l.folderName === lectureSlugOrFolderName ||
         slugify(l.folderName) === lectureSlugOrFolderName ||
         slugify(l.folderName.replace(/_notes(_enhanced)?$/i, '')) === lectureSlugOrFolderName ||
         slugify(l.topicTitle) === lectureSlugOrFolderName
);

if (!matchedLecture) {
  return Astro.redirect('/');
}

// Redirect to canonical slug if raw/unslugified names or folderNames were used in URL
const canonicalSubjectSlug = slugify(subjectName);
const canonicalLectureSlug = matchedLecture.slug;

if (subjectSlugOrFolderName !== canonicalSubjectSlug || lectureSlugOrFolderName !== canonicalLectureSlug) {
  const targetUrl = new URL(`/view/${encodeURIComponent(canonicalSubjectSlug)}/${encodeURIComponent(canonicalLectureSlug)}`, Astro.url);
  targetUrl.search = Astro.url.search;
  return Astro.redirect(targetUrl.pathname + targetUrl.search);
}

const lectureFolderName = matchedLecture.folderName;

let errorMsg = '';
let customMetadata: any = null;
let htmlContent = '';
let hasHtmlContent = false;
let cssContent = '';
let jsContent = '';

const lectureContent = await getLectureContent(subjectName, lectureFolderName);
if (lectureContent) {
  htmlContent = lectureContent.htmlContent;
  cssContent = lectureContent.cssContent || '';
  jsContent = lectureContent.jsContent || '';
  hasHtmlContent = true;
  customMetadata = lectureContent.metadata;
} else {
  errorMsg = `No notes found for "${subjectName}/${lectureFolderName}". Check that the HTML file exists in src/content/notes/.`;
}

let bodyContent = '';
let inlineStyles = '';
let hasRevisionSection = false;
let revisionSectionContent = '';
let hasQuizSection = false;
let quizSectionContent = '';

if (hasHtmlContent) {
  const parsed = parseLectureHtml(htmlContent, cssContent);
  bodyContent = parsed.bodyContent;
  inlineStyles = parsed.inlineStyles;
  hasRevisionSection = parsed.hasRevisionSection;
  revisionSectionContent = parsed.revisionSectionContent;
  hasQuizSection = parsed.hasQuizSection;
  quizSectionContent = parsed.quizSectionContent;
}

const hasMermaid = bodyContent.includes('class="mermaid"') || bodyContent.includes('data-type="concept-map"');

const metadata = customMetadata || getFallbackMetadata(lectureFolderName, subjectName);
const lectureName = (lectureContent?.fileName || lectureFolderName).replace(/_/g, ' ');

const { topics } = splitLectureTopics(bodyContent);

// Phase 7: resource-type awareness. Non-lecture (subject-scope) resources must
// not be labelled "Lecture Notes" and must never fabricate a lecture number.
const isResource = metadata.scope === 'subject' || (metadata.resourceKind && metadata.resourceKind !== 'lecture');
const showRightSidebar = !(topics.length === 1 && topics[0].id === 'full' && isResource);
const resourceKindLabel = isResource ? getResourceKindLabel(metadata.resourceKind ?? 'lecture') : 'Lecture';
// Derive raw topic title from metadata or matched catalog lecture entry
const rawTopicTitle = (
  metadata.topicTitle ||
  metadata.title ||
  matchedLecture?.topicTitle ||
  ''
).trim();

// Fallback topic title from keyConcepts if topicTitle is missing
const conceptTitle = rawTopicTitle
  ? rawTopicTitle
  : (metadata.keyConcepts && metadata.keyConcepts.length > 0
      ? metadata.keyConcepts.slice(0, 2).join(', ')
      : '');

// Clean lecture name (e.g. "DRL Lecture 6 Notes")
const cleanLectureName = lectureName.replace(/\s+/g, ' ').trim();

let pageSeoTitle = '';

if (isResource) {
  const resourceTitle = conceptTitle || cleanLectureName;
  pageSeoTitle = `${resourceTitle} | ${subjectName} ${resourceKindLabel} | BitsNotes`;
} else if (conceptTitle) {
  const lowerConcept = conceptTitle.toLowerCase();
  const lowerLecture = cleanLectureName.toLowerCase();
  if (lowerConcept.includes(lowerLecture) || lowerConcept.includes('lecture')) {
    pageSeoTitle = `${conceptTitle} | ${subjectName} | BitsNotes`;
  } else {
    pageSeoTitle = `${conceptTitle} — ${cleanLectureName} | ${subjectName} | BitsNotes`;
  }
} else {
  pageSeoTitle = `${cleanLectureName} | ${subjectName} | BitsNotes`;
}

// Display title for UI & JSON-LD schema
const displayResourceTitle = isResource
  ? (conceptTitle || cleanLectureName)
  : (conceptTitle ? `${cleanLectureName} · ${conceptTitle}` : cleanLectureName);

const showRevisionTab = hasRevisionSection || !!(metadata.examRevisionNotes && metadata.examRevisionNotes.length > 0);
const showQuizTab = hasQuizSection || !!(metadata.quiz && metadata.quiz.length > 0);

const subjects = await listSubjects();

let prevUrl = '', prevLabel = '', nextUrl = '', nextLabel = '';
const currentLectureIndex = lectures.findIndex(l => l.folderName === lectureFolderName);
const currentSubjectIndex = subjects.findIndex(s => s.name === subjectName);

if (currentLectureIndex !== -1 && currentSubjectIndex !== -1) {
  if (currentLectureIndex > 0) {
    const p = lectures[currentLectureIndex - 1];
    prevUrl = `/view/${encodeURIComponent(slugify(subjectName))}/${encodeURIComponent(p.slug)}`;
    prevLabel = p.displayTitle || p.name;
  } else {
    const prevSubjectIdx = (currentSubjectIndex - 1 + subjects.length) % subjects.length;
    const prevSubject = subjects[prevSubjectIdx];
    const prevLectures = await listLectures(prevSubject.name);
    if (prevLectures.length > 0) {
      const last = prevLectures[prevLectures.length - 1];
      prevUrl = `/view/${encodeURIComponent(slugify(prevSubject.name))}/${encodeURIComponent(last.slug)}`;
      prevLabel = last.displayTitle || last.name;
    }
  }

  if (currentLectureIndex < lectures.length - 1) {
    const n = lectures[currentLectureIndex + 1];
    nextUrl = `/view/${encodeURIComponent(slugify(subjectName))}/${encodeURIComponent(n.slug)}`;
    nextLabel = n.displayTitle || n.name;
  } else {
    const nextSubjectIdx = (currentSubjectIndex + 1) % subjects.length;
    const nextSubject = subjects[nextSubjectIdx];
    const nextLectures = await listLectures(nextSubject.name);
    if (nextLectures.length > 0) {
      const first = nextLectures[0];
      nextUrl = `/view/${encodeURIComponent(slugify(nextSubject.name))}/${encodeURIComponent(first.slug)}`;
      nextLabel = first.displayTitle || first.name;
    }
  }
}

const seoDescription = metadata.summary
  ? (metadata.summary.length > 155 ? metadata.summary.slice(0, 152) + "..." : metadata.summary)
  : (conceptTitle
      ? `Study notes and learning guide on ${conceptTitle} (${cleanLectureName}) for ${subjectName} on BitsNotes.`
      : `Access study notes and resources for ${cleanLectureName} in ${subjectName} on BitsNotes.`);

const seoKeywords = [
  conceptTitle, metadata.title, subjectName, cleanLectureName,
  "lecture notes", "study guide", "practice quiz",
  ...(metadata.keyConcepts || []).map((k: string) => k.split(' ').slice(0, 3).join(' ').replace(/[^\w\s]/g, '')),
].filter(Boolean).join(", ");

const learningResourceSchema = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": conceptTitle ? `${conceptTitle} (${cleanLectureName})` : cleanLectureName,
  "description": metadata.summary || seoDescription,
  "learningResourceType": isResource ? resourceKindLabel : "Lecture Notes",
  "educationalLevel": metadata.gradeLevel || "higher education",
  "teaches": metadata.keyConcepts?.join(", ") || conceptTitle || "",
  "audience": { "@type": "Audience", "audienceType": metadata.targetAudience || "Students" },
  "datePublished": metadata.datePublished,
  "inLanguage": "en",
  "author": { "@type": "Organization", "name": "BitsNotes" },
  "publisher": { "@type": "Organization", "name": "BitsNotes" }
};

const quizSchema = metadata.quiz && metadata.quiz.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "Quiz",
  "name": `${cleanLectureName} Practice Quiz`,
  "description": `Interactive practice quiz covering ${cleanLectureName} concepts.`,
  "about": { "@type": "Thing", "name": cleanLectureName },
  "hasPart": (metadata.quiz as QuizQuestion[]).map((q: QuizQuestion, idx: number) => ({
    "@type": "Question",
    "name": `Question ${idx + 1}`,
    "text": q.question,
    "suggestedAnswer": q.options.map((o: string, oi: number) => ({ "@type": "Answer", "text": o, "position": oi + 1 })),
    "acceptedAnswer": { "@type": "Answer", "text": q.options[q.answerIndex] }
  }))
} : null;

const learningResourceJson = JSON.stringify(learningResourceSchema);
const quizJson = quizSchema ? JSON.stringify(quizSchema) : null;
---

<BaseLayout
  title={pageSeoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogType="article"
  robots="index, follow"
>
  <Fragment slot="head">

    <script type="application/ld+json" set:html={learningResourceJson} />
    {quizJson && <script type="application/ld+json" set:html={quizJson} />}
    <script defer src="/auth-features.js"></script>
  </Fragment>

  <div class="flex-grow w-full flex flex-col bg-[var(--bg)]">
    {errorMsg && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
        <div class="border-l-3 border-[var(--callout-warning-border)] bg-[var(--callout-warning-bg)] rounded-r-[var(--r-sm)] p-4 text-sm text-[var(--callout-warning-text)]">
          <h3 class="font-bold">Error Loading Lecture Notes</h3>
          <p class="mt-1">{errorMsg}</p>
        </div>
      </div>
    )}

    {hasHtmlContent && (
      <div class="max-w-[1700px] mx-auto w-full px-4 sm:px-6 lg:px-8 py-6 flex-grow relative">
        <div class="flex gap-0 lg:gap-8 items-start">
          <!-- Mobile toggles -->
          <button id="sidebar-toggle" aria-label="Toggle lecture list">
            <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
          <div id="sidebar-overlay" class="fixed inset-0 z-40 bg-[var(--scrim)] hidden lg:hidden"></div>

          {showRightSidebar && (
            <>
              <button id="topic-sidebar-toggle" aria-label="Toggle topic list">
                <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                  <path d="M4 6h16M4 12h12M4 18h16" />
                </svg>
              </button>
              <div id="topic-sidebar-overlay" class="fixed inset-0 z-40 bg-[var(--scrim)] hidden lg:hidden"></div>
            </>
          )}

          <!-- ========== LEFT SIDEBAR ========== -->
          <aside id="lecture-sidebar" class="lecture-sidebar w-[260px] shrink-0 sticky top-20 max-h-[calc(100vh-100px)] overflow-y-auto lg:block" style="scrollbar-width:thin">
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-[var(--border)]">
              <div class="sidebar-header-text">
                <span class="text-[10px] text-[var(--text-faint)] uppercase tracking-wider font-medium">Subject</span>
                <h2 class="font-display text-base font-bold text-[var(--text)] mt-0.5">{subjectName}</h2>
              </div>
              <button id="lecture-sidebar-collapse-btn" class="hidden lg:flex items-center justify-center p-1.5 rounded hover:bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[var(--text)]" aria-label="Collapse sidebar">
                <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M15 19l-7-7 7-7" />
                </svg>
              </button>
            </div>
            <nav class="flex flex-col gap-0.5">
              {(() => {
                const lectureItems = lectures.filter((l) => l.scope === 'lecture' || l.resourceKind === 'lecture');
                const resourceItems = lectures.filter((l) => l.scope !== 'lecture' && l.resourceKind !== 'lecture');
                const renderItem = (lec: typeof lectures[number]) => {
                  const active = lec.folderName === lectureFolderName;
                  const url = active ? '#' : `/view/${encodeURIComponent(slugify(subjectName))}/${encodeURIComponent(lec.slug)}`;
                  const numLabel = lec.lectureNumber != null
                    ? (lec.lectureNumberEnd != null
                        ? `${lec.lectureNumber.toString().padStart(2, '0')}–${lec.lectureNumberEnd.toString().padStart(2, '0')}`
                        : lec.lectureNumber.toString().padStart(2, '0'))
                    : '';
                  const label = lec.displayTitle || lec.name;
                  return (
                    <a href={url}
                      data-astro-prefetch
                      title={label}
                      class={`flex items-center gap-2.5 px-3 py-2 rounded-[var(--r-sm)] text-sm transition-colors no-underline
                        ${active ? 'bg-[var(--accent-subtle)] text-[var(--accent)] font-semibold border-l-[3px] border-[var(--accent)]' : 'text-[var(--text-muted)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text)] border-l-[3px] border-transparent'}`}>
                      {numLabel ? (
                        <span class={`w-5 h-5 rounded-[4px] flex items-center justify-center text-[10px] font-bold shrink-0 ${active ? 'bg-[var(--accent)] text-[var(--accent-contrast)]' : 'bg-[var(--bg-subtle)] text-[var(--text-muted)]'}`}>
                          {numLabel}
                        </span>
                      ) : (
                        <span class="w-5 shrink-0"></span>
                      )}
                      <span class="line-clamp-2 leading-snug flex-1">{label}</span>
                    </a>
                  );
                };
                return (
                  <Fragment>
                    <span class="px-3 pt-1 pb-1.5 text-[10px] text-[var(--text-faint)] uppercase tracking-wider font-medium">Lectures</span>
                    {lectureItems.map(renderItem)}
                    {resourceItems.length > 0 && (
                      <span class="px-3 pt-3 pb-1.5 text-[10px] text-[var(--text-faint)] uppercase tracking-wider font-medium">Revision resources</span>
                    )}
                    {resourceItems.map(renderItem)}
                  </Fragment>
                );
              })()}
            </nav>
          </aside>

          <!-- ========== CENTER CONTENT ========== -->
          <div class="flex-1 min-w-0 flex flex-col max-w-[900px] w-full mx-auto">
            <!-- Pomodoro timer (toggle + status) -->
            <PomodoroTimer />

            <!-- Underline tabs -->
            <nav class="flex gap-0 justify-center border-b border-[var(--border)] mb-3 overflow-x-auto overflow-y-hidden -mx-4 sm:mx-0 px-4 sm:px-0" role="tablist" aria-label="Lecture viewer tabs">
              {[
                { id: 'notes', label: isResource ? `${resourceKindLabel}` : 'Lecture Notes' },
                { id: 'guide', label: 'Study Guide' },
                ...(showRevisionTab ? [{ id: 'revision', label: 'Exam Revision' }] : []),
                ...(showQuizTab ? [{ id: 'quiz', label: 'Practice Quiz' }] : []),
              ].map((tab, i) => (
                <button
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  data-tab={tab.id}
                  class={`shrink-0 px-4 py-2.5 text-sm font-medium whitespace-nowrap border-b-2 transition-colors -mb-[1px]
                    ${i === 0 ? 'text-[var(--accent)] border-[var(--accent)]' : 'text-[var(--text-muted)] border-transparent hover:text-[var(--text)] hover:border-[var(--border-strong)]'}`}
                >
                  {tab.label}
                </button>
              ))}
            </nav>

            <!-- Page view counter for this lecture -->
            <div class="flex justify-end mb-2 mt-1">
              <ViewCounter pageKey={`lecture:${subjectName}:${lectureFolderName}`} class="text-xs text-[var(--text-faint)]" />
            </div>

            <!-- Toolbar row: bookmark + notes toggle (always in DOM, shown by JS when logged in) -->
            <div id="bn-toolbar-row" class="hidden flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <button type="button" id="bn-bookmark-toggle"
                  class="hidden items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
                  data-subject={subjectName}
                  data-lecture={lectureFolderName}
                  data-display-name={displayResourceTitle}
                  data-bookmarked="false"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg class="w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <span>Save</span>
                </button>
              </div>
            </div>

            <!-- Tab panels -->
            <!-- Notes panel -->
            <div class="tab-panel active" id="panel-notes" role="tabpanel" aria-labelledby="tab-notes">
              {inlineStyles && <style set:html={inlineStyles} />}
              <div class="lecture-notes-wrapper" id="lecture-content" data-subject={subjectName} data-lecture={lectureFolderName}>

                <div class="container">
                  <main id="topic-content">
                    {topics.map((t) => (
                      <section id={t.slug} class="lecture-section mb-12 scroll-mt-24">
                        <Fragment set:html={t.html} />
                      </section>
                    ))}
                  </main>
                </div>

              </div>
              {hasMermaid && (
                <>
                  <script is:inline src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
                  <script is:inline data-astro-rerun>
                    if (window.mermaid) { window.mermaid.initialize({ startOnLoad: true, theme: 'neutral' }); }
                  </script>
                </>
              )}
              {jsContent && (
                <script is:inline data-astro-rerun set:html={jsContent}></script>
              )}
            </div>

            <!-- Study Guide panel -->
            <div class="tab-panel study-guide-panel" id="panel-guide" role="tabpanel" aria-labelledby="tab-guide">
              <div class="guide-header">
                <h2>{displayResourceTitle}</h2>
                <div class="guide-meta">
                  <span>{subjectName}</span>
                  {metadata.gradeLevel && <span>&middot; {metadata.gradeLevel}</span>}
                  {metadata.datePublished && <span>&middot; {metadata.datePublished}</span>}
                </div>
              </div>

              {metadata.summary && (
                <div class="guide-summary"><h3>Summary</h3><p>{metadata.summary}</p></div>
              )}

              {metadata.keyConcepts && metadata.keyConcepts.length > 0 && (
                <div class="objectives">
                  <h3>Learning Objectives</h3>
                  {metadata.keyConcepts.map((concept: string, idx: number) => (
                    <div class="objective-item">
                      <span class="objective-marker">{idx + 1}</span>
                      <span class="objective-text">{concept}</span>
                    </div>
                  ))}
                </div>
              )}

              {metadata.sections && metadata.sections.length > 0 && (
                <div class="sections-breakdown">
                  <h3>Sections Breakdown</h3>
                  {metadata.sections.map((section: any, idx: number) => (
                    <div class="section-card">
                      <div class="section-card-header">
                        <span class="section-card-number">{idx + 1}</span>
                        <span class="section-card-title">{section.title}</span>
                      </div>
                      {section.pages && <span class="section-card-pages">{section.pages}</span>}
                      {section.description && <p class="section-card-desc">{section.description}</p>}
                    </div>
                  ))}
                </div>
              )}

              {metadata.targetAudience && (
                <div class="audience-badge">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                  {metadata.targetAudience}
                </div>
              )}
            </div>

            <!-- Exam Revision panel -->
            {showRevisionTab && (
              <div class="tab-panel revision-panel" id="panel-revision" role="tabpanel" aria-labelledby="tab-revision">
                {hasRevisionSection ? (
                  <Fragment set:html={revisionSectionContent} />
                ) : (
                  <>
                    <div class="guide-header">
                      <h2>Exam Revision Notes</h2>
                      <div class="guide-meta">
                        <span>Key Topics</span><span>&middot; Must Knows</span><span>&middot; Formulas</span><span>&middot; Quick Checks</span>
                      </div>
                    </div>
                    <div class="flex flex-col gap-6">
                      {metadata.examRevisionNotes?.map((item: any, idx: number) => (
                        <div class="section-card">
                          <div class="flex items-center gap-3.5 mb-4 pb-3 border-b border-[var(--border)]">
                            <span class="section-card-number">{idx + 1}</span>
                            <span class="section-card-title text-lg">{item.topic}</span>
                          </div>
                          <div class="flex flex-col gap-4">
                            {item.mustKnow && (
                              <div class="revision-mustknow"><strong>Must Know</strong><p>{item.mustKnow}</p></div>
                            )}
                            {item.keyFormula && (
                              <div class="revision-formula">
                                <strong class="text-[0.7rem] font-bold text-[var(--accent)] uppercase tracking-wider block mb-2">Key Formula</strong>
                                <div>{(item.keyFormula.startsWith('\\[') || item.keyFormula.startsWith('$$') || item.keyFormula.startsWith('\\(')) ? item.keyFormula : `\\[ ${item.keyFormula} \\]`}</div>
                              </div>
                            )}
                            {item.commonPitfall && (
                              <div class="revision-pitfall"><strong>Common Pitfall</strong><p>{item.commonPitfall}</p></div>
                            )}
                            {item.quickCheck && (
                              <div class="revision-check"><strong>Quick Check</strong><p>{item.quickCheck}</p></div>
                            )}
                            {item.connections && item.connections.length > 0 && (
                              <div class="revision-connections"><strong>Connections:</strong>
                                {item.connections.map((conn: string) => (
                                  <span class="px-2.5 py-1 bg-[var(--accent-subtle)] rounded-[var(--r-sm)] text-xs font-semibold text-[var(--accent)]">{conn}</span>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </>
                )}
              </div>
            )}

            <!-- Quiz panel -->
            {showQuizTab && (
              <div class="tab-panel quiz-panel" id="panel-quiz" role="tabpanel" aria-labelledby="tab-quiz">
                {hasQuizSection ? (
                  <Fragment set:html={quizSectionContent} />
                ) : (
                  <>
                    <div class="quiz-header">
                      <h2>Practice Quiz</h2>
                      <p>Test your understanding of {lectureName}. Select an answer for each question — results are instant.</p>
                    </div>
                    <div class="quiz-grid" id="quiz-grid">
                      {metadata.quiz.map((q: any, qIdx: number) => (
                        <div class="quiz-card" data-correct-index={q.answerIndex} id={`quiz-card-${qIdx}`}>
                          <div class="quiz-card-header">
                            <span class="quiz-card-number">{qIdx + 1}</span>
                            <p class="quiz-question">{q.question}</p>
                          </div>
                          <div class="quiz-options">
                            {q.options.map((opt: string, optIdx: number) => (
                              <button class="quiz-option" onclick={`window.checkQuizAnswer(this, ${optIdx}, ${qIdx})`}>{opt}</button>
                            ))}
                          </div>
                          <div class="quiz-explanation hidden"><strong>Explanation:</strong> {q.explanation}</div>
                        </div>
                      ))}
                    </div>
                    <div class="quiz-score hidden" id="quiz-score">
                      <h3 id="quiz-score-text">0 / {metadata.quiz.length}</h3>
                      <p id="quiz-score-label">Keep going! Review the questions you missed.</p>
                      <div class="progress-bar"><div class="progress-fill" id="quiz-progress-fill" style="width:0%"></div></div>
                      <button class="quiz-retry" onclick="window.resetQuiz()">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
                        Try Again
                      </button>
                    </div>
                  </>
                )}
              </div>
            )}

            <!-- Prev / Next navigation -->
            <div class="flex gap-3 mt-8 pt-6 border-t border-[var(--border)]">
              {prevUrl ? (
                <a href={prevUrl} data-astro-prefetch class="flex-1 flex items-center gap-3 px-4 py-3.5 bg-[var(--bg-elevated)] border border-[var(--border)] border-l-4 border-l-[var(--accent)] rounded-[var(--r-md)] shadow-sm hover:shadow-md hover:bg-[var(--bg-subtle)] hover:border-[var(--accent)] hover:border-l-[var(--accent)] transition no-underline group">
                  <svg class="w-4 h-4 text-[var(--text-muted)] shrink-0 transition duration-200 group-hover:-translate-x-1 group-hover:text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M15 19l-7-7 7-7"/>
                  </svg>
                  <div class="min-w-0">
                    <span class="block text-[10px] text-[var(--text-muted)] uppercase tracking-widest font-bold">Previous Lecture</span>
                    <span class="block text-sm font-semibold text-[var(--text)] line-clamp-1 group-hover:text-[var(--accent)] transition-colors">{prevLabel}</span>
                  </div>
                </a>
              ) : <div class="flex-1"></div>}
              {nextUrl ? (
                <a href={nextUrl} data-astro-prefetch class="flex-1 flex items-center justify-end gap-3 px-4 py-3.5 bg-[var(--bg-elevated)] border border-[var(--border)] border-r-4 border-r-[var(--accent)] rounded-[var(--r-md)] shadow-sm hover:shadow-md hover:bg-[var(--bg-subtle)] hover:border-[var(--accent)] hover:border-r-[var(--accent)] transition no-underline group text-right">
                  <div class="min-w-0">
                    <span class="block text-[10px] text-[var(--text-muted)] uppercase tracking-widest font-bold">Next Lecture</span>
                    <span class="block text-sm font-semibold text-[var(--text)] line-clamp-1 group-hover:text-[var(--accent)] transition-colors">{nextLabel}</span>
                  </div>
                  <svg class="w-4 h-4 text-[var(--text-muted)] shrink-0 transition duration-200 group-hover:translate-x-1 group-hover:text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ) : <div class="flex-1"></div>}
            </div>

            <!-- "Was this useful?" feedback (after prev/next, before comments) -->
            {hasHtmlContent && (
              <UsefulnessFeedback pageType="lecture" subject={subjectName} lecture={lectureFolderName} />
            )}

            <!-- Anonymous comments (lazy-loaded, below prev/next) -->
            {hasHtmlContent && (
              <CommentsSection pageType="lecture" subject={subjectName} lecture={lectureFolderName} />
            )}
          </div>

          <!-- ========== RIGHT SIDEBAR (TOC) ========== -->
          {showRightSidebar && (
            <aside id="topic-sidebar" class="topic-sidebar w-[300px] shrink-0 sticky top-28 max-h-[calc(100vh-130px)] overflow-y-auto lg:block collapsed" style="scrollbar-width:thin">
              <div class="flex items-center justify-between pb-4 mb-4 border-b border-[var(--border)]">
                <div class="sidebar-header-text">
                  <span class="text-[10px] text-[var(--text-faint)] uppercase tracking-wider font-medium">TOC</span>
                  <h2 class="font-display text-base font-bold text-[var(--text)] mt-0.5">Topics</h2>
                </div>
                <button id="topic-sidebar-collapse-btn" class="hidden lg:flex items-center justify-center p-1.5 rounded hover:bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[var(--text)]" aria-label="Collapse topics">
                  <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
              <nav class="flex flex-col gap-0.5" id="topic-list-nav">
                {topics.map((t) => (
                  <div class="topic-item-container" data-topic-id={t.id}>
                    <a href={`#${t.slug}`}
                       class="topic-nav-link flex items-center gap-2.5 px-3 py-2 rounded-[var(--r-sm)] text-[13px] transition-colors no-underline text-[var(--text-muted)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text)]"
                       data-topic-id={t.id}
                       title={t.title}
                    >
                      {((t.id === 'overview' || t.id === 'full' || /^\d+(\.\d+)?$/.test(t.id)) ? (
                        <span class="topic-badge w-7 h-5 rounded-[4px] flex items-center justify-center text-[10px] font-bold bg-[var(--bg-subtle)] text-[var(--text-muted)] shrink-0">
                          {t.id === 'overview' ? 'Intro' : t.id === 'full' ? 'Notes' : t.id}
                        </span>
                      ) : (
                        <span class="w-7 shrink-0"></span>
                      ))}
                      <span class="topic-title-text line-clamp-2 leading-snug flex-1">{t.title}</span>
                    </a>
                    
                    {t.subtopics.length > 0 && (
                      <ul class="topic-subtopics-list pl-8 pr-3 py-1 flex flex-col gap-0.5 list-none">
                        {t.subtopics.map((st) => (
                          <li>
                            <a
                              href={`#${st.slug}`}
                              class="topic-nav-link topic-subtopic-link flex items-center px-3 py-1 rounded-[var(--r-sm)] text-xs text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors no-underline line-clamp-2 leading-snug border-l-2 border-transparent bg-transparent"
                              data-topic-id={t.id}
                              data-subtopic-slug={st.slug}
                              title={st.title}
                            >
                              <span class="line-clamp-2 flex-1">{st.title}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </nav>
            </aside>
          )}

        </div>
      </div>
    )}

    {/* Floating Comments FAB */}
    {hasHtmlContent && (
      <button id="floating-comments-btn" aria-label="Scroll to comments" title="Comments">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
        </svg>
      </button>
    )}
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  // ===================== TAB SWITCHING (delegated + page-load safe) =====================
  var mathjaxLoaded = false;

  function loadMathJax(cb) {
    if (window.MathJax && window.MathJax.typesetPromise) { if (cb) cb(); return; }
    if (document.getElementById('MathJax-script')) {
      var id = setInterval(function() {
        if (window.MathJax && window.MathJax.typesetPromise) { clearInterval(id); if (cb) cb(); }
      }, 100);
      return;
    }
    window.MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
      },
      startup: {
        typeset: false
      }
    };
    var s = document.createElement('script');
    s.id = 'MathJax-script';
    s.async = true;
    s.src = 'https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-svg.js';
    if (cb) s.onload = cb;
    document.head.appendChild(s);
  }

  function initTabs() {
    var tabNav = document.querySelector('[role="tablist"]');
    if (!tabNav || tabNav.dataset.tabsInited) return;
    tabNav.dataset.tabsInited = 'true';

    tabNav.addEventListener('click', function(e) {
      var btn = e.target.closest('[role="tab"][data-tab]');
      if (!btn) return;
      var tabId = btn.getAttribute('data-tab');

      // Update tab styling
      tabNav.querySelectorAll('[role="tab"][data-tab]').forEach(function(t) {
        t.classList.remove('text-[var(--accent)]', 'border-[var(--accent)]');
        t.classList.add('text-[var(--text-muted)]', 'border-transparent');
        t.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('text-[var(--accent)]', 'border-[var(--accent)]');
      btn.classList.remove('text-[var(--text-muted)]', 'border-transparent');
      btn.setAttribute('aria-selected', 'true');

      // Show the target panel, hide others
      var panelIds = ['panel-notes', 'panel-guide', 'panel-revision', 'panel-quiz'];
      panelIds.forEach(function(id) {
        var p = document.getElementById(id);
        if (p) p.classList.remove('active');
      });
      var panel = document.getElementById('panel-' + tabId);
      if (panel) {
        panel.classList.add('active');
        typesetNotes(panel);
      }
    });

    // Auto-load MathJax if Notes tab is already active on page load
    var notesPanel = document.getElementById('panel-notes');
    if (notesPanel && notesPanel.classList.contains('active')) {
      typesetNotes(notesPanel);
    }
  }

  // Detect whether a panel actually contains math that needs typesetting.
  // This lets us skip the (heavy) MathJax download entirely for plain lectures.
  function panelHasMath(panel) {
    if (!panel) return false;
    if (panel.querySelector('.mjx-container')) return true;
    // Inline/display TeX delimiters used by the notes pipeline.
    return /\\\(|\\\[|\$\$|\$[^$]+\$/.test(panel.textContent || '');
  }

  function typesetNotes(panel) {
    var targets = [panel];
    var sidebar = document.getElementById('topic-sidebar');
    if (sidebar) {
      targets.push(sidebar);
    }

    var targetsToTypeset = targets.filter(function(el) {
      return panelHasMath(el);
    });

    if (targetsToTypeset.length === 0) return;

    if (!mathjaxLoaded) {
      mathjaxLoaded = true;
      loadMathJax(function() {
        if (window.MathJax && window.MathJax.typesetPromise) {
          window.MathJax.typesetPromise(targetsToTypeset).catch(function() {});
        }
      });
    } else if (window.MathJax && window.MathJax.typesetPromise) {
      window.MathJax.typesetPromise(targetsToTypeset).catch(function() {});
    }
  }

  // ===================== SCROLL-SPY TOC =====================
  function initScrollSpy() {
    var topicLinks = document.querySelectorAll('#topic-list-nav .topic-nav-link:not(.topic-subtopic-link)');
    var subtopicLinks = document.querySelectorAll('#topic-list-nav .topic-subtopic-link');
    var spyTargets = document.querySelectorAll('.lecture-section, .lecture-section h3[id]');
    if (!spyTargets.length) return;

    function spy() {
      var notesPanel = document.getElementById('panel-notes');
      if (!notesPanel || !notesPanel.classList.contains('active')) return;

      var scrollPos = window.scrollY || document.documentElement.scrollTop;
      var buffer = 150; // offset buffer
      var currentTarget = null;

      for (var i = 0; i < spyTargets.length; i++) {
        var el = spyTargets[i];
        if (el.offsetTop - buffer <= scrollPos) {
          currentTarget = el;
        } else {
          break;
        }
      }

      if (!currentTarget && spyTargets.length > 0) {
        currentTarget = spyTargets[0];
      }

      if (currentTarget) {
        var activeSection = currentTarget.classList.contains('lecture-section')
          ? currentTarget
          : currentTarget.closest('.lecture-section');
        var activeSectionId = activeSection ? activeSection.getAttribute('id') : null;
        var activeSubtopicId = currentTarget.tagName === 'H3' ? currentTarget.getAttribute('id') : null;

        topicLinks.forEach(function(link) {
          var href = link.getAttribute('href');
          if (activeSectionId && href === '#' + activeSectionId) {
            link.classList.add('bg-[var(--bg-subtle)]', 'text-[var(--text)]', 'font-semibold');
            link.classList.remove('text-[var(--text-muted)]');
            var badge = link.querySelector('.topic-badge');
            if (badge) {
              badge.classList.add('bg-[var(--accent)]', 'text-[var(--accent-contrast)]');
              badge.classList.remove('bg-[var(--bg-subtle)]', 'text-[var(--text-muted)]');
            }
          } else {
            link.classList.remove('bg-[var(--bg-subtle)]', 'text-[var(--text)]', 'font-semibold');
            link.classList.add('text-[var(--text-muted)]');
            var badge = link.querySelector('.topic-badge');
            if (badge) {
              badge.classList.remove('bg-[var(--accent)]', 'text-[var(--accent-contrast)]');
              badge.classList.add('bg-[var(--bg-subtle)]', 'text-[var(--text-muted)]');
            }
          }
        });

        subtopicLinks.forEach(function(link) {
          var href = link.getAttribute('href');
          if (activeSubtopicId && href === '#' + activeSubtopicId) {
            link.classList.add('text-[var(--accent)]', 'font-semibold', 'border-l-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            link.classList.remove('text-[var(--text-muted)]', 'font-normal', 'border-transparent', 'bg-transparent');
          } else {
            link.classList.remove('text-[var(--accent)]', 'font-semibold', 'border-l-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            link.classList.add('text-[var(--text-muted)]', 'font-normal', 'border-transparent', 'bg-transparent');
          }
        });
      }
    }

    window.addEventListener('scroll', spy, { passive: true });
    spy();

    document.addEventListener('astro:before-swap', function() {
      window.removeEventListener('scroll', spy);
    }, { once: true });
  }

  function initTopicNavLinks() {
    var nav = document.getElementById('topic-list-nav');
    if (!nav) return;
    nav.addEventListener('click', function(e) {
      var link = e.target.closest('.topic-nav-link');
      if (!link) return;

      e.preventDefault();
      var targetId = link.getAttribute('href');
      var targetEl = document.getElementById(targetId.substring(1));
      if (!targetEl) return;

      var notesTab = document.querySelector('[role="tab"][data-tab="notes"]');
      if (notesTab && notesTab.getAttribute('aria-selected') !== 'true') {
        notesTab.click();
      }

      targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // Close mobile drawer if open
      var topicSidebar = document.getElementById('topic-sidebar');
      var topicOverlay = document.getElementById('topic-sidebar-overlay');
      if (topicSidebar && topicSidebar.classList.contains('open')) {
        topicSidebar.classList.remove('open');
        if (topicOverlay) topicOverlay.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }
    });
  }

  // ===================== FLOATING COMMENTS FAB =====================
  function initCommentsBtn() {
    var btn = document.getElementById('floating-comments-btn');
    if (!btn) return;
    btn.addEventListener('click', function() {
      var commentsEl = document.querySelector('.bn-comments');
      if (commentsEl) {
        commentsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  // ===================== DUAL MOBILE DRAWERS =====================
  function initMobileDrawers() {
    var lectureToggle = document.getElementById('sidebar-toggle');
    var lectureSidebar = document.getElementById('lecture-sidebar');
    var lectureOverlay = document.getElementById('sidebar-overlay');

    var topicToggle = document.getElementById('topic-sidebar-toggle');
    var topicSidebar = document.getElementById('topic-sidebar');
    var topicOverlay = document.getElementById('topic-sidebar-overlay');

    if (!lectureToggle || !lectureSidebar || !lectureOverlay) return;

    function closeAllDrawers() {
      lectureSidebar.classList.remove('open');
      lectureOverlay.classList.add('hidden');
      if (topicSidebar && topicOverlay) {
        topicSidebar.classList.remove('open');
        topicOverlay.classList.add('hidden');
      }
      document.body.classList.remove('overflow-hidden');
    }

    function toggleLectureSidebar() {
      if (window.innerWidth < 1024) {
        if (topicSidebar && topicSidebar.classList.contains('open')) {
          topicSidebar.classList.remove('open');
          topicOverlay.classList.add('hidden');
        }
        var isOpen = lectureSidebar.classList.toggle('open');
        lectureOverlay.classList.toggle('hidden', !isOpen);
        document.body.classList.toggle('overflow-hidden', isOpen);
      }
    }

    function toggleTopicSidebar() {
      if (window.innerWidth < 1024 && topicSidebar && topicOverlay) {
        if (lectureSidebar.classList.contains('open')) {
          lectureSidebar.classList.remove('open');
          lectureOverlay.classList.add('hidden');
        }
        var isOpen = topicSidebar.classList.toggle('open');
        topicOverlay.classList.toggle('hidden', !isOpen);
        document.body.classList.toggle('overflow-hidden', isOpen);
      }
    }

    lectureToggle.addEventListener('click', toggleLectureSidebar);
    lectureOverlay.addEventListener('click', closeAllDrawers);

    if (topicToggle && topicSidebar && topicOverlay) {
      topicToggle.addEventListener('click', toggleTopicSidebar);
      topicOverlay.addEventListener('click', closeAllDrawers);
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeAllDrawers();
      }
    });
  }

  // ===================== DESKTOP COLLAPSE CONTROL =====================
  function initSidebarCollapse() {
    var leftBtn = document.getElementById('lecture-sidebar-collapse-btn');
    var leftSidebar = document.getElementById('lecture-sidebar');
    if (leftBtn && leftSidebar) {
      // Default to maximized (expanded); only collapse if explicitly stored 'true'.
      var leftStored = localStorage.getItem('bitsnotes-left-sidebar-collapsed');
      var isCollapsed = leftStored === 'true';
      if (isCollapsed) {
        leftSidebar.classList.add('collapsed');
      }
      leftBtn.addEventListener('click', function() {
        var collapsed = leftSidebar.classList.toggle('collapsed');
        localStorage.setItem('bitsnotes-left-sidebar-collapsed', collapsed ? 'true' : 'false');
      });
    }

    var rightBtn = document.getElementById('topic-sidebar-collapse-btn');
    var rightSidebar = document.getElementById('topic-sidebar');
    if (rightBtn && rightSidebar) {
      // Default to collapsed (minimized); only expand if explicitly stored 'false'.
      var rightStored = localStorage.getItem('bitsnotes-right-sidebar-collapsed');
      var isCollapsed = rightStored !== 'false';
      if (isCollapsed) {
        rightSidebar.classList.add('collapsed');
      } else {
        rightSidebar.classList.remove('collapsed');
      }
      rightBtn.addEventListener('click', function() {
        var collapsed = rightSidebar.classList.toggle('collapsed');
        localStorage.setItem('bitsnotes-right-sidebar-collapsed', collapsed ? 'true' : 'false');
      });
    }
  }

  // ===================== CODE COPY BUTTONS =====================
  function initCodeCopy() {
    var panel = document.getElementById('topic-content');
    if (!panel) return;
    panel.querySelectorAll('pre:not([data-copy-inited])').forEach(function(p) {
      if (p.querySelector('.copy-btn') || p.parentElement.classList.contains('code-block-wrapper')) return;
      p.setAttribute('data-copy-inited', 'true');
      var b = document.createElement('button');
      b.className = 'copy-btn';
      b.setAttribute('aria-label', 'Copy code');
      b.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
      var d = document.createElement('div');
      d.className = 'code-block-wrapper';
      p.parentNode.insertBefore(d, p);
      d.appendChild(p);
      d.appendChild(b);
      b.addEventListener('click', async function() {
        var code = p.querySelector('code') || p;
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          b.classList.add('copied');
          b.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>';
          setTimeout(function() {
            b.classList.remove('copied');
            b.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
          }, 2000);
        } catch (_) {}
      });
    });
  }

  // Run initializers on load / view transitions
  initTabs();
  initMobileDrawers();
  initSidebarCollapse();
  initTopicNavLinks();
  initScrollSpy();
  initCommentsBtn();
  initCodeCopy();
</script>

<script is:inline data-astro-rerun>
  // ===================== QUIZ =====================
  window.quizState = { answered: 0, correct: 0, total: 0 };

  window.checkQuizAnswer = function(_button, optionIndex, questionIndex) {
    var card = document.getElementById('quiz-card-' + questionIndex);
    if (!card || card.dataset.answered === 'true') return;
    card.dataset.answered = 'true';
    var correctIndex = parseInt(card.getAttribute('data-correct-index'));
    var options = card.querySelectorAll('.quiz-option');
    var isCorrect = optionIndex === correctIndex;
    options.forEach(function(opt, idx) {
      opt.disabled = true;
      if (idx === correctIndex) opt.classList.add('correct');
      else if (idx === optionIndex) opt.classList.add('incorrect');
    });
    var explanation = card.querySelector('.quiz-explanation');
    if (explanation) { explanation.classList.remove('hidden'); explanation.classList.add('fade-in'); }

    var totalCards = document.querySelectorAll('#quiz-grid .quiz-card').length;
    window.quizState.total = totalCards;
    window.quizState.answered = document.querySelectorAll('#quiz-grid .quiz-card[data-answered="true"]').length;
    if (isCorrect) window.quizState.correct++;
    if (window.quizState.answered >= window.quizState.total) window.showQuizScore();
  };

  window.showQuizScore = function() {
    var scoreEl = document.getElementById('quiz-score');
    var textEl = document.getElementById('quiz-score-text');
    var labelEl = document.getElementById('quiz-score-label');
    var fillEl = document.getElementById('quiz-progress-fill');
    if (!scoreEl) return;
    scoreEl.classList.remove('hidden');
    var pct = window.quizState.total > 0 ? Math.round((window.quizState.correct / window.quizState.total) * 100) : 0;
    textEl.textContent = window.quizState.correct + ' / ' + window.quizState.total;
    fillEl.style.width = pct + '%';
    if (pct === 100) labelEl.textContent = 'Perfect score! You mastered this material.';
    else if (pct >= 70) labelEl.textContent = 'Great job! Review the explanations for questions you missed.';
    else labelEl.textContent = 'Keep going! Review the lecture notes and try again.';
  };

  window.resetQuiz = function() {
    document.querySelectorAll('#quiz-grid .quiz-card').forEach(function(card) {
      card.dataset.answered = 'false';
      card.querySelectorAll('.quiz-option').forEach(function(opt) {
        opt.disabled = false;
        opt.classList.remove('correct', 'incorrect');
      });
      var expl = card.querySelector('.quiz-explanation');
      if (expl) { expl.classList.add('hidden'); expl.classList.remove('fade-in'); }
    });
    var scoreEl = document.getElementById('quiz-score');
    if (scoreEl) scoreEl.classList.add('hidden');
    window.quizState = { answered: 0, correct: 0, total: 0 };
  };

  // Legacy inline quiz handler
  window.checkAnswer = function(button, optionIndex) {
    var card = button.closest('.quiz-card');
    if (!card || card.dataset.answered === 'true') return;
    card.dataset.answered = 'true';
    var correctIndex = parseInt(card.getAttribute('data-correct-index') || card.dataset.correctIndex);
    var options = card.querySelectorAll('.quiz-option');
    options.forEach(function(opt, idx) {
      opt.disabled = true;
      if (idx === correctIndex) opt.classList.add('correct');
      else if (idx === optionIndex) opt.classList.add('incorrect');
    });
    var explanation = card.querySelector('.quiz-explanation');
    if (explanation) { explanation.classList.remove('hidden'); explanation.classList.add('fade-in'); }
  };
</script>

<script is:inline data-astro-rerun>
  // ===================== AUTH FEATURES (bookmarks, progress) ================
  (function () {
    function init() {
      var BN = window.BitsNotes;
      if (!BN) return;

      var subject = (document.getElementById('lecture-content') || {}).dataset
        ? document.getElementById('lecture-content').dataset.subject : null;
      var lecture = (document.getElementById('lecture-content') || {}).dataset
        ? document.getElementById('lecture-content').dataset.lecture : null;
      var bootstrapUrl = '/api/user/bootstrap' + (subject ? ('?subject=' + encodeURIComponent(subject) + (lecture ? '&lecture=' + encodeURIComponent(lecture) : '')) : '');
      
      var cacheKey = '__bnBootstrapPromise_' + subject + '_' + lecture;
      if (!window[cacheKey]) {
        window[cacheKey] = new Promise(function (resolve) {
          var load = function () {
            fetch(bootstrapUrl, { credentials: 'same-origin' })
              .then(function (r) {
                if (r.status === 401) return null;
                return r.json().then(function (data) {
                  return (data && data.loggedIn !== false) ? data : null;
                });
              })
              .then(resolve)
              .catch(function () { resolve(null); });
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(function () { load(); });
          } else {
            setTimeout(load, 1);
          }
        });
      }
      window[cacheKey].then(function (bootstrap) {
        if (!bootstrap) return;

        // Show bookmark button
        var bmBtn = document.getElementById('bn-bookmark-toggle');
        if (bmBtn) {
          bmBtn.classList.remove('hidden');
          var toolbarRow = document.getElementById('bn-toolbar-row');
          if (toolbarRow) toolbarRow.classList.remove('hidden');
        }

        // Check bookmark state from the consolidated bootstrap payload.
        if (bmBtn) {
          var bSubject = bmBtn.dataset.subject;
          var bLecture = bmBtn.dataset.lecture;
          var allBookmarks = Object.values(bootstrap.bookmarks.bookmarks || {}).flat();
          var isBm = allBookmarks.some(function (b) { return b.subject === bSubject && b.lecture === bLecture; });
          bmBtn.dataset.bookmarked = isBm ? 'true' : 'false';
          if (isBm) {
            bmBtn.classList.add('border-[var(--accent)]', 'bg-[var(--accent-subtle)]', 'text-[var(--accent)]');
            bmBtn.classList.remove('border-[var(--border)]', 'text-[var(--text-muted)]');
            bmBtn.querySelector('span:last-child').textContent = 'Saved';
          }

          bmBtn.addEventListener('click', function () {
            BN.toggleBookmark(bmBtn);
          });
        }

        // Setup reading progress
        var contentEl = document.getElementById('lecture-content');
        if (contentEl && contentEl.dataset.subject) {
          BN.setupProgress(contentEl.dataset.subject, contentEl.dataset.lecture);
        }
      });
    }

    function startInit() {
      if (window.BitsNotes) {
        init();
      } else {
        var retries = 0;
        var checkInterval = setInterval(function () {
          if (window.BitsNotes) {
            clearInterval(checkInterval);
            init();
          } else if (retries > 50) {
            clearInterval(checkInterval);
          }
          retries++;
        }, 50);
      }
    }

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      startInit();
    } else {
      document.addEventListener('DOMContentLoaded', startInit);
    }
  })();
</script>

{/*
  AdSense is deferred: the library is only fetched after the user has granted
  ad consent AND the page is idle / the ad area is near the viewport. This keeps
  the third-party script off the critical path (Phase 8.5). There is no ad slot
  rendered on this page yet, so this simply primes the library when allowed.
*/}
<script is:inline data-astro-rerun>
  (function () {
    function loadAds() {
      if (window.__bnAdsLoaded) return;
      window.__bnAdsLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2602136383267308';
      document.head.appendChild(s);
    }

    function consentAllowsAds() {
      try {
        var c = JSON.parse(localStorage.getItem('bitsnotes-cookie-consent') || '{}');
        return !!c.ads;
      } catch (e) { return false; }
    }

    if (!consentAllowsAds()) return;

    // Load on idle, or after a short delay if requestIdleCallback is missing.
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadAds, { timeout: 4000 });
    } else {
      setTimeout(loadAds, 3000);
    }
  })();
</script>
