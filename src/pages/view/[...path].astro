---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFallbackMetadata, type DocumentMetadata } from '../../utils/metadata';
import { listSubjects, listLectures, getLectureContent, type LectureSummary } from '../../utils/notesLoader';
import { parseLectureHtml } from '../../utils/htmlParser';

export function getStaticPaths() {
  const subjects = listSubjects();
  const paths: { params: { path: string } }[] = [];

  for (const subject of subjects) {
    const lectures = listLectures(subject.name);
    for (const lecture of lectures) {
      paths.push({
        params: { path: `${subject.name}/${lecture.folderName}` },
      });
    }
  }

  return paths;
}

// path is a slash-joined string: "SubjectName/LectureFolderName"
const { path } = Astro.params;
if (!path) {
  return Astro.redirect('/');
}

const segments = path.split('/').map(decodeURIComponent);
if (segments.length < 2) {
  return Astro.redirect('/');
}

const subjectName = segments[0];
const lectureFolderName = segments[1];

let errorMsg = '';
let customMetadata = null;
let htmlContent = '';
let hasHtmlContent = false;

// Read content from the git filesystem
const lectureContent = getLectureContent(subjectName, lectureFolderName);

if (lectureContent) {
  htmlContent = lectureContent.htmlContent;
  hasHtmlContent = true;
  customMetadata = lectureContent.metadata;
} else {
  errorMsg = `No notes found for "${subjectName}/${lectureFolderName}". Check that the HTML file exists in src/content/notes/.`;
}

// Extract body content, styles, and sections from the raw HTML
let bodyContent = '';
let hasRevisionSection = false;
let revisionSectionContent = '';
let hasQuizSection = false;
let quizSectionContent = '';

if (hasHtmlContent) {
  const parsed = parseLectureHtml(htmlContent);
  bodyContent = parsed.bodyContent;
  hasRevisionSection = parsed.hasRevisionSection;
  revisionSectionContent = parsed.revisionSectionContent;
  hasQuizSection = parsed.hasQuizSection;
  quizSectionContent = parsed.quizSectionContent;
}

// Get the display name for this lecture (from the actual HTML filename)
const lectureName = lectureContent?.fileName || lectureFolderName;

const metadata = (customMetadata || getFallbackMetadata(lectureFolderName, subjectName)) as DocumentMetadata;

const showRevisionTab = hasRevisionSection || !!(metadata.examRevisionNotes && metadata.examRevisionNotes.length > 0);
const showQuizTab = hasQuizSection || !!(metadata.quiz && metadata.quiz.length > 0);

// Fetch all subjects and lectures for navigation
const subjects = listSubjects();
const lectures = listLectures(subjectName);

// Previous and next lecture navigation logic
let prevUrl = '';
let prevLabel = '';
let nextUrl = '';
let nextLabel = '';

const currentLectureIndex = lectures.findIndex(l => l.folderName === lectureFolderName);
const currentSubjectIndex = subjects.findIndex(s => s.name === subjectName);

if (currentLectureIndex !== -1 && currentSubjectIndex !== -1) {
  // Previous lecture calculation
  if (currentLectureIndex > 0) {
    const prevLecture = lectures[currentLectureIndex - 1];
    prevUrl = `/view/${encodeURIComponent(subjectName)}/${encodeURIComponent(prevLecture.folderName)}`;
    prevLabel = prevLecture.name;
  } else {
    // Current is first lecture. Previous goes to last lecture of previous subject.
    const prevSubjectIndex = (currentSubjectIndex - 1 + subjects.length) % subjects.length;
    const prevSubject = subjects[prevSubjectIndex];
    const prevSubjectLectures = listLectures(prevSubject.name);
    if (prevSubjectLectures.length > 0) {
      const lastLecture = prevSubjectLectures[prevSubjectLectures.length - 1];
      prevUrl = `/view/${encodeURIComponent(prevSubject.name)}/${encodeURIComponent(lastLecture.folderName)}`;
      prevLabel = `${prevSubject.name} - ${lastLecture.name}`;
    }
  }

  // Next lecture calculation
  if (currentLectureIndex < lectures.length - 1) {
    const nextLecture = lectures[currentLectureIndex + 1];
    nextUrl = `/view/${encodeURIComponent(subjectName)}/${encodeURIComponent(nextLecture.folderName)}`;
    nextLabel = nextLecture.name;
  } else {
    // Current is last lecture. Next goes to first lecture of next subject.
    const nextSubjectIndex = (currentSubjectIndex + 1) % subjects.length;
    const nextSubject = subjects[nextSubjectIndex];
    const nextSubjectLectures = listLectures(nextSubject.name);
    if (nextSubjectLectures.length > 0) {
      const firstLecture = nextSubjectLectures[0];
      nextUrl = `/view/${encodeURIComponent(nextSubject.name)}/${encodeURIComponent(firstLecture.folderName)}`;
      nextLabel = `${nextSubject.name} - ${firstLecture.name}`;
    }
  }
}

// Setup dynamic keywords and descriptions
const seoDescription = metadata.summary
  ? (metadata.summary.length > 155 ? metadata.summary.slice(0, 152) + "..." : metadata.summary)
  : `Access study notes and resources for ${lectureName} in ${subjectName} on BitsNotes.`;

const seoKeywords = [
  metadata.title,
  subjectName,
  lectureName,
  "lecture notes",
  "study guide",
  "practice quiz",
  ...(metadata.keyConcepts || []).map(k => k.split(' ').slice(0, 3).join(' ').replace(/[^\w\s]/g, '')),
].filter(Boolean).join(", ");

// Generate JSON-LD Schema.org markup
const learningResourceSchema = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": `${lectureName} | ${subjectName} Lecture Notes`,
  "description": metadata.summary,
  "learningResourceType": "Lecture Notes",
  "educationalLevel": metadata.gradeLevel,
  "teaches": metadata.keyConcepts?.join(", ") || "",
  "audience": {
    "@type": "Audience",
    "audienceType": metadata.targetAudience
  },
  "datePublished": metadata.datePublished,
  "inLanguage": "en",
  "author": {
    "@type": "Organization",
    "name": "BitsNotes"
  },
  "publisher": {
    "@type": "Organization",
    "name": "BitsNotes"
  }
};

const quizSchema = metadata.quiz && metadata.quiz.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "Quiz",
  "name": `${lectureName} Practice Quiz`,
  "description": `Interactive practice quiz covering ${lectureName} concepts.`,
  "about": {
    "@type": "Thing",
    "name": lectureName
  },
  "hasPart": metadata.quiz.map((q, index) => ({
    "@type": "Question",
    "name": `Question ${index + 1}`,
    "text": q.question,
    "suggestedAnswer": q.options.map((opt, optIndex) => ({
      "@type": "Answer",
      "text": opt,
      "position": optIndex + 1
    })),
    "acceptedAnswer": {
      "@type": "Answer",
      "text": q.options[q.answerIndex]
    }
  }))
} : null;

const learningResourceJson = JSON.stringify(learningResourceSchema);
const quizJson = quizSchema ? JSON.stringify(quizSchema) : null;
---

<BaseLayout
  title={`${lectureName} | ${subjectName} | BitsNotes`}
  description={seoDescription}
  keywords={seoKeywords}
  ogType="article"
  robots="index, follow"
>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/lecture-notes.css" />
    <script type="application/ld+json" set:html={learningResourceJson} />
    {quizJson && <script type="application/ld+json" set:html={quizJson} />}

    <!-- Google AdSense Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2602136383267308" crossorigin="anonymous"></script>


  </Fragment>

  <main class="flex-grow w-full flex flex-col bg-slate-50 dark:bg-slate-950">

    {errorMsg && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
        <div class="bg-rose-50 border border-rose-200 rounded-2xl p-5 text-rose-800 flex items-start gap-3.5 shadow-sm">
          <svg class="w-6 h-6 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <div>
            <h3 class="font-bold text-rose-900 text-sm">Error Loading Lecture Notes</h3>
            <p class="text-xs text-rose-700 mt-1 leading-relaxed">{errorMsg}</p>
          </div>
        </div>
      </div>
    )}

    {hasHtmlContent && (
      <div class="viewer-layout max-w-[1440px] mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-grow flex gap-8 relative">
        <!-- Sidebar Drawer Toggle for Mobile -->
        <button id="sidebar-toggle" class="sidebar-toggle-btn lg:hidden shadow-lg" aria-label="Toggle Lecture List">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <!-- Sidebar Overlay for Mobile -->
        <div id="sidebar-overlay" class="sidebar-overlay hidden lg:hidden"></div>

        <!-- Sidebar Panel -->
        <aside id="lecture-sidebar" class="lecture-sidebar">
          <div class="sidebar-header">
            <span class="sidebar-subject-badge">Subject</span>
            <h2 class="sidebar-subject-title">{subjectName}</h2>
          </div>

          <nav class="sidebar-nav">
            {lectures.map((lec, idx) => {
              const isActive = lec.folderName === lectureFolderName;
              const viewUrl = `/view/${encodeURIComponent(subjectName)}/${encodeURIComponent(lec.folderName)}`;
              return (
                <a
                  href={isActive ? '#' : viewUrl}
                  class={`sidebar-item ${isActive ? 'active' : ''}`}
                >
                  <span class="sidebar-item-number">{idx + 1}</span>
                  <span class="sidebar-item-name">{lec.name}</span>
                </a>
              );
            })}
          </nav>
        </aside>

        <!-- Content Panel -->
        <div class="viewer-content flex-grow max-w-4xl flex flex-col min-w-0">
          <div class="lecture-notes-wrapper w-full bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800/80 shadow-md overflow-hidden flex-grow">

            <!-- Tab Navigation -->
            <nav class="tab-nav" role="tablist" aria-label="Lecture viewer tabs">
              <button class="active-tab" role="tab" aria-selected="true" data-tab="notes" id="tab-notes">
                <svg fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
                Lecture Notes
              </button>
              <button role="tab" aria-selected="false" data-tab="guide" id="tab-guide">
                <svg fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
                Study Guide
              </button>
              {showRevisionTab && (
                <button role="tab" aria-selected="false" data-tab="revision" id="tab-revision">
                  <svg fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                  Exam Revision
                </button>
              )}
              {showQuizTab && (
                <button role="tab" aria-selected="false" data-tab="quiz" id="tab-quiz">
                  <svg fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  Practice Quiz
                </button>
              )}
            </nav>

            <!-- Tab Panel 1: Lecture Notes -->
            <div class="tab-panel active" id="panel-notes" role="tabpanel" aria-labelledby="tab-notes">
              <Fragment set:html={bodyContent} />
            </div>

            <!-- Tab Panel 2: Study Guide -->
            <div class="tab-panel study-guide-panel" id="panel-guide" role="tabpanel" aria-labelledby="tab-guide">
              <div class="guide-header">
                <h2>{lectureName}</h2>
                <div class="guide-meta">
                  <span>{subjectName}</span>
                  {metadata.gradeLevel && <span>&middot; {metadata.gradeLevel}</span>}
                  {metadata.datePublished && <span>&middot; {metadata.datePublished}</span>}
                </div>
              </div>

              {metadata.summary && (
                <div class="guide-summary">
                  <h3>Summary</h3>
                  <p>{metadata.summary}</p>
                </div>
              )}

              {metadata.keyConcepts && metadata.keyConcepts.length > 0 && (
                <div class="objectives">
                  <h3>Learning Objectives</h3>
                  {metadata.keyConcepts.map((concept: string, idx: number) => (
                    <div class="objective-item">
                      <span class="objective-marker">{idx + 1}</span>
                      <span class="objective-text">{concept}</span>
                    </div>
                  ))}
                </div>
              )}

              {metadata.sections && metadata.sections.length > 0 && (
                <div class="sections-breakdown">
                  <h3>Sections Breakdown</h3>
                  {metadata.sections.map((section: any, idx: number) => (
                    <div class="section-card">
                      <div class="section-card-header">
                        <span class="section-card-number">{idx + 1}</span>
                        <span class="section-card-title">{section.title}</span>
                      </div>
                      {section.pages && <span class="section-card-pages">{section.pages}</span>}
                      {section.description && <p class="section-card-desc">{section.description}</p>}
                    </div>
                  ))}
                </div>
              )}

              {metadata.targetAudience && (
                <div class="audience-badge">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                  {metadata.targetAudience}
                </div>
              )}
            </div>

            <!-- Tab Panel 3: Exam Revision -->
            {showRevisionTab && (
              <div class="tab-panel revision-panel" id="panel-revision" role="tabpanel" aria-labelledby="tab-revision">
                {hasRevisionSection ? (
                  <Fragment set:html={revisionSectionContent} />
                ) : (
                  <>
                    <div class="guide-header">
                      <h2>Exam Revision Notes</h2>
                      <div class="guide-meta">
                        <span>Key Topics</span>
                        <span>&middot; Must Knows</span>
                        <span>&middot; Formulas</span>
                        <span>&middot; Quick Checks</span>
                      </div>
                    </div>

                    <div class="flex flex-col gap-6">
                      {metadata.examRevisionNotes?.map((item: any, idx: number) => (
                        <div class="section-card">
                          <div class="flex items-center gap-3.5 mb-4 pb-3 border-b border-slate-100 dark:border-slate-800/80">
                            <span class="section-card-number">{idx + 1}</span>
                            <span class="section-card-title text-[1.125rem]">{item.topic}</span>
                          </div>

                          <div class="flex flex-col gap-4">
                            {/* Must Know */}
                            {item.mustKnow && (
                              <div class="p-4 bg-slate-50 dark:bg-slate-950/50 border-l-4 border-slate-500 rounded-r-xl">
                                <h4 class="text-[0.7rem] font-bold text-slate-500 dark:text-slate-450 uppercase tracking-wider mb-1">Must Know</h4>
                                <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal">{item.mustKnow}</p>
                              </div>
                            )}

                            {/* Key Formula */}
                            {item.keyFormula && (
                              <div class="p-4 bg-indigo-50/20 dark:bg-indigo-950/20 border border-indigo-100/40 dark:border-indigo-900/40 rounded-xl">
                                <h4 class="text-[0.7rem] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                  <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                  </svg>
                                  Key Formula
                                </h4>
                                <div class="text-slate-800 dark:text-slate-200 text-center overflow-x-auto py-1 font-serif text-base">
                                  {item.keyFormula.startsWith('\\[') || item.keyFormula.startsWith('$$') || item.keyFormula.startsWith('\\(') ? (
                                    item.keyFormula
                                  ) : (
                                    `\\[ ${item.keyFormula} \\]`
                                  )}
                                </div>
                              </div>
                            )}

                            {/* Common Pitfall */}
                            {item.commonPitfall && (
                              <div class="p-4 bg-rose-50/50 dark:bg-rose-950/20 border-l-4 border-rose-500 rounded-r-xl">
                                <h4 class="text-[0.7rem] font-bold text-rose-700 dark:text-rose-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                                  <svg class="w-3.5 h-3.5 text-rose-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                  </svg>
                                  Common Pitfall
                                </h4>
                                <p class="text-sm text-rose-800 dark:text-rose-350 leading-relaxed font-normal">{item.commonPitfall}</p>
                              </div>
                            )}

                            {/* Quick Check */}
                            {item.quickCheck && (
                              <div class="p-4 bg-emerald-50/30 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40 rounded-xl">
                                <h4 class="text-[0.7rem] font-bold text-emerald-800 dark:text-emerald-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                                  <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                  </svg>
                                  Quick Check
                                </h4>
                                <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-medium italic">{item.quickCheck}</p>
                              </div>
                            )}

                            {/* Connections */}
                            {item.connections && item.connections.length > 0 && (
                              <div class="pt-2 flex flex-wrap items-center gap-2">
                                <span class="text-[0.7rem] font-extrabold text-slate-400 dark:text-slate-500 uppercase tracking-wider mr-1">Connections:</span>
                                {item.connections.map((conn: string) => (
                                  <span class="px-3 py-1 bg-indigo-50/50 dark:bg-indigo-950/50 hover:bg-indigo-50 dark:hover:bg-indigo-900 border border-indigo-100/60 dark:border-indigo-900/50 rounded-full text-xs font-semibold text-indigo-700 dark:text-indigo-300 transition-colors">
                                    {conn}
                                  </span>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </>
                )}
              </div>
            )}

            <!-- Tab Panel 4: Practice Quiz -->
            {showQuizTab && (
              <div class="tab-panel quiz-panel" id="panel-quiz" role="tabpanel" aria-labelledby="tab-quiz">
                {hasQuizSection ? (
                  <Fragment set:html={quizSectionContent} />
                ) : (
                  <>
                    <div class="quiz-header">
                      <h2>Practice Quiz</h2>
                      <p>Test your understanding of {lectureName}. Select an answer for each question — results are instant.</p>
                    </div>

                    <div class="quiz-grid" id="quiz-grid">
                      {metadata.quiz.map((q: any, qIdx: number) => (
                        <div class="quiz-card" data-correct-index={q.answerIndex} id={`quiz-card-${qIdx}`}>
                          <div class="quiz-card-header">
                            <span class="quiz-card-number">{qIdx + 1}</span>
                            <p class="quiz-question">{q.question}</p>
                          </div>
                          <div class="quiz-options">
                            {q.options.map((opt: string, optIdx: number) => (
                              <button class="quiz-option" onclick={`window.checkQuizAnswer(this, ${optIdx}, ${qIdx})`}>
                                {opt}
                              </button>
                            ))}
                          </div>
                          <div class="quiz-explanation hidden">
                            <strong>Explanation:</strong> {q.explanation}
                          </div>
                        </div>
                      ))}
                    </div>
                    <div class="quiz-score hidden" id="quiz-score">
                      <h3 id="quiz-score-text">0 / {metadata.quiz.length}</h3>
                      <p id="quiz-score-label">Keep going! Review the questions you missed.</p>
                      <div class="progress-bar">
                        <div class="progress-fill" id="quiz-progress-fill" style="width: 0%"></div>
                      </div>
                      <button class="quiz-retry" onclick="window.resetQuiz()">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
                        Try Again
                      </button>
                    </div>
                  </>
                )}
              </div>
            )}

          </div>

          <!-- Dynamic Navigation Buttons -->
          <div class="navigation-footer flex flex-col sm:flex-row items-center justify-between gap-4 mt-8 pt-4 pb-6">
            {prevUrl ? (
              <a href={prevUrl} class="nav-btn prev-btn flex items-center gap-4 w-full sm:w-auto">
                <div class="nav-btn-icon flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 transition-transform duration-250" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </div>
                <div class="text-left min-w-0">
                  <span class="nav-btn-hint text-[10px] block text-slate-400 dark:text-slate-550 uppercase tracking-widest font-bold">Previous</span>
                  <span class="nav-btn-title text-sm block font-bold text-slate-700 dark:text-slate-300 line-clamp-1">{prevLabel}</span>
                </div>
              </a>
            ) : (
              <div class="w-full sm:w-auto invisible"></div>
            )}

            {nextUrl ? (
              <a href={nextUrl} class="nav-btn next-btn flex items-center justify-between gap-4 w-full sm:w-auto text-right">
                <div class="text-right min-w-0">
                  <span class="nav-btn-hint text-[10px] block text-slate-400 dark:text-slate-550 uppercase tracking-widest font-bold">Next</span>
                  <span class="nav-btn-title text-sm block font-bold text-slate-700 dark:text-slate-300 line-clamp-1">{nextLabel}</span>
                </div>
                <div class="nav-btn-icon flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 transition-transform duration-250" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                  </svg>
                </div>
              </a>
            ) : (
              <div class="w-full sm:w-auto invisible"></div>
            )}
          </div>
        </div>
      </div>
    )}

  </main>
</BaseLayout>

<script is:inline>
  // ============================================
  // Tab Switching
  // ============================================
  (function() {
    var tabs = document.querySelectorAll('.tab-nav button[data-tab]');
    var panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tabId = this.getAttribute('data-tab');
        tabs.forEach(function(t) {
          t.classList.remove('active-tab');
          t.setAttribute('aria-selected', 'false');
        });
        this.classList.add('active-tab');
        this.setAttribute('aria-selected', 'true');

        panels.forEach(function(p) { p.classList.remove('active'); });
        var panel = document.getElementById('panel-' + tabId);
        if (panel) {
          panel.classList.add('active');
          if (window.MathJax && window.MathJax.typesetPromise) {
            window.MathJax.typesetPromise([panel]).catch(function(err) {});
          }
        }
      });
    });
  })();

  // ============================================
  // Quiz Panel: check answer + score tracking
  // ============================================
  window.quizState = { answered: 0, correct: 0, total: 0 };

  window.checkQuizAnswer = function(button, optionIndex, questionIndex) {
    var card = document.getElementById('quiz-card-' + questionIndex);
    if (!card || card.dataset.answered === 'true') return;
    card.dataset.answered = 'true';
    var correctIndex = parseInt(card.getAttribute('data-correct-index'));
    var options = card.querySelectorAll('.quiz-option');
    var isCorrect = optionIndex === correctIndex;
    options.forEach(function(opt, idx) {
      opt.disabled = true;
      if (idx === correctIndex) opt.classList.add('correct');
      else if (idx === optionIndex) opt.classList.add('incorrect');
    });
    var explanation = card.querySelector('.quiz-explanation');
    if (explanation) {
      explanation.classList.remove('hidden');
      explanation.classList.add('fade-in');
    }

    // Track score
    var totalCards = document.querySelectorAll('#quiz-grid .quiz-card').length;
    window.quizState.total = totalCards;
    window.quizState.answered = document.querySelectorAll('#quiz-grid .quiz-card[data-answered="true"]').length;
    if (isCorrect) window.quizState.correct++;

    // Show scorecard if all answered
    if (window.quizState.answered >= window.quizState.total) {
      window.showQuizScore();
    }
  };

  window.showQuizScore = function() {
    var scoreEl = document.getElementById('quiz-score');
    var textEl = document.getElementById('quiz-score-text');
    var labelEl = document.getElementById('quiz-score-label');
    var fillEl = document.getElementById('quiz-progress-fill');
    if (!scoreEl) return;
    scoreEl.classList.remove('hidden');
    var pct = window.quizState.total > 0 ? Math.round((window.quizState.correct / window.quizState.total) * 100) : 0;
    textEl.textContent = window.quizState.correct + ' / ' + window.quizState.total;
    fillEl.style.width = pct + '%';
    if (pct === 100) {
      labelEl.textContent = 'Perfect score! You mastered this material.';
    } else if (pct >= 70) {
      labelEl.textContent = 'Great job! Review the explanations for questions you missed.';
    } else {
      labelEl.textContent = 'Keep going! Review the lecture notes and try again.';
    }
  };

  window.resetQuiz = function() {
    var cards = document.querySelectorAll('#quiz-grid .quiz-card');
    cards.forEach(function(card) {
      card.dataset.answered = 'false';
      var opts = card.querySelectorAll('.quiz-option');
      opts.forEach(function(opt) {
        opt.disabled = false;
        opt.classList.remove('correct', 'incorrect');
      });
      var expl = card.querySelector('.quiz-explanation');
      if (expl) {
        expl.classList.add('hidden');
        expl.classList.remove('fade-in');
      }
    });
    var scoreEl = document.getElementById('quiz-score');
    if (scoreEl) scoreEl.classList.add('hidden');
    window.quizState = { answered: 0, correct: 0, total: 0 };
  };

  // ============================================
  // Legacy inline quiz handler (for quizzes embedded in HTML content)
  // ============================================
  window.checkAnswer = function(button, optionIndex) {
    var card = button.closest('.quiz-card');
    if (!card || card.dataset.answered === 'true') return;
    card.dataset.answered = 'true';
    var correctIndex = parseInt(card.getAttribute('data-correct-index') || card.dataset.correctIndex);
    var options = card.querySelectorAll('.quiz-option');
    options.forEach(function(opt, idx) {
      opt.disabled = true;
      if (idx === correctIndex) opt.classList.add('correct');
      else if (idx === optionIndex) opt.classList.add('incorrect');
    });
    var explanation = card.querySelector('.quiz-explanation');
    if (explanation) {
      explanation.classList.remove('hidden');
      explanation.classList.add('fade-in');
    }
  };

  // ============================================
  // Mobile sidebar toggle handlers
  // ============================================
  var toggleBtn = document.getElementById('sidebar-toggle');
  var sidebar = document.getElementById('lecture-sidebar');
  var overlay = document.getElementById('sidebar-overlay');

  if (toggleBtn && sidebar && overlay) {
    var toggleSidebar = function() {
      if (window.innerWidth < 1024) {
        sidebar.classList.toggle('open');
        overlay.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden');
      }
    };

    toggleBtn.addEventListener('click', toggleSidebar);
    overlay.addEventListener('click', toggleSidebar);
  }

  // Dynamically inject MathJax if math markup is present
  if (!document.getElementById('MathJax-script') && !window.MathJax) {
    var script = document.createElement('script');
    script.id = 'MathJax-script';
    script.async = true;
    script.src = 'https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js';
    document.head.appendChild(script);
  }

  // Add copy buttons to code blocks in lecture notes (only in the notes tab panel)
  (function() {
    var panel = document.getElementById('panel-notes');
    if (!panel) return;
    panel.querySelectorAll('pre').forEach(function(p) {
      if (p.querySelector('.copy-btn') || p.parentElement.classList.contains('code-block-wrapper')) return;
      var b = document.createElement('button');
      b.className = 'copy-btn';
      b.setAttribute('aria-label', 'Copy code');
      b.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
      var d = document.createElement('div');
      d.className = 'code-block-wrapper';
      p.parentNode.insertBefore(d, p);
      d.appendChild(p);
      d.appendChild(b);
      b.addEventListener('click', async function() {
        var code = p.querySelector('code') || p;
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          b.classList.add('copied');
          b.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>';
          setTimeout(function() {
            b.classList.remove('copied');
            b.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
          }, 2000);
        } catch (_) {}
      });
    });
  })();
</script>
