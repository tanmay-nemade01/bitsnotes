---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listSubjects, listLectures, type LectureSummary } from '../../utils/notesLoader';

export function getStaticPaths() {
  const subjects = listSubjects();
  return subjects.map((s) => ({
    params: { subject: s.name },
  }));
}

const { subject } = Astro.params;
if (!subject) {
  return Astro.redirect('/');
}

const decodedSubject = decodeURIComponent(subject);
const lectures = listLectures(decodedSubject);

// Generate CollectionPage and Course structured data schema
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${decodedSubject} Lecture Notes & Study Guides | BitsNotes`,
  "description": `Comprehensive collection of study guides, lecture notes, and interactive quizzes for ${decodedSubject}.`,
  "url": new URL(Astro.url.pathname, 'https://bitsnotes.com').href,
  "about": {
    "@type": "Course",
    "name": decodedSubject,
    "description": `Academic course materials and study resources for ${decodedSubject}.`
  },
  "hasPart": lectures.map((lecture, index) => ({
    "@type": "LearningResource",
    "name": lecture.name,
    "url": new URL(`/view/${encodeURIComponent(decodedSubject)}/${encodeURIComponent(lecture.folderName)}`, 'https://bitsnotes.com').href,
    "position": index + 1
  }))
};

const collectionPageJson = JSON.stringify(collectionPageSchema);
const seoKeywords = `${decodedSubject}, lecture notes, study guides, college courses, study materials, academic resources, BitsNotes`;
---

<BaseLayout
  title={`${decodedSubject} Lectures & Notes | BitsNotes`}
  description={`Comprehensive collection of lecture notes, study guides, and interactive practice quizzes for ${decodedSubject}. Access view-only notes and curated summaries for every lecture.`}
  keywords={seoKeywords}
  robots="index, follow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={collectionPageJson} />
  </Fragment>

  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-400 mb-8 select-none">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Home</a>
      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
      </svg>
      <span class="text-indigo-600 dark:text-indigo-450 truncate">{decodedSubject}</span>
    </nav>
 
    <!-- Header Card -->
    <div class="relative bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800/80 p-8 md:p-10 shadow-xl shadow-slate-100/50 dark:shadow-none overflow-hidden mb-10">
      <!-- Decorative Backdrop Gradients -->
      <div class="absolute right-0 top-0 -mt-12 -mr-12 w-64 h-64 bg-indigo-100/40 dark:bg-indigo-950/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute left-1/3 bottom-0 -mb-16 w-80 h-80 bg-violet-100/30 dark:bg-violet-950/10 rounded-full blur-3xl pointer-events-none"></div>
 
      <div class="relative z-10 max-w-2xl">
        <span class="inline-block text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest bg-indigo-50 dark:bg-indigo-950/50 px-3 py-1.5 rounded-lg mb-4">Subject</span>
        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          {decodedSubject}
        </h1>
        <p class="mt-3 text-slate-600 dark:text-slate-300 leading-relaxed text-base md:text-lg">
          Select a lecture below to open its study notes. All documents are view-only.
        </p>
 
        <!-- Search -->
        <div class="mt-8 relative max-w-lg">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            placeholder="Search lectures..."
            class="block w-full pl-11 pr-4 py-3.5 border border-slate-200 dark:border-slate-800 rounded-2xl bg-slate-50/50 dark:bg-slate-950 text-slate-900 dark:text-white placeholder-slate-500 dark:placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:bg-white dark:focus:bg-slate-900 transition-all shadow-inner text-sm"
          />
        </div>
      </div>
    </div>

    <!-- Lectures Section Header -->
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
        Lectures
        <span id="lecture-count" class="text-xs px-2.5 py-1 bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 border border-indigo-100 dark:border-indigo-900/50 rounded-full font-bold">{lectures.length}</span>
      </h2>
      <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Sorted alphabetically</span>
    </div>
 
    <!-- Grid of Lectures -->
    {lectures.length === 0 ? (
      <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
        <svg class="mx-auto h-12 w-12 text-slate-300 dark:text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
        </svg>
        <h3 class="mt-4 text-sm font-bold text-slate-900 dark:text-white">No lectures found</h3>
        <p class="mt-1.5 text-xs text-slate-600 dark:text-slate-400">Add HTML note files into this subject's folder in src/content/notes/.</p>
      </div>
    ) : (
      <div id="lectures-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 animate-stagger">
        {lectures.map(({ name: lectureName, folderName }, idx) => {
          const viewPath = `/view/${encodeURIComponent(decodedSubject)}/${encodeURIComponent(folderName)}`;
          return (
            <a
              href={viewPath}
              target="_blank"
              rel="noopener noreferrer"
              data-lecture-name={lectureName.toLowerCase()}
              class="lecture-card group bg-white dark:bg-slate-900 rounded-2xl border border-slate-150 dark:border-slate-800/80 p-6 shadow-sm hover:shadow-xl hover:border-indigo-200 dark:hover:border-indigo-500/50 dark:hover:shadow-[0_10px_30px_rgba(99,102,241,0.08)] hover:-translate-y-1 transition-all duration-300 flex flex-col h-full relative overflow-hidden"
            >
              <!-- Top Glow -->
              <div class="absolute -right-6 -top-6 w-20 h-20 bg-indigo-500/5 dark:bg-indigo-500/10 rounded-full group-hover:bg-indigo-500/15 dark:group-hover:bg-indigo-500/20 group-hover:scale-125 transition-all duration-300"></div>
 
              <div class="flex items-start gap-4 mb-4">
                <!-- Lecture Number Badge -->
                <div class="w-12 h-12 bg-indigo-50 dark:bg-indigo-900/30 rounded-xl flex items-center justify-center text-indigo-600 dark:text-indigo-400 font-extrabold text-lg shrink-0 group-hover:bg-indigo-600 group-hover:text-white dark:group-hover:bg-indigo-600 dark:group-hover:text-white transition-all duration-300">
                  {idx + 1}
                </div>
                <div class="flex-grow">
                  <h3 class="font-bold text-slate-800 dark:text-slate-100 leading-snug group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-2">
                    {lectureName}
                  </h3>
                  <p class="text-sm text-slate-600 dark:text-slate-350 mt-1 font-medium flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-slate-400 dark:text-slate-550" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    {decodedSubject}
                  </p>
                </div>
              </div>
 
              <div class="mt-auto pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-indigo-600 dark:text-indigo-400 font-bold">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  Open in New Tab
                </span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </main>
</BaseLayout>

<script is:inline>
  const searchCards = document.querySelectorAll('.lecture-card');
  searchCards.forEach((card, i) => { card.style.setProperty('--i', i); });

  const searchInput = document.getElementById('search-input');
  const lectureCount = document.getElementById('lecture-count');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase().trim();
      let visible = 0;
      searchCards.forEach((card) => {
        const name = card.getAttribute('data-lecture-name') || '';
        if (name.includes(term)) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });
      if (lectureCount) lectureCount.textContent = visible;
    });
  }
</script>
