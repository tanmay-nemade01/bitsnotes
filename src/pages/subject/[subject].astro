---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listLectures, getSubjectByNameOrSlug, getSubjectDetails } from '../../utils/notesLoader';
import CommentsSection from '../../components/CommentsSection.astro';
import { slugify } from '../../utils/lectureDisplay';
import { getEnv } from '../../lib/apiHelpers';
import { getHiddenSubjectNames } from '../../lib/subjectVisibility';

export const prerender = false;

const { subject } = Astro.params;
if (!subject) return Astro.redirect('/');

const decodedSubject = decodeURIComponent(subject);
const matchedSubject = await getSubjectByNameOrSlug(decodedSubject);
if (!matchedSubject) return Astro.redirect('/');

// Check visibility: hidden subjects are completely invisible to non-admins
const env = await getEnv(Astro).catch(() => null);
const isAdmin = Boolean((Astro.locals as any).isAdmin);
const hiddenSubjects = await getHiddenSubjectNames(env?.DB);
const isHidden = hiddenSubjects.has(matchedSubject.name);

if (isHidden && !isAdmin) {
  return Astro.redirect('/');
}

// Redirect to canonical slug if raw subject name or unslugified path was used
const canonicalSubjectSlug = slugify(matchedSubject.name);
if (decodedSubject !== canonicalSubjectSlug) {
  return Astro.redirect(`/subject/${encodeURIComponent(canonicalSubjectSlug)}`);
}

const decodedSubjectName = matchedSubject.name;
const lectures = await listLectures(decodedSubjectName);
const subjectInfo = await getSubjectDetails(decodedSubjectName);

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${decodedSubjectName} Lecture Notes & Study Guides | BitsNotes`,
  "description": `Comprehensive collection of study guides, lecture notes, and interactive quizzes for ${decodedSubjectName}.`,
  "url": new URL(Astro.url.pathname, 'https://bitsnotes.com').href,
  "about": { "@type": "Course", "name": decodedSubjectName, "description": `Academic course materials and study resources for ${decodedSubjectName}.` },
  "hasPart": lectures.map((l, i) => ({
    "@type": "LearningResource",
    "name": l.displayTitle || l.name,
    "url": new URL(`/view/${encodeURIComponent(canonicalSubjectSlug)}/${encodeURIComponent(l.slug)}`, 'https://bitsnotes.com').href,
    "position": i + 1
  }))
};

const collectionPageJson = JSON.stringify(collectionPageSchema);
const seoKeywords = `${decodedSubjectName}, lecture notes, study guides, college courses, study materials, academic resources, BitsNotes`;
const robotsDirective = isHidden ? 'noindex, nofollow' : 'index, follow';
---

<BaseLayout
  title={`${decodedSubjectName} Lectures & Notes | BitsNotes`}
  description={`Comprehensive collection of lecture notes, study guides, and interactive practice quizzes for ${decodedSubjectName}. Access view-only notes and curated summaries for every lecture.`}
  keywords={seoKeywords}
  robots={robotsDirective}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={collectionPageJson} />
  </Fragment>

  <div class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-[var(--text-muted)] mb-8">
      <a href="/" class="hover:text-[var(--accent)] transition-colors">Home</a>
      <svg class="w-3 h-3 text-[var(--text-faint)]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-[var(--text)] font-medium truncate">{decodedSubjectName}</span>
    </nav>

    {isAdmin && isHidden && (
      <aside class="mb-8 rounded-[var(--r-md)] border border-amber-500/30 bg-amber-500/10 p-4 text-amber-700 dark:text-amber-300">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="p-2 rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400 shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </span>
            <div>
              <p class="font-bold text-sm flex items-center gap-2">
                Admin Preview Mode
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30">
                  Hidden from Public
                </span>
              </p>
              <p class="text-xs text-amber-700/80 dark:text-amber-300/80 mt-0.5">
                This subject and all {lectures.length} {lectures.length === 1 ? 'lecture' : 'lectures'} are completely hidden from non-admin users. Only admins can see this preview.
              </p>
            </div>
          </div>
          <button
            type="button"
            id="subject-publish-toggle-btn"
            data-subject={decodedSubjectName}
            data-target-public="true"
            class="shrink-0 px-3.5 py-1.5 text-xs font-semibold rounded-[var(--r-sm)] bg-amber-600 text-white hover:bg-amber-700 transition-colors cursor-pointer flex items-center gap-1.5 shadow-sm"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            Make Public
          </button>
        </div>
      </aside>
    )}

    {isAdmin && !isHidden && (
      <div class="mb-6 flex items-center justify-between text-xs text-[var(--text-muted)] bg-[var(--bg-subtle)] border border-[var(--border)] px-3.5 py-2 rounded-[var(--r-sm)]">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Admin status: This subject is <strong>Public</strong> to everyone.</span>
        </div>
        <button
          type="button"
          id="subject-publish-toggle-btn"
          data-subject={decodedSubjectName}
          data-target-public="false"
          class="text-xs text-amber-600 dark:text-amber-400 hover:underline font-medium cursor-pointer"
        >
          Hide Subject
        </button>
      </div>
    )}

    {isAdmin && (
      <script is:inline>
        document.getElementById('subject-publish-toggle-btn')?.addEventListener('click', async function () {
          var btn = this;
          var subjectName = btn.getAttribute('data-subject');
          var targetPublic = btn.getAttribute('data-target-public') === 'true';
          btn.disabled = true;
          var origText = btn.textContent;
          btn.textContent = 'Updating…';
          try {
            var res = await fetch('/api/admin/subjects/visibility', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ subjectName: subjectName, isPublic: targetPublic })
            });
            if (res.ok) {
              window.location.reload();
            } else {
              alert('Failed to update visibility.');
              btn.disabled = false;
              btn.textContent = origText;
            }
          } catch (e) {
            alert('Network error.');
            btn.disabled = false;
            btn.textContent = origText;
          }
        });
      </script>
    )}

    <!-- Editorial header -->
    <header class="mb-8">
      <h1 class="font-display text-3xl md:text-4xl font-extrabold text-[var(--text)] leading-tight tracking-tight">
        {decodedSubjectName}
      </h1>
      <p class="mt-1 text-sm text-[var(--text-muted)]">
        {lectures.length} {lectures.length === 1 ? 'lecture' : 'lectures'}
      </p>
      <p class="mt-2 text-sm text-[var(--text-faint)] max-w-prose">
        {subjectInfo.description}
      </p>

      <!-- Search -->
      <div class="mt-5 relative max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
          <svg class="w-4 h-4 text-[var(--text-muted)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <input
          type="text"
          id="search-input"
          placeholder="Search lectures..."
          class="block w-full pl-10 pr-4 py-2.5 border border-[var(--border)] text-[var(--text)] bg-[var(--bg-input)] placeholder-[var(--input-placeholder)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150"
        />
      </div>
    </header>

    <!-- Lecture list — tight vertical list -->
    {lectures.length === 0 ? (
      <div class="text-center py-16 border border-[var(--border)] rounded-[var(--r-md)]">
        <svg class="mx-auto h-10 w-10 text-[var(--text-faint)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
        </svg>
        <h3 class="mt-3 text-sm font-bold text-[var(--text)]">No lectures found</h3>
        <p class="mt-1 text-xs text-[var(--text-muted)]">Add HTML note files into this subject's folder in src/content/notes/.</p>
      </div>
    ) : (
      <div id="lecture-list" class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {lectures.map((lec) => {
          const viewPath = `/view/${encodeURIComponent(canonicalSubjectSlug)}/${encodeURIComponent(lec.slug)}`;
          const lectureName = lec.displayTitle || lec.name;
          const numLabel = lec.lectureNumber != null
            ? (lec.lectureNumberEnd != null
                ? `${lec.lectureNumber.toString().padStart(2, '0')}–${lec.lectureNumberEnd.toString().padStart(2, '0')}`
                : lec.lectureNumber.toString().padStart(2, '0'))
            : '';
          return (
            <div
              data-lecture-name={lectureName.toLowerCase()}
              data-subject={decodedSubjectName}
              data-lecture={lec.folderName}
              class="flex items-center gap-4 py-3.5 px-3 -mx-3 rounded-[var(--r-sm)] hover:bg-[var(--bg-subtle)] transition-colors group"
            >
              <span class="font-mono text-xs text-[var(--text-muted)] w-6 shrink-0 text-right tabular-nums">
                {/* Progress dot (hidden by default, shown by JS when logged in) */}
                <span class="bm-progress-dot hidden w-3 h-3 rounded-full border border-[var(--border)] shrink-0" title="Reading progress"></span>
                <span class="font-mono text-xs text-[var(--text-faint)] w-6 shrink-0 text-right tabular-nums">
                  {numLabel || '·'}
                </span>
              </span>
              <a href={viewPath} data-astro-prefetch="hover" class="flex-1 min-w-0 text-sm font-medium text-[var(--text)] group-hover:text-[var(--accent)] transition-colors line-clamp-1 no-underline">
                {lectureName}
              </a>
              {/* Bookmark button (hidden by default, shown by JS when logged in) */}
              <button
                type="button"
                class="bm-star-btn hidden p-1 rounded-full hover:bg-[var(--accent-subtle)] transition-colors shrink-0"
                data-subject={decodedSubjectName}
                data-lecture={lec.folderName}
                data-display-name={lectureName}
                data-bookmarked="false"
                aria-label="Bookmark"
                title="Bookmark"
              >
                <svg class="w-3.5 h-3.5 text-[var(--text-faint)] group-hover/bm:text-[var(--accent)] bm-outline transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <svg class="w-3.5 h-3.5 text-[var(--accent)] hidden bm-filled transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              </button>
              <svg class="w-4 h-4 text-[var(--text-faint)] shrink-0 group-hover:text-[var(--accent)] transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          );
        })}
      </div>
    )}

    <!-- Anonymous comments (lazy-loaded, below resource list) -->
    <CommentsSection pageType="subject" subject={decodedSubjectName} />
  </div>
</BaseLayout>

<script defer src="/auth-features.js"></script>

<script is:inline data-astro-rerun>
  // Search
  const searchInput = document.getElementById('search-input');
  const items = document.querySelectorAll('[data-lecture-name]');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      const term = this.value.toLowerCase().trim();
      let visible = 0;
      items.forEach(function(item) {
        const name = item.getAttribute('data-lecture-name') || '';
        if (name.includes(term)) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });
    });
  }

  // ─── Auth features: bookmarks + progress dots ─────────────────────
  (function () {
    var BN = window.BitsNotes;
    if (!BN) return;

    var initBookmarks = function () {
      fetch('/api/bookmarks/list', { credentials: 'same-origin' }).then(function (r) {
        if (r.status === 401) return false;
        return r.json().then(function (data) { return data && data.loggedIn !== false; });
      }).then(function (loggedIn) {
        if (!loggedIn) return;

        var subject = document.querySelector('[data-subject]');
        var subjectName = subject ? subject.dataset.subject : '';

        // Show bookmark buttons
        document.querySelectorAll('.bm-star-btn').forEach(function (btn) {
          btn.classList.remove('hidden');
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var isBm = btn.dataset.bookmarked === 'true';
            var data = {
              subject: btn.dataset.subject,
              lecture: btn.dataset.lecture,
              displayName: btn.dataset.displayName,
            };
            if (isBm) {
              BN.del('/api/bookmarks/remove', data).then(function () {
                btn.dataset.bookmarked = 'false';
                btn.querySelector('.bm-outline').classList.remove('hidden');
                btn.querySelector('.bm-filled').classList.add('hidden');
              });
            } else {
              BN.post('/api/bookmarks/add', data).then(function () {
                btn.dataset.bookmarked = 'true';
                btn.querySelector('.bm-outline').classList.add('hidden');
                btn.querySelector('.bm-filled').classList.remove('hidden');
              });
            }
          });
        });

        // Load bookmarks to set initial state
        BN.json('/api/bookmarks/list').then(function (data) {
          if (!data || !data.bookmarks) return;
          var allBm = Object.values(data.bookmarks).flat();
          document.querySelectorAll('.bm-star-btn').forEach(function (btn) {
            var isBm = allBm.some(function (b) {
              return b.subject === btn.dataset.subject && b.lecture === btn.dataset.lecture;
            });
            if (isBm) {
              btn.dataset.bookmarked = 'true';
              btn.querySelector('.bm-outline').classList.add('hidden');
              btn.querySelector('.bm-filled').classList.remove('hidden');
            }
          });
        });

        // Load progress
        BN.json('/api/progress/list?subject=' + encodeURIComponent(subjectName)).then(function (data) {
          if (!data || !data.lectures) return;
          var progressMap = {};
          data.lectures.forEach(function (l) { progressMap[l.lecture] = l.readPct; });

          document.querySelectorAll('[data-lecture]').forEach(function (row) {
            var lecture = row.dataset.lecture;
            var pct = progressMap[lecture];
            if (pct === undefined) return;
            var dot = row.querySelector('.bm-progress-dot');
            if (!dot) return;
            dot.classList.remove('hidden');
            if (pct >= 80) {
              dot.style.backgroundColor = 'var(--accent)';
              dot.style.borderColor = 'var(--accent)';
              dot.title = 'Read';
            } else if (pct > 20) {
              dot.style.background = 'linear-gradient(to right, var(--accent) 50%, var(--border) 50%)';
              dot.style.borderColor = 'var(--accent)';
              dot.title = 'Partially read';
            } else {
              dot.style.borderColor = 'var(--text-faint)';
              dot.title = 'Unread';
            }
          });
        });
      });
    };

    if ('requestIdleCallback' in window) {
      requestIdleCallback(function () { initBookmarks(); });
    } else {
      setTimeout(initBookmarks, 1);
    }
  })();
</script>
