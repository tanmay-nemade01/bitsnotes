---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listLectures } from '../../utils/notesLoader';
import { getSubjectInfo } from '../../data/subjects';
import CommentsSection from '../../components/CommentsSection.astro';

export const prerender = false;

const { subject } = Astro.params;
if (!subject) return Astro.redirect('/');

const decodedSubject = decodeURIComponent(subject);
const lectures = await listLectures(decodedSubject);
const subjectInfo = getSubjectInfo(decodedSubject);

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${decodedSubject} Lecture Notes & Study Guides | BitsNotes`,
  "description": `Comprehensive collection of study guides, lecture notes, and interactive quizzes for ${decodedSubject}.`,
  "url": new URL(Astro.url.pathname, 'https://bitsnotes.com').href,
  "about": { "@type": "Course", "name": decodedSubject, "description": `Academic course materials and study resources for ${decodedSubject}.` },
  "hasPart": lectures.map((l, i) => ({
    "@type": "LearningResource",
    "name": l.name,
    "url": new URL(`/view/${encodeURIComponent(decodedSubject)}/${encodeURIComponent(l.folderName)}`, 'https://bitsnotes.com').href,
    "position": i + 1
  }))
};

const collectionPageJson = JSON.stringify(collectionPageSchema);
const seoKeywords = `${decodedSubject}, lecture notes, study guides, college courses, study materials, academic resources, BitsNotes`;
---

<BaseLayout
  title={`${decodedSubject} Lectures & Notes | BitsNotes`}
  description={`Comprehensive collection of lecture notes, study guides, and interactive practice quizzes for ${decodedSubject}. Access view-only notes and curated summaries for every lecture.`}
  keywords={seoKeywords}
  robots="index, follow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={collectionPageJson} />
  </Fragment>

  <div class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-[var(--text-muted)] mb-8">
      <a href="/" class="hover:text-[var(--accent)] transition-colors">Home</a>
      <svg class="w-3 h-3 text-[var(--text-faint)]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-[var(--text)] font-medium truncate">{decodedSubject}</span>
    </nav>

    <!-- Editorial header -->
    <header class="mb-8">
      <h1 class="font-display text-3xl md:text-4xl font-extrabold text-[var(--text)] leading-tight tracking-tight">
        {decodedSubject}
      </h1>
      <p class="mt-1 text-sm text-[var(--text-muted)]">
        {lectures.length} {lectures.length === 1 ? 'lecture' : 'lectures'}
      </p>
      <p class="mt-2 text-sm text-[var(--text-faint)] max-w-prose">
        {subjectInfo.description}
      </p>

      <!-- Search -->
      <div class="mt-5 relative max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
          <svg class="w-4 h-4 text-[var(--text-muted)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <input
          type="text"
          id="search-input"
          placeholder="Search lectures..."
          class="block w-full pl-10 pr-4 py-2.5 border border-[var(--border)] text-[var(--text)] bg-[var(--bg-input)] placeholder-[var(--input-placeholder)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150"
        />
      </div>
    </header>

    <!-- Lecture list — tight vertical list -->
    {lectures.length === 0 ? (
      <div class="text-center py-16 border border-[var(--border)] rounded-[var(--r-md)]">
        <svg class="mx-auto h-10 w-10 text-[var(--text-faint)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
        </svg>
        <h3 class="mt-3 text-sm font-bold text-[var(--text)]">No lectures found</h3>
        <p class="mt-1 text-xs text-[var(--text-muted)]">Add HTML note files into this subject's folder in src/content/notes/.</p>
      </div>
    ) : (
      <div id="lecture-list" class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {lectures.map((lec) => {
          const viewPath = `/view/${encodeURIComponent(decodedSubject)}/${encodeURIComponent(lec.folderName)}`;
          const lectureName = lec.displayTitle || lec.name;
          const numLabel = lec.lectureNumber != null
            ? (lec.lectureNumberEnd != null
                ? `${lec.lectureNumber.toString().padStart(2, '0')}–${lec.lectureNumberEnd.toString().padStart(2, '0')}`
                : lec.lectureNumber.toString().padStart(2, '0'))
            : '';
          return (
            <div
              data-lecture-name={lectureName.toLowerCase()}
              data-subject={decodedSubject}
              data-lecture={lec.folderName}
              class="flex items-center gap-4 py-3.5 px-3 -mx-3 rounded-[var(--r-sm)] hover:bg-[var(--bg-subtle)] transition-colors group"
            >
              <span class="font-mono text-xs text-[var(--text-muted)] w-6 shrink-0 text-right tabular-nums">
                {/* Progress dot (hidden by default, shown by JS when logged in) */}
                <span class="bm-progress-dot hidden w-3 h-3 rounded-full border border-[var(--border)] shrink-0" title="Reading progress"></span>
                <span class="font-mono text-xs text-[var(--text-faint)] w-6 shrink-0 text-right tabular-nums">
                  {numLabel || '·'}
                </span>
              </span>
              <a href={viewPath} class="flex-1 min-w-0 text-sm font-medium text-[var(--text)] group-hover:text-[var(--accent)] transition-colors line-clamp-1 no-underline">
                {lectureName}
              </a>
              {/* Bookmark button (hidden by default, shown by JS when logged in) */}
              <button
                type="button"
                class="bm-star-btn hidden p-1 rounded-full hover:bg-[var(--accent-subtle)] transition-colors shrink-0"
                data-subject={decodedSubject}
                data-lecture={lec.folderName}
                data-display-name={lectureName}
                data-bookmarked="false"
                aria-label="Bookmark"
                title="Bookmark"
              >
                <svg class="w-3.5 h-3.5 text-[var(--text-faint)] group-hover/bm:text-[var(--accent)] bm-outline transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <svg class="w-3.5 h-3.5 text-[var(--accent)] hidden bm-filled transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              </button>
              <svg class="w-4 h-4 text-[var(--text-faint)] shrink-0 group-hover:text-[var(--accent)] transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          );
        })}
      </div>
    )}

    <!-- Anonymous comments (lazy-loaded, below resource list) -->
    <CommentsSection pageType="subject" subject={decodedSubject} />
  </div>
</BaseLayout>

<script defer src="/auth-features.js"></script>

<script is:inline data-astro-rerun>
  // Search
  const searchInput = document.getElementById('search-input');
  const items = document.querySelectorAll('[data-lecture-name]');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      const term = this.value.toLowerCase().trim();
      let visible = 0;
      items.forEach(function(item) {
        const name = item.getAttribute('data-lecture-name') || '';
        if (name.includes(term)) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });
    });
  }

  // ─── Auth features: bookmarks + progress dots ─────────────────────
  (function () {
    var BN = window.BitsNotes;
    if (!BN) return;

    fetch('/api/bookmarks/list', { credentials: 'same-origin' }).then(function (r) {
      if (r.status === 401) return false;
      return r.json().then(function () { return true; });
    }).then(function (loggedIn) {
      if (!loggedIn) return;

      var subject = document.querySelector('[data-subject]');
      var subjectName = subject ? subject.dataset.subject : '';

      // Show bookmark buttons
      document.querySelectorAll('.bm-star-btn').forEach(function (btn) {
        btn.classList.remove('hidden');
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var isBm = btn.dataset.bookmarked === 'true';
          var data = {
            subject: btn.dataset.subject,
            lecture: btn.dataset.lecture,
            displayName: btn.dataset.displayName,
          };
          if (isBm) {
            BN.del('/api/bookmarks/remove', data).then(function () {
              btn.dataset.bookmarked = 'false';
              btn.querySelector('.bm-outline').classList.remove('hidden');
              btn.querySelector('.bm-filled').classList.add('hidden');
            });
          } else {
            BN.post('/api/bookmarks/add', data).then(function () {
              btn.dataset.bookmarked = 'true';
              btn.querySelector('.bm-outline').classList.add('hidden');
              btn.querySelector('.bm-filled').classList.remove('hidden');
            });
          }
        });
      });

      // Load bookmarks to set initial state
      BN.json('/api/bookmarks/list').then(function (data) {
        if (!data || !data.bookmarks) return;
        var allBm = Object.values(data.bookmarks).flat();
        document.querySelectorAll('.bm-star-btn').forEach(function (btn) {
          var isBm = allBm.some(function (b) {
            return b.subject === btn.dataset.subject && b.lecture === btn.dataset.lecture;
          });
          if (isBm) {
            btn.dataset.bookmarked = 'true';
            btn.querySelector('.bm-outline').classList.add('hidden');
            btn.querySelector('.bm-filled').classList.remove('hidden');
          }
        });
      });

      // Load progress
      BN.json('/api/progress/list?subject=' + encodeURIComponent(subjectName)).then(function (data) {
        if (!data || !data.lectures) return;
        var progressMap = {};
        data.lectures.forEach(function (l) { progressMap[l.lecture] = l.readPct; });

        document.querySelectorAll('[data-lecture]').forEach(function (row) {
          var lecture = row.dataset.lecture;
          var pct = progressMap[lecture];
          if (pct === undefined) return;
          var dot = row.querySelector('.bm-progress-dot');
          if (!dot) return;
          dot.classList.remove('hidden');
          if (pct >= 80) {
            dot.style.backgroundColor = 'var(--accent)';
            dot.style.borderColor = 'var(--accent)';
            dot.title = 'Read';
          } else if (pct > 20) {
            dot.style.background = 'linear-gradient(to right, var(--accent) 50%, var(--border) 50%)';
            dot.style.borderColor = 'var(--accent)';
            dot.title = 'Partially read';
          } else {
            dot.style.borderColor = 'var(--text-faint)';
            dot.title = 'Unread';
          }
        });
      });
    });
  })();
</script>
