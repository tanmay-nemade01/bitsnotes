---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Subscription Confirmed | BitsNotes" 
  description="Your subscription to the BitsNotes newsletter has been successfully confirmed."
  robots="noindex, nofollow"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 flex-grow w-full flex items-center justify-center">
    <div class="p-8 md:p-12 border border-[var(--border)] rounded-[var(--r-md)] bg-[var(--bg-elevated)] max-w-md w-full text-center relative overflow-hidden">
      <!-- Top Accent Line -->
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-[var(--accent)]"></div>

      <!-- Success Icon -->
      <div class="mx-auto w-16 h-16 rounded-[var(--r-md)] bg-[var(--callout-example-bg)] border border-[var(--callout-example-border)] flex items-center justify-center text-[var(--callout-example-text)] mb-6 animate-bounce-subtle">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>

      <h1 class="font-display text-3xl font-extrabold text-[var(--text)] tracking-tight leading-tight mb-4">
        Subscription Confirmed!
      </h1>
      <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-8">
        Thank you for confirming your email. You are now officially subscribed to the BitsNotes newsletter. We will send you new lecture notes and study guides as they are published.
      </p>

      <a href="/" 
        class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-contrast)] text-sm font-bold rounded-[var(--r-sm)] transition-colors duration-150 cursor-pointer active:scale-[0.97] w-full justify-center">
        Go to Dashboard
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  @keyframes bounceSubtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  .animate-bounce-subtle {
    animation: bounceSubtle 2s infinite ease-in-out;
  }
</style>
