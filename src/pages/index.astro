---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listSubjects } from '../utils/r2Structure';

const bucket = env?.BUCKET;
const kv = env?.SESSION;
let subjects: { name: string; lectureCount: number }[] = [];
let errorMsg = '';
let isDemoMode = false;

if (bucket) {
  try {
    subjects = await listSubjects(bucket as any, kv as any);
  } catch (error: any) {
    errorMsg = `Failed to connect to Cloudflare R2: ${error.message || error}`;
    isDemoMode = true;
  }
} else {
  isDemoMode = true;
}

if (subjects.length === 0 && (isDemoMode || import.meta.env.DEV)) {
  isDemoMode = true;
  subjects = [
    { name: 'Deep Reinforcement Learning', lectureCount: 5 },
    { name: 'Machine Learning', lectureCount: 8 },
    { name: 'Computer Networks', lectureCount: 6 },
  ];
}
---

<BaseLayout
  title="Classroom Notes & Lectures | BitsNotes"
  description="Access secure classroom notes, lectures, and study guides for free. Browse subjects and open individual lecture notes in a secure viewer."
  theme="light"
>
  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">

    <!-- Welcome Section -->
    <div class="relative bg-white rounded-3xl border border-slate-100 p-8 md:p-10 shadow-xl shadow-slate-100/50 overflow-hidden mb-10">
      <!-- Decorative Backdrop Gradients -->
      <div class="absolute right-0 top-0 -mt-12 -mr-12 w-64 h-64 bg-indigo-100/40 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute left-1/3 bottom-0 -mb-16 w-80 h-80 bg-violet-100/30 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl">
        <span class="inline-block text-xs font-bold text-indigo-600 uppercase tracking-widest bg-indigo-50 px-3 py-1.5 rounded-lg mb-4">Welcome Students</span>
        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Access your learning materials securely in one place
        </h1>
        <p class="mt-3 text-slate-600 leading-relaxed text-base md:text-lg">
          Browse subjects below, select a subject to see its lectures, then open any lecture in a secure viewer. All documents are view-only.
        </p>

        <!-- Search Input -->
        <div class="mt-8 relative max-w-lg">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            placeholder="Search subjects..."
            class="block w-full pl-11 pr-4 py-3.5 border border-slate-200 rounded-2xl bg-slate-50/50 text-slate-900 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:bg-white transition-all shadow-inner text-sm"
          />
        </div>
      </div>
    </div>

    <!-- Error Alert -->
    {errorMsg && (
      <div class="mb-10 bg-rose-50 border border-rose-200 rounded-2xl p-5 text-rose-800 flex items-start gap-3.5 shadow-sm">
        <svg class="w-6 h-6 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <div>
          <h3 class="font-bold text-rose-900 text-sm">Cloudflare R2 Configuration Needed</h3>
          <p class="text-xs text-rose-700 mt-1 leading-relaxed">{errorMsg}</p>
          <p class="text-xs text-rose-700 mt-2 font-semibold">Showing simulated subjects below so you can inspect the design layout.</p>
        </div>
      </div>
    )}

    <!-- Subjects Section -->
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
        Subjects
        <span id="subject-count" class="text-xs px-2.5 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full font-bold">{subjects.length}</span>
      </h2>
      <span class="text-xs text-slate-600 font-medium">Sorted alphabetically</span>
    </div>

    <!-- Grid of Subjects -->
    {subjects.length === 0 ? (
      <div class="text-center py-16 bg-white rounded-3xl border border-slate-100 shadow-sm">
        <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        <h3 class="mt-4 text-sm font-bold text-slate-900">No subjects found</h3>
        <p class="mt-1.5 text-xs text-slate-600">Drop HTML files into subject subfolders in your watch folder to upload them to R2.</p>
      </div>
    ) : (
      <div id="subjects-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 animate-stagger">
        {subjects.map(({ name, lectureCount }) => {
          const subjectParam = encodeURIComponent(name);
          return (
            <a
              href={isDemoMode && errorMsg ? `#` : `/subject/${subjectParam}`}
              data-subject-name={name.toLowerCase()}
              class="subject-card group bg-white rounded-2xl border border-slate-150 p-6 shadow-sm hover:shadow-xl hover:border-indigo-200 hover:-translate-y-1 transition-all duration-300 flex flex-col h-full relative overflow-hidden"
            >
              <!-- Top Glow -->
              <div class="absolute -right-6 -top-6 w-20 h-20 bg-indigo-500/5 rounded-full group-hover:bg-indigo-500/10 group-hover:scale-125 transition-all duration-300"></div>

              <div class="flex items-start gap-4 mb-4">
                <!-- Subject Icon -->
                <div class="w-12 h-12 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600 shrink-0 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                </div>
                <div class="flex-grow">
                  <h3 class="font-bold text-slate-800 leading-snug group-hover:text-indigo-600 transition-colors line-clamp-2">
                    {name}
                  </h3>
                  <p class="text-xs text-slate-600 mt-1 font-medium flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    {lectureCount} {lectureCount === 1 ? 'Lecture' : 'Lectures'}
                  </p>
                </div>
              </div>

              <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-indigo-600 font-bold">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                  </svg>
                  Browse Lectures
                </span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>

              {isDemoMode && errorMsg && (
                <div class="absolute inset-0 bg-slate-900/5 backdrop-blur-[0.5px] rounded-2xl flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                  <span class="bg-slate-800 text-white text-xs px-3 py-1.5 rounded-lg shadow-md font-bold">Configure R2 to View</span>
                </div>
              )}
            </a>
          );
        })}
      </div>
    )}
  </main>
</BaseLayout>

<!-- Client side search script -->
<script is:inline>
  const searchInput = document.getElementById('search-input');
  const searchCards = document.querySelectorAll('.subject-card');
  searchCards.forEach((card, i) => { card.style.setProperty('--i', i); });
  const subjectCount = document.getElementById('subject-count');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase().trim();
      let visibleCount = 0;

      searchCards.forEach((card) => {
        const name = card.getAttribute('data-subject-name') || '';
        if (name.includes(searchTerm)) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (subjectCount) {
        subjectCount.textContent = visibleCount;
      }
    });
  }
</script>
