---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listSubjects } from '../utils/notesLoader';

export const prerender = false;

const subjects = await listSubjects();
const homeKeywords = 'lecture notes, study guides, classroom notes, bitsnotes, free study materials, AI notes, machine learning notes, deep learning, natural language processing, software engineering, data management, postgraduate notes, exam preparation';

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "BitsNotes",
  "url": "https://bitsnotes.com",
  "description": "Free classroom notes, lecture notes, and study guides for postgraduate students.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://bitsnotes.com/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const webSiteJson = JSON.stringify(webSiteSchema);
---

<BaseLayout
  title="Classroom Notes & Lectures | BitsNotes"
  description="Access classroom notes, lectures, and study guides for free. Browse subjects and open individual lecture notes in a viewer."
  keywords={homeKeywords}
  robots="index, follow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={webSiteJson} />
  </Fragment>

  <div class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <!-- Editorial page header — no hero card, no blobs, no badges -->
    <header class="mb-10">
      <h1 class="font-display text-4xl md:text-5xl font-extrabold text-[var(--text)] leading-tight tracking-tight">
        Lecture notes for AI &amp; ML
      </h1>
      <p class="mt-2 text-[var(--text-muted)] text-base max-w-prose">
        Free, comprehensive notes covering postgraduate computer science topics. Browse subjects, open lectures in the viewer, and study at your own pace.
      </p>

      <!-- Prominent but minimal search trigger -->
      <button
        type="button"
        id="homepage-search-trigger"
        class="mt-6 flex w-full max-w-md items-center gap-3 pl-3.5 pr-4 py-2.5 border border-[var(--border)] text-black bg-white text-sm rounded-[var(--r-sm)] hover:border-[var(--border-strong)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-all cursor-pointer text-left group"
        aria-label="Open universal search"
      >
        <svg class="w-4 h-4 text-black/70 group-hover:text-black transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <span class="flex-grow text-black/80 group-hover:text-black transition-colors">Search notes, concepts, and subjects...</span>
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[9px] font-sans font-semibold text-black/70 bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[4px] leading-none shrink-0">Ctrl+K</kbd>
      </button>
    </header>

    <!-- Subjects grid -->
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-sm font-bold text-[var(--text-muted)] uppercase tracking-widest">
        Subjects
        <span id="subject-count" class="ml-2 text-[var(--text-faint)] font-normal normal-case tracking-normal">({subjects.length})</span>
      </h2>
    </div>

    {subjects.length === 0 ? (
      <div class="text-center py-16 border border-[var(--border)] rounded-[var(--r-md)]">
        <svg class="mx-auto h-10 w-10 text-[var(--text-faint)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        <h3 class="mt-3 text-sm font-bold text-[var(--text)]">No subjects found</h3>
        <p class="mt-1 text-xs text-[var(--text-muted)]">Add HTML note files to src/content/notes/ and redeploy.</p>
      </div>
    ) : (
      <div id="subjects-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {subjects.map(({ name, lectureCount }) => {
          const param = encodeURIComponent(name);
          return (
            <a
              href={`/subject/${param}`}
              data-subject-name={name.toLowerCase()}
               class="group border border-[var(--border)] rounded-[var(--r-md)] p-5 hover:border-[var(--border-strong)] hover:bg-[var(--bg-subtle)] transition-colors no-underline"
            >
              <div class="flex items-start gap-3">
                <!-- Monoline book glyph -->
                <div class="mt-0.5 w-8 h-8 rounded-[var(--r-sm)] bg-[var(--accent-subtle)] flex items-center justify-center text-[var(--accent)] shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="font-display font-bold text-[var(--text)] text-base leading-snug group-hover:text-[var(--accent)] transition-colors line-clamp-2">
                    {name}
                  </h3>
                  <p class="text-xs text-[var(--text-muted)] mt-1">
                    {lectureCount} {lectureCount === 1 ? 'lecture' : 'lectures'}
                  </p>
                </div>
                <!-- Accent arrow nudge on hover -->
                <svg class="w-4 h-4 text-[var(--text-faint)] mt-1 shrink-0 group-hover:text-[var(--accent)] group-hover:translate-x-0.5 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>

<script defer src="/auth-features.js"></script>

<script is:inline>
  // ─── Dashboard auth features: recently saved + progress bars ─────
  (function () {
    var BN = window.BitsNotes;
    if (!BN) return;

    fetch('/api/bookmarks/list', { credentials: 'same-origin' }).then(function (r) {
      if (r.status === 401) return false;
      return r.json().then(function () { return true; });
    }).then(function (loggedIn) {
      if (!loggedIn) return;

      // Load recently saved
      BN.json('/api/bookmarks/list').then(function (data) {
        if (!data || !data.recentBookmarks) return;
        var allBm = data.recentBookmarks;
        if (allBm.length === 0) return;

        var header = document.querySelector('header');
        if (!header) return;

        var section = document.createElement('section');
        section.className = 'mb-8';
        section.innerHTML = '<h2 class="text-sm font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">Recently saved</h2>' +
          '<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="recently-saved-grid"></div>';
        header.parentNode.insertBefore(section, header.nextSibling);

        var grid = section.querySelector('#recently-saved-grid');
        allBm.forEach(function (bm) {
          var a = document.createElement('a');
          a.href = '/view/' + encodeURIComponent(bm.subject) + '/' + encodeURIComponent(bm.lecture);
          a.className = 'flex items-center gap-3 p-3 border border-[var(--border)] bg-[var(--bg-elevated)] rounded-[var(--r-sm)] hover:border-[var(--accent)] hover:bg-[var(--bg-subtle)] transition-colors no-underline group';
          a.innerHTML =
            '<div class="w-7 h-7 rounded-[6px] bg-[var(--accent-subtle)] flex items-center justify-center shrink-0">' +
            '<svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>' +
            '</div>' +
            '<div class="min-w-0 flex-1">' +
            '<p class="text-sm font-medium text-[var(--text)] group-hover:text-[var(--accent)] transition-colors line-clamp-1">' + bm.display_name + '</p>' +
            '<p class="text-[10px] text-[var(--text-muted)] truncate">' + bm.subject + '</p>' +
            '</div>';
          grid.appendChild(a);
        });
      });

      // Load progress for each subject card
      BN.json('/api/progress/list').then(function (data) {
        if (!data || !data.summary) return;
        document.querySelectorAll('[data-subject-name]').forEach(function (card) {
          var name = card.getAttribute('data-subject-name');
          var prog = null;
          // Match by checking if the summary key matches (case-insensitive)
          Object.keys(data.summary).forEach(function (k) {
            if (k.toLowerCase() === name.toLowerCase()) prog = data.summary[k];
          });
          if (!prog || prog.total === 0) return;

          var bar = document.createElement('div');
          bar.className = 'mt-2';
          bar.innerHTML =
            '<div class="flex items-center gap-2 mb-1">' +
            '<div class="flex-1 h-1.5 bg-[var(--bg-subtle)] rounded-full overflow-hidden">' +
            '<div class="h-full rounded-full bg-[var(--accent)] transition-all duration-500" style="width:' + prog.percent + '%"></div>' +
            '</div>' +
            '<span class="text-[10px] text-[var(--text-faint)] tabular-nums shrink-0">' + prog.read + '/' + prog.total + '</span>' +
            '</div>';

          // Insert after the lecture count paragraph
          var countEl = card.querySelector('p.text-xs');
          if (countEl && countEl.textContent.includes('lecture')) {
            countEl.parentNode.insertBefore(bar, countEl.nextSibling);
          }
        });
      });
    });
  })();
</script>

