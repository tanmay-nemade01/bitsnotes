---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us | BitsNotes" 
  description="Have questions about the lecture notes or need study support? Get in touch with us through our contact form."
  keywords="contact bitsnotes, lecture notes support, study help, educational support, DMCA inquiries"
  robots="index, follow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Contact BitsNotes",
      "description": "Contact form for BitsNotes - lecture notes support, DMCA inquiries, and general questions.",
      "url": "https://bitsnotes.com/contact"
    })} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex-grow w-full">
    <!-- Editorial header -->
    <header class="mb-10">
      <h1 class="font-display text-4xl md:text-5xl font-extrabold text-[var(--text)] tracking-tight leading-tight">
        Get in touch
      </h1>
      <p class="mt-2 text-[var(--text-muted)] text-lg">
        Have questions about the notes, found a typo, or want to suggest new topics? Drop a message below.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      <!-- Left: contact detail -->
      <div class="lg:col-span-1">
        <div class="p-5 border border-[var(--border)] rounded-[var(--r-md)]">
          <div class="w-8 h-8 rounded-[var(--r-sm)] bg-[var(--accent-subtle)] flex items-center justify-center text-[var(--accent)] mb-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-bold text-sm text-[var(--text)]">Email Address</h3>
          <p class="text-sm text-[var(--text-muted)] mt-1">For support or questions:</p>
          <a href="mailto:support@bitsnotes.com" class="text-sm font-bold text-[var(--accent)] hover:text-[var(--accent-hover)] block mt-2 transition-colors">
            support@bitsnotes.com
          </a>
        </div>
      </div>

      <!-- Right: contact form -->
      <div class="lg:col-span-2 p-6 border border-[var(--border)] rounded-[var(--r-md)] relative">
        <form id="contact-form" class="space-y-5">
          <!-- Honeypot -->
          <div style="position:absolute;left:-9999px" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="_website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-bold text-[var(--text)] uppercase tracking-wider mb-1.5">Your Name</label>
              <input type="text" id="name" required placeholder="John Doe"
                class="block w-full px-3.5 py-2.5 border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] placeholder-[var(--text-faint)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150" />
            </div>
            <div>
              <label for="email" class="block text-xs font-bold text-[var(--text)] uppercase tracking-wider mb-1.5">Email Address</label>
              <input type="email" id="email" required placeholder="john@example.com"
                class="block w-full px-3.5 py-2.5 border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] placeholder-[var(--text-faint)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150" />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold text-[var(--text)] uppercase tracking-wider mb-1.5">Subject</label>
            <input type="text" id="subject" required placeholder="Lecture notes feedback / Question"
              class="block w-full px-3.5 py-2.5 border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] placeholder-[var(--text-faint)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150" />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold text-[var(--text)] uppercase tracking-wider mb-1.5">Message</label>
            <textarea id="message" rows="5" required placeholder="Type your message details here..."
              class="block w-full px-3.5 py-2.5 border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] placeholder-[var(--text-faint)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)] transition-colors duration-150 resize-none"></textarea>
          </div>

          <!-- Error alert -->
          <div id="error-alert" class="hidden border-l-3 border-[var(--callout-warning-border)] bg-[var(--callout-warning-bg)] rounded-r-[var(--r-sm)] p-4 text-sm text-[var(--callout-warning-text)]">
            <span class="font-bold">Message failed to send.</span>
            <p id="error-message" class="mt-0.5"></p>
          </div>

          <button type="submit"
            class="px-6 py-2.5 bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-contrast)] text-sm font-bold rounded-[var(--r-sm)] transition-colors cursor-pointer flex items-center gap-2 active:scale-[0.97]">
            Send Message
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </form>

        <!-- Success overlay -->
        <div id="success-alert" class="hidden absolute inset-0 rounded-[var(--r-md)] flex flex-col items-center justify-center text-center p-8">
          <div class="w-14 h-14 rounded-[var(--r-md)] bg-[var(--callout-example-bg)] border border-[var(--callout-example-border)] flex items-center justify-center text-[var(--callout-example-text)] mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--text)]">Message Sent Successfully!</h3>
          <p class="text-sm text-[var(--text-muted)] mt-2 max-w-sm">Thank you for reaching out. We have received your query and will get back to you as soon as possible.</p>
          <button type="button" id="reset-form-btn"
            class="mt-5 text-xs font-bold text-[var(--accent)] hover:text-[var(--accent-hover)] py-1.5 px-3 rounded-[var(--r-sm)] hover:bg-[var(--accent-subtle)] transition-colors">
            Send another message
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const alertBox = document.getElementById('success-alert');
  const errorBox = document.getElementById('error-alert');
  const errorMsg = document.getElementById('error-message');
  const resetBtn = document.getElementById('reset-form-btn');
  const submitBtn = form?.querySelector('button[type="submit"]');
  const originalText = submitBtn ? submitBtn.innerHTML : 'Send Message';

  if (form && alertBox) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('name').value;
      const email = document.getElementById('email').value;
      const subject = document.getElementById('subject').value;
      const message = document.getElementById('message').value;
      const _website = document.getElementById('website').value;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
        submitBtn.innerHTML = 'Sending... <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>';
      }
      if (errorBox) errorBox.classList.add('hidden');

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, subject, message, _website }),
        });
        const data = await response.json();
        if (response.ok && data.success) {
          alertBox.classList.remove('hidden');
          form.reset();
        } else {
          if (errorMsg) errorMsg.textContent = data.error || 'Something went wrong. Please try again.';
          if (errorBox) errorBox.classList.remove('hidden');
        }
      } catch (err) {
        if (errorMsg) errorMsg.textContent = 'A network error occurred. Please check your connection.';
        if (errorBox) errorBox.classList.remove('hidden');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
          submitBtn.innerHTML = originalText;
        }
      }
    });
  }

  if (resetBtn && alertBox) {
    resetBtn.addEventListener('click', () => {
      alertBox.classList.add('hidden');
      if (errorBox) errorBox.classList.add('hidden');
    });
  }
</script>
