---
/**
 * Account settings — self-serve account deletion (GDPR) and backup account linking.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUser, getEnv } from '../lib/apiHelpers';
import { findUserById } from '../lib/auth/db';
import { isBackupEmailEligible } from '../lib/auth/backupEmail';
import { formatAccessDate } from '../lib/auth/access';
import { isAdmin } from '../lib/comments';

export const prerender = false;

const user = getUser(Astro);
if (!user) {
  return Astro.redirect('/auth/signin?redirect=/account');
}

const env = await getEnv();
const row = env.DB ? await findUserById(env.DB, user.id) : null;
const backupEligible = isBackupEmailEligible(user.email);
const isBackupLocked = backupEligible && row?.backup_email_verified_at != null;
const backupEmail = isBackupLocked ? (row?.backup_email ?? '') : '';
const isAdminUser = env.DB ? await isAdmin(env.DB, user.id) : false;

const userTag = row?.tags || user?.tags || 'normal';
const accessExpiresAt = row?.access_expires_at ?? user?.accessExpiresAt ?? null;
const isAccessExpired = Boolean(accessExpiresAt != null && Date.now() > accessExpiresAt && !isAdminUser);
const formattedAccessDate = formatAccessDate(accessExpiresAt);

const backupLinked = Astro.url.searchParams.get('backup') === 'linked';
const backupError = Astro.url.searchParams.get('backup_error');
let backupBannerMessage = '';
let backupBannerSuccess = false;
if (backupLinked) {
  backupBannerMessage = 'Backup Google account linked.';
  backupBannerSuccess = true;
} else if (backupError) {
  backupBannerSuccess = false;
  if (backupError === 'unverified') {
    backupBannerMessage = 'Google reports that email as unverified.';
  } else if (backupError === 'same_as_primary') {
    backupBannerMessage = 'Pick a different Google account from your main one.';
  } else if (backupError === 'has_account') {
    backupBannerMessage = 'That Google account already has its own BitsNotes account. Delete that account first, then try again.';
  } else if (backupError === 'already_backup' || backupError === 'identity_taken') {
    backupBannerMessage = 'That Google account is already linked to another BitsNotes account.';
  } else if (backupError === 'already_set') {
    backupBannerMessage = 'A backup account is already linked.';
  } else {
    backupBannerMessage = 'Could not link the backup account. Please try again.';
  }
}
---

<BaseLayout
  title="Account — BitsNotes"
  description="Manage your BitsNotes account."
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="max-w-lg mx-auto px-4 sm:px-6 py-12 flex-grow">
    <h1 class="font-display text-3xl font-extrabold text-[var(--text)] mb-2">Your account</h1>
    <p class="text-sm text-[var(--text-muted)] mb-8">
      Signed in as <span class="font-medium text-[var(--text)]">{user.email}</span>
    </p>

    {backupBannerMessage && (
      <div
        class={`p-3 text-sm rounded-[var(--r-sm)] border mb-6 ${
          backupBannerSuccess
            ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-800 dark:text-emerald-200'
            : 'bg-rose-500/10 border-rose-500/30 text-rose-800 dark:text-rose-200'
        }`}
        role="status"
      >
        {backupBannerMessage}
      </div>
    )}

    {isAdminUser && (
      <a
        href="/backstage"
        class="flex items-center gap-3 border border-[var(--accent)]/30 rounded-[var(--r-md)] p-4 mb-6 bg-[var(--accent-subtle)] no-underline hover:border-[var(--accent)] transition-colors"
      >
        <span class="w-9 h-9 rounded-[var(--r-sm)] bg-[var(--accent)] text-[var(--accent-contrast)] flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block font-display font-bold text-[var(--text)]">Admin dashboard</span>
          <span class="block text-xs text-[var(--text-muted)]">Manage comments, tags and supporters.</span>
        </span>
        <svg class="w-4 h-4 shrink-0 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </a>
    )}

    <!-- Access & Membership status -->
    <section class="border border-[var(--border)] rounded-[var(--r-md)] p-5 space-y-3 mb-6 bg-[var(--bg-elevated)]">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-lg font-bold text-[var(--text)]">Access & Membership</h2>
        <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-full border ${
          userTag === 'batchmate'
            ? 'bg-[var(--accent-subtle)] text-[var(--accent)] border-[var(--accent)]/30'
            : 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border-[var(--border)]'
        }`}>
          {userTag === 'batchmate' ? '🎓 Batchmate' : 'Member'}
        </span>
      </div>

      <div class="pt-1 text-sm space-y-1">
        <div class="flex items-center justify-between">
          <span class="text-[var(--text-muted)]">Access status</span>
          {isAccessExpired ? (
            <span class="font-semibold text-rose-600 dark:text-rose-400">
              Expired ({formattedAccessDate})
            </span>
          ) : (
            <span class="font-semibold text-emerald-600 dark:text-emerald-400">
              Active {accessExpiresAt ? `(until ${formattedAccessDate})` : '(Indefinite)'}
            </span>
          )}
        </div>
        {isAccessExpired && (
          <p class="text-xs text-rose-600 dark:text-rose-400 pt-1 leading-relaxed">
            Your free access period has ended. Please <a href="/contact" class="underline hover:text-[var(--accent)]">contact an administrator</a> to extend or renew access.
          </p>
        )}
      </div>
    </section>

    <section
      id="backup-email-section"
      class={`border border-[var(--border)] rounded-[var(--r-md)] p-5 space-y-4 mb-6 ${backupEligible ? '' : 'opacity-50'}`}
      aria-disabled={backupEligible ? 'false' : 'true'}
    >
      <div class="flex items-center justify-between">
        <h2 class="font-display text-lg font-bold text-[var(--text)]">Backup email</h2>
        {isBackupLocked && (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">
            <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Permanently linked
          </span>
        )}
      </div>

      {isBackupLocked ? (
        <div class="space-y-3">
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">
            Your backup email is linked to this account. Even if your university email expires, signing in with this email connects you to this same account.
          </p>
          <div class="flex flex-col sm:flex-row gap-2">
            <input
              type="email"
              id="backup-email-input"
              value={backupEmail}
              disabled
              readonly
              class="flex-1 px-3 py-2 text-sm rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text)] cursor-not-allowed opacity-80"
            />
          </div>
          <p class="text-xs text-[var(--text-muted)]">
            As a security measure, your backup email cannot be changed or removed once set.
          </p>
        </div>
      ) : backupEligible ? (
        <div class="space-y-3">
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">
            If your college email stops working, you can sign in to this same account with your backup Google account. Linking is one-time and cannot be changed.
          </p>
          <div>
            <button
              type="button"
              id="backup-link-btn"
              class="px-4 py-2 text-sm font-semibold rounded-[var(--r-sm)] border border-[var(--accent)] text-[var(--accent)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer disabled:cursor-not-allowed disabled:border-[var(--border)] disabled:text-[var(--text-muted)]"
            >
              Link backup Google account
            </button>
          </div>
          <p id="backup-email-status" class="text-sm text-[var(--text-muted)] hidden" role="status"></p>
        </div>
      ) : (
        <div class="space-y-3">
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">
            Backup email is only available for WILP accounts that start with 2025 (e.g. 2025xxxx@wilp.bits-pilani.ac.in).
          </p>
          <div class="flex flex-col sm:flex-row gap-2">
            <input
              type="email"
              value=""
              placeholder="Not available"
              disabled
              class="flex-1 px-3 py-2 text-sm rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] disabled:cursor-not-allowed"
            />
            <button
              type="button"
              disabled
              class="px-4 py-2 text-sm font-semibold rounded-[var(--r-sm)] border border-[var(--border)] text-[var(--text-muted)] disabled:cursor-not-allowed"
            >
              Link backup Google account
            </button>
          </div>
        </div>
      )}
    </section>

    <section class="border border-[var(--border)] rounded-[var(--r-md)] p-5 space-y-4">
      <h2 class="font-display text-lg font-bold text-[var(--text)]">Delete account</h2>
      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Permanently deletes your account, bookmarks, and reading progress.
        Public comments you posted stay visible but are disconnected from your identity.
        This cannot be undone.
      </p>
      <button
        type="button"
        id="delete-account-btn"
        class="px-4 py-2 text-sm font-semibold rounded-[var(--r-sm)] border border-[var(--danger)] text-[var(--danger)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
      >
        Delete my account
      </button>
      <p id="delete-account-status" class="text-sm text-[var(--text-muted)] hidden" role="status"></p>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var linkBtn = document.getElementById('backup-link-btn');
    var status = document.getElementById('backup-email-status');
    function show(t) { if (status) { status.classList.remove('hidden'); status.textContent = t; } }
    if (linkBtn) {
      linkBtn.addEventListener('click', function () {
        if (linkBtn.disabled) return;
        var confirmed = window.confirm(
          'Are you sure you want to link a backup Google account?\\n\\nImportant: Linking is one-time and cannot be changed or removed later.'
        );
        if (!confirmed) return;

        linkBtn.disabled = true;
        linkBtn.textContent = 'Redirecting to Google…';

        fetch('/api/auth/link-backup', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: '{}',
        })
          .then(function (res) {
            return res.json().then(function (data) {
              return { ok: res.ok, data: data };
            });
          })
          .then(function (result) {
            if (result.ok && result.data && result.data.url) {
              window.location.href = result.data.url;
            } else {
              linkBtn.disabled = false;
              linkBtn.textContent = 'Link backup Google account';
              show((result.data && result.data.error) || 'Could not initiate Google link.');
            }
          })
          .catch(function () {
            linkBtn.disabled = false;
            linkBtn.textContent = 'Link backup Google account';
            show('Network error. Please try again.');
          });
      });
    }
  })();
</script>

<script is:inline>
  (function () {
    var btn = document.getElementById('delete-account-btn');
    var status = document.getElementById('delete-account-status');
    if (!btn) return;

    btn.addEventListener('click', function () {
      var ok = window.confirm(
        'Delete your BitsNotes account permanently? This cannot be undone.'
      );
      if (!ok) return;

      btn.disabled = true;
      btn.textContent = 'Deleting…';
      if (status) {
        status.classList.remove('hidden');
        status.textContent = '';
      }

      fetch('/api/auth/delete-account', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ confirm: true }),
      })
        .then(function (res) {
          return res.json().then(function (data) {
            return { ok: res.ok, data: data };
          });
        })
        .then(function (result) {
          if (result.ok) {
            try { sessionStorage.removeItem('bitsnotes-user'); } catch (e) {}
            window.location.href = '/?deleted=1';
            return;
          }
          btn.disabled = false;
          btn.textContent = 'Delete my account';
          if (status) status.textContent = (result.data && result.data.error) || 'Deletion failed. Please try again.';
        })
        .catch(function () {
          btn.disabled = false;
          btn.textContent = 'Delete my account';
          if (status) status.textContent = 'Network error. Please try again.';
        });
    });
  })();
</script>
