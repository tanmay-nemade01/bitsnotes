---
/**
 * AdminLayout — dedicated shell for every /backstage page.
 *
 * Renders a persistent sidebar + compact top bar and hides the public site
 * chrome (navbar / footer / banner / search / cookie banner).
 *
 * Access control is enforced in src/middleware.ts for the whole /backstage
 * subtree (redirect to sign-in when signed out, 404 for non-admins). This
 * layout only reads `locals` for presentation.
 */
import BaseLayout from './BaseLayout.astro';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;

const user = (Astro.locals as any).user ?? null;
const displayName = user?.displayName || user?.email || 'Admin';
const initial = String(displayName)[0].toUpperCase();
---

<BaseLayout
  title={`${title} — BitsNotes Admin`}
  description="BitsNotes administration."
  hideChrome
  adminShell
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="admin-shell w-full flex-grow" data-admin-shell>
    <!-- Backdrop (mobile) -->
    <div
      id="admin-backdrop"
      data-admin-backdrop
      class="hidden fixed inset-0 z-40 bg-[var(--scrim)] lg:hidden"
      aria-hidden="true"
    ></div>

    <!-- Sidebar -->
    <aside
      id="admin-sidebar"
      data-admin-sidebar
      class="fixed inset-y-0 left-0 z-50 w-64 -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-[var(--ease-out)] bg-[var(--bg-elevated)] border-r border-[var(--border)] flex flex-col"
      aria-label="Admin navigation"
    >
      <div class="h-14 shrink-0 flex items-center gap-2 px-4 border-b border-[var(--border)]">
        <a href="/backstage" class="font-display text-lg font-bold text-[var(--text)] no-underline hover:text-[var(--accent)] transition-colors">
          BitsNotes
        </a>
        <span class="rounded-full border border-[var(--accent)]/30 bg-[var(--accent-subtle)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-[var(--accent)]">
          Admin
        </span>
      </div>

      <div class="flex-1 overflow-y-auto px-3 py-4">
        <AdminSidebar />
      </div>

      <div class="shrink-0 border-t border-[var(--border)] p-3">
        <div class="flex items-center gap-2.5">
          {user?.avatarUrl ? (
            <img src={user.avatarUrl} alt="" class="w-8 h-8 rounded-full" referrerpolicy="no-referrer" />
          ) : (
            <span class="w-8 h-8 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] flex items-center justify-center text-sm font-bold">
              {initial}
            </span>
          )}
          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold text-[var(--text)] truncate">{displayName}</p>
            <p class="text-[11px] text-[var(--text-muted)] truncate">{user?.email ?? ''}</p>
          </div>
        </div>
        <form action="/api/auth/signout" method="POST" class="mt-2.5">
          <button
            type="submit"
            class="w-full rounded-[var(--r-sm)] border border-[var(--border)] px-3 py-1.5 text-xs font-semibold text-[var(--danger)] hover:border-[var(--danger)] transition-colors cursor-pointer"
          >
            Sign out
          </button>
        </form>
      </div>
    </aside>

    <!-- Content column -->
    <div class="lg:pl-64 flex flex-col min-h-screen">
      <header class="sticky top-0 z-30 h-14 shrink-0 bg-[var(--bg-elevated)]/95 backdrop-blur border-b border-[var(--border)] flex items-center gap-3 px-4 sm:px-6">
        <button
          type="button"
          data-admin-menu-toggle
          class="lg:hidden p-2 -ml-2 rounded-[var(--r-sm)] text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
          aria-label="Toggle admin menu"
          aria-controls="admin-sidebar"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>

        <div class="min-w-0">
          <h1 class="font-display text-base font-bold text-[var(--text)] truncate">{title}</h1>
          {subtitle && <p class="text-[11px] text-[var(--text-muted)] truncate hidden sm:block">{subtitle}</p>}
        </div>

        <div class="ml-auto flex items-center gap-2">
          <div class="hidden sm:block">
            <ThemeToggle />
          </div>
          <a
            href="/"
            class="inline-flex items-center gap-1.5 h-8 px-3 text-xs font-semibold rounded-[var(--r-sm)] border border-[var(--border)] bg-[var(--bg-interactive)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors no-underline"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
            <span class="hidden sm:inline">View site</span>
          </a>
        </div>
      </header>

      <div class="admin-main flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  (function () {
    // ── Shared client helpers (available to every admin page script) ──
    var A = (window.__bnAdmin = window.__bnAdmin || {});

    if (!A.esc) {
      A.esc = function (s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      };
    }

    if (!A.timeAgo) {
      A.timeAgo = function (ts) {
        var diff = Date.now() - ts;
        var m = Math.floor(diff / 60000);
        if (m < 1) return 'just now';
        if (m < 60) return m + 'm ago';
        var h = Math.floor(m / 60);
        if (h < 24) return h + 'h ago';
        var d = Math.floor(h / 24);
        if (d < 30) return d + 'd ago';
        return new Date(ts).toLocaleDateString();
      };
    }

    if (!A.getJSON) {
      A.getJSON = function (path) {
        return fetch(path, { credentials: 'same-origin', cache: 'no-store' }).then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        });
      };
    }

    if (!A.postJSON) {
      A.postJSON = function (path, body, method) {
        return fetch(path, {
          method: method || 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: body == null ? undefined : JSON.stringify(body),
        }).then(function (r) {
          return r.json().then(
            function (d) { return { ok: r.ok, status: r.status, data: d }; },
            function () { return { ok: r.ok, status: r.status, data: {} }; },
          );
        });
      };
    }

    // ── Mobile sidebar drawer ──
    function closeDrawer() {
      var root = document.querySelector('[data-admin-shell]');
      if (!root) return;
      var sidebar = root.querySelector('[data-admin-sidebar]');
      var backdrop = root.querySelector('[data-admin-backdrop]');
      var toggle = root.querySelector('[data-admin-menu-toggle]');
      if (sidebar) sidebar.classList.add('-translate-x-full');
      if (backdrop) backdrop.classList.add('hidden');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
    }

    function initDrawer() {
      var root = document.querySelector('[data-admin-shell]');
      if (!root || root.dataset.drawerBound === 'true') return;
      var sidebar = root.querySelector('[data-admin-sidebar]');
      var backdrop = root.querySelector('[data-admin-backdrop]');
      var toggle = root.querySelector('[data-admin-menu-toggle]');
      if (!sidebar || !toggle) return;
      root.dataset.drawerBound = 'true';

      function open() {
        sidebar.classList.remove('-translate-x-full');
        if (backdrop) backdrop.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('overflow-hidden');
      }
      function close() {
        sidebar.classList.add('-translate-x-full');
        if (backdrop) backdrop.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
      }

      toggle.addEventListener('click', function () {
        if (sidebar.classList.contains('-translate-x-full')) open();
        else close();
      });
      if (backdrop) backdrop.addEventListener('click', close);
      sidebar.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          if (window.innerWidth < 1024) close();
        });
      });
    }

    function bootDrawer() {
      var sidebar = document.querySelector('[data-admin-sidebar]');
      if (sidebar && window.innerWidth < 1024) sidebar.classList.add('-translate-x-full');
      initDrawer();
    }

    // Register document-level listeners exactly once per tab.
    if (!A.adminBootBound) {
      A.adminBootBound = true;
      document.addEventListener('astro:page-load', bootDrawer);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDrawer();
      });
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootDrawer);
      else bootDrawer();
    } else {
      bootDrawer();
    }
  })();
</script>

<style>
  .admin-main {
    animation: adminFadeIn 0.18s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes adminFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
