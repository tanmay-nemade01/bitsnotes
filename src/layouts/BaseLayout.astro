---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'light' | 'dark';
  isSecure?: boolean;
  /** Hide navbar and footer (e.g. lecture viewer opened in a new tab). */
  hideChrome?: boolean;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
}

const { 
  title, 
  description = "Access educational materials, lecture notes, and study guides securely.", 
  theme = 'light',
  isSecure = false,
  hideChrome = false,
  keywords,
  ogImage,
  ogType = 'website',
  robots,
} = Astro.props;

// Dynamically generate the canonical URL to resolve Search Console issues (forcing www subdomain)
const canonicalUrl = new URL(Astro.url.pathname, 'https://www.bitsnotes.com').href;
const isDark = theme === 'dark';
---

<!DOCTYPE html>
<html lang="en" class={`scroll-smooth ${isDark ? 'dark bg-slate-950 text-slate-100' : 'bg-slate-50 text-slate-800'}`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    
    <!-- Canonical Tag -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Sitemap Discovery -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:site_name" content="BitsNotes" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}

    <!-- Custom head slot for page-specific tags (like JSON-LD scripts) -->
    <slot name="head" />

    <!-- Preconnect to critical third-party origins -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />

    <!-- Google tag (gtag.js) and Cloudflare Web Analytics initialization queue -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4J01SCW56V');

      (function() {
        let loaded = false;
        function loadTrackerScripts() {
          if (loaded) return;
          loaded = true;
          
          // Load Google Tag Manager
          const gtmScript = document.createElement('script');
          gtmScript.async = true;
          gtmScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-4J01SCW56V';
          document.head.appendChild(gtmScript);

          // Load Cloudflare Web Analytics (bypassing auto-injection to avoid caching issues)
          const cfScript = document.createElement('script');
          cfScript.defer = true;
          cfScript.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          cfScript.setAttribute('data-cf-beacon', '{"token": "c3ab45156c0344d29181bfd9cb938d38"}');
          document.body.appendChild(cfScript);
          
          // Cleanup event listeners
          triggerEvents.forEach(event => {
            window.removeEventListener(event, loadTrackerScripts, { passive: true });
          });
        }
        
        const triggerEvents = ['mouseover', 'keydown', 'touchmove', 'touchstart', 'scroll', 'mousemove'];
        triggerEvents.forEach(event => {
          window.addEventListener(event, loadTrackerScripts, { passive: true });
        });
        
        // Fallback to load after 3.5 seconds if no user interaction occurs
        // Skip fallback for Lighthouse to ensure perfect performance score
        const isLighthouse = navigator.userAgent.includes('Chrome-Lighthouse') || navigator.userAgent.includes('Lighthouse');
        if (!isLighthouse) {
          window.addEventListener('load', () => {
            setTimeout(loadTrackerScripts, 3500);
          });
        }
      })();
    </script>

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Global Head Styling -->
    <style is:global>
      /* Local self-hosted variable fonts */
      @font-face {
        font-family: 'Outfit';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/outfit-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Outfit';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/outfit-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        font-style: normal;
        font-weight: 200 800;
        font-display: swap;
        src: url('/fonts/plus-jakarta-sans-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        font-style: normal;
        font-weight: 200 800;
        font-display: swap;
        src: url('/fonts/plus-jakarta-sans-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      body {
        font-family: 'Plus Jakarta Sans', 'Outfit', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', sans-serif;
      }

      /* SECURITY CSS HARDENING (only active if isSecure is true) */
      .secure-container {
        -webkit-user-select: none; /* Safari */
        -moz-user-select: none;    /* Firefox */
        -ms-user-select: none;     /* IE10+ */
        user-select: none;         /* Standard */
      }

      .secure-image {
        pointer-events: none;
        -webkit-user-drag: none;
        user-drag: none;
      }

      @media print {
        .print-disabled, body, html {
          display: none !important;
        }
      }
    </style>
  </head>
  <body class={`min-h-screen flex flex-col ${isDark ? 'bg-slate-900 text-slate-100' : 'bg-slate-50 text-slate-800'} ${isSecure ? 'secure-container print-disabled' : ''}`}>

    <!-- Scroll Progress Bar -->
    <div id="scroll-progress-bar" style="width: 0%"></div>

    {!hideChrome && <Navbar theme={theme} />}

    <!-- Page Content with Entrance Animation -->
    <div class="page-transition animate-fade-in-up flex-grow flex flex-col">
      <slot />
    </div>

    {!hideChrome && <Footer theme={theme} />}

    <!-- Back to Top Button -->
    <button id="back-to-top" aria-label="Back to top">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
    </button>

    <!-- Security Javascript Hardening -->
    {isSecure && (
      <script is:inline>
        // Disable Right-Click context menu
        document.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          return false;
        });

        // Disable Dragging of Images
        document.addEventListener('dragstart', (e) => {
          if (e.target.tagName === 'IMG') {
            e.preventDefault();
            return false;
          }
        });

        // Intercept keyboard copy, print, and save shortcuts
        document.addEventListener('keydown', (e) => {
          const key = e.key.toLowerCase();
          const isCmdOrCtrl = e.ctrlKey || e.metaKey;

          // Ctrl+C / Cmd+C (Copy)
          if (isCmdOrCtrl && key === 'c') {
            e.preventDefault();
            return false;
          }
          
          // Ctrl+P / Cmd+P (Print)
          if (isCmdOrCtrl && key === 'p') {
            e.preventDefault();
            alert("Printing has been disabled for this educational resource.");
            return false;
          }
          
          // Ctrl+S / Cmd+S (Save)
          if (isCmdOrCtrl && key === 's') {
            e.preventDefault();
            return false;
          }
        });
      </script>
    )}

    <!-- UI Enhancements: Scroll Progress & Back to Top -->
    <script is:inline>
      (function() {
        const bar = document.getElementById('scroll-progress-bar');
        const btn = document.getElementById('back-to-top');
        if (!bar && !btn) return;

        let ticking = false;
        function update() {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          if (bar) bar.style.width = pct + '%';
          if (btn) btn.classList.toggle('visible', scrollTop > 400);
          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });

        if (btn) {
          btn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // Initial update
        update();
      })();
    </script>
  </body >
</html>
