---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'light' | 'dark';
  isSecure?: boolean;
  /** Hide navbar and footer (e.g. lecture viewer opened in a new tab). */
  hideChrome?: boolean;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
}

const { 
  title, 
  description = "Access educational materials, lecture notes, and study guides securely.", 
  theme = 'light',
  isSecure = false,
  hideChrome = false,
  keywords,
  ogImage,
  ogType = 'website',
  robots,
} = Astro.props;

// Dynamically generate the canonical URL to resolve Search Console issues
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const isDark = theme === 'dark';
---

<!DOCTYPE html>
<html lang="en" class={`scroll-smooth ${isDark ? 'dark bg-slate-950 text-slate-100' : 'bg-slate-50 text-slate-800'}`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    
    <!-- Canonical Tag -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Sitemap Discovery -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:site_name" content="BitsNotes" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}

    <!-- Custom head slot for page-specific tags (like JSON-LD scripts) -->
    <slot name="head" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4J01SCW56V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4J01SCW56V');
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Global Head Styling -->
    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', 'Outfit', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', sans-serif;
      }

      /* SECURITY CSS HARDENING (only active if isSecure is true) */
      .secure-container {
        -webkit-user-select: none; /* Safari */
        -moz-user-select: none;    /* Firefox */
        -ms-user-select: none;     /* IE10+ */
        user-select: none;         /* Standard */
      }

      .secure-image {
        pointer-events: none;
        -webkit-user-drag: none;
        user-drag: none;
      }

      @media print {
        .print-disabled, body, html {
          display: none !important;
        }
      }
    </style>
  </head>
  <body class={`min-h-screen flex flex-col ${isDark ? 'bg-slate-900 text-slate-100' : 'bg-slate-50 text-slate-800'} ${isSecure ? 'secure-container print-disabled' : ''}`}>

    {!hideChrome && <Navbar theme={theme} />}

    <!-- Slot for Main Content -->
    <slot />

    {!hideChrome && <Footer theme={theme} />}

    <!-- Security Javascript Hardening -->
    {isSecure && (
      <script is:inline>
        // Disable Right-Click context menu
        document.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          return false;
        });

        // Disable Dragging of Images
        document.addEventListener('dragstart', (e) => {
          if (e.target.tagName === 'IMG') {
            e.preventDefault();
            return false;
          }
        });

        // Intercept keyboard copy, print, and save shortcuts
        document.addEventListener('keydown', (e) => {
          const key = e.key.toLowerCase();
          const isCmdOrCtrl = e.ctrlKey || e.metaKey;

          // Ctrl+C / Cmd+C (Copy)
          if (isCmdOrCtrl && key === 'c') {
            e.preventDefault();
            return false;
          }
          
          // Ctrl+P / Cmd+P (Print)
          if (isCmdOrCtrl && key === 'p') {
            e.preventDefault();
            alert("Printing has been disabled for this educational resource.");
            return false;
          }
          
          // Ctrl+S / Cmd+S (Save)
          if (isCmdOrCtrl && key === 's') {
            e.preventDefault();
            return false;
          }
        });
      </script>
    )}
  </body>
</html>
