---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  isSecure?: boolean;
  /** Hide navbar and footer (e.g. lecture viewer opened in a new tab). */
  hideChrome?: boolean;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
}

const { 
  title, 
  description = "Access educational materials, lecture notes, and study guides.", 
  isSecure = false,
  hideChrome = false,
  keywords,
  ogImage,
  ogType = 'website',
  robots,
} = Astro.props;

// Dynamically generate the canonical URL to resolve Search Console issues
const canonicalUrl = new URL(Astro.url.pathname, 'https://bitsnotes.com').href;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="BitsNotes" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <ClientRouter />

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="BitsNotes" />
    {keywords && <meta name="keywords" content={keywords} />}
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    
    <!-- Canonical Tag -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Sitemap Discovery -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage || 'https://bitsnotes.com/og-default.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="BitsNotes" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage || 'https://bitsnotes.com/og-default.png'} />
    <meta property="twitter:image:alt" content={title} />

    <!-- Custom head slot for page-specific tags (like JSON-LD scripts) -->
    <slot name="head" />

    <!-- Preconnect to critical third-party origins -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />

    <!-- Analytics — lazy load without per-frame listeners -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4J01SCW56V');

      (function() {
        function loadTrackers() {
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=G-4J01SCW56V';
          document.head.appendChild(g);

          var c = document.createElement('script');
          c.defer = true;
          c.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          c.setAttribute('data-cf-beacon', '{"token": "c3ab45156c0344d29181bfd9cb938d38"}');
          document.body.appendChild(c);
        }

        // Load after first user interaction (single event, no per-frame noise)
        var loaded = false;
        function onUserInteraction() {
          if (loaded) return;
          loaded = true;
          loadTrackers();
          document.removeEventListener('pointerdown', onUserInteraction);
          document.removeEventListener('keydown', onUserInteraction);
        }
        document.addEventListener('pointerdown', onUserInteraction, { once: true });
        document.addEventListener('keydown', onUserInteraction, { once: true });

        // Fallback after 3.5s
        var isLH = navigator.userAgent.indexOf('Chrome-Lighthouse') > -1 || navigator.userAgent.indexOf('Lighthouse') > -1;
        if (!isLH) {
          addEventListener('load', function() { setTimeout(loadTrackers, 3500); });
        }
      })();
    </script>

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Global Head Styling -->
    <style is:global>
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/fraunces-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/fraunces-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      /* Local self-hosted variable fonts aliased to Inter */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      html { background-color: var(--bg); }

      body {
        font-family: var(--font-body);
        color: var(--text);
        background-color: var(--bg);
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
      }

      /* View transitions — snappy cross-fade, ~80ms total */
      @keyframes vt-out {
        to { opacity: 0; }
      }
      @keyframes vt-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      ::view-transition-old(root) {
        animation: 80ms ease-out both vt-out;
      }
      ::view-transition-new(root) {
        animation: 80ms ease-out both vt-in;
      }

      /* SECURITY CSS HARDENING (only active if isSecure is true) */
      .secure-image {
        pointer-events: none;
        -webkit-user-drag: none;
        user-drag: none;
      }
    </style>
  </head>
  <body class={`min-h-screen flex flex-col ${isSecure ? 'secure-container print-disabled' : ''}`}>

    <!-- Scroll Progress Bar -->
    <div id="scroll-progress-bar" style="width: 0%"></div>

    {!hideChrome && <Navbar />}

    <!-- Page Content — no load-time animations, content appears instantly -->
    <div class="flex-grow flex flex-col">
      <slot />
    </div>

    {!hideChrome && <Footer />}

    <!-- Back to Top Button -->
    <button id="back-to-top" aria-label="Back to top">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
    </button>

    <!-- Dynamic Click Ripple Feedback -->
    <script is:inline>
      (function() {
        document.addEventListener('pointerdown', function(e) {
          // Find closest interactive element
          const target = e.target.closest('a, button, [role="button"], [role="tab"], .quiz-option, input[type="submit"], input[type="button"]');
          if (!target) return;
          if (target.disabled || target.getAttribute('aria-disabled') === 'true') return;

          // Calculate pointer offsets
          const rect = target.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          
          // Size should cover target from clicked point
          const size = Math.max(rect.width, rect.height) * 2;

          // Create ripple element
          const ripple = document.createElement('span');
          ripple.className = 'click-ripple';
          ripple.style.width = ripple.style.height = size + 'px';
          ripple.style.left = x + 'px';
          ripple.style.top = y + 'px';

          // Determine ripple color based on text contrast
          const computed = window.getComputedStyle(target);
          const textColor = computed.color;
          if (textColor.indexOf('255, 255, 255') !== -1 || textColor === 'white' || textColor === 'rgb(255, 255, 255)') {
            ripple.style.backgroundColor = 'rgba(255, 255, 255, 0.35)';
          } else {
            ripple.style.backgroundColor = 'rgba(15, 118, 110, 0.18)';
          }

          // Handle container overflow and relative position
          const originalPosition = target.style.position;
          const originalOverflow = target.style.overflow;
          const isStatic = computed.position === 'static';

          if (isStatic) {
            target.style.position = 'relative';
          }
          target.style.overflow = 'hidden';

          target.appendChild(ripple);

          ripple.addEventListener('animationend', function() {
            ripple.remove();
            if (isStatic) {
              target.style.position = originalPosition;
            }
            target.style.overflow = originalOverflow;
          });
        });
      })();
    </script>

    <!-- UI Enhancements: Scroll Progress & Back to Top -->
    <script is:inline>
      (function() {
        const bar = document.getElementById('scroll-progress-bar');
        const btn = document.getElementById('back-to-top');
        if (!bar && !btn) return;

        let ticking = false;
        function update() {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          if (bar) bar.style.width = pct + '%';
          if (btn) btn.classList.toggle('visible', scrollTop > 400);
          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });

        if (btn) {
          btn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // Initial update
        update();
      })();
    </script>
  </body>
</html>
