---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'light' | 'dark';
  isSecure?: boolean;
}

const { 
  title, 
  description = "Access educational materials, lecture notes, and study guides securely.", 
  theme = 'light',
  isSecure = false 
} = Astro.props;

// Dynamically generate the canonical URL to resolve Search Console issues
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const isDark = theme === 'dark';
---

<!DOCTYPE html>
<html lang="en" class={`scroll-smooth ${isDark ? 'dark bg-slate-950 text-slate-100' : 'bg-slate-50 text-slate-800'}`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <!-- Canonical Tag -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Global Head Styling -->
    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', 'Outfit', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', sans-serif;
      }

      /* SECURITY CSS HARDENING (only active if isSecure is true) */
      .secure-container {
        -webkit-user-select: none; /* Safari */
        -moz-user-select: none;    /* Firefox */
        -ms-user-select: none;     /* IE10+ */
        user-select: none;         /* Standard */
      }

      .secure-image {
        pointer-events: none;
        -webkit-user-drag: none;
        user-drag: none;
      }

      @media print {
        .print-disabled, body, html {
          display: none !important;
        }
      }
    </style>
  </head>
  <body class={`min-h-screen flex flex-col ${isDark ? 'bg-slate-900 text-slate-100' : 'bg-slate-50 text-slate-800'} ${isSecure ? 'secure-container print-disabled' : ''}`}>
    <!-- Top Security Warning Banner for Students -->
    {isSecure && (
      <div class="bg-gradient-to-r from-indigo-600 via-indigo-700 to-violet-800 text-white text-xs text-center py-2 px-4 font-semibold flex items-center justify-center gap-2 shadow-sm shrink-0">
        <svg class="w-4 h-4 text-indigo-200 animate-pulse shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <span>Secure View-Only Student Portal. Copying, printing, and downloading are disabled.</span>
      </div>
    )}

    <!-- Navbar -->
    <Navbar theme={theme} />

    <!-- Slot for Main Content -->
    <slot />

    <!-- Footer -->
    <Footer theme={theme} />

    <!-- Security Javascript Hardening -->
    {isSecure && (
      <script is:inline>
        // Disable Right-Click context menu
        document.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          return false;
        });

        // Disable Dragging of Images
        document.addEventListener('dragstart', (e) => {
          if (e.target.tagName === 'IMG') {
            e.preventDefault();
            return false;
          }
        });

        // Intercept keyboard copy, print, and save shortcuts
        document.addEventListener('keydown', (e) => {
          const key = e.key.toLowerCase();
          const isCmdOrCtrl = e.ctrlKey || e.metaKey;

          // Ctrl+C / Cmd+C (Copy)
          if (isCmdOrCtrl && key === 'c') {
            e.preventDefault();
            return false;
          }
          
          // Ctrl+P / Cmd+P (Print)
          if (isCmdOrCtrl && key === 'p') {
            e.preventDefault();
            alert("Printing has been disabled for this educational resource.");
            return false;
          }
          
          // Ctrl+S / Cmd+S (Save)
          if (isCmdOrCtrl && key === 's') {
            e.preventDefault();
            return false;
          }
        });
      </script>
    )}
  </body>
</html>
