---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import SearchModal from '../components/SearchModal.astro';
import CookieConsent from '../components/CookieConsent.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

interface Props {
  title: string;
  description?: string;
  isSecure?: boolean;
  /** Hide navbar and footer (e.g. lecture viewer opened in a new tab). */
  hideChrome?: boolean;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
}

const { 
  title, 
  description = "Access educational materials, lecture notes, and study guides.", 
  isSecure = false,
  hideChrome = false,
  keywords,
  ogImage,
  ogType = 'website',
  robots,
} = Astro.props;

// Dynamically generate the canonical URL to resolve Search Console issues
const canonicalUrl = new URL(Astro.url.pathname, 'https://bitsnotes.com').href;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <!-- Theme bootstrap — must run before paint to avoid FOUC -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('bitsnotes-theme');
          var resolved = (stored === 'dark' || stored === 'light') ? stored : 'light';
          var root = document.documentElement;
          root.dataset.theme = resolved;
          root.style.colorScheme = resolved;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', resolved === 'dark' ? '#161B22' : '#FFFFFF');

          // Re-apply after Astro view transitions
          document.addEventListener('astro:after-swap', function () {
            var s = localStorage.getItem('bitsnotes-theme');
            var r = (s === 'dark' || s === 'light') ? s : 'light';
            root.dataset.theme = r;
            root.style.colorScheme = r;
            if (meta) meta.setAttribute('content', r === 'dark' ? '#161B22' : '#FFFFFF');
          });
        } catch (e) {}
      })();
    </script>

    <!-- Google Consent Mode v2 Default Settings -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      
      // Load consent from localStorage if exists, otherwise set defaults (denied)
      var savedConsent = null;
      try {
        savedConsent = JSON.parse(localStorage.getItem('bitsnotes-cookie-consent'));
      } catch (e) {}

      if (savedConsent) {
        gtag('consent', 'default', {
          'ad_storage': savedConsent.ads ? 'granted' : 'denied',
          'ad_user_data': savedConsent.ads ? 'granted' : 'denied',
          'ad_personalization': savedConsent.ads ? 'granted' : 'denied',
          'analytics_storage': savedConsent.analytics ? 'granted' : 'denied'
        });
      } else {
        gtag('consent', 'default', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'denied'
        });
      }
    </script>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="BitsNotes" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FAF9F6" />

    <ClientRouter />

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="BitsNotes" />
    {keywords && <meta name="keywords" content={keywords} />}
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    
    <!-- Canonical Tag -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Sitemap Discovery -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage || 'https://bitsnotes.com/og-default.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="BitsNotes" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage || 'https://bitsnotes.com/og-default.png'} />
    <meta property="twitter:image:alt" content={title} />

    <!-- Custom head slot for page-specific tags (like JSON-LD scripts) -->
    <slot name="head" />

    <!-- DNS prefetch to third-party origins to avoid unused preconnect warnings during initial load -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />

    <!-- Analytics — lazy load without per-frame listeners -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4J01SCW56V');

      (function() {
        function loadTrackers() {
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=G-4J01SCW56V';
          document.head.appendChild(g);

          var c = document.createElement('script');
          c.defer = true;
          c.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          c.setAttribute('data-cf-beacon', '{"token": "c3ab45156c0344d29181bfd9cb938d38"}');
          document.body.appendChild(c);
        }

        // Load after first user interaction (single event, no per-frame noise)
        var loaded = false;
        function onUserInteraction() {
          if (loaded) return;
          loaded = true;
          loadTrackers();
          document.removeEventListener('pointerdown', onUserInteraction);
          document.removeEventListener('keydown', onUserInteraction);
        }
        document.addEventListener('pointerdown', onUserInteraction, { once: true });
        document.addEventListener('keydown', onUserInteraction, { once: true });

        // Fallback after 3.5s
        var isLH = navigator.userAgent.indexOf('Chrome-Lighthouse') > -1 || navigator.userAgent.indexOf('Lighthouse') > -1;
        if (!isLH) {
          addEventListener('load', function() { setTimeout(loadTrackers, 3500); });
        }
      })();
    </script>

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Global Head Styling -->
    <style is:global>
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/fraunces-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/fraunces-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      /* Local self-hosted variable fonts aliased to Inter */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      html {
        background-color: var(--bg);
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 256px 256px;
        max-width: 100%;
        overflow-x: clip;
      }

      body {
        font-family: var(--font-body);
        color: var(--text);
        background-color: var(--bg);
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 256px 256px;
        max-width: 100%;
        overflow-x: clip;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
      }

      /* View transitions — snappy cross-fade, ~80ms total */
      @keyframes vt-out {
        to { opacity: 0; }
      }
      @keyframes vt-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      ::view-transition-old(root) {
        animation: 80ms ease-out both vt-out;
      }
      ::view-transition-new(root) {
        animation: 80ms ease-out both vt-in;
      }

      /* SECURITY CSS HARDENING (only active if isSecure is true) */
      .secure-image {
        pointer-events: none;
        -webkit-user-drag: none;
        user-drag: none;
      }
    </style>
  </head>
  <body class={`min-h-screen flex flex-col ${isSecure ? 'secure-container print-disabled' : ''}`}>

    <!-- Skip to main content — accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-[var(--accent)] focus:text-[var(--accent-contrast)] focus:rounded-[var(--r-sm)] focus:shadow-lg focus:outline-none">
      Skip to main content
    </a>

    <!-- Navigation Progress Bar (loading indicator) -->
    <div id="nav-progress-bar"></div>

    <!-- Scroll Progress Bar -->
    <div id="scroll-progress-bar" style="width: 0%"></div>

    {!hideChrome && <Navbar />}

    <!-- Page Content — no load-time animations, content appears instantly -->
    <main id="main-content" class="flex-grow flex flex-col" tabindex="-1">
      <slot />
    </main>

    {!hideChrome && <Footer />}

    <SearchModal />
    <CookieConsent />
    {!hideChrome && <NewsletterForm />}

    <!-- Back to Top Button -->
    <button id="back-to-top" aria-label="Back to top">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
    </button>

    <!-- Navigation Progress Bar Controller -->
    <script is:inline>
      (function() {
        var bar = document.getElementById('nav-progress-bar');
        if (!bar) return;
        var completionTimer = null;

        function startBar() {
          clearTimeout(completionTimer);
          bar.className = '';
          // Defer class addition to double requestAnimationFrame to restart animation without forced reflow
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              bar.classList.add('active');
            });
          });
        }

        function completeBar() {
          clearTimeout(completionTimer);
          bar.classList.remove('active');
          bar.classList.add('completing');
          completionTimer = setTimeout(function() {
            bar.classList.add('fade-out');
            completionTimer = setTimeout(function() {
              bar.className = '';
              bar.style.width = '';
            }, 350);
          }, 200);
        }

        function resetBar() {
          clearTimeout(completionTimer);
          bar.className = '';
          bar.style.width = '';
        }

        // ---- Astro View Transitions (SPA navigations) ----
        document.addEventListener('astro:before-preparation', startBar);
        document.addEventListener('astro:page-load', function() {
          // Re-acquire bar reference after swap (DOM is replaced)
          bar = document.getElementById('nav-progress-bar');
          if (!bar) return;
          // If the bar is active (a transition just happened), complete it
          if (bar.classList.contains('active')) {
            completeBar();
          }
        });

        // Clean up on back/forward if View Transitions don't fire
        window.addEventListener('pageshow', function(e) {
          if (e.persisted) {
            bar = document.getElementById('nav-progress-bar');
            if (bar) resetBar();
          }
        });
      })();
    </script>

    <!-- UI Enhancements: Scroll Progress & Back to Top -->
    <script is:inline>
      (function() {
        const bar = document.getElementById('scroll-progress-bar');
        const btn = document.getElementById('back-to-top');
        if (!bar && !btn) return;

        let ticking = false;
        function update() {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          if (bar) bar.style.width = pct + '%';
          if (btn) btn.classList.toggle('visible', scrollTop > 400);
          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });

        if (btn) {
          btn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // Initial update
        update();
      })();
    </script>
  </body>
</html>
