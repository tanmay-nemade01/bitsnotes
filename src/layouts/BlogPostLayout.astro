---
import BaseLayout from './BaseLayout.astro';
import CommentsSection from '../components/CommentsSection.astro';
import ViewCounter from '../components/ViewCounter.astro';
import '../styles/prose.css';
import '../styles/blog.css';

interface Props {
  title: string;
  description: string;
  publishedAt: string;
  updatedAt?: string;
  tags?: string[];
  coverImage?: string;
  coverAlt?: string;
  author?: string;
  readingTime?: number;
  canonicalUrl?: string;
  slug: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  tags,
  coverImage,
  coverAlt,
  author,
  readingTime,
  canonicalUrl,
  slug,
} = Astro.props;

const user = (Astro.locals as any).user ?? null;

const ogImage = coverImage
  ? `https://bitsnotes.com${coverImage.startsWith('/') ? '' : '/'}${coverImage}`
  : undefined;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": ogImage || 'https://bitsnotes.com/og-default.png',
  "datePublished": publishedAt,
  "dateModified": updatedAt || publishedAt,
  "author": {
    "@type": "Person",
    "name": author || "BitsNotes",
  },
  "publisher": {
    "@type": "Organization",
    "name": "BitsNotes",
    "logo": {
      "@type": "ImageObject",
      "url": "https://bitsnotes.com/favicon-96x96.png",
    },
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl || `https://bitsnotes.com/blog/${slug}`,
  },
};

const schemaJson = JSON.stringify(blogPostingSchema);

const displayDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${title} — BitsNotes Blog`}
  description={description}
  ogImage={ogImage}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schemaJson} />
  </Fragment>

  <article slot="default" itemscope itemtype="https://schema.org/BlogPosting">
    <meta itemprop="datePublished" content={publishedAt} />
    {updatedAt && <meta itemprop="dateModified" content={updatedAt} />}
    <meta itemprop="author" content={author || 'BitsNotes'} />

    <div class="blog-page">
      <div class="blog-hero">
        <a href="/blog" class="blog-hero__back">← Back to Blog</a>

        <h1 itemprop="headline" class="font-display text-4xl font-extrabold text-[var(--text)] tracking-tight leading-tight mt-4 mb-3">{title}</h1>

        {description && <p class="blog-hero__dek text-[var(--text-muted)] text-lg leading-relaxed mb-6">{description}</p>}

        <!-- Medium-style Author Row -->
        <div class="blog-author-row flex items-center justify-between mt-6 mb-6">
          <div class="flex items-center gap-3">
            <div class="blog-author-avatar w-11 h-11 rounded-full bg-[var(--accent-subtle)] border border-[var(--accent)] flex items-center justify-center text-[var(--accent)] font-semibold text-lg overflow-hidden select-none">
              {author ? author.charAt(0).toUpperCase() : 'B'}
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="blog-author-name font-semibold text-sm text-[var(--text)]">{author || 'BitsNotes'}</span>
                <span class="blog-meta__dot text-[var(--text-faint)]">·</span>
                <button class="blog-follow-btn text-xs font-bold text-[var(--accent)] hover:text-[var(--accent-hover)] cursor-pointer" data-author={author || 'BitsNotes'}>
                  Follow
                </button>
              </div>
              <div class="flex items-center gap-2 text-xs text-[var(--text-muted)] mt-0.5">
                <time datetime={publishedAt} itemprop="datePublished">{displayDate}</time>
                <span class="blog-meta__dot">·</span>
                <span>{readingTime || 5} min read</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Upper Engagement Bar -->
        <div class="blog-engagement-bar border-y border-[var(--border)] py-3 my-6 flex justify-between items-center text-sm text-[var(--text-muted)]" data-slug={slug} data-user={user ? '1' : '0'}>
          <div class="flex items-center gap-6">
            <button class="blog-btn-like flex items-center gap-2 hover:text-[var(--text)] transition-colors cursor-pointer group" aria-label="Like">
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
              <span class="blog-likes-count font-mono text-xs font-semibold">0</span>
            </button>
            <a href={`#comments-${slug}`} class="blog-btn-comments flex items-center gap-2 hover:text-[var(--text)] transition-colors group">
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641l-.318 1.272a.4.4 0 00.518.474l1.678-.56c.45-.15.932-.08 1.332.195 1.193.818 2.628 1.248 4.233 1.248z" />
              </svg>
              <span class="font-mono text-xs font-semibold">Comments</span>
            </a>
            <ViewCounter pageKey={`blog:${slug}`} />
          </div>
          <div class="flex items-center gap-4">
            <button class="blog-btn-bookmark hover:text-[var(--text)] transition-colors cursor-pointer group" aria-label="Bookmark">
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
              </svg>
            </button>
            <button class="blog-btn-share hover:text-[var(--text)] transition-colors cursor-pointer group" aria-label="Share">
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
              </svg>
            </button>
          </div>
        </div>

        {coverImage && (
          <figure class="blog-hero__cover">
            <img src={coverImage} alt={coverAlt || title} />
            {coverAlt && <figcaption>{coverAlt}</figcaption>}
          </figure>
        )}
      </div>

      <div class="blog-prose" itemprop="articleBody">
        <slot name="content" />
      </div>

      <!-- Lower Engagement Bar -->
      <div class="blog-hero mb-0">
        <div class="blog-engagement-bar border-y border-[var(--border)] py-3 my-6 flex justify-between items-center text-sm text-[var(--text-muted)]" data-slug={slug} data-user={user ? '1' : '0'}>
          <div class="flex items-center gap-6">
            <button class="blog-btn-like flex items-center gap-2 hover:text-[var(--text)] transition-colors cursor-pointer group" aria-label="Like">
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
              <span class="blog-likes-count font-mono text-xs font-semibold">0</span>
            </button>
            <a href={`#comments-${slug}`} class="blog-btn-comments flex items-center gap-2 hover:text-[var(--text)] transition-colors group">
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641l-.318 1.272a.4.4 0 00.518.474l1.678-.56c.45-.15.932-.08 1.332.195 1.193.818 2.628 1.248 4.233 1.248z" />
              </svg>
              <span class="font-mono text-xs font-semibold">Comments</span>
            </a>
            <ViewCounter pageKey={`blog:${slug}`} />
          </div>
          <div class="flex items-center gap-4">
            <button class="blog-btn-bookmark hover:text-[var(--text)] transition-colors cursor-pointer group" aria-label="Bookmark">
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
              </svg>
            </button>
            <button class="blog-btn-share hover:text-[var(--text)] transition-colors cursor-pointer group" aria-label="Share">
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Author Bio / Bottom Card -->
      <div class="blog-author-card border border-[var(--border)] rounded-[var(--r-md)] p-6 bg-[var(--bg-elevated)] mt-12 flex flex-col sm:flex-row items-center gap-4 max-w-[70ch] mx-auto">
        <div class="blog-author-avatar-large w-16 h-16 rounded-full bg-[var(--accent-subtle)] border border-[var(--accent)] flex items-center justify-center text-[var(--accent)] font-semibold text-2xl overflow-hidden flex-shrink-0 select-none">
          {author ? author.charAt(0).toUpperCase() : 'B'}
        </div>
        <div class="flex-grow text-center sm:text-left">
          <div class="flex flex-col sm:flex-row sm:items-center gap-2 justify-center sm:justify-start">
            <h3 class="font-display text-lg font-bold text-[var(--text)] m-0">Written by {author || 'BitsNotes'}</h3>
            <button class="blog-follow-btn text-xs font-bold text-[var(--accent)] hover:text-[var(--accent-hover)] cursor-pointer self-center sm:self-auto" data-author={author || 'BitsNotes'}>
              Follow
            </button>
          </div>
          <p class="text-sm text-[var(--text-muted)] mt-2 mb-0">Exploring the depth of computer science, engineering practices, and artificial intelligence, one note at a time.</p>
        </div>
      </div>

      <!-- Comments Section (Phase 4 integration) -->
      <div class="blog-hero mt-8 mb-10" id={`comments-${slug}`}>
        <CommentsSection pageType="blog" subject={slug} />
      </div>
    </div>
  </article>

  <!-- Share Toast Alert -->
  <div id="blog-share-toast" class="fixed bottom-5 right-5 z-50 bg-[var(--accent)] text-[var(--accent-contrast)] px-4 py-2 rounded-[var(--r-sm)] shadow-[var(--shadow-overlay)] text-sm font-medium transform translate-y-10 opacity-0 pointer-events-none transition-all duration-300">
    Copied link to clipboard!
  </div>

  <!-- Sign-in Nudge Toast -->
  <div id="blog-signin-nudge" class="nudge-hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-[var(--bg-elevated)] border border-[var(--border)] text-[var(--text)] px-4 py-3 rounded-[var(--r-md)] shadow-[var(--shadow-overlay)] text-sm font-medium transition-all duration-300">
    <svg class="w-4 h-4 text-[var(--accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>
    <span><a href={`/auth/signin?redirect=${encodeURIComponent('/blog/' + slug)}`} class="text-[var(--accent)] font-semibold hover:underline">Sign in</a> to like and follow</span>
    <button id="blog-signin-nudge-close" class="ml-2 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors flex-shrink-0" aria-label="Dismiss">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</BaseLayout>


<script is:inline>
  (function () {
    // ── Auth state ──────────────────────────────────────────────────────────
    // We do NOT trust data-user on the DOM: Cloudflare may serve an
    // edge-cached anonymous page to a logged-in user, leaving data-user="0"
    // even after sign-in. /api/auth/me is always no-cache and reads the real
    // session cookie, so it is the correct source of truth.
    var _authState = null; // null = pending, false = logged out, true = logged in

    function getAuthState(cb) {
      if (_authState !== null) { cb(_authState); return; }
      fetch('/api/auth/me', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          _authState = !!(data && data.user);
          cb(_authState);
        })
        .catch(function () { _authState = false; cb(false); });
    }

    // ── Sign-in nudge toast ─────────────────────────────────────────────────
    var nudgeTimeout = null;
    function showSignInNudge() {
      var el = document.getElementById('blog-signin-nudge');
      if (!el) return;
      clearTimeout(nudgeTimeout);
      el.classList.remove('nudge-hidden');
      el.classList.add('nudge-visible');
      nudgeTimeout = setTimeout(function () {
        el.classList.remove('nudge-visible');
        el.classList.add('nudge-hidden');
      }, 3500);
    }

    // ── Share toast ─────────────────────────────────────────────────────────
    function showShareToast() {
      var toast = document.getElementById('blog-share-toast');
      if (!toast) return;
      toast.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(function () {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
      }, 2500);
    }

    // ── Like UI ─────────────────────────────────────────────────────────────
    function setLikeUI(slug, liked, count) {
      document.querySelectorAll('.blog-engagement-bar[data-slug="' + slug + '"] .blog-likes-count').forEach(function (span) {
        span.textContent = count;
      });
      document.querySelectorAll('.blog-engagement-bar[data-slug="' + slug + '"] .blog-btn-like').forEach(function (b) {
        var s = b.querySelector('svg');
        if (liked) {
          b.classList.add('liked');
          s.setAttribute('fill', 'currentColor');
          s.setAttribute('stroke', 'currentColor');
        } else {
          b.classList.remove('liked');
          s.setAttribute('fill', 'none');
          s.setAttribute('stroke', 'currentColor');
        }
      });
    }

    // ── Follow UI ───────────────────────────────────────────────────────────
    function setFollowUI(author, following) {
      document.querySelectorAll('.blog-follow-btn[data-author="' + author + '"]').forEach(function (btn) {
        if (following) {
          btn.textContent = 'Following';
          btn.classList.add('following');
        } else {
          btn.textContent = 'Follow';
          btn.classList.remove('following');
        }
      });
    }

    // ── Main setup ──────────────────────────────────────────────────────────
    function setupInteractivity() {
      // Reset auth state on each page (important for view transitions / SPA nav)
      _authState = null;

      // 1. Follow Buttons — always fetch state from API (not from DOM)
      var followBtns = document.querySelectorAll('.blog-follow-btn');

      followBtns.forEach(function (btn) {
        var author = btn.dataset.author;
        fetch('/api/blog/follow?author=' + encodeURIComponent(author), { credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) { if (data) setFollowUI(author, data.following); })
          .catch(function () {});

        btn.onclick = function (e) {
          e.preventDefault();
          getAuthState(function (loggedIn) {
            if (!loggedIn) { showSignInNudge(); return; }
            var isFollowing = btn.classList.contains('following');
            // Optimistic UI
            setFollowUI(author, !isFollowing);
            fetch('/api/blog/follow', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ author: author }),
            })
              .then(function (r) {
                if (r.status === 401) { setFollowUI(author, isFollowing); showSignInNudge(); return null; }
                return r.ok ? r.json() : null;
              })
              .then(function (data) { if (data) setFollowUI(author, data.following); })
              .catch(function () { setFollowUI(author, isFollowing); });
          });
        };
      });

      // 2. Like Buttons — always fetch initial state from API
      var likers = document.querySelectorAll('.blog-btn-like');
      var loadedSlugs = {};
      likers.forEach(function (btn) {
        var bar = btn.closest('.blog-engagement-bar');
        var slug = bar && bar.dataset.slug;
        if (!slug) return;

        if (!loadedSlugs[slug]) {
          loadedSlugs[slug] = true;
          fetch('/api/blog/like?slug=' + encodeURIComponent(slug), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) { if (data) setLikeUI(slug, data.liked, data.count); })
            .catch(function () {});
        }

        btn.onclick = function (e) {
          e.preventDefault();
          getAuthState(function (loggedIn) {
            if (!loggedIn) { showSignInNudge(); return; }
            var wasLiked = btn.classList.contains('liked');
            var countEls = document.querySelectorAll('.blog-engagement-bar[data-slug="' + slug + '"] .blog-likes-count');
            var currentCount = parseInt((countEls[0] && countEls[0].textContent) || '0', 10) || 0;
            // Optimistic UI
            setLikeUI(slug, !wasLiked, currentCount + (wasLiked ? -1 : 1));
            if (!wasLiked) {
              btn.classList.add('like-pulse');
              setTimeout(function () { btn.classList.remove('like-pulse'); }, 300);
            }
            fetch('/api/blog/like', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug: slug }),
            })
              .then(function (r) {
                if (r.status === 401) { setLikeUI(slug, wasLiked, currentCount); showSignInNudge(); return null; }
                return r.ok ? r.json() : null;
              })
              .then(function (data) { if (data) setLikeUI(slug, data.liked, data.count); })
              .catch(function () { setLikeUI(slug, wasLiked, currentCount); });
          });
        };
      });

      // 3. Bookmarks (localStorage)
      var bookmarkBtns = document.querySelectorAll('.blog-btn-bookmark');
      var bookmarks = {};
      try {
        var savedB = localStorage.getItem('bitsnotes-bookmarked-posts');
        if (savedB) bookmarks = JSON.parse(savedB);
      } catch (e) {}

      function updateBookmarkBtnUI(btn) {
        var bar = btn.closest('.blog-engagement-bar');
        var slug = bar && bar.dataset.slug;
        if (!slug) return;
        var svg = btn.querySelector('svg');
        if (bookmarks[slug]) {
          btn.classList.add('bookmarked');
          svg.setAttribute('fill', 'currentColor');
          svg.setAttribute('stroke', 'currentColor');
        } else {
          btn.classList.remove('bookmarked');
          svg.setAttribute('fill', 'none');
          svg.setAttribute('stroke', 'currentColor');
        }
      }

      bookmarkBtns.forEach(function (btn) {
        updateBookmarkBtnUI(btn);
        btn.onclick = function (e) {
          e.preventDefault();
          var bar = btn.closest('.blog-engagement-bar');
          var slug = bar && bar.dataset.slug;
          if (!slug) return;
          bookmarks[slug] = !bookmarks[slug];
          try { localStorage.setItem('bitsnotes-bookmarked-posts', JSON.stringify(bookmarks)); } catch (err) {}
          document.querySelectorAll('.blog-engagement-bar[data-slug="' + slug + '"] .blog-btn-bookmark').forEach(updateBookmarkBtnUI);
        };
      });

      // 4. Share Buttons
      document.querySelectorAll('.blog-btn-share').forEach(function (btn) {
        btn.onclick = function (e) {
          e.preventDefault();
          navigator.clipboard.writeText(window.location.href).then(showShareToast).catch(function () {});
        };
      });

      // 5. Sign-in nudge close button
      var nudgeClose = document.getElementById('blog-signin-nudge-close');
      if (nudgeClose) {
        nudgeClose.onclick = function () {
          var el = document.getElementById('blog-signin-nudge');
          if (el) { clearTimeout(nudgeTimeout); el.classList.remove('nudge-visible'); el.classList.add('nudge-hidden'); }
        };
      }
    }

    setupInteractivity();
    document.addEventListener('astro:after-swap', setupInteractivity);
  })();
</script>

