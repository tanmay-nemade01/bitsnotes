---
/**
 * BookmarkButton.astro — Star toggle for lecture rows.
 * Props: subject, lecture, displayName, isBookmarked, collectionId
 */
interface Props {
  subject: string;
  lecture: string;
  displayName: string;
  isBookmarked?: boolean;
  collectionId?: string;
}

const { subject, lecture, displayName, isBookmarked = false, collectionId } = Astro.props;
---

<button
  type="button"
  class="bookmark-btn group/bm relative p-1.5 rounded-full hover:bg-[var(--accent-subtle)] transition-colors shrink-0"
  data-subject={subject}
  data-lecture={lecture}
  data-display-name={displayName}
  data-bookmarked={isBookmarked ? 'true' : 'false'}
  data-collection-id={collectionId || ''}
  aria-label={isBookmarked ? 'Remove bookmark' : 'Bookmark this lecture'}
  title={isBookmarked ? 'Remove bookmark' : 'Bookmark'}
>
  <!-- Outline star (not bookmarked) -->
  <svg class:list={['w-4 h-4 transition-colors', { 'hidden': isBookmarked, 'text-[var(--text-faint)] group-hover/bm:text-[var(--accent)]': !isBookmarked }]}
    fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
  </svg>
  <!-- Filled star (bookmarked) -->
  <svg class:list={['w-4 h-4 transition-colors', { 'hidden': !isBookmarked, 'text-[var(--accent)]': isBookmarked }]}
    fill="currentColor" viewBox="0 0 24 24">
    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
  </svg>

  <!-- Collection picker popover -->
  <div class="bookmark-picker hidden absolute right-0 top-full mt-1 w-44 bg-[var(--bg-elevated)] border border-[var(--border)] rounded-[var(--r-md)] shadow-lg py-1 z-50">
    <div class="px-3 py-1.5 text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider">Save to</div>
    <div class="bookmark-picker-collections">
      <!-- Populated by JS -->
    </div>
  </div>
</button>
