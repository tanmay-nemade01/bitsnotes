---
// ResourceTypeBadge.astro
//
// Phase 3.2 — Text badges with tokenized styling that describe a catalog
// resource. Shows the primary resource kind (e.g. "Lecture", "Race Card")
// plus up to a capped number of mode badges derived from `availableModes`
// (notes / study-guide / exam-revision / quiz). When more modes exist than
// the cap allows, a "+N" badge is rendered.
//
// Props:
//   resourceKind: ResourceKind  — primary kind (drives the first badge)
//   availableModes: AvailableMode[] — modes to surface as secondary badges
//   maxModes?: number           — cap on mode badges (default 3)

import type { ResourceKind, AvailableMode } from '../utils/metadata';
import { getResourceKindLabel } from '../utils/lectureDisplay';

interface Props {
  resourceKind: ResourceKind;
  availableModes: AvailableMode[];
  maxModes?: number;
}

const { resourceKind, availableModes = [], maxModes = 3 } = Astro.props;

const MODE_LABELS: Record<AvailableMode, string> = {
  notes: 'Notes',
  'study-guide': 'Study Guide',
  'exam-revision': 'Revision',
  quiz: 'Quiz',
};

const primaryLabel = getResourceKindLabel(resourceKind);

// De-duplicate and keep a stable order.
const orderedModes = (['notes', 'study-guide', 'exam-revision', 'quiz'] as AvailableMode[])
  .filter((m) => availableModes.includes(m));

const shownModes = orderedModes.slice(0, maxModes);
const overflow = orderedModes.length - shownModes.length;
---

<span class="rt-badge-group" aria-label={`Resource type: ${primaryLabel}`}>
  <span class="rt-badge rt-badge--primary">{primaryLabel}</span>
  {shownModes.map((m) => (
    <span class="rt-badge rt-badge--mode">{MODE_LABELS[m]}</span>
  ))}
  {overflow > 0 && (
    <span class="rt-badge rt-badge--more" aria-label={`${overflow} more`}>+{overflow}</span>
  )}
</span>

<style>
  .rt-badge-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  .rt-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    padding: 3px 7px;
    border-radius: 999px;
    white-space: nowrap;
    border: 1px solid var(--border);
    color: var(--text-muted);
    background: var(--bg-subtle);
  }

  .rt-badge--primary {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: var(--accent);
  }

  .rt-badge--mode {
    color: var(--text-muted);
    background: var(--bg-subtle);
    border-color: var(--border);
  }

  .rt-badge--more {
    color: var(--text-faint);
    background: transparent;
    border-color: var(--border);
  }
</style>
