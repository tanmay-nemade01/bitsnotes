---
/**
 * CommentsSection.astro — Reddit-style threaded comments for lecture + subject pages.
 *
 * Mounts below prev/next (lecture) or below resource list (subject).
 * Lazy-loaded via IntersectionObserver so it never blocks lecture LCP.
 * All user-submitted text is rendered with textContent only (no innerHTML).
 *
 * Features:
 *  - Threaded replies (nested, depth-capped)
 *  - Up/down voting (Reddit-style score)
 *  - Collapsible threads
 *  - Signed-in users get name pre-filled + email tracked server-side
 *  - Anonymous users keep a one-time delete token in localStorage
 */
import { getEnv } from '../lib/apiHelpers';

interface Props {
  pageType: 'lecture' | 'subject';
  subject: string;
  lecture?: string;
}

const { pageType, subject, lecture } = Astro.props;
const env = await getEnv(Astro);
const turnstileSiteKey = env.TURNSTILE_SITE_KEY || '';
// Signed-in user (resolved by middleware) — used to pre-fill name + flag ownership.
const user = (Astro.locals as any)?.user ?? null;
const sectionId = `comments-${pageType}-${encodeURIComponent(subject)}${lecture ? '-' + encodeURIComponent(lecture) : ''}`;
---

<section
  id={sectionId}
  class="bn-comments mt-10 pt-8 border-t border-[var(--border)]"
  data-page-type={pageType}
  data-subject={subject}
  data-lecture={lecture ?? ''}
  data-turnstile-key={turnstileSiteKey}
  data-user={user ? JSON.stringify({ id: user.id, displayName: user.displayName || '', email: user.email }) : ''}
  aria-label="Comments"
>
  <div class="bn-comments__placeholder flex items-center gap-3 text-sm text-[var(--text-muted)]">
    <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 3a9 9 0 109 9"/></svg>
    <span>Loading comments…</span>
  </div>
</section>

<script is:inline data-astro-rerun>
  (function () {
    var SECTIONS = document.querySelectorAll('.bn-comments');
    if (!SECTIONS.length) return;

    var LS_NAME = 'bitsnotes-comment-name';
    var LS_TOKEN_PREFIX = 'bitsnotes-comment-token:';
    var MAX_DEPTH = 6;

    // Signed-in user (from data-user attribute, set server-side).
    function currentUser() {
      var el = document.querySelector('.bn-comments');
      var raw = el && el.dataset.user;
      if (!raw) return null;
      try { return JSON.parse(raw); } catch (e) { return null; }
    }

    function escAttr(s) { return String(s).replace(/"/g, '&quot;'); }

    function timeAgo(ts) {
      var diff = Date.now() - ts;
      var m = Math.floor(diff / 60000);
      if (m < 1) return 'just now';
      if (m < 60) return m + 'm ago';
      var h = Math.floor(m / 60);
      if (h < 24) return h + 'h ago';
      var d = Math.floor(h / 24);
      if (d < 30) return d + 'd ago';
      return new Date(ts).toLocaleDateString();
    }

    function initials(name) {
      var parts = String(name).trim().split(/\s+/).slice(0, 2);
      return parts.map(function (p) { return p.charAt(0).toUpperCase(); }).join('') || '?';
    }

    // Deterministic accent color from a string (for avatar background).
    function avatarColor(seed) {
      var palette = ['#0F766E', '#7C3AED', '#DB2777', '#D97706', '#2563EB', '#059669', '#DC2626', '#4F46E5'];
      var h = 0;
      for (var i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
      return palette[h % palette.length];
    }

    function makeAvatar(name) {
      var av = document.createElement('div');
      av.className = 'bn-comment__avatar';
      av.setAttribute('aria-hidden', 'true');
      av.textContent = initials(name);
      av.style.background = avatarColor(name || '?');
      return av;
    }

    /** Build a single comment node (article) with vote rail + actions. */
    function renderComment(c, opts) {
      opts = opts || {};
      var wrap = document.createElement('article');
      wrap.className = 'bn-comment';
      wrap.dataset.id = c.id;
      wrap.dataset.parent = c.parentId || '';
      wrap.dataset.depth = String(c.depth || 0);

      // ── Vote rail (Reddit-style) ──
      var rail = document.createElement('div');
      rail.className = 'bn-comment__rail';

      var up = document.createElement('button');
      up.type = 'button';
      up.className = 'bn-vote bn-vote--up';
      up.setAttribute('aria-label', 'Upvote');
      up.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5l7 7H5z"/></svg>';

      var score = document.createElement('span');
      score.className = 'bn-comment__score';
      score.textContent = String(c.score || 0);

      var down = document.createElement('button');
      down.type = 'button';
      down.className = 'bn-vote bn-vote--down';
      down.setAttribute('aria-label', 'Downvote');
      down.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l-7-7h14z"/></svg>';

      rail.appendChild(up);
      rail.appendChild(score);
      rail.appendChild(down);

      // ── Main column ──
      var main = document.createElement('div');
      main.className = 'bn-comment__main';

      var head = document.createElement('div');
      head.className = 'bn-comment__head';
      head.appendChild(makeAvatar(c.displayName));
      var name = document.createElement('span');
      name.className = 'bn-comment__name';
      name.textContent = c.displayName; // textContent only — XSS safe
      var time = document.createElement('time');
      time.dateTime = new Date(c.createdAt).toISOString();
      time.className = 'bn-comment__time';
      time.textContent = timeAgo(c.createdAt);
      head.appendChild(name);
      head.appendChild(time);

      var body = document.createElement('p');
      body.className = 'bn-comment__body';
      body.style.whiteSpace = 'pre-wrap';
      body.textContent = c.body; // textContent only — XSS safe

      // ── Action row ──
      var actions = document.createElement('div');
      actions.className = 'bn-comment__actions';

      var replyBtn = document.createElement('button');
      replyBtn.type = 'button';
      replyBtn.className = 'bn-comment__action';
      replyBtn.textContent = 'Reply';
      replyBtn.addEventListener('click', function () { toggleReplyForm(wrap, c); });
      actions.appendChild(replyBtn);

      // Owned? show delete if token stored (anon) or signed-in owner.
      var token = localStorage.getItem(LS_TOKEN_PREFIX + c.id);
      var user = currentUser();
      var owned = !!token || (user && c.authorUserId === user.id);
      if (owned) {
        var del = document.createElement('button');
        del.type = 'button';
        del.className = 'bn-comment__action bn-comment__action--danger';
        del.textContent = 'Delete';
        del.addEventListener('click', function () { deleteComment(c.id, token, wrap); });
        actions.appendChild(del);
      } else {
        var rep = document.createElement('button');
        rep.type = 'button';
        rep.className = 'bn-comment__action';
        rep.textContent = 'Report';
        rep.addEventListener('click', function () { reportComment(c.id, rep); });
        actions.appendChild(rep);
      }

      main.appendChild(head);
      main.appendChild(body);
      main.appendChild(actions);

      // Reply container (lazy form injected here).
      var replySlot = document.createElement('div');
      replySlot.className = 'bn-comment__replyslot';
      main.appendChild(replySlot);

      wrap.appendChild(rail);
      wrap.appendChild(main);

      // Wire voting.
      up.addEventListener('click', function () { castVote(c.id, 1, score, up, down); });
      down.addEventListener('click', function () { castVote(c.id, -1, score, up, down); });

      return wrap;
    }

    /** Insert a comment into the correct place in the tree (top-level or nested). */
    function insertComment(section, c) {
      var list = section.querySelector('.bn-comments__list');
      if (!list) { fetchComments(section, null); return; }
      var node = renderComment(c);
      if (!c.parentId) {
        list.insertBefore(node, list.firstChild);
      } else {
        var parent = list.querySelector('.bn-comment[data-id="' + cssEscape(c.parentId) + '"]');
        if (!parent) { fetchComments(section, null); return; }
        var children = parent.querySelector(':scope > .bn-comment__children');
        if (!children) {
          children = document.createElement('div');
          children.className = 'bn-comment__children';
          parent.appendChild(children);
        }
        children.insertBefore(node, children.firstChild);
      }
      bumpCount(section, 1);
    }

    function cssEscape(s) {
      if (window.CSS && CSS.escape) return CSS.escape(s);
      return String(s).replace(/["\\]/g, '\\$&');
    }

    function bumpCount(section, delta) {
      var count = section.querySelector('.bn-comments__count');
      if (count) count.textContent = String((parseInt(count.textContent, 10) || 0) + delta);
    }

    /** Build the nested tree from a flat list (parentId/depth). */
    function renderList(section, data) {
      var list = section.querySelector('.bn-comments__list');
      if (!list) {
        list = document.createElement('div');
        list.className = 'bn-comments__list';
        section.appendChild(list);
      }
      // Map of id -> node, then nest.
      var nodes = {};
      data.comments.forEach(function (c) {
        var node = renderComment(c);
        nodes[c.id] = node;
      });
      data.comments.forEach(function (c) {
        var node = nodes[c.id];
        if (c.parentId && nodes[c.parentId]) {
          var children = nodes[c.parentId].querySelector(':scope > .bn-comment__main > .bn-comment__children');
          if (!children) {
            children = document.createElement('div');
            children.className = 'bn-comment__children';
            nodes[c.parentId].querySelector(':scope > .bn-comment__main').appendChild(children);
          }
          children.appendChild(node);
        } else {
          list.appendChild(node);
        }
      });

      var count = section.querySelector('.bn-comments__count');
      if (count) count.textContent = String(data.total);

      var more = section.querySelector('.bn-comments__more');
      if (data.hasMore) {
        if (!more) {
          more = document.createElement('button');
          more.type = 'button';
          more.className = 'bn-comments__more mt-4 text-sm font-medium text-[var(--accent)] hover:underline';
          more.textContent = 'Load more comments';
          section.appendChild(more);
          more.addEventListener('click', function () { loadMore(section, data.nextCursor); });
        }
        more.dataset.cursor = data.nextCursor || '';
      } else if (more) {
        more.remove();
      }
    }

    function loadMore(section, cursor) {
      fetchComments(section, cursor);
    }

    function fetchComments(section, cursor) {
      var pt = section.dataset.pageType;
      var subj = section.dataset.subject;
      var lec = section.dataset.lecture;
      var qs = new URLSearchParams({ pageType: pt, subject: subj });
      if (pt === 'lecture') qs.set('lecture', lec);
      if (cursor) qs.set('cursor', cursor);
      // Tell the server which comments we own (anon delete tokens).
      var own = [];
      try {
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (k && k.indexOf(LS_TOKEN_PREFIX) === 0) own.push(k.slice(LS_TOKEN_PREFIX.length));
        }
      } catch (e) {}
      if (own.length) qs.set('own', own.join(','));
      fetch('/api/comments?' + qs.toString(), { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) { renderList(section, data); })
        .catch(function () {});
    }

    function castVote(id, value, scoreEl, upBtn, downBtn) {
      fetch('/api/comments/' + encodeURIComponent(id) + '/vote', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ value: value }),
      })
        .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
        .then(function (res) {
          if (res.status === 200) {
            scoreEl.textContent = String(res.data.score);
            var my = res.data.myVote;
            upBtn.classList.toggle('is-active', my === 1);
            downBtn.classList.toggle('is-active', my === -1);
          }
        })
        .catch(function () {});
    }

    /** Toggle an inline reply form under a comment. */
    function toggleReplyForm(parentWrap, parentComment) {
      var slot = parentWrap.querySelector(':scope > .bn-comment__main > .bn-comment__replyslot');
      if (!slot) return;
      if (slot.firstChild) { slot.innerHTML = ''; return; }
      slot.appendChild(buildForm(parentWrap.closest('.bn-comments'), {
        parentId: parentComment.id,
        compact: true,
        onPosted: function (c) {
          slot.innerHTML = '';
          // Insert into the tree.
          var list = parentWrap.closest('.bn-comments__list') || parentWrap.parentNode;
          var section = parentWrap.closest('.bn-comments');
          var node = renderComment(c);
          var children = parentWrap.querySelector(':scope > .bn-comment__main > .bn-comment__children');
          if (!children) {
            children = document.createElement('div');
            children.className = 'bn-comment__children';
            parentWrap.querySelector(':scope > .bn-comment__main').appendChild(children);
          }
          children.insertBefore(node, children.firstChild);
          bumpCount(section, 1);
        }
      }));
      var ta = slot.querySelector('textarea');
      if (ta) ta.focus();
    }

    function buildForm(section, opts) {
      opts = opts || {};
      var form = document.createElement('form');
      form.className = 'bn-comments__form mt-3 space-y-3' + (opts.compact ? ' bn-comments__form--compact' : ' mt-6');
      form.noValidate = true;

      var user = currentUser();
      var nameWrap = document.createElement('div');
      var nameLabel = document.createElement('label');
      nameLabel.className = 'block text-xs font-semibold text-[var(--text-muted)] mb-1';
      nameLabel.textContent = user ? 'Commenting as' : 'Display name';
      var nameInput = document.createElement('input');
      nameInput.type = 'text';
      nameInput.name = 'displayName';
      nameInput.maxLength = 40;
      nameInput.required = true;
      nameInput.className = 'block w-full px-3 py-2 border border-[var(--border)] text-[var(--text)] bg-[var(--bg-input)] placeholder-[var(--input-placeholder)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)]';
      nameInput.placeholder = 'e.g. Anonymous Student';
      // Pre-fill: signed-in display name, else remembered anon name.
      if (user && user.displayName) nameInput.value = user.displayName;
      else {
        var savedName = localStorage.getItem(LS_NAME);
        if (savedName) nameInput.value = savedName;
      }
      if (user) { nameInput.readOnly = true; nameInput.classList.add('bn-comments__name--locked'); }
      nameWrap.appendChild(nameLabel);
      nameWrap.appendChild(nameInput);

      var bodyWrap = document.createElement('div');
      var bodyLabel = document.createElement('label');
      bodyLabel.className = 'block text-xs font-semibold text-[var(--text-muted)] mb-1';
      bodyLabel.textContent = opts.parentId ? 'Write a reply' : 'Comment';
      var bodyEl = document.createElement('textarea');
      bodyEl.name = 'body';
      bodyEl.rows = opts.compact ? 3 : 4;
      bodyEl.required = true;
      bodyEl.maxLength = 1500;
      bodyEl.className = 'block w-full px-3 py-2 border border-[var(--border)] text-[var(--text)] bg-[var(--bg-input)] placeholder-[var(--input-placeholder)] text-sm rounded-[var(--r-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:border-[var(--accent)]';
      bodyEl.placeholder = opts.parentId ? 'Add to the discussion…' : 'Share a correction, thanks, or a helpful note…';
      var counter = document.createElement('span');
      counter.className = 'block text-right text-xs text-[var(--text-faint)] mt-1';
      counter.textContent = '0 / 1500';
      bodyEl.addEventListener('input', function () { counter.textContent = bodyEl.value.length + ' / 1500'; });
      bodyWrap.appendChild(bodyLabel);
      bodyWrap.appendChild(bodyEl);
      bodyWrap.appendChild(counter);

      // Honeypot
      var hp = document.createElement('input');
      hp.type = 'text';
      hp.name = '_website';
      hp.tabIndex = -1;
      hp.autocomplete = 'off';
      hp.setAttribute('aria-hidden', 'true');
      hp.style.position = 'absolute';
      hp.style.left = '-9999px';
      hp.style.width = '1px';
      hp.style.height = '1px';

      var started = document.createElement('input');
      started.type = 'hidden';
      started.name = 'formStartedAt';
      started.value = String(Date.now());

      var row = document.createElement('div');
      row.className = 'flex items-center gap-3 flex-wrap';

      var submit = document.createElement('button');
      submit.type = 'submit';
      submit.className = 'inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-[var(--r-sm)] bg-[var(--accent)] text-[var(--accent-contrast)] hover:bg-[var(--accent-hover)] transition-colors disabled:opacity-60';
      submit.textContent = opts.parentId ? 'Post reply' : 'Post comment';

      row.appendChild(submit);

      if (opts.parentId) {
        var cancel = document.createElement('button');
        cancel.type = 'button';
        cancel.className = 'text-sm text-[var(--text-muted)] hover:underline';
        cancel.textContent = 'Cancel';
        cancel.addEventListener('click', function () {
          var slot = form.parentNode;
          if (slot) slot.innerHTML = '';
        });
        row.appendChild(cancel);
      }

      var status = document.createElement('p');
      status.className = 'bn-comments__status text-sm text-[var(--text-muted)]';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');

      // Turnstile container (only on the top-level form).
      var tsBox = null;
      if (!opts.compact) {
        tsBox = document.createElement('div');
        tsBox.className = 'bn-comments__turnstile';
      }

      form.appendChild(nameWrap);
      form.appendChild(bodyWrap);
      form.appendChild(hp);
      form.appendChild(started);
      if (tsBox) form.appendChild(tsBox);
      form.appendChild(row);
      form.appendChild(status);

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        status.textContent = '';
        var name = nameInput.value.trim();
        var text = bodyEl.value;
        if (name.length < 2) { status.textContent = 'Please enter a display name (2+ characters).'; return; }
        if (text.trim().length < 3) { status.textContent = 'Comment is too short.'; return; }

        var payload = {
          pageType: section.dataset.pageType,
          subject: section.dataset.subject,
          lecture: section.dataset.lecture || undefined,
          displayName: name,
          body: text,
          parentId: opts.parentId || undefined,
          _website: hp.value,
          formStartedAt: started.value,
        };
        if (!opts.compact && window.turnstile && tsRendered) {
          try { payload.turnstileToken = window.turnstile.getResponse(); } catch (e) {}
        }

        submit.disabled = true;
        status.textContent = 'Posting…';
        fetch('/api/comments', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
          .then(function (res) {
            if (res.status === 201 && res.data.token) {
              localStorage.setItem(LS_TOKEN_PREFIX + res.data.id, res.data.token);
              localStorage.setItem(LS_NAME, name);
              bodyEl.value = '';
              counter.textContent = '0 / 1500';
              status.textContent = 'Thanks! Your reply is live.';
              var posted = {
                id: res.data.id, pageType: section.dataset.pageType, subject: section.dataset.subject,
                lecture: section.dataset.lecture || null, parentId: res.data.parentId || null,
                displayName: name, body: text, score: 0, createdAt: Date.now()
              };
              if (opts.onPosted) opts.onPosted(posted);
              else insertComment(section, posted);
            } else if (res.status === 202) {
              localStorage.setItem(LS_NAME, name);
              bodyEl.value = '';
              status.textContent = 'Thanks! Your comment is awaiting moderation.';
            } else if (res.status === 422) {
              status.textContent = 'We could not post that comment. Please revise and try again.';
            } else if (res.status === 429) {
              status.textContent = 'Too many comments. Please try again later.';
            } else {
              status.textContent = res.data.error || 'Something went wrong. Please try again.';
            }
          })
          .catch(function () { status.textContent = 'Network error. Please try again.'; })
          .finally(function () { submit.disabled = false; });
      });

      // Lazy render Turnstile when the top-level form scrolls into view.
      if (!opts.compact && section.dataset.turnstileKey) {
        renderTurnstileInto(tsBox, section);
      }

      return form;
    }

    // ── Turnstile (shared loader) ──
    var tsRendered = false;
    var tsWidgetId = null;
    var tsApiLoading = false;
    var tsApiLoaded = false;

    function loadTurnstileApi(onReady) {
      if (tsApiLoaded) { onReady(); return; }
      if (window.turnstile) { tsApiLoaded = true; onReady(); return; }
      if (tsApiLoading) {
        var attempts = 0;
        var check = setInterval(function () {
          attempts++;
          if (window.turnstile) { clearInterval(check); tsApiLoaded = true; onReady(); }
          else if (attempts > 100) { clearInterval(check); tsApiLoading = false; }
        }, 100);
        return;
      }
      tsApiLoading = true;
      var s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = function () { tsApiLoaded = true; onReady(); };
      s.onerror = function () { tsApiLoading = false; };
      document.head.appendChild(s);
    }

    function renderTurnstileInto(tsBox, section) {
      var tsKey = section.dataset.turnstileKey;
      if (!tsKey) return;
      function doRender() {
        if (tsRendered && tsWidgetId != null) {
          try { window.turnstile.remove(tsWidgetId); } catch (e) {}
          tsRendered = false; tsWidgetId = null;
        }
        if (tsRendered) return;
        tsRendered = true;
        tsWidgetId = window.turnstile.render(tsBox, {
          sitekey: tsKey,
          theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
          callback: function () {}
        });
      }
      if (!window.turnstile) { loadTurnstileApi(doRender); return; }
      doRender();
    }

    window.addEventListener('bitsnotes:theme-changed', function () {
      var s = document.querySelector('.bn-comments');
      if (s && s.dataset.turnstileKey && tsRendered) {
        var box = s.querySelector('.bn-comments__turnstile');
        if (box) renderTurnstileInto(box, s);
      }
    });

    function deleteComment(id, token, wrap) {
      if (!confirm('Delete your comment? This cannot be undone.')) return;
      fetch('/api/comments/' + encodeURIComponent(id), {
        method: 'DELETE',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: token || '' }),
      }).then(function (r) {
        if (r.ok) {
          localStorage.removeItem(LS_TOKEN_PREFIX + id);
          // Replace with a "deleted" placeholder to preserve thread structure.
          wrap.classList.add('bn-comment--deleted');
          var main = wrap.querySelector(':scope > .bn-comment__main');
          if (main) {
            main.innerHTML = '<p class="bn-comment__deleted-note text-sm text-[var(--text-faint)] italic">[deleted]</p>';
          }
          var rail = wrap.querySelector(':scope > .bn-comment__rail');
          if (rail) rail.remove();
        } else {
          alert('Could not delete comment.');
        }
      });
    }

    function reportComment(id, btn) {
      var reason = prompt('Report reason? (spam / abuse / offtopic / other)', 'spam');
      if (reason === null) return;
      reason = reason.trim().toLowerCase();
      if (!['spam', 'abuse', 'offtopic', 'other'].includes(reason)) reason = 'other';
      fetch('/api/comments/' + encodeURIComponent(id) + '/report', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: reason }),
      }).then(function (r) {
        if (r.ok) { btn.textContent = 'Reported'; btn.disabled = true; }
      });
    }

    function initSection(section) {
      var placeholder = section.querySelector('.bn-comments__placeholder');
      if (placeholder) placeholder.remove();

      var header = document.createElement('div');
      header.className = 'flex items-center justify-between mb-4';
      var h = document.createElement('h2');
      h.className = 'font-display text-lg font-bold text-[var(--text)]';
      h.textContent = 'Discussion';
      var count = document.createElement('span');
      count.className = 'bn-comments__count text-sm text-[var(--text-muted)]';
      count.textContent = '0';
      header.appendChild(h);
      header.appendChild(count);
      section.appendChild(header);

      fetchComments(section, null);
      section.appendChild(buildForm(section, {}));
    }

    // Lazy-load each section when it scrolls into view (don't block LCP).
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) {
            initSection(en.target);
            io.unobserve(en.target);
          }
        });
      }, { rootMargin: '200px' });
      SECTIONS.forEach(function (s) { io.observe(s); });
    } else {
      SECTIONS.forEach(initSection);
    }
  })();
</script>

