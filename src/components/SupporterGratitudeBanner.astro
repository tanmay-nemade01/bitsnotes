---
/**
 * SupporterGratitudeBanner.astro
 *
 * Subtle thank-you note shown to all logged-in users.
 * Expresses appreciation that BitsNotes is sustained and kept open by
 * community supporters, provides an option to view them on the Wall of Gratitude,
 * and gives a gentle option to support as well.
 *
 * - Auto-closes after 15 seconds.
 * - Suppressed for 1 hour after dismissal or auto-close.
 * - Never displayed on /support.
 */
import { getUser } from '../lib/apiHelpers';

const user = getUser(Astro);
const isSupportPage = Astro.url.pathname.startsWith('/support');
const initialLoggedIn = Boolean(user) && !isSupportPage;
---

<div
  id="bn-supporter-gratitude-banner"
  class="hidden relative z-20 bg-[var(--bg-elevated)]/95 border-b border-[var(--border)] text-[var(--text)] px-4 py-2 text-xs sm:text-sm transition-all"
  role="region"
  aria-label="Community support thank-you note"
  data-ssr-logged-in={initialLoggedIn ? 'true' : 'false'}
>
  <div class="max-w-[1560px] mx-auto flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 shrink-0 text-xs" aria-hidden="true">
        💛
      </span>
      <p class="truncate leading-tight text-[var(--text-muted)] text-xs sm:text-sm">
        <strong class="font-semibold text-[var(--text)]">Gratitude Note:</strong> BitsNotes is 100% free for all students, kept running by voluntary supporters.
      </p>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href="/support#wall-of-gratitude"
        class="hidden sm:inline-flex items-center gap-1 font-semibold text-[var(--accent)] hover:underline text-xs whitespace-nowrap"
      >
        Meet our supporters
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
      <a
        href="/support"
        class="font-semibold px-2.5 py-1 rounded-[var(--r-sm)] bg-[var(--accent-subtle)] text-[var(--accent)] hover:bg-[var(--accent)] hover:text-[var(--accent-contrast)] border border-[var(--accent)]/30 transition-colors text-xs whitespace-nowrap no-underline shadow-xs"
      >
        Support BitsNotes
      </a>
      <button
        type="button"
        id="bn-dismiss-supporter-banner"
        class="p-1 rounded-[var(--r-sm)] text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
        aria-label="Dismiss banner"
        title="Dismiss for 1 hour"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var ONE_HOUR_MS = 60 * 60 * 1000;
    var AUTO_CLOSE_MS = 15 * 1000;
    var autoCloseTimer = null;

    function closeBanner() {
      if (autoCloseTimer) {
        clearTimeout(autoCloseTimer);
        autoCloseTimer = null;
      }
      try {
        localStorage.setItem('bn-supporter-banner-dismissed', Date.now().toString());
      } catch (e) {}

      var banner = document.getElementById('bn-supporter-gratitude-banner');
      if (!banner) return;

      banner.style.transition = 'opacity 300ms ease, max-height 300ms ease, padding 300ms ease';
      banner.style.opacity = '0';
      banner.style.maxHeight = '0';
      banner.style.paddingTop = '0';
      banner.style.paddingBottom = '0';
      banner.style.overflow = 'hidden';

      setTimeout(function () {
        banner.classList.add('hidden');
        banner.style.transition = '';
        banner.style.opacity = '';
        banner.style.maxHeight = '';
        banner.style.paddingTop = '';
        banner.style.paddingBottom = '';
        banner.style.overflow = '';
      }, 320);
    }

    function evaluateSupporterBanner() {
      var banner = document.getElementById('bn-supporter-gratitude-banner');
      if (!banner) return;

      // Never display on the support page itself
      if (window.location.pathname.startsWith('/support')) {
        banner.classList.add('hidden');
        return;
      }

      // Check logged-in status
      var user = null;
      var cachedStr = sessionStorage.getItem('bitsnotes-user');
      if (cachedStr) {
        try { user = JSON.parse(cachedStr); } catch (e) {}
      }

      var isLoggedIn = Boolean(user) || banner.getAttribute('data-ssr-logged-in') === 'true';

      if (!isLoggedIn) {
        banner.classList.add('hidden');
        return;
      }

      // Respect 1-hour cooldown after auto-close or manual dismissal
      try {
        var dismissedAt = localStorage.getItem('bn-supporter-banner-dismissed');
        var now = Date.now();
        if (dismissedAt && (now - parseInt(dismissedAt, 10)) < ONE_HOUR_MS) {
          banner.classList.add('hidden');
          return;
        }
      } catch (e) {}

      // Reveal banner
      banner.classList.remove('hidden');

      // Bind dismiss button
      var dismissBtn = document.getElementById('bn-dismiss-supporter-banner');
      if (dismissBtn && !dismissBtn.dataset.bound) {
        dismissBtn.dataset.bound = 'true';
        dismissBtn.addEventListener('click', function () {
          closeBanner();
        });
      }

      // Pause auto-close while user is hovering over the banner
      if (!banner.dataset.hoverBound) {
        banner.dataset.hoverBound = 'true';
        banner.addEventListener('mouseenter', function () {
          if (autoCloseTimer) {
            clearTimeout(autoCloseTimer);
            autoCloseTimer = null;
          }
        });
        banner.addEventListener('mouseleave', function () {
          if (!autoCloseTimer && !banner.classList.contains('hidden')) {
            autoCloseTimer = setTimeout(closeBanner, 5000);
          }
        });
      }

      // Auto-close after 15 seconds
      if (autoCloseTimer) clearTimeout(autoCloseTimer);
      autoCloseTimer = setTimeout(function () {
        closeBanner();
      }, AUTO_CLOSE_MS);
    }

    evaluateSupporterBanner();
    document.addEventListener('astro:page-load', evaluateSupporterBanner);
    window.addEventListener('bitsnotes:user-updated', function (e) {
      var banner = document.getElementById('bn-supporter-gratitude-banner');
      if (!banner) return;
      if (!e.detail) {
        banner.setAttribute('data-ssr-logged-in', 'false');
        banner.classList.add('hidden');
        if (autoCloseTimer) {
          clearTimeout(autoCloseTimer);
          autoCloseTimer = null;
        }
      } else {
        banner.setAttribute('data-ssr-logged-in', 'true');
        evaluateSupporterBanner();
      }
    });
  })();
</script>
