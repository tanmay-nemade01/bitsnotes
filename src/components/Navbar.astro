---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;

const isDark = theme === 'dark';

// CSS classes based on theme
const navClass = isDark 
  ? 'bg-slate-950/85 backdrop-blur-md border-b border-slate-900 sticky top-0 z-40 px-4 sm:px-6 lg:px-8 shadow-lg transition-all duration-300' 
  : 'bg-white/85 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-40 px-4 sm:px-6 lg:px-8 shadow-sm transition-all duration-300';

const titleClass = isDark ? 'text-white' : 'text-slate-900';
const subtitleClass = isDark ? 'text-slate-400' : 'text-slate-500';
const linkClass = isDark 
  ? 'text-sm font-semibold text-slate-300 hover:text-white transition-colors py-2 px-3 rounded-lg hover:bg-slate-900/60' 
  : 'text-sm font-semibold text-slate-600 hover:text-indigo-600 transition-colors py-2 px-3 rounded-lg hover:bg-slate-50';

const activeLinkClass = isDark
  ? 'text-sm font-bold text-indigo-400 py-2 px-3 rounded-lg bg-indigo-500/10 border border-indigo-500/20'
  : 'text-sm font-bold text-indigo-600 py-2 px-3 rounded-lg bg-indigo-50 border border-indigo-100';

const mobileMenuClass = isDark
  ? 'hidden md:hidden bg-slate-950 border-b border-slate-900 px-4 py-4 space-y-2'
  : 'hidden md:hidden bg-white border-b border-slate-200 px-4 py-4 space-y-2 shadow-lg';

const mobileLinkClass = isDark
  ? 'block text-base font-semibold text-slate-300 hover:text-white py-2 px-3 rounded-lg hover:bg-slate-900'
  : 'block text-base font-semibold text-slate-600 hover:text-indigo-600 py-2 px-3 rounded-lg hover:bg-slate-50';

// Current path to highlight active state
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;
---

<header class={navClass}>
  <div class="max-w-7xl mx-auto h-20 flex items-center justify-between">
    <!-- Left: Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none">
      <div class="w-11 h-11 bg-indigo-600 rounded-xl flex items-center justify-center text-white shadow-md shadow-indigo-600/20 group-hover:scale-105 transition-transform duration-300">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
      </div>
      <div>
        <span class={`block text-lg sm:text-xl font-bold tracking-tight ${titleClass} group-hover:text-indigo-500 transition-colors`}>
          BitsNotes
        </span>
        <p class={`text-[10px] sm:text-xs font-semibold uppercase tracking-wider ${subtitleClass}`}>
          Classroom Notes
        </p>
      </div>
    </a>

    <!-- Center/Right: Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-2">
      <a href="/" class={isActive('/') ? activeLinkClass : linkClass}>
        Dashboard
      </a>
      <a href="/about" class={isActive('/about') ? activeLinkClass : linkClass}>
        About Project
      </a>
      <a href="/contact" class={isActive('/contact') ? activeLinkClass : linkClass}>
        Contact
      </a>
      <a href="/privacy" class={isActive('/privacy') ? activeLinkClass : linkClass}>
        Privacy Policy
      </a>
      <a href="/terms" class={isActive('/terms') ? activeLinkClass : linkClass}>
        Terms
      </a>
    </nav>

    <!-- Right: Mobile Menu Toggle -->
    <div class="flex items-center gap-3">
      <!-- Mobile Menu Button -->
      <button 
        type="button" 
        id="mobile-menu-btn" 
        class={`md:hidden p-2.5 rounded-xl border focus:outline-none focus:ring-2 focus:ring-indigo-500 ${
          isDark 
            ? 'bg-slate-900 border-slate-800 text-slate-300 hover:text-white' 
            : 'bg-slate-50 border-slate-200 text-slate-600 hover:text-indigo-600'
        }`}
        aria-label="Toggle Menu"
      >
        <svg id="menu-icon-hamburger" class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-icon-close" class="w-5.5 h-5.5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Menu -->
<div id="mobile-menu" class={mobileMenuClass}>
  <a href="/" class={isActive('/') ? 'block text-base font-bold text-indigo-500 py-2 px-3 rounded-lg bg-indigo-500/10' : mobileLinkClass}>
    Dashboard
  </a>
  <a href="/about" class={isActive('/about') ? 'block text-base font-bold text-indigo-500 py-2 px-3 rounded-lg bg-indigo-500/10' : mobileLinkClass}>
    About Project
  </a>
  <a href="/contact" class={isActive('/contact') ? 'block text-base font-bold text-indigo-500 py-2 px-3 rounded-lg bg-indigo-500/10' : mobileLinkClass}>
    Contact
  </a>
  <a href="/privacy" class={isActive('/privacy') ? 'block text-base font-bold text-indigo-500 py-2 px-3 rounded-lg bg-indigo-500/10' : mobileLinkClass}>
    Privacy Policy
  </a>
  <a href="/terms" class={isActive('/terms') ? 'block text-base font-bold text-indigo-500 py-2 px-3 rounded-lg bg-indigo-500/10' : mobileLinkClass}>
    Terms
  </a>
</div>

<script is:inline>
  // Mobile menu toggle logic
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('menu-icon-hamburger');
  const closeIcon = document.getElementById('menu-icon-close');

  if (menuBtn && menu) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menu.classList.contains('hidden');
      if (isExpanded) {
        menu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });
  }
</script>
