---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;

const user = (Astro.locals as any).user ?? null;

// Primary nav stays lean so it doesn't compete with study focus.
// Legal/contact links live in the footer (see Footer.astro).
const navLinks = [
  { href: '/', label: 'Dashboard' },
  { href: '/about', label: 'About' },
  { href: '/support', label: 'Support' },
];
---

<header id="site-header" class="h-14 bg-[var(--bg-elevated)] border-b border-[var(--border)] sticky top-0 z-40">
  <div class="max-w-7xl mx-auto h-full flex items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Wordmark only -->
    <a href="/" class="font-display text-xl font-bold text-[var(--text)] hover:text-[var(--accent)] transition-colors no-underline">
      BitsNotes
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`
            px-3 py-1.5 text-sm font-medium border-b-2 transition-colors
            ${isActive(href)
              ? 'text-[var(--text)] border-[var(--text)] font-semibold'
              : 'text-[var(--text-muted)] border-transparent hover:text-[var(--text)] hover:border-[var(--border)]'
            }
          `}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Right: auth + mobile hamburger -->
    <div class="flex items-center gap-3 md:gap-4">
      <!-- Theme toggle (desktop) -->
      <div class="hidden md:block">
        <ThemeToggle />
      </div>

      <!-- Search button -->
      <button
        type="button"
        id="nav-search-btn"
        class="flex items-center gap-2 px-3 py-1.5 text-xs text-[var(--text)] bg-[var(--bg-elevated)] border border-[var(--border)] rounded-[var(--r-sm)] hover:border-[var(--border-strong)] transition-all cursor-pointer group"
        aria-label="Search site content"
      >
        <svg class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <span class="hidden sm:inline">Search...</span>
        <kbd class="hidden md:inline-flex items-center px-1.5 py-0.5 text-[9px] font-sans font-semibold text-[var(--text-muted)] bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[4px] leading-none">Ctrl+K</kbd>
      </button>

      {user ? (
        <!-- Logged in: user dropdown -->
        <div class="hidden md:flex items-center gap-3">
          <div class="relative" id="user-menu-wrapper">
            <button type="button" id="user-menu-btn" class="flex items-center gap-2 px-2 py-1 rounded-[var(--r-sm)] hover:bg-[var(--bg-subtle)] transition-colors text-sm text-[var(--text-muted)] hover:text-[var(--text)]">
              {user.avatarUrl ? (
                <img src={user.avatarUrl} alt="" class="w-6 h-6 rounded-full" referrerpolicy="no-referrer" />
              ) : (
                <span class="w-6 h-6 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] flex items-center justify-center text-xs font-bold">
                  {(user.displayName || user.email || 'U')[0].toUpperCase()}
                </span>
              )}
              <span class="max-w-[120px] truncate">{user.displayName || user.email}</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="user-dropdown" class="hidden absolute right-0 top-full mt-1 w-48 bg-[var(--bg-elevated)] border border-[var(--border)] rounded-[var(--r-md)] shadow-lg py-1 z-50">
              <div class="px-3 py-2 border-b border-[var(--border)]">
                <p class="text-xs font-medium text-[var(--text)] truncate">{user.displayName || 'User'}</p>
                <p class="text-xs text-[var(--text-muted)] truncate">{user.email}</p>
              </div>
              <a href="/bookmarks" class="block px-3 py-2 text-sm text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors">Bookmarks</a>
              <form action="/api/auth/signout" method="POST" class="border-t border-[var(--border)]">
                <button type="submit" class="w-full text-left px-3 py-2 text-sm text-[var(--danger)] hover:bg-[var(--bg-subtle)] transition-colors">Sign out</button>
              </form>
            </div>
          </div>
        </div>
      ) : (
        <!-- Logged out: sign in link -->
        <a href="/auth/signin" class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-[var(--accent)] hover:text-[var(--accent)] border border-[var(--accent)] rounded-[var(--r-sm)] transition-colors no-underline">
          Sign in
        </a>
      )}

      <!-- Mobile hamburger -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors rounded-[var(--r-sm)] hover:bg-[var(--bg-subtle)]"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon-hamburger" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile: full-height clean sheet overlay -->
<aside
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-[var(--bg-elevated)] hidden flex-col"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div class="h-14 border-b border-[var(--border)] flex items-center justify-between px-4 sm:px-6">
    <span class="font-display text-lg font-bold text-[var(--text)]">BitsNotes</span>
    <button
      type="button"
      id="mobile-menu-close"
      class="p-2 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
      aria-label="Close menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
  <nav class="flex-1 flex flex-col gap-1 px-4 py-6">
    <div class="px-4 pb-4">
      <ThemeToggle />
    </div>
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class={`
          block py-4 px-4 text-lg font-medium border-b border-[var(--border)] transition-colors
          ${isActive(href)
            ? 'text-[var(--text)] font-bold'
            : 'text-[var(--text-muted)] hover:text-[var(--text)]'
          }
        `}
      >
        {label}
      </a>
    ))}
    {user ? (
      <div id="mobile-user-actions" class="contents">
        <a href="/bookmarks" class="block py-4 px-4 text-lg font-medium border-b border-[var(--border)] transition-colors text-[var(--text-muted)] hover:text-[var(--text)]">
          Bookmarks
        </a>
        <form action="/api/auth/signout" method="POST" class="mt-4">
          <button type="submit" class="w-full text-left py-4 px-4 text-lg font-medium text-[var(--danger)] border-b border-[var(--border)] transition-colors">
            Sign out
          </button>
        </form>
      </div>
    ) : (
      <a href="/auth/signin" class="mt-4 block py-4 px-4 text-lg font-medium text-[var(--accent)] border-b border-[var(--border)] transition-colors">
        Sign in
      </a>
    )}
  </nav>
</aside>

{user && (
  <div id="auth-state-data" data-user={JSON.stringify(user)} style="display: none;"></div>
)}

<script is:inline>
  (function() {
    // HTML-escape user data to prevent XSS
    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    // Validate avatar URL — only allow http: and https:
    function safeAvatar(url) {
      if (!url) return '';
      var u = String(url);
      return (/^https?:/i).test(u) ? esc(u) : '';
    }

    function bindMobileMenu() {
      var menuBtn = document.getElementById('mobile-menu-btn');
      var menu = document.getElementById('mobile-menu');
      var closeBtn = document.getElementById('mobile-menu-close');

      function openMenu() {
        if (!menu) return;
        menu.classList.remove('hidden');
        var hamburger = document.getElementById('menu-icon-hamburger');
        var closeIcon = document.getElementById('menu-icon-close');
        if (hamburger) hamburger.classList.add('hidden');
        if (closeIcon) closeIcon.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      }

      function closeMenuFn() {
        if (!menu) return;
        menu.classList.add('hidden');
        var hamburger = document.getElementById('menu-icon-hamburger');
        var closeIcon = document.getElementById('menu-icon-close');
        if (hamburger) hamburger.classList.remove('hidden');
        if (closeIcon) closeIcon.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }

      if (menuBtn && !menuBtn.dataset.bound) {
        menuBtn.addEventListener('click', openMenu);
        menuBtn.dataset.bound = 'true';
      }
      if (closeBtn && !closeBtn.dataset.bound) {
        closeBtn.addEventListener('click', closeMenuFn);
        closeBtn.dataset.bound = 'true';
      }
      if (menu) {
        menu.querySelectorAll('a').forEach(function(a) {
          if (!a.dataset.bound) {
            a.addEventListener('click', closeMenuFn);
            a.dataset.bound = 'true';
          }
        });
      }
    }

    function bindUserDropdown() {
      var userMenuBtn = document.getElementById('user-menu-btn');
      var userDropdown = document.getElementById('user-dropdown');
      if (userMenuBtn && userDropdown && !userMenuBtn.dataset.bound) {
        userMenuBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          userDropdown.classList.toggle('hidden');
        });
        userMenuBtn.dataset.bound = 'true';
      }

      if (!window.bitsnotesUserDropdownDocClick) {
        document.addEventListener('click', function() {
          var dropdown = document.getElementById('user-dropdown');
          if (dropdown) dropdown.classList.add('hidden');
        });
        window.bitsnotesUserDropdownDocClick = true;
      }
    }

    function bindSignoutForms() {
      document.querySelectorAll('form[action="/api/auth/signout"]').forEach(function(form) {
        if (!form.dataset.bound) {
          form.addEventListener('submit', function() {
            sessionStorage.removeItem('bitsnotes-user');
          });
          form.dataset.bound = 'true';
        }
      });
    }

    function upgradeToLoggedIn(user) {
      var signInLink = document.querySelector('a[href="/auth/signin"][class*="hidden md:inline-flex"]');
      if (signInLink) {
        var safeDisplayName = esc(user.displayName || user.email);
        var safeEmail = esc(user.email);
        var safeInitial = esc((user.displayName || user.email || 'U')[0].toUpperCase());
        var avatarSrc = safeAvatar(user.avatarUrl);

        var avatarHtml = avatarSrc
          ? '<img src="' + avatarSrc + '" alt="" class="w-6 h-6 rounded-full" referrerpolicy="no-referrer" />'
          : '<span class="w-6 h-6 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] flex items-center justify-center text-xs font-bold">' + safeInitial + '</span>';

        var loggedInHtml =
          '<div class="hidden md:flex items-center gap-3" id="desktop-user-menu">' +
            '<div class="relative" id="user-menu-wrapper">' +
              '<button type="button" id="user-menu-btn" class="flex items-center gap-2 px-2 py-1 rounded-[var(--r-sm)] hover:bg-[var(--bg-subtle)] transition-colors text-sm text-[var(--text-muted)] hover:text-[var(--text)]">' +
                avatarHtml +
                '<span class="max-w-[120px] truncate">' + safeDisplayName + '</span>' +
                '<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>' +
              '</button>' +
              '<div id="user-dropdown" class="hidden absolute right-0 top-full mt-1 w-48 bg-[var(--bg-elevated)] border border-[var(--border)] rounded-[var(--r-md)] shadow-lg py-1 z-50">' +
                '<div class="px-3 py-2 border-b border-[var(--border)]">' +
                  '<p class="text-xs font-medium text-[var(--text)] truncate">' + safeDisplayName + '</p>' +
                  '<p class="text-xs text-[var(--text-muted)] truncate">' + safeEmail + '</p>' +
                '</div>' +
                '<a href="/bookmarks" class="block px-3 py-2 text-sm text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors">Bookmarks</a>' +
                '<form action="/api/auth/signout" method="POST" class="border-t border-[var(--border)]">' +
                  '<button type="submit" class="w-full text-left px-3 py-2 text-sm text-[var(--danger)] hover:bg-[var(--bg-subtle)] transition-colors">Sign out</button>' +
                '</form>' +
              '</div>' +
            '</div>' +
          '</div>';

        signInLink.outerHTML = loggedInHtml;
      }

      var mobileSignIn = document.querySelector('#mobile-menu a[href="/auth/signin"]');
      if (mobileSignIn) {
        mobileSignIn.outerHTML =
          '<div id="mobile-user-actions" class="contents">' +
            '<a href="/bookmarks" class="block py-4 px-4 text-lg font-medium border-b border-[var(--border)] transition-colors text-[var(--text-muted)] hover:text-[var(--text)]">Bookmarks</a>' +
            '<form action="/api/auth/signout" method="POST" class="mt-4">' +
              '<button type="submit" class="w-full text-left py-4 px-4 text-lg font-medium text-[var(--danger)] border-b border-[var(--border)] transition-colors">' +
                'Sign out' +
              '</button>' +
            '</form>' +
          '</div>';
      }

      bindMobileMenu();
      bindUserDropdown();
      bindSignoutForms();
    }

    function downgradeToLoggedOut() {
      var userMenu = document.getElementById('desktop-user-menu') || document.getElementById('user-menu-wrapper')?.parentElement;
      if (userMenu && !userMenu.querySelector('a[href="/auth/signin"]')) {
        var signInHtml =
          '<a href="/auth/signin" class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-[var(--accent)] hover:text-[var(--accent)] border border-[var(--accent)] rounded-[var(--r-sm)] transition-colors no-underline">' +
            'Sign in' +
          '</a>';
        userMenu.outerHTML = signInHtml;
      }

      var mobileActions = document.getElementById('mobile-user-actions') || document.querySelector('#mobile-menu form[action="/api/auth/signout"]')?.parentElement;
      if (mobileActions && !mobileActions.querySelector('a[href="/auth/signin"]')) {
        var mobileSignInHtml =
          '<a href="/auth/signin" class="mt-4 block py-4 px-4 text-lg font-medium text-[var(--accent)] border-b border-[var(--border)] transition-colors">' +
            'Sign in' +
          '</a>';
        mobileActions.outerHTML = mobileSignInHtml;
      }

      bindMobileMenu();
      bindUserDropdown();
      bindSignoutForms();
    }

    function initNav() {
      bindMobileMenu();
      bindUserDropdown();
      bindSignoutForms();

      var stateEl = document.getElementById('auth-state-data');
      if (stateEl && stateEl.dataset.user) {
        try {
          var userObj = JSON.parse(stateEl.dataset.user);
          sessionStorage.setItem('bitsnotes-user', JSON.stringify(userObj));
        } catch (e) {}
      }

      var cachedUserStr = sessionStorage.getItem('bitsnotes-user');
      if (cachedUserStr) {
        try {
          var cachedUser = JSON.parse(cachedUserStr);
          upgradeToLoggedIn(cachedUser);
        } catch (e) {}
      }

      fetch('/api/auth/me', { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data && data.user) {
            sessionStorage.setItem('bitsnotes-user', JSON.stringify(data.user));
            upgradeToLoggedIn(data.user);
          } else {
            sessionStorage.removeItem('bitsnotes-user');
            downgradeToLoggedOut();
          }
        })
        .catch(function() {});
    }

    document.addEventListener('astro:page-load', initNav);
  })();
</script>
