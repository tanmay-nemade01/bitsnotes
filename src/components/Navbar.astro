---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;

const navLinks = [
  { href: '/', label: 'Dashboard' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<header id="site-header" class="h-14 bg-[var(--bg-elevated)] border-b border-[var(--border)] sticky top-0 z-40">
  <div class="max-w-7xl mx-auto h-full flex items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Wordmark only -->
    <a href="/" class="font-display text-xl font-bold text-[var(--text)] hover:text-[var(--accent)] transition-colors no-underline">
      BitsNotes
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`
            px-3 py-1.5 text-sm font-medium border-b-2 transition-colors
            ${isActive(href)
              ? 'text-[var(--accent)] border-[var(--accent)]'
              : 'text-[var(--text-muted)] border-transparent hover:text-[var(--text)] hover:border-[var(--border)]'
            }
          `}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Right: Theme toggle + mobile hamburger -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="theme-toggle"
        class="p-2 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors rounded-[var(--r-sm)] hover:bg-[var(--bg-subtle)]"
        aria-label="Toggle theme"
      >
        <!-- Sun icon: visible only in dark mode -->
        <svg id="theme-icon-sun" class="w-[18px] h-[18px] hidden" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707m12.728 12.728A9 9 0 115.636 5.636m12.728 12.728A9 9 0 015.636 5.636"/>
        </svg>
        <!-- Moon icon: visible only in light mode -->
        <svg id="theme-icon-moon" class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Mobile hamburger -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors rounded-[var(--r-sm)] hover:bg-[var(--bg-subtle)]"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon-hamburger" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile: full-height clean sheet overlay -->
<aside
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-[var(--bg-elevated)] hidden flex-col"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div class="h-14 border-b border-[var(--border)] flex items-center justify-between px-4 sm:px-6">
    <span class="font-display text-lg font-bold text-[var(--text)]">BitsNotes</span>
    <button
      type="button"
      id="mobile-menu-close"
      class="p-2 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
      aria-label="Close menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
  <nav class="flex-1 flex flex-col gap-1 px-4 py-6">
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class={`
          block py-4 px-4 text-lg font-medium border-b border-[var(--border)] transition-colors
          ${isActive(href)
            ? 'text-[var(--accent)]'
            : 'text-[var(--text)] hover:text-[var(--accent)]'
          }
        `}
      >
        {label}
      </a>
    ))}
  </nav>
</aside>

<script is:inline>
  (function() {
    var sun = document.getElementById('theme-icon-sun');
    var moon = document.getElementById('theme-icon-moon');

    function syncThemeUI() {
      var isDark = document.documentElement.classList.contains('dark');
      if (sun) sun.classList.toggle('hidden', !isDark);
      if (moon) moon.classList.toggle('hidden', isDark);
    }

    // Initial sync
    syncThemeUI();

    // Theme toggle click
    var themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', function() {
        var isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
        syncThemeUI();
      });
    }

    // Mobile menu
    var menuBtn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    var closeBtn = document.getElementById('mobile-menu-close');
    var hamburger = document.getElementById('menu-icon-hamburger');
    var closeIcon = document.getElementById('menu-icon-close');

    function openMenu() {
      if (!menu) return;
      menu.classList.remove('hidden');
      if (hamburger) hamburger.classList.add('hidden');
      if (closeIcon) closeIcon.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeMenuFn() {
      if (!menu) return;
      menu.classList.add('hidden');
      if (hamburger) hamburger.classList.remove('hidden');
      if (closeIcon) closeIcon.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    if (menuBtn) menuBtn.addEventListener('click', openMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMenuFn);
    if (menu) {
      menu.querySelectorAll('a').forEach(function(a) {
        a.addEventListener('click', closeMenuFn);
      });
    }
  })();
</script>
