---
// Self-contained Pomodoro timer for the lecture viewer.
// State:
//   localStorage  -> interval preference (15 | 30)
//   sessionStorage -> active timer state (survives refresh + view transitions,
//                     cleared when the tab/window closes)
// Refresh does NOT reset the timer: sessionStorage persists across reloads in
// the same tab, and we intentionally do NOT clear it on page load.
---

<div id="pomodoro" class="pomodoro" hidden>
  <div class="pomodoro__bar">
    <!-- Left: interval length selector -->
    <div class="pomodoro__left">
      <span class="pomodoro__label">Pomodoro</span>
      <div
        class="pomodoro__intervals"
        role="radiogroup"
        aria-label="Focus interval length"
      >
        <button type="button" class="pomodoro__int" role="radio" aria-checked="true" data-interval="15">15 min</button>
        <button type="button" class="pomodoro__int" role="radio" aria-checked="false" data-interval="30">30 min</button>
      </div>
    </div>

    <!-- Center: timer + start/pause -->
    <div class="pomodoro__center">
      <span id="pomodoro-status" class="pomodoro__status" aria-live="polite">Ready</span>
      <button type="button" id="pomodoro-start" class="pomodoro__start">Start</button>
    </div>

    <!-- Right: info + minimize -->
    <div class="pomodoro__right">
      <div class="pomodoro__info-wrapper">
        <span class="pomodoro__info" tabindex="0" aria-describedby="pomodoro-info-card" aria-label="About Pomodoro mode">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4"/>
            <path d="M12 8h.01"/>
          </svg>
        </span>
        <div id="pomodoro-info-card" class="pomodoro__card" role="tooltip">
          <strong>Pomodoro Mode</strong> — Study in focused intervals with guided breathing breaks.
        </div>
      </div>

      <button type="button" id="pomodoro-minimize" class="pomodoro__minimize" aria-label="Minimize timer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- Break vignette overlay -->
<div id="pomodoro-vignette" class="pomodoro-vignette" role="dialog" aria-modal="true" aria-label="Take a break">
  <div class="pomodoro-vignette__card">
    <h2 class="pomodoro-vignette__title">Take a Break</h2>

    <div class="pomodoro-breath" aria-hidden="true">
      <div class="pomodoro-breath__ring"></div>
      <div class="pomodoro-breath__circle"></div>
    </div>

    <p id="pomodoro-break-countdown" class="pomodoro-vignette__countdown">5:00</p>
    <p id="pomodoro-breath-label" class="pomodoro-vignette__phase">Inhale…</p>

    <p class="pomodoro-vignette__hint">Give your mind a break — no phone, no music, just idle time or a quick walk.</p>

    <button type="button" id="pomodoro-skip" class="pomodoro-vignette__skip" aria-label="Skip break">Skip Break</button>

    <div id="pomodoro-ad-slot" class="pomodoro-ad-slot" hidden></div>
  </div>
</div>

<!-- Floating minimized badge: transparent circle with time -->
<button type="button" id="pomodoro-minimized-badge" class="pomodoro-badge" hidden aria-label="Expand Pomodoro timer">
  <span id="pomodoro-badge-text" class="pomodoro-badge__text">--:--</span>
</button>

<!-- Morph clone used for minimize/maximize transitions -->
<div id="pomodoro-clone" class="pomodoro-clone" hidden aria-hidden="true"></div>

<style>
  [hidden] {
    display: none !important;
  }

  .pomodoro {
    position: sticky;
    top: 3.75rem; /* clears the h-14 (3.5rem) header + a touch of padding */
    z-index: 30;
    width: 100%;
    margin-bottom: 0.75rem;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
  }

  .pomodoro[data-minimized='true'] {
    display: none !important;
  }

  /* ---- Bar (single row, three groups) ---- */
  .pomodoro__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background: var(--bg-elevated, #fff);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: var(--r-md, 10px);
    box-shadow: var(--shadow-overlay, 0 8px 30px rgba(0, 0, 0, 0.12));
  }

  /* ---- Three groups ---- */
  .pomodoro__left,
  .pomodoro__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .pomodoro__center {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }

  /* ---- Interval selector ---- */
  .pomodoro__intervals {
    display: inline-flex;
    gap: 0.25rem;
  }
  .pomodoro__int {
    border: 1px solid var(--border, #e5e7eb);
    background: transparent;
    color: var(--text-muted, #64748b);
    border-radius: var(--r-md, 10px);
    padding: 0.3rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: background var(--duration-fast, 120ms) var(--ease-out, ease-out),
      color var(--duration-fast, 120ms) var(--ease-out, ease-out),
      border-color var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }
  .pomodoro__int:hover {
    background: var(--bg-subtle, #f1f5f9);
    color: var(--text, #1a1916);
  }
  .pomodoro__int[aria-checked='true'] {
    background: var(--accent, #0f766e);
    color: var(--accent-contrast, #fff);
    border-color: var(--accent, #0f766e);
  }

  /* ---- Start / Pause ---- */
  .pomodoro__start {
    border: 1px solid var(--accent, #0f766e);
    background: var(--accent, #0f766e);
    color: var(--accent-contrast, #fff);
    border-radius: var(--r-md, 10px);
    padding: 0.35rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    letter-spacing: 0.01em;
    transition: background var(--duration-fast, 120ms) var(--ease-out, ease-out),
      color var(--duration-fast, 120ms) var(--ease-out, ease-out),
      box-shadow var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }
  .pomodoro__start:hover {
    background: var(--accent-hover, #115e59);
    border-color: var(--accent-hover, #115e59);
  }
  .pomodoro__start[data-running='true'] {
    background: transparent;
    color: var(--accent, #0f766e);
  }
  .pomodoro__start[data-running='true']:hover {
    background: var(--accent-subtle, rgba(15, 118, 110, 0.10));
  }

  /* ---- Status (timer display) ---- */
  .pomodoro__status {
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--text-muted, #64748b);
    user-select: none;
  }
  .pomodoro__status[data-state='focus'] {
    color: var(--accent, #0f766e);
  }
  .pomodoro__status[data-state='break'] {
    color: var(--pomodoro-break, #6366f1);
  }

  /* ---- Info wrapper for relative positioning ---- */
  .pomodoro__info-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* ---- Info icon + tooltip ---- */
  .pomodoro__info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--bg-subtle, #f1f5f9);
    color: var(--text-muted, #64748b);
    font-size: 0.8rem;
    cursor: help;
    transition: background-color var(--duration-fast, 120ms) var(--ease-out, ease-out),
      color var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }
  .pomodoro__info:hover {
    background: var(--accent-subtle, rgba(15, 118, 110, 0.10));
    color: var(--accent, #0f766e);
  }
  .pomodoro__card {
    position: absolute;
    top: 2.2rem;
    right: 0;
    width: 18rem;
    padding: 0.8rem 1rem;
    background: var(--bg-elevated, #fff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: var(--r-md, 10px);
    box-shadow: var(--shadow-overlay, 0 8px 30px rgba(0, 0, 0, 0.12));
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text, #1f2937);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity var(--duration-fast, 120ms) var(--ease-out, ease-out),
      transform var(--duration-fast, 120ms) var(--ease-out, ease-out);
    z-index: 60;
    pointer-events: none;
  }
  .pomodoro__info:hover + .pomodoro__card,
  .pomodoro__info:focus + .pomodoro__card,
  .pomodoro__info:focus-visible + .pomodoro__card {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ---- Minimize Button ---- */
  .pomodoro__minimize {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--bg-subtle, #f1f5f9);
    border: none;
    color: var(--text-muted, #64748b);
    cursor: pointer;
    transition: background-color var(--duration-fast, 120ms) var(--ease-out, ease-out),
      color var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }
  .pomodoro__minimize:hover {
    background: var(--accent-subtle, rgba(15, 118, 110, 0.10));
    color: var(--accent, #0f766e);
  }

  /* ---- Label ---- */
  .pomodoro__label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-faint, #736e65);
    margin-right: 0.25rem;
    user-select: none;
  }

  /* Floating minimized badge: solid circle with time */
  .pomodoro-badge {
    position: fixed;
    bottom: 96px;
    right: 24px;
    z-index: 90;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated, #fff);
    border: 1.5px solid var(--border, #cbd5e1);
    box-shadow: var(--shadow-overlay, 0 8px 30px rgba(0, 0, 0, 0.12));
    cursor: pointer;
    font-family: inherit;
    transition: border-color var(--duration-fast, 120ms) var(--ease-out, ease-out),
      background var(--duration-fast, 120ms) var(--ease-out, ease-out),
      transform 0.1s var(--ease-out);
  }
  .pomodoro-badge:hover {
    background: var(--bg-subtle, #f1f5f9);
    border-color: var(--border-strong, #787265);
  }
  .pomodoro-badge:active {
    transform: scale(0.95);
  }
  .pomodoro-badge__text {
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted, #64748b);
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .pomodoro-badge[data-state='focus'] {
    border-color: var(--accent, #0f766e);
    background: var(--bg-elevated, #fff);
  }
  .pomodoro-badge[data-state='focus'] .pomodoro-badge__text {
    color: var(--accent, #0f766e);
  }
  .pomodoro-badge[data-state='focus']:hover {
    background: var(--accent-subtle, rgba(15, 118, 110, 0.10));
  }
  .pomodoro-badge[data-state='break'] {
    border-color: var(--pomodoro-break, #6366f1);
    background: var(--bg-elevated, #fff);
  }
  .pomodoro-badge[data-state='break'] .pomodoro-badge__text {
    color: var(--pomodoro-break, #6366f1);
  }
  .pomodoro-badge[data-state='break']:hover {
    background: rgba(99, 102, 241, 0.08);
  }
  .pomodoro-badge[hidden] {
    display: none !important;
  }

  @media (max-width: 1023px) {
    .pomodoro-badge {
      bottom: 168px;
    }
  }

  /* Morph clone for min ↔ max transitions */
  .pomodoro-clone {
    position: fixed;
    z-index: 95;
    pointer-events: none;
    will-change: transform, width, height, border-radius, opacity;
  }
  .pomodoro-clone[hidden] {
    display: none !important;
  }

  /* Break vignette overlay */
  /* ---- Break vignette ---- */
  .pomodoro-vignette {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 18, 18, 0.78);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 350ms ease, visibility 350ms ease;
  }
  .pomodoro-vignette.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .pomodoro-vignette__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    color: #f1f5f9;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    max-width: 20rem;
    width: 100%;
    padding: 1.75rem 1.5rem;
    background: radial-gradient(ellipse at 50% 30%, rgba(45, 212, 191, 0.08), rgba(255, 255, 255, 0.04));
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: var(--r-lg, 14px);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    transform: scale(0.92) translateY(12px);
    opacity: 0;
    transition: transform 450ms cubic-bezier(0.34, 1.3, 0.64, 1),
                opacity 300ms ease;
  }
  .pomodoro-vignette.is-visible .pomodoro-vignette__card {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .pomodoro-vignette__title {
    font-family: var(--font-display, 'Fraunces', serif);
    font-size: 1.35rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
    color: #fff;
    letter-spacing: -0.01em;
  }

  /* Breathing circle + animated ring */
  .pomodoro-breath {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    margin: 0.25rem 0;
  }
  .pomodoro-breath__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(45, 212, 191, 0.25);
    animation: pomodoro-ring-pulse 16s ease-in-out infinite;
  }
  @keyframes pomodoro-ring-pulse {
    0%   { transform: scale(0.75); opacity: 0.6; }
    25%  { transform: scale(1.0);  opacity: 0.15; }
    50%  { transform: scale(1.0);  opacity: 0.15; }
    75%  { transform: scale(0.75); opacity: 0.6; }
    100% { transform: scale(0.75); opacity: 0.6; }
  }
  .pomodoro-breath__circle {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #5eead4, var(--accent, #0f766e));
    box-shadow: 0 0 40px rgba(45, 212, 191, 0.30), 0 0 80px rgba(15, 118, 110, 0.12);
    animation: pomodoro-breathe 16s ease-in-out infinite;
  }
  @keyframes pomodoro-breathe {
    0%   { transform: scale(0.55); }
    25%  { transform: scale(1.0);  }
    50%  { transform: scale(1.0);  }
    75%  { transform: scale(0.55); }
    100% { transform: scale(0.55); }
  }

  .pomodoro-vignette__countdown {
    font-size: 1.3rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    margin: 0;
    color: #f8fafc;
  }

  .pomodoro-vignette__phase {
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0;
    color: #5eead4;
    min-height: 1.2em;
    letter-spacing: 0.02em;
  }

  .pomodoro-vignette__hint {
    font-size: 0.78rem;
    font-weight: 400;
    margin: 0;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.5;
    max-width: 16rem;
  }

  .pomodoro-vignette__skip {
    margin-top: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    border-radius: var(--r-md, 10px);
    padding: 0.45rem 1.25rem;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: background-color var(--duration-fast, 120ms) var(--ease-out, ease-out),
                border-color var(--duration-fast, 120ms) var(--ease-out, ease-out),
                color var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }
  .pomodoro-vignette__skip:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
  }
  .pomodoro-vignette__skip:active {
    transform: scale(0.97);
  }

  .pomodoro-ad-slot {
    width: 100%;
    min-height: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pomodoro-breath__circle,
    .pomodoro-breath__ring { animation: none; }
    .pomodoro-breath__circle { transform: scale(0.8); }
    .pomodoro-breath__ring   { transform: scale(0.9); opacity: 0.3; }
  }

  @media (max-width: 640px) {
    .pomodoro__label {
      display: none;
    }
    .pomodoro__bar {
      padding: 0.6rem 0.75rem;
      gap: 0.5rem;
    }
    .pomodoro__int {
      padding: 0.25rem 0.55rem;
      font-size: 0.75rem;
    }
    .pomodoro__status {
      font-size: 1rem;
    }
    .pomodoro__start {
      padding: 0.3rem 0.8rem;
      font-size: 0.8rem;
    }
    .pomodoro__card {
      width: 14rem;
      right: auto;
      left: 50%;
      transform: translate(-50%, -8px);
    }
    .pomodoro__info:hover + .pomodoro__card,
    .pomodoro__info:focus + .pomodoro__card,
    .pomodoro__info:focus-visible + .pomodoro__card {
      transform: translate(-50%, 0);
    }
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    'use strict';

    var INTERVAL_KEY = 'bitsnotes:pomodoro:interval';
    var TIMER_KEY = 'bitsnotes:pomodoro:timerState';
    var MINIMIZED_KEY = 'bitsnotes:pomodoro:minimized';
    var BREAK_MS = 5 * 60 * 1000; // 5 minutes

    var root = document.getElementById('pomodoro');
    if (!root) return; // not on a lecture page

    var intervalBtns = Array.prototype.slice.call(root.querySelectorAll('.pomodoro__int'));
    var intervalsContainer = root.querySelector('.pomodoro__intervals');
    var startBtn = document.getElementById('pomodoro-start');
    var statusEl = document.getElementById('pomodoro-status');
    var centerGroup = root.querySelector('.pomodoro__center');
    var vignette = document.getElementById('pomodoro-vignette');
    var breathLabel = document.getElementById('pomodoro-breath-label');
    var breakCountdown = document.getElementById('pomodoro-break-countdown');
    var skipBtn = document.getElementById('pomodoro-skip');
    
    var minimizeBtn = document.getElementById('pomodoro-minimize');
    var badge = document.getElementById('pomodoro-minimized-badge');
    var badgeText = document.getElementById('pomodoro-badge-text');

    // Use a window-level handle so re-runs (data-astro-rerun on View
    // Transitions) can clear any interval started by a previous run.
    var TICK_KEY = '__bitsnotesPomodoroTick';

    function getIntervalMin() {
      return parseInt(localStorage.getItem(INTERVAL_KEY) || '15', 10);
    }
    function getTimerState() {
      try {
        return JSON.parse(sessionStorage.getItem(TIMER_KEY) || 'null');
      } catch (e) {
        return null;
      }
    }
    function setTimerState(state) {
      if (state) {
        sessionStorage.setItem(TIMER_KEY, JSON.stringify(state));
      } else {
        sessionStorage.removeItem(TIMER_KEY);
      }
    }

    function isMinimized() {
      // Default to minimized (a chip) so it doesn't compete with the title.
      // Only expand if the user has explicitly opted in (stored 'false').
      var stored = sessionStorage.getItem(MINIMIZED_KEY);
      return stored !== 'false';
    }
    function setMinimizedState(minimized) {
      sessionStorage.setItem(MINIMIZED_KEY, String(minimized));
    }
    function applyMinimizedState() {
      var minimized = isMinimized();
      root.setAttribute('data-minimized', String(minimized));
      if (badge) {
        badge.hidden = !minimized;
      }
    }

    function fmt(ms) {
      var total = Math.max(0, Math.ceil(ms / 1000));
      var m = Math.floor(total / 60);
      var s = total % 60;
      return m + ':' + (s < 10 ? '0' + s : s);
    }

    function renderIntervals() {
      // Ensure the widget wrapper itself is always visible once JS initializes it
      root.hidden = false;

      intervalBtns.forEach(function (b) {
        b.setAttribute('aria-checked', String(getIntervalMin()) === b.getAttribute('data-interval') ? 'true' : 'false');
      });
    }

    function renderStartBtn(state) {
      if (!state || state.status === 'idle') {
        startBtn.textContent = 'Start';
        startBtn.setAttribute('data-running', 'false');
      } else if (state.status === 'focus' || state.status === 'break') {
        startBtn.textContent = 'Pause';
        startBtn.setAttribute('data-running', 'true');
      }
    }

    function setStatus(text, state) {
      statusEl.textContent = text;
      if (state) statusEl.setAttribute('data-state', state);
      else statusEl.removeAttribute('data-state');

      // Badge shows only the mm:ss time, fallback to default interval
      if (badgeText) {
        var match = text.match(/(\d{1,2}:\d{2})/);
        badgeText.textContent = match ? match[1] : (getIntervalMin() + 'm');
      }
      if (badge) {
        if (state) {
          badge.setAttribute('data-state', state);
        } else {
          badge.removeAttribute('data-state');
        }
      }
    }

    function tick() {
      var state = getTimerState();
      if (!state || state.status === 'idle') return;

      var elapsed = Date.now() - state.startedAt + (state.elapsedBeforePause || 0);

      if (state.status === 'focus') {
        var focusMs = getIntervalMin() * 60 * 1000;
        if (elapsed >= focusMs) {
          startBreak();
        } else {
          setStatus('Focus — ' + fmt(focusMs - elapsed) + ' remaining', 'focus');
        }
      } else if (state.status === 'break') {
        if (elapsed >= BREAK_MS) {
          endBreak();
        } else {
          setStatus('Break — ' + fmt(BREAK_MS - elapsed) + ' remaining', 'break');
          if (vignette && vignette.classList.contains('is-visible')) {
            breakCountdown.textContent = fmt(BREAK_MS - elapsed);
            updateBreathLabel(elapsed);
          }
        }
      }
    }

    function startTick() {
      if (window[TICK_KEY]) return;
      window[TICK_KEY] = setInterval(tick, 1000);
    }
    function stopTick() {
      if (window[TICK_KEY]) {
        clearInterval(window[TICK_KEY]);
        window[TICK_KEY] = null;
      }
    }

    function startFocus() {
      setTimerState({
        status: 'focus',
        startedAt: Date.now(),
        elapsedBeforePause: 0,
        interval: getIntervalMin()
      });
      renderStartBtn({ status: 'focus' });
      setStatus('Focus — ' + getIntervalMin() + ':00 remaining', 'focus');
      startTick();
    }

    function pauseTimer() {
      var state = getTimerState();
      if (!state || state.status === 'idle') return;
      var elapsed = Date.now() - state.startedAt + (state.elapsedBeforePause || 0);
      setTimerState({
        status: state.status,
        startedAt: 0,
        elapsedBeforePause: elapsed,
        interval: state.interval
      });
      renderStartBtn({ status: 'idle' });
      setStatus('Paused', null);
      stopTick();
    }

    function resumeTimer() {
      var state = getTimerState();
      if (!state || state.status === 'idle') return;
      state.startedAt = Date.now();
      setTimerState(state);
      renderStartBtn(state);
      startTick();
      tick();
    }

    function startBreak() {
      setTimerState({
        status: 'break',
        startedAt: Date.now(),
        elapsedBeforePause: 0,
        interval: getIntervalMin()
      });
      if (vignette) vignette.classList.add('is-visible');
      renderStartBtn({ status: 'break' });
      setStatus('Break — 5:00 remaining', 'break');
      breakCountdown.textContent = '5:00';
      updateBreathLabel(0);
      startTick();
    }

    function endBreak() {
      if (vignette) vignette.classList.remove('is-visible');
      startFocus();
    }

    function updateBreathLabel(elapsed) {
      if (!breathLabel) return;
      var cycle = 16000;
      var pos = elapsed % cycle;
      var phase;
      if (pos < 4000) phase = 'Inhale…';
      else if (pos < 8000) phase = 'Hold';
      else if (pos < 12000) phase = 'Exhale…';
      else phase = 'Hold';
      breathLabel.textContent = phase;
    }

    function onStartClick() {
      var state = getTimerState();
      if (!state || state.status === 'idle') {
        startFocus();
      } else {
        // toggle pause/resume
        if (state.startedAt === 0) {
          resumeTimer();
        } else {
          pauseTimer();
        }
      }
    }

    // Event wiring
    intervalBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        var val = parseInt(b.getAttribute('data-interval'), 10);
        localStorage.setItem(INTERVAL_KEY, String(val));
        renderIntervals();
        // If currently idle, just update the ready label
        var st = getTimerState();
        if (!st || st.status === 'idle') {
          setStatus('Ready', null);
        }
      });
    });

    startBtn.addEventListener('click', onStartClick);

    if (skipBtn) {
      skipBtn.addEventListener('click', function () {
        endBreak();
      });
    }

    if (minimizeBtn) {
      minimizeBtn.addEventListener('click', function () {
        morphToBadge(function () {
          setMinimizedState(true);
          applyMinimizedState();
        });
      });
    }

    if (badge) {
      badge.addEventListener('click', function () {
        morphToBar(function () {
          setMinimizedState(false);
          applyMinimizedState();
        });
      });
    }

    // ---- Morph animation helpers ----

    var cloneEl = document.getElementById('pomodoro-clone');
    var DUR = 250; // ms — short enough to feel snappy, long enough for smoothness

    function resetClone() {
      cloneEl.hidden = true;
      cloneEl.removeAttribute('style');
    }

    /**
     * Morph bar → badge: GPU-accelerated transform + border-radius.
     * Clone is a plain styled div (no innerHTML) to avoid layout thrashing.
     */
    function morphToBadge(onDone) {
      var bar = root.querySelector('.pomodoro__bar');
      if (!bar || !badge || !cloneEl) { onDone(); return; }

      var b  = bar.getBoundingClientRect();
      var cs = window.getComputedStyle(bar);

      // Measure badge position
      badge.hidden = false;
      badge.style.visibility = 'hidden';
      var bc = badge.getBoundingClientRect();
      badge.hidden = true;
      badge.style.visibility = '';

      // Scale factors
      var sx = bc.width  / b.width;
      var sy = bc.height / b.height;

      // Build clone: visual snapshot of bar (no content)
      cloneEl.hidden = false;
      Object.assign(cloneEl.style, {
        position: 'fixed',
        left: '0', top: '0',
        width:  b.width  + 'px',
        height: b.height + 'px',
        borderRadius: cs.borderRadius,
        background: cs.background,
        border: cs.border,
        boxShadow: cs.boxShadow,
        backdropFilter: cs.backdropFilter,
        webkitBackdropFilter: cs.webkitBackdropFilter,
        transform: 'translate(' + b.left + 'px, ' + b.top + 'px) scale(1, 1)',
        transformOrigin: '0 0',
        willChange: 'transform, border-radius, opacity',
        contain: 'layout style paint',
        opacity: '1',
        overflow: 'hidden',
        transition: 'none'
      });
      cloneEl.getBoundingClientRect(); // force paint

      // Hide real bar
      root.setAttribute('data-minimized', 'true');

      // Kick off GPU animation
      cloneEl.style.transition =
        'transform ' + DUR + 'ms cubic-bezier(0.25, 0.1, 0.25, 1),' +
        'border-radius ' + DUR + 'ms cubic-bezier(0.25, 0.1, 0.25, 1),' +
        'opacity 160ms ease-out';
      cloneEl.style.transform = 'translate(' + bc.left + 'px, ' + bc.top + 'px) scale(' + sx + ', ' + sy + ')';
      cloneEl.style.borderRadius = '50%';
      cloneEl.style.opacity = '0';

      setTimeout(function () { onDone(); }, DUR * 0.55);
      setTimeout(function () { resetClone(); }, DUR + 50);
    }

    /**
     * Morph badge → bar: GPU-accelerated transform + border-radius.
     * Clone starts as a circle, expands to bar shape.
     */
    function morphToBar(onDone) {
      var bar = root.querySelector('.pomodoro__bar');
      if (!bar || !badge || !cloneEl) { onDone(); return; }

      var bc = badge.getBoundingClientRect();

      // Force bar layout while hidden
      root.setAttribute('data-minimized', 'false');
      root.style.visibility = 'hidden';
      bar.getBoundingClientRect(); // force layout
      var b  = bar.getBoundingClientRect();
      var cs = window.getComputedStyle(bar);
      root.style.visibility = '';
      root.setAttribute('data-minimized', 'true');

      // Scale factors (badge → bar)
      var sx = b.width  / bc.width;
      var sy = b.height / bc.height;

      // Build clone: circle matching badge appearance
      cloneEl.hidden = false;
      Object.assign(cloneEl.style, {
        position: 'fixed',
        left: '0', top: '0',
        width:  bc.width  + 'px',
        height: bc.height + 'px',
        borderRadius: '50%',
        background: 'transparent',
        border: '1.5px solid ' + (badge.getAttribute('data-state') === 'focus' ?
          'var(--accent, #0f766e)' : 'rgba(15, 118, 110, 0.25)'),
        boxShadow: 'none',
        backdropFilter: 'none',
        webkitBackdropFilter: 'none',
        transform: 'translate(' + bc.left + 'px, ' + bc.top + 'px) scale(1, 1)',
        transformOrigin: '0 0',
        willChange: 'transform, border-radius, opacity',
        contain: 'layout style paint',
        opacity: '1',
        overflow: 'hidden',
        transition: 'none'
      });
      cloneEl.getBoundingClientRect(); // force paint

      // Hide badge
      badge.hidden = true;

      // Kick off GPU animation
      cloneEl.style.transition =
        'transform ' + DUR + 'ms cubic-bezier(0.25, 0.1, 0.25, 1),' +
        'border-radius ' + DUR + 'ms cubic-bezier(0.25, 0.1, 0.25, 1),' +
        'opacity 160ms ease-in';
      cloneEl.style.transform = 'translate(' + b.left + 'px, ' + b.top + 'px) scale(' + sx + ', ' + sy + ')';
      cloneEl.style.borderRadius = cs.borderRadius;
      cloneEl.style.opacity = '0';

      setTimeout(function () { onDone(); }, DUR * 0.55);
      setTimeout(function () { resetClone(); }, DUR + 50);
    }

    function init() {
      renderIntervals();
      applyMinimizedState();
      var st = getTimerState();
      if (st && st.status !== 'idle') {
        renderStartBtn(st);
        startTick();
        tick();
      } else {
        setStatus('Ready', null);
        renderStartBtn({ status: 'idle' });
      }
    }

    init();
  })();
</script>
