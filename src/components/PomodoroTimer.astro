---
// Self-contained Pomodoro timer component for the site header.
// State:
//   localStorage  -> interval preference (15 | 30)
//   sessionStorage -> active timer state (survives refresh + view transitions)
---

<div id="pomodoro" class="relative flex items-center">
  <!-- Header Control Pill (Placed right of Sign-In / User Profile in Navbar) -->
  <div
    id="pomodoro-bar"
    class="flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium bg-[var(--bg-elevated)] border border-[var(--border)] rounded-[var(--r-sm)] hover:border-[var(--border-strong)] transition-all select-none shadow-xs"
  >
    <!-- Quick Start / Pause Button -->
    <button
      type="button"
      id="pomodoro-start"
      class="flex items-center justify-center p-1 rounded-full text-[var(--accent)] hover:bg-[var(--accent-subtle)] active:scale-95 transition-all cursor-pointer"
      title="Start / Pause Pomodoro"
      aria-label="Start or pause Pomodoro timer"
    >
      <!-- Play Icon (default) -->
      <svg id="pomodoro-icon-play" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
      <!-- Pause Icon (when active) -->
      <svg id="pomodoro-icon-pause" class="w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
      </svg>
    </button>

    <!-- Timer Readout / Status Badge & Dropdown Trigger -->
    <button
      type="button"
      id="pomodoro-toggle-menu"
      class="flex items-center gap-1.5 cursor-pointer text-[var(--text)] hover:text-[var(--accent)] transition-colors group"
      aria-expanded="false"
      aria-controls="pomodoro-dropdown"
      title="Pomodoro Timer settings"
    >
      <span id="pomodoro-status" class="font-mono text-xs font-bold tracking-tight text-[var(--text)]" data-state="idle">
        15:00
      </span>
      <span id="pomodoro-state-label" class="hidden sm:inline text-[10px] uppercase font-semibold text-[var(--text-faint)] tracking-wider">
        Ready
      </span>
      <svg id="pomodoro-chevron" class="w-3 h-3 text-[var(--text-muted)] group-hover:text-[var(--text)] transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 9l-7 7-7-7"/>
      </svg>
    </button>
  </div>

  <!-- Popover / Dropdown Menu for Pomodoro Controls & Settings -->
  <div
    id="pomodoro-dropdown"
    class="hidden absolute right-0 top-full mt-2 w-72 bg-[var(--bg-elevated)] border border-[var(--border)] rounded-[var(--r-md)] shadow-xl p-4 z-50 transition-all duration-200"
    role="dialog"
    aria-label="Pomodoro Timer Settings"
  >
    <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-[var(--border)]">
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
        </svg>
        <span class="font-display text-sm font-semibold text-[var(--text)]">Pomodoro Timer</span>
      </div>
      <span class="text-[10px] font-medium text-[var(--text-muted)] bg-[var(--bg-subtle)] px-2 py-0.5 rounded-full border border-[var(--border)]">
        Focus Tool
      </span>
    </div>

    <!-- Interval Duration Selector -->
    <div class="mb-4">
      <label class="block text-[10px] font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-1.5">
        Focus Duration
      </label>
      <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Focus interval length">
        <button
          type="button"
          class="pomodoro__int px-3 py-1.5 text-xs font-medium border rounded-[var(--r-sm)] transition-all cursor-pointer text-center"
          role="radio"
          aria-checked="true"
          data-interval="15"
        >
          ⚡ 15 Minutes
        </button>
        <button
          type="button"
          class="pomodoro__int px-3 py-1.5 text-xs font-medium border rounded-[var(--r-sm)] transition-all cursor-pointer text-center"
          role="radio"
          aria-checked="false"
          data-interval="30"
        >
          🎯 30 Minutes
        </button>
      </div>
    </div>

    <!-- Big Status & Main Action Buttons -->
    <div class="bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[var(--r-sm)] p-3 text-center mb-3">
      <div id="pomodoro-modal-status" class="text-xs font-medium text-[var(--text-muted)] mb-1">
        Ready to focus
      </div>
      <div id="pomodoro-modal-timer" class="font-mono text-2xl font-bold text-[var(--text)] tracking-wider mb-2.5">
        15:00
      </div>
      <div class="flex gap-2">
        <button
          type="button"
          id="pomodoro-modal-start"
          class="flex-1 py-1.5 px-3 text-xs font-semibold bg-[var(--accent)] text-[var(--accent-contrast)] rounded-[var(--r-sm)] hover:opacity-90 active:scale-98 transition-all cursor-pointer shadow-xs"
        >
          Start Focus
        </button>
        <button
          type="button"
          id="pomodoro-reset"
          class="py-1.5 px-3 text-xs font-medium bg-[var(--bg-elevated)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--border-strong)] rounded-[var(--r-sm)] transition-all cursor-pointer"
          title="Reset timer"
        >
          Reset
        </button>
      </div>
    </div>

    <p class="text-[11px] text-[var(--text-muted)] leading-relaxed text-center">
      Study in focused intervals with guided breathing breaks to maximize retention and prevent burn-out.
    </p>
  </div>
</div>

<!-- Break Vignette Overlay (full screen modal when focus timer finishes) -->
<div id="pomodoro-vignette" class="pomodoro-vignette" role="dialog" aria-modal="true" aria-label="Take a break">
  <div class="pomodoro-vignette__card">
    <h2 class="pomodoro-vignette__title">Take a Break</h2>

    <div class="pomodoro-breath" aria-hidden="true">
      <div class="pomodoro-breath__ring"></div>
      <div class="pomodoro-breath__circle"></div>
    </div>

    <p id="pomodoro-break-countdown" class="pomodoro-vignette__countdown">5:00</p>
    <p id="pomodoro-breath-label" class="pomodoro-vignette__phase">Inhale…</p>

    <p class="pomodoro-vignette__hint">Give your mind a break — no phone, no music, just idle time or a quick walk.</p>

    <button type="button" id="pomodoro-skip" class="pomodoro-vignette__skip" aria-label="Skip break">Skip Break</button>

    <div id="pomodoro-ad-slot" class="pomodoro-ad-slot" hidden></div>
  </div>
</div>

<style>
  [hidden] {
    display: none !important;
  }

  .pomodoro__int[aria-checked='true'] {
    background: var(--accent, #0f766e);
    color: var(--accent-contrast, #fff);
    border-color: var(--accent, #0f766e);
  }
  .pomodoro__int[aria-checked='false'] {
    background: var(--bg-elevated, #fff);
    color: var(--text-muted, #64748b);
    border-color: var(--border, #e5e7eb);
  }
  .pomodoro__int[aria-checked='false']:hover {
    background: var(--bg-subtle, #f1f5f9);
    color: var(--text, #1a1916);
  }

  /* Status Colors */
  #pomodoro-status[data-state='focus'] {
    color: var(--accent, #0f766e);
  }
  #pomodoro-status[data-state='break'] {
    color: var(--pomodoro-break, #6366f1);
  }

  /* Break vignette overlay */
  .pomodoro-vignette {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 18, 18, 0.78);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 350ms ease, visibility 350ms ease;
  }
  .pomodoro-vignette.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .pomodoro-vignette__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    color: #f1f5f9;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    max-width: 20rem;
    width: 100%;
    padding: 1.75rem 1.5rem;
    background: radial-gradient(ellipse at 50% 30%, rgba(45, 212, 191, 0.08), rgba(255, 255, 255, 0.04));
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: var(--r-lg, 14px);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    transform: scale(0.92) translateY(12px);
    opacity: 0;
    transition: transform 450ms cubic-bezier(0.34, 1.3, 0.64, 1),
                opacity 300ms ease;
  }
  .pomodoro-vignette.is-visible .pomodoro-vignette__card {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .pomodoro-vignette__title {
    font-family: var(--font-display, 'Fraunces', serif);
    font-size: 1.35rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
    color: #fff;
    letter-spacing: -0.01em;
  }

  /* Breathing circle + animated ring */
  .pomodoro-breath {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    margin: 0.25rem 0;
  }
  .pomodoro-breath__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(45, 212, 191, 0.25);
    animation: pomodoro-ring-pulse 16s ease-in-out infinite;
  }
  @keyframes pomodoro-ring-pulse {
    0%   { transform: scale(0.75); opacity: 0.6; }
    25%  { transform: scale(1.0);  opacity: 0.15; }
    50%  { transform: scale(1.0);  opacity: 0.15; }
    75%  { transform: scale(0.75); opacity: 0.6; }
    100% { transform: scale(0.75); opacity: 0.6; }
  }
  .pomodoro-breath__circle {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #5eead4, var(--accent, #0f766e));
    box-shadow: 0 0 40px rgba(45, 212, 191, 0.30), 0 0 80px rgba(15, 118, 110, 0.12);
    animation: pomodoro-breathe 16s ease-in-out infinite;
  }
  @keyframes pomodoro-breathe {
    0%   { transform: scale(0.55); }
    25%  { transform: scale(1.0);  }
    50%  { transform: scale(1.0);  }
    75%  { transform: scale(0.55); }
    100% { transform: scale(0.55); }
  }

  .pomodoro-vignette__countdown {
    font-size: 1.3rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    margin: 0;
    color: #f8fafc;
  }

  .pomodoro-vignette__phase {
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0;
    color: #5eead4;
    min-height: 1.2em;
    letter-spacing: 0.02em;
  }

  .pomodoro-vignette__hint {
    font-size: 0.78rem;
    font-weight: 400;
    margin: 0;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.5;
    max-width: 16rem;
  }

  .pomodoro-vignette__skip {
    margin-top: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    border-radius: var(--r-md, 10px);
    padding: 0.45rem 1.25rem;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: background-color var(--duration-fast, 120ms) var(--ease-out, ease-out),
                border-color var(--duration-fast, 120ms) var(--ease-out, ease-out),
                color var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }
  .pomodoro-vignette__skip:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .pomodoro-breath__circle,
    .pomodoro-breath__ring { animation: none; }
    .pomodoro-breath__circle { transform: scale(0.8); }
    .pomodoro-breath__ring   { transform: scale(0.9); opacity: 0.3; }
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    'use strict';

    var INTERVAL_KEY = 'bitsnotes:pomodoro:interval';
    var TIMER_KEY = 'bitsnotes:pomodoro:timerState';
    var BREAK_MS = 5 * 60 * 1000; // 5 minutes break

    var root = document.getElementById('pomodoro');
    if (!root) return;

    var startBtn = document.getElementById('pomodoro-start');
    var modalStartBtn = document.getElementById('pomodoro-modal-start');
    var resetBtn = document.getElementById('pomodoro-reset');
    var statusEl = document.getElementById('pomodoro-status');
    var stateLabel = document.getElementById('pomodoro-state-label');
    var modalStatusEl = document.getElementById('pomodoro-modal-status');
    var modalTimerEl = document.getElementById('pomodoro-modal-timer');
    var iconPlay = document.getElementById('pomodoro-icon-play');
    var iconPause = document.getElementById('pomodoro-icon-pause');

    var menuBtn = document.getElementById('pomodoro-toggle-menu');
    var dropdown = document.getElementById('pomodoro-dropdown');
    var chevron = document.getElementById('pomodoro-chevron');

    var intervalBtns = Array.prototype.slice.call(root.querySelectorAll('.pomodoro__int'));
    var vignette = document.getElementById('pomodoro-vignette');
    var breathLabel = document.getElementById('pomodoro-breath-label');
    var breakCountdown = document.getElementById('pomodoro-break-countdown');
    var skipBtn = document.getElementById('pomodoro-skip');

    var TICK_KEY = '__bitsnotesPomodoroTick';

    function getIntervalMin() {
      return parseInt(localStorage.getItem(INTERVAL_KEY) || '15', 10);
    }
    function getTimerState() {
      try {
        return JSON.parse(sessionStorage.getItem(TIMER_KEY) || 'null');
      } catch (e) {
        return null;
      }
    }
    function setTimerState(state) {
      if (state) {
        sessionStorage.setItem(TIMER_KEY, JSON.stringify(state));
      } else {
        sessionStorage.removeItem(TIMER_KEY);
      }
    }

    function fmt(ms) {
      var total = Math.max(0, Math.ceil(ms / 1000));
      var m = Math.floor(total / 60);
      var s = total % 60;
      return m + ':' + (s < 10 ? '0' + s : s);
    }

    function renderIntervals() {
      intervalBtns.forEach(function (b) {
        b.setAttribute('aria-checked', String(getIntervalMin()) === b.getAttribute('data-interval') ? 'true' : 'false');
      });
    }

    function renderStartBtns(state) {
      var isRunning = state && (state.status === 'focus' || state.status === 'break') && state.startedAt > 0;
      if (iconPlay && iconPause) {
        if (isRunning) {
          iconPlay.classList.add('hidden');
          iconPause.classList.remove('hidden');
        } else {
          iconPlay.classList.remove('hidden');
          iconPause.classList.add('hidden');
        }
      }
      if (modalStartBtn) {
        if (!state || state.status === 'idle') {
          modalStartBtn.textContent = 'Start Focus';
        } else if (isRunning) {
          modalStartBtn.textContent = 'Pause';
        } else {
          modalStartBtn.textContent = 'Resume';
        }
      }
    }

    function setStatus(text, formattedTime, state) {
      if (statusEl) {
        statusEl.textContent = formattedTime;
        if (state) statusEl.setAttribute('data-state', state);
        else statusEl.removeAttribute('data-state');
      }
      if (modalTimerEl) {
        modalTimerEl.textContent = formattedTime;
      }
      if (stateLabel) {
        if (state === 'focus') stateLabel.textContent = 'Focus';
        else if (state === 'break') stateLabel.textContent = 'Break';
        else stateLabel.textContent = 'Ready';
      }
      if (modalStatusEl) {
        modalStatusEl.textContent = text;
      }
    }

    function tick() {
      var state = getTimerState();
      if (!state || state.status === 'idle') return;

      var elapsed = (state.startedAt > 0 ? (Date.now() - state.startedAt) : 0) + (state.elapsedBeforePause || 0);

      if (state.status === 'focus') {
        var focusMs = getIntervalMin() * 60 * 1000;
        if (elapsed >= focusMs) {
          startBreak();
        } else {
          var remaining = focusMs - elapsed;
          var isPaused = state.startedAt === 0;
          setStatus(
            isPaused ? 'Focus Paused' : 'Focusing...',
            fmt(remaining),
            'focus'
          );
        }
      } else if (state.status === 'break') {
        if (elapsed >= BREAK_MS) {
          endBreak();
        } else {
          var remainingBreak = BREAK_MS - elapsed;
          var isBreakPaused = state.startedAt === 0;
          setStatus(
            isBreakPaused ? 'Break Paused' : 'On a Break',
            fmt(remainingBreak),
            'break'
          );
          if (vignette && vignette.classList.contains('is-visible')) {
            if (breakCountdown) breakCountdown.textContent = fmt(remainingBreak);
            updateBreathLabel(elapsed);
          }
        }
      }
    }

    function startTick() {
      if (window[TICK_KEY]) return;
      window[TICK_KEY] = setInterval(tick, 1000);
    }
    function stopTick() {
      if (window[TICK_KEY]) {
        clearInterval(window[TICK_KEY]);
        window[TICK_KEY] = null;
      }
    }

    function startFocus() {
      setTimerState({
        status: 'focus',
        startedAt: Date.now(),
        elapsedBeforePause: 0,
        interval: getIntervalMin()
      });
      renderStartBtns({ status: 'focus', startedAt: Date.now() });
      setStatus('Focusing...', getIntervalMin() + ':00', 'focus');
      startTick();
    }

    function pauseTimer() {
      var state = getTimerState();
      if (!state || state.status === 'idle') return;
      var elapsed = (state.startedAt > 0 ? (Date.now() - state.startedAt) : 0) + (state.elapsedBeforePause || 0);
      setTimerState({
        status: state.status,
        startedAt: 0,
        elapsedBeforePause: elapsed,
        interval: state.interval
      });
      renderStartBtns({ status: state.status, startedAt: 0 });
      setStatus(state.status === 'break' ? 'Break Paused' : 'Focus Paused', fmt(getIntervalMin() * 60 * 1000 - elapsed), state.status);
      stopTick();
    }

    function resumeTimer() {
      var state = getTimerState();
      if (!state || state.status === 'idle') return;
      state.startedAt = Date.now();
      setTimerState(state);
      renderStartBtns(state);
      startTick();
      tick();
    }

    function resetTimer() {
      setTimerState(null);
      stopTick();
      renderStartBtns({ status: 'idle', startedAt: 0 });
      setStatus('Ready to focus', getIntervalMin() + ':00', null);
      if (vignette) vignette.classList.remove('is-visible');
    }

    function startBreak() {
      setTimerState({
        status: 'break',
        startedAt: Date.now(),
        elapsedBeforePause: 0,
        interval: getIntervalMin()
      });
      if (vignette) vignette.classList.add('is-visible');
      renderStartBtns({ status: 'break', startedAt: Date.now() });
      setStatus('On a Break', '5:00', 'break');
      if (breakCountdown) breakCountdown.textContent = '5:00';
      updateBreathLabel(0);
      startTick();
    }

    function endBreak() {
      if (vignette) vignette.classList.remove('is-visible');
      startFocus();
    }

    function updateBreathLabel(elapsed) {
      if (!breathLabel) return;
      var cycle = 16000;
      var pos = elapsed % cycle;
      var phase;
      if (pos < 4000) phase = 'Inhale…';
      else if (pos < 8000) phase = 'Hold';
      else if (pos < 12000) phase = 'Exhale…';
      else phase = 'Hold';
      breathLabel.textContent = phase;
    }

    function onStartToggle() {
      var state = getTimerState();
      if (!state || state.status === 'idle') {
        startFocus();
      } else {
        if (state.startedAt === 0) {
          resumeTimer();
        } else {
          pauseTimer();
        }
      }
    }

    // Wiring event handlers
    if (startBtn && !startBtn.dataset.bound) {
      startBtn.addEventListener('click', onStartToggle);
      startBtn.dataset.bound = 'true';
    }
    if (modalStartBtn && !modalStartBtn.dataset.bound) {
      modalStartBtn.addEventListener('click', onStartToggle);
      modalStartBtn.dataset.bound = 'true';
    }
    if (resetBtn && !resetBtn.dataset.bound) {
      resetBtn.addEventListener('click', resetTimer);
      resetBtn.dataset.bound = 'true';
    }

    intervalBtns.forEach(function (b) {
      if (!b.dataset.bound) {
        b.addEventListener('click', function () {
          var val = parseInt(b.getAttribute('data-interval'), 10);
          localStorage.setItem(INTERVAL_KEY, String(val));
          renderIntervals();
          var st = getTimerState();
          if (!st || st.status === 'idle') {
            setStatus('Ready to focus', val + ':00', null);
          }
        });
        b.dataset.bound = 'true';
      }
    });

    if (skipBtn && !skipBtn.dataset.bound) {
      skipBtn.addEventListener('click', endBreak);
      skipBtn.dataset.bound = 'true';
    }

    // Dropdown toggle & click outside
    function toggleDropdown(e) {
      if (e) e.stopPropagation();
      if (!dropdown) return;
      var isHidden = dropdown.classList.contains('hidden');
      if (isHidden) {
        dropdown.classList.remove('hidden');
        if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
        if (chevron) chevron.classList.add('rotate-180');
      } else {
        dropdown.classList.add('hidden');
        if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
        if (chevron) chevron.classList.remove('rotate-180');
      }
    }

    if (menuBtn && !menuBtn.dataset.bound) {
      menuBtn.addEventListener('click', toggleDropdown);
      menuBtn.dataset.bound = 'true';
    }

    // Close dropdown on outside click or escape
    if (!window.bitsnotesPomodoroDropdownDocClick) {
      document.addEventListener('click', function (e) {
        if (dropdown && !dropdown.classList.contains('hidden')) {
          if (root && !root.contains(e.target)) {
            dropdown.classList.add('hidden');
            if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
            if (chevron) chevron.classList.remove('rotate-180');
          }
        }
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && dropdown && !dropdown.classList.contains('hidden')) {
          dropdown.classList.add('hidden');
          if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.classList.remove('rotate-180');
        }
      });
      window.bitsnotesPomodoroDropdownDocClick = true;
    }

    function init() {
      renderIntervals();
      var st = getTimerState();
      if (st && st.status !== 'idle') {
        renderStartBtns(st);
        if (st.startedAt > 0) {
          startTick();
        }
        tick();
      } else {
        setStatus('Ready to focus', getIntervalMin() + ':00', null);
        renderStartBtns({ status: 'idle', startedAt: 0 });
      }
    }

    init();
  })();
</script>
