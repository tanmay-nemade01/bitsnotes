---
/**
 * RecentlySaved.astro — Dashboard widget showing 5 most recent bookmarks.
 * Only renders for logged-in users.
 */
import { listRecentBookmarks } from '../lib/bookmarks';
import type { Bookmark } from '../lib/bookmarks';

const user = (Astro.locals as any).user ?? null;
const db = (Astro.locals as any).runtime?.env?.DB;

let bookmarks: Bookmark[] = [];
if (user && db) {
  bookmarks = await listRecentBookmarks(db, user.id, 5);
}
---

{user && bookmarks.length > 0 && (
  <section class="mb-10">
    <h2 class="text-sm font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">
      Recently saved
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {bookmarks.map((bm) => (
        <a
          href={`/view/${encodeURIComponent(bm.subject)}/${encodeURIComponent(bm.lecture)}`}
          class="flex items-center gap-3 p-3 border border-[var(--border)] bg-[var(--bg-elevated)] rounded-[var(--r-sm)] hover:border-[var(--accent)] hover:bg-[var(--bg-subtle)] transition-colors no-underline group"
        >
          <div class="w-7 h-7 rounded-[var(--r-sm)] bg-[var(--accent-subtle)] flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-[var(--text)] group-hover:text-[var(--accent)] transition-colors line-clamp-1">{bm.display_name}</p>
            <p class="text-[10px] text-[var(--text-muted)] truncate">{bm.subject}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
