---
/**
 * RecentlySaved.astro — Dashboard widget showing 5 most recent bookmarks.
 * Only renders for logged-in users.
 */
import { listRecentBookmarks } from '../lib/bookmarks';
import type { Bookmark } from '../lib/bookmarks';
import { getEnv } from '../lib/getEnv';
import { getHiddenSubjectNames, SubjectVisibilityUnavailableError } from '../lib/subjectVisibility';
import { listCatalog } from '../utils/notesLoader';
import { slugify } from '../utils/lectureDisplay';

const user = (Astro.locals as any).user ?? null;
let bookmarks: Bookmark[] = [];

if (user) {
  const env = await getEnv();
  const raw = await listRecentBookmarks(env.DB, user.id, 5);
  const isAdmin = Boolean((Astro.locals as any).isAdmin);
  try {
    const hiddenSubjects = await getHiddenSubjectNames(env.DB);
    bookmarks = (!isAdmin && hiddenSubjects.size > 0)
      ? raw.filter((bm) => !hiddenSubjects.has(bm.subject))
      : raw;
  } catch (err) {
    if (err instanceof SubjectVisibilityUnavailableError) {
      bookmarks = isAdmin ? raw : [];
    } else {
      throw err;
    }
  }
}

// Normalize bookmark titles to match the catalog (lecture-number prefixed).
const catalog = user ? await listCatalog() : [];
const titleLookup = new Map<string, string>();
const slugLookup = new Map<string, string>();
for (const subject of catalog) {
  for (const lec of subject.lectures) {
    titleLookup.set(`${subject.subject}::${lec.folderName}`, lec.displayTitle || lec.name);
    slugLookup.set(`${subject.subject}::${lec.folderName}`, lec.slug);
  }
}
function bookmarkTitle(bm: Bookmark): string {
  return titleLookup.get(`${bm.subject}::${bm.lecture}`) || bm.display_name;
}
---

{user && bookmarks.length > 0 && (
  <section class="mb-10">
    <h2 class="text-sm font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">
      Recently saved
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {bookmarks.map((bm) => (
        <a
          href={`/view/${encodeURIComponent(slugify(bm.subject))}/${encodeURIComponent(slugLookup.get(`${bm.subject}::${bm.lecture}`) || bm.lecture)}`}
          class="flex items-center gap-3 p-3 border border-[var(--border)] bg-[var(--bg-elevated)] rounded-[var(--r-sm)] hover:border-[var(--accent)] hover:bg-[var(--bg-subtle)] transition-colors no-underline group"
        >
          <div class="min-w-0 flex-1">
            <span class="block text-xs font-semibold text-[var(--accent)] truncate">
              {bm.subject}
            </span>
            <span class="block text-sm font-medium text-[var(--text)] truncate group-hover:text-[var(--accent)]">
              {bookmarkTitle(bm)}
            </span>
          </div>
          <svg class="w-4 h-4 text-[var(--text-muted)] group-hover:text-[var(--accent)] shrink-0 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      ))}
    </div>
  </section>
)}
