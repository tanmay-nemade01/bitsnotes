---
// LibraryStats.astro
//
// Phase 3.5 — Real library statistics derived from the catalog manifest.
// Values come from `getLibraryStats()` (no view counters, no animation from
// zero). Rendered server-side so they are correct on first paint.

import { getLibraryStats } from '../utils/notesLoader';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const stats = await getLibraryStats();

const items = [
  { label: 'Subjects', value: stats.subjects },
  { label: 'Lectures', value: stats.lectures },
  { label: 'Authored quiz questions', value: stats.authoredQuizQuestions },
  { label: 'Exam / revision resources', value: stats.examRevisionResources },
];
---

<section class={`library-stats ${className ?? ''}`} aria-label="Library statistics">
  <ul class="library-stats__grid">
    {items.map((it) => (
      <li class="library-stats__item">
        <span class="library-stats__value">{it.value.toLocaleString()}</span>
        <span class="library-stats__label">{it.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .library-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .library-stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .library-stats__item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4) var(--space-4);
    background: var(--bg-elevated);
  }

  .library-stats__value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .library-stats__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.3;
  }
</style>
