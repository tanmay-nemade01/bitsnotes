---
// CookieConsent.astro - GDPR-Compliant Cookie Consent Manager
---

<div id="cookie-consent-banner" class="cookie-banner hidden" role="dialog" aria-modal="false" aria-label="Cookie consent settings">
  <div class="cookie-banner-container">
    <div class="cookie-banner-content">
      <div class="cookie-banner-header">
        <svg class="cookie-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <span class="cookie-banner-title">Cookie Preferences</span>
      </div>
      <p class="cookie-banner-text">
        We use cookies to analyze traffic and customize your learning experience. You can manage your preferences below or read our <a href="/privacy" class="cookie-link">Privacy Policy</a> for more information.
      </p>

      <!-- Customization Section -->
      <div id="cookie-customize-panel" class="cookie-customize-panel hidden">
        <div class="cookie-option-item">
          <div class="cookie-option-info">
            <label class="cookie-option-label">Necessary Cookies</label>
            <span class="cookie-option-desc">Required for basic website functionality. Cannot be disabled.</span>
          </div>
          <input type="checkbox" checked disabled class="cookie-checkbox" />
        </div>

        <div class="cookie-option-item">
          <div class="cookie-option-info">
            <label for="consent-analytics" class="cookie-option-label cursor-pointer">Performance & Analytics</label>
            <span class="cookie-option-desc">Allows us to monitor site usage and page speeds via Google Analytics.</span>
          </div>
          <input type="checkbox" id="consent-analytics" class="cookie-checkbox cursor-pointer" checked />
        </div>

        <div class="cookie-option-item">
          <div class="cookie-option-info">
            <label for="consent-ads" class="cookie-option-label cursor-pointer">Personalised Ads & AdSense</label>
            <span class="cookie-option-desc">Enables Google to recommend relevant educational resources and ads.</span>
          </div>
          <input type="checkbox" id="consent-ads" class="cookie-checkbox cursor-pointer" checked />
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="cookie-banner-actions">
      <div class="cookie-banner-buttons-left">
        <button type="button" id="cookie-btn-customize" class="cookie-btn-secondary">Customize</button>
      </div>
      <div class="cookie-banner-buttons-right">
        <button type="button" id="cookie-btn-decline" class="cookie-btn-secondary">Decline All</button>
        <button type="button" id="cookie-btn-accept" class="cookie-btn-primary">Accept All</button>
        <button type="button" id="cookie-btn-save" class="cookie-btn-primary hidden">Save Preferences</button>
      </div>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 24px;
    right: 24px;
    left: 24px;
    z-index: 99;
    max-width: 460px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-overlay);
    overflow: hidden;
    animation: slideUp 0.3s var(--ease-out) both;
  }

  @media (min-width: 640px) {
    .cookie-banner {
      left: auto;
      right: 24px;
    }
  }

  .cookie-banner-container {
    padding: 20px;
    display: flex;
    flex-col: col;
    flex-direction: column;
    gap: 16px;
  }

  .cookie-banner-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cookie-banner-header {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
  }

  .cookie-icon {
    width: 20px;
    height: 20px;
  }

  .cookie-banner-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
  }

  .cookie-banner-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .cookie-link {
    color: var(--accent);
    text-decoration: underline;
    font-weight: 600;
  }

  .cookie-link:hover {
    color: var(--accent-hover);
  }

  /* Customize Panel */
  .cookie-customize-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px dashed var(--border);
  }

  .cookie-option-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 6px 0;
  }

  .cookie-option-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cookie-option-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text);
  }

  .cookie-option-desc {
    font-size: 0.75rem;
    color: var(--text-faint);
    line-height: 1.4;
  }

  .cookie-checkbox {
    width: 16px;
    height: 16px;
    accent-color: var(--accent);
    margin-top: 2px;
  }

  /* Actions */
  .cookie-banner-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
    margin-top: 4px;
  }

  .cookie-banner-buttons-right {
    display: flex;
    gap: 8px;
  }

  .cookie-btn-primary, .cookie-btn-secondary {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .cookie-btn-primary {
    background-color: var(--accent);
    color: var(--accent-contrast);
    border: 1px solid var(--accent);
  }

  .cookie-btn-primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .cookie-btn-secondary {
    background-color: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border-strong);
  }

  .cookie-btn-secondary:hover {
    background-color: var(--bg-subtle);
    color: var(--text);
  }

  .hidden {
    display: none !important;
  }

  @keyframes slideUp {
    from {
      transform: translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  (function() {
    function initCookieConsent() {
      const banner = document.getElementById('cookie-consent-banner');
      if (!banner) return;

      const btnAccept = document.getElementById('cookie-btn-accept');
      const btnDecline = document.getElementById('cookie-btn-decline');
      const btnCustomize = document.getElementById('cookie-btn-customize');
      const btnSave = document.getElementById('cookie-btn-save');
      const panel = document.getElementById('cookie-customize-panel');

      const checkAnalytics = document.getElementById('consent-analytics');
      const checkAds = document.getElementById('consent-ads');

      // Check if consent has already been given
      let savedConsent = null;
      try {
        savedConsent = JSON.parse(localStorage.getItem('bitsnotes-cookie-consent'));
      } catch (e) {}

      if (savedConsent) {
        banner.classList.add('hidden');
        return;
      }

      // Show banner if no consent
      banner.classList.remove('hidden');

      function saveConsentState(consentObj) {
        localStorage.setItem('bitsnotes-cookie-consent', JSON.stringify(consentObj));
        banner.classList.add('hidden');

        // Update Google Consent Mode if gtag is defined
        if (typeof gtag === 'function') {
          gtag('consent', 'update', {
            'ad_storage': consentObj.ads ? 'granted' : 'denied',
            'ad_user_data': consentObj.ads ? 'granted' : 'denied',
            'ad_personalization': consentObj.ads ? 'granted' : 'denied',
            'analytics_storage': consentObj.analytics ? 'granted' : 'denied'
          });
        }

        // Dispatch a custom event in case other scripts need to react
        window.dispatchEvent(new CustomEvent('bitsnotes:consent-updated', { detail: consentObj }));
      }

      btnAccept.addEventListener('click', function() {
        saveConsentState({ analytics: true, ads: true });
      });

      btnDecline.addEventListener('click', function() {
        saveConsentState({ analytics: false, ads: false });
      });

      btnCustomize.addEventListener('click', function() {
        panel.classList.remove('hidden');
        btnCustomize.classList.add('hidden');
        btnDecline.classList.add('hidden');
        btnAccept.classList.add('hidden');
        btnSave.classList.remove('hidden');
      });

      btnSave.addEventListener('click', function() {
        saveConsentState({
          analytics: checkAnalytics ? checkAnalytics.checked : false,
          ads: checkAds ? checkAds.checked : false
        });
      });
    }

    // Run on init
    initCookieConsent();

    // Support Astro View Transitions
    document.addEventListener('astro:after-swap', initCookieConsent);
  })();
</script>
