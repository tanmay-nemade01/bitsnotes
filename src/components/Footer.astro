---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;

const isDark = theme === 'dark';

// CSS classes based on theme
const footerClass = isDark
  ? 'bg-slate-950 border-t border-slate-900 text-slate-500 py-10 text-center text-xs mt-auto'
  : 'bg-white border-t border-slate-200 text-slate-400 py-10 text-center text-xs mt-auto shadow-inner';

const linkClass = isDark
  ? 'hover:text-slate-300 transition-colors font-medium'
  : 'hover:text-slate-700 transition-colors font-medium';

const dividerClass = isDark ? 'text-slate-800' : 'text-slate-200';
---

<footer class={footerClass}>
  <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
    <!-- Left Side: Copyright -->
    <div>
      <p>© {new Date().getFullYear()} BitsNotes Secure Viewer. All rights reserved.</p>
      <p class="mt-1 text-[10px] opacity-75">Built for classrooms with security, speed, and privacy in mind.</p>
    </div>

    <!-- Right Side: Links -->
    <div class="flex items-center gap-4 flex-wrap justify-center text-xs">
      <a href="/" class={linkClass}>Dashboard</a>
      <span class={dividerClass}>|</span>
      <a href="/about" class={linkClass}>About Project</a>
      <span class={dividerClass}>|</span>
      <a href="/contact" class={linkClass}>Contact Us</a>
      <span class={dividerClass}>|</span>
      <a href="/privacy" class={linkClass}>Privacy Policy</a>
      <span class={dividerClass}>|</span>
      <a href="/terms" class={linkClass}>Terms</a>
    </div>
  </div>
</footer>
