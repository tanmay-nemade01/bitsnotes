---

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] bg-[var(--bg-elevated)] text-[var(--text-muted)] mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <span class="font-display text-lg font-bold text-[var(--text)]">BitsNotes</span>
        <p class="text-xs mt-2 leading-relaxed max-w-[20ch]">
          Lecture notes for postgraduate students.
        </p>
      </div>

      <!-- Browse -->
      <div>
        <h4 class="text-xs font-bold text-[var(--text)] uppercase tracking-widest mb-3">Browse</h4>
        <div class="flex flex-col gap-2">
          <a href="/" class="text-xs hover:text-[var(--accent)] transition-colors">Dashboard</a>
          <a href="/about" class="text-xs hover:text-[var(--accent)] transition-colors">About</a>
        </div>
      </div>

      <!-- Support -->
      <div>
        <h4 class="text-xs font-bold text-[var(--text)] uppercase tracking-widest mb-3">Support</h4>
        <div class="flex flex-col gap-2">
          <a href="/contact" class="text-xs hover:text-[var(--accent)] transition-colors">Contact</a>
          <a href="/privacy" class="text-xs hover:text-[var(--accent)] transition-colors">Privacy</a>
          <a href="/terms" class="text-xs hover:text-[var(--accent)] transition-colors">Terms</a>
        </div>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-xs font-bold text-[var(--text)] uppercase tracking-widest mb-3">Legal</h4>
        <div class="flex flex-col gap-2">
          <a href="/privacy" class="text-xs hover:text-[var(--accent)] transition-colors">Privacy Policy</a>
          <a href="/terms" class="text-xs hover:text-[var(--accent)] transition-colors">Terms of Use</a>
        </div>
      </div>
    </div>

    <div class="border-t border-[var(--border)] mt-8 pt-6 text-xs text-[var(--text-faint)]">
      &copy; {year} BitsNotes. All rights reserved.
    </div>
  </div>
</footer>
