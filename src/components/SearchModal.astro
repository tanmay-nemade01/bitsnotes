---
// SearchModal.astro - Universal Keyword Search Modal Component
---

<div id="search-modal-backdrop" class="search-modal-backdrop hidden" role="dialog" aria-modal="true" aria-label="Search site content">
  <div id="search-modal-container" class="search-modal-container">
    <!-- Header -->
    <div class="search-modal-header">
      <svg class="search-modal-icon" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input type="text" id="search-modal-input" class="search-modal-input" placeholder="Search notes, concepts, topics..." autocomplete="off" spellcheck="false" />
      <button type="button" id="search-modal-clear" class="search-modal-clear hidden" aria-label="Clear search">✕</button>
      <kbd class="search-modal-esc-badge">ESC</kbd>
    </div>
    
    <!-- Results / Body -->
    <div id="search-modal-results" class="search-modal-results">
      <div class="search-modal-empty-state">
        <svg class="w-8 h-8 text-[var(--text-faint)] mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <p class="font-semibold text-[var(--text)]">Search lecture notes</p>
        <p class="text-xs text-[var(--text-faint)] max-w-[280px] mt-0.5">Find topics, formulas, concepts, and quiz questions across all subjects instantly.</p>
      </div>
    </div>
    
    <!-- Footer -->
    <div class="search-modal-footer">
      <div class="search-modal-shortcuts">
        <span><kbd>↑↓</kbd> Navigate</span>
        <span><kbd>↵</kbd> Select</span>
        <span><kbd>ESC</kbd> Close</span>
      </div>
      <div class="search-modal-powered">
        BitsNotes Search
      </div>
    </div>
  </div>
</div>

<style>
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--scrim);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: start;
    justify-content: center;
    padding: var(--space-4);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-out);
  }
  @media (min-width: 640px) {
    .search-modal-backdrop {
      padding: var(--space-12);
    }
  }
  .search-modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .search-modal-container {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    width: 100%;
    max-width: 42rem;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-overlay), var(--shadow-modal);
    display: flex;
    flex-direction: column;
    max-height: 80vh;
    overflow: hidden;
    transform: translateY(-16px) scale(0.97);
    transition: transform var(--duration-normal) var(--ease-out);
  }
  .search-modal-backdrop.open .search-modal-container {
    transform: translateY(0) scale(1);
  }

  .search-modal-header {
    position: relative;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding: 0 var(--space-4);
  }

  .search-modal-icon {
    position: absolute;
    left: var(--space-4);
    width: var(--space-4);
    height: var(--space-4);
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-modal-input {
    width: 100%;
    background: transparent;
    border: 0;
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--text-base);
    padding: var(--space-4) var(--space-8) var(--space-4) 2.5rem;
  }
  .search-modal-input::placeholder {
    color: var(--text-muted);
  }
  .search-modal-input:focus {
    outline: none;
    box-shadow: none;
  }

  .search-modal-clear {
    position: absolute;
    right: 3.5rem;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--r-sm);
    font-size: 11px;
  }
  .search-modal-clear:hover {
    color: var(--text);
    background-color: var(--bg-subtle);
  }

  .search-modal-esc-badge {
    position: absolute;
    right: var(--space-4);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 2px 5px;
    border-radius: 4px;
    pointer-events: none;
  }

  .search-modal-results {
    flex-grow: 1;
    overflow-y: auto;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    scrollbar-width: thin;
    min-height: 120px;
  }

  .search-modal-empty-state, :global(.search-modal-loading-state), :global(.search-modal-no-results) {
    padding: var(--space-12) var(--space-4);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  :global(.search-modal-result-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    text-decoration: none;
    background-color: transparent;
    transition: all var(--duration-fast) var(--ease-out);
  }
  :global(.search-modal-result-item:hover), :global(.search-modal-result-item.active) {
    background-color: var(--bg-subtle);
    border-color: var(--border-strong);
  }
  :global(.search-modal-result-item.active) {
    background-color: var(--accent-subtle);
    border-color: var(--accent);
  }

  :global(.search-result-left) {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.search-result-subject) {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }
  :global(.search-modal-result-item:hover .search-result-subject), 
  :global(.search-modal-result-item.active .search-result-subject) {
    color: var(--accent);
  }

  :global(.search-result-title) {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  :global(.search-modal-result-item:hover .search-result-title), 
  :global(.search-modal-result-item.active .search-result-title) {
    color: var(--accent);
  }

  :global(.search-result-snippet) {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-result-right) {
    display: flex;
    align-items: center;
    color: var(--text-muted);
    transition: all var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }
  :global(.search-modal-result-item:hover .search-result-right), 
  :global(.search-modal-result-item.active .search-result-right) {
    color: var(--accent);
    transform: translateX(3px);
  }

  .search-modal-footer {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--border);
    background-color: var(--bg-subtle);
    font-size: 10px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .search-modal-shortcuts {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .search-modal-shortcuts span {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .search-modal-shortcuts kbd {
    font-size: 9px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: 1px 4px;
    border-radius: 3px;
    font-weight: 600;
  }

  .search-modal-powered {
    font-weight: 500;
  }

  /* Scrollbar styling for modal */
  .search-modal-results::-webkit-scrollbar {
    width: 6px;
  }
  .search-modal-results::-webkit-scrollbar-track {
    background: transparent;
  }
  .search-modal-results::-webkit-scrollbar-thumb {
    background-color: var(--border-strong);
    border-radius: 3px;
  }
  .search-modal-results::-webkit-scrollbar-thumb:hover {
    background-color: var(--text-faint);
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { slugify } from '../utils/lectureDisplay';

  let searchIndex: any = null;
  let isFetchingIndex = false;
  let activeIndex = -1;
  let resultsList: any[] = [];
  
  async function fetchSearchIndex() {
    if (searchIndex || isFetchingIndex) return;
    isFetchingIndex = true;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        searchIndex = await res.json();
      }
    } catch (e) {
      console.error('Failed to load search index:', e);
    } finally {
      isFetchingIndex = false;
    }
  }

  function initSearch() {
    const backdrop = document.getElementById('search-modal-backdrop');
    const input = document.getElementById('search-modal-input') as HTMLInputElement;
    const clearBtn = document.getElementById('search-modal-clear');
    const resultsContainer = document.getElementById('search-modal-results');
    let lastActiveElement: HTMLElement | null = null;

    if (!backdrop || !input || !resultsContainer) return;

    function openModal() {
      lastActiveElement = document.activeElement as HTMLElement;
      backdrop!.classList.remove('hidden');
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          backdrop!.classList.add('open');
        });
      });
      input!.value = '';
      if (clearBtn) clearBtn.classList.add('hidden');
      input!.focus();
      document.body.classList.add('overflow-hidden');
      resultsList = [];
      activeIndex = -1;
      renderDefaultState();
      fetchSearchIndex();
    }

    function closeModal() {
      backdrop!.classList.remove('open');
      document.body.classList.remove('overflow-hidden');
      setTimeout(() => {
        if (!backdrop!.classList.contains('open')) {
          backdrop!.classList.add('hidden');
        }
      }, 180);
      if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      }
    }

    function renderDefaultState() {
      resultsContainer!.innerHTML = `
        <div class="search-modal-empty-state">
          <svg class="w-8 h-8 text-[var(--text-muted)] mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <p class="font-semibold text-[var(--text)]">Search lecture notes</p>
          <p class="text-xs text-[var(--text-muted)] max-w-[280px] mt-0.5">Find topics, formulas, concepts, and quiz questions across all subjects instantly.</p>
        </div>
      `;
    }

    function renderLoadingState() {
      resultsContainer!.innerHTML = `
        <div class="search-modal-loading-state">
          <svg class="animate-spin h-5 w-5 text-[var(--accent)] mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-xs text-[var(--text-muted)]">Initializing search index...</p>
        </div>
      `;
    }

    function renderNoResults(query: string) {
      resultsContainer!.innerHTML = `
        <div class="search-modal-no-results">
          <svg class="w-8 h-8 text-[var(--text-muted)] mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <p class="font-bold text-[var(--text)]">No results found for "${query}"</p>
          <p class="text-xs text-[var(--text-muted)] max-w-[280px] mt-0.5">Try searching for other keywords, subjects, or concepts (e.g. "RAG", "Saga", "Markov", "Regression").</p>
        </div>
      `;
    }

    function countOccurrences(text: string, term: string, maxCount = 10): number {
      if (!term || term.length === 0) return 0;
      let count = 0;
      let pos = 0;
      const step = Math.max(1, term.length);
      while (count < maxCount) {
        pos = text.indexOf(term, pos);
        if (pos === -1) break;
        count++;
        pos += step;
      }
      return count;
    }

    function getSearchSnippet(text: string, query: string, maxLen = 160) {
      if (!query || !text) return (text || '').slice(0, maxLen) + ((text || '').length > maxLen ? '...' : '');
      const rawQuery = query.trim().toLowerCase();
      const terms = rawQuery.split(/\s+/).filter(Boolean);
      if (terms.length === 0) return text.slice(0, maxLen) + (text.length > maxLen ? '...' : '');

      let firstIndex = -1;
      let matchedLength = 0;
      const lowerText = text.toLowerCase();

      // First try to locate the exact full query phrase in text
      if (rawQuery.length >= 2) {
        const phraseIdx = lowerText.indexOf(rawQuery);
        if (phraseIdx !== -1) {
          firstIndex = phraseIdx;
          matchedLength = rawQuery.length;
        }
      }

      // Fallback: locate the first occurrence of any term
      if (firstIndex === -1) {
        for (const term of terms) {
          const idx = lowerText.indexOf(term);
          if (idx !== -1 && (firstIndex === -1 || idx < firstIndex)) {
            firstIndex = idx;
            matchedLength = term.length;
          }
        }
      }

      if (firstIndex === -1) {
        return text.slice(0, maxLen) + (text.length > maxLen ? '...' : '');
      }

      const start = Math.max(0, firstIndex - 60);
      const end = Math.min(text.length, firstIndex + matchedLength + 100);
      let snippet = text.slice(start, end);

      if (start > 0) snippet = '...' + snippet;
      if (end < text.length) snippet = snippet + '...';

      let escaped = snippet
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Only highlight terms of length >= 2 to avoid cluttering with every single letter
      const sortedTerms = [...terms].filter(t => t.length >= 2).sort((a, b) => b.length - a.length);
      for (const term of sortedTerms) {
        const escapedTerm = term.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
        const regex = new RegExp(`(${escapedTerm})`, 'gi');
        escaped = escaped.replace(regex, '<mark class="bg-[var(--accent-subtle)] text-[var(--accent)] font-semibold px-0.5 rounded-[2px]">$1</mark>');
      }

      return escaped;
    }

    function getSearchTitle(title: string, query: string) {
      const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
      let escaped = title
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
      if (terms.length === 0) return escaped;

      // Only highlight terms of length >= 2
      const sortedTerms = [...terms].filter(t => t.length >= 2).sort((a, b) => b.length - a.length);
      for (const term of sortedTerms) {
        const escapedTerm = term.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
        const regex = new RegExp(`(${escapedTerm})`, 'gi');
        escaped = escaped.replace(regex, '<mark class="bg-[var(--accent-subtle)] text-[var(--accent)] font-semibold px-0.5 rounded-[2px]">$1</mark>');
      }
      return escaped;
    }

    function performSearch(query: string) {
      if (!searchIndex) {
        renderLoadingState();
        fetchSearchIndex().then(() => {
          if (input!.value === query) {
            performSearch(query);
          }
        });
        return;
      }

      const rawQuery = query.trim();
      const queryLower = rawQuery.toLowerCase();
      const terms = queryLower.split(/\s+/).filter(Boolean);

      if (terms.length === 0) {
        resultsList = [];
        activeIndex = -1;
        renderDefaultState();
        return;
      }

      const isShortQuery = queryLower.length < 2;
      const matches = [];

      for (const item of searchIndex) {
        const titleLower = (item.title || '').toLowerCase();
        const subjectLower = (item.subject || '').toLowerCase();
        const topicTitleLower = (item.topicTitle || '').toLowerCase();
        const textLower = isShortQuery ? '' : (item.text || item.snippet || '').toLowerCase();

        let score = 0;
        let termMatchesCount = 0;

        // Exact contiguous query match
        if (queryLower.length >= 2) {
          if (titleLower.includes(queryLower)) score += 1000;
          if (topicTitleLower.includes(queryLower)) score += 800;
          if (subjectLower.includes(queryLower)) score += 300;

          if (textLower.includes(queryLower)) {
            const exactCount = countOccurrences(textLower, queryLower, 10);
            score += 500 + exactCount * 50;
          }
        }

        // Score individual terms
        for (const term of terms) {
          let termMatched = false;

          const inTitleIdx = titleLower.indexOf(term);
          if (inTitleIdx !== -1) {
            termMatched = true;
            score += (inTitleIdx === 0 ? 200 : 100);
          }

          const inTopicIdx = topicTitleLower.indexOf(term);
          if (inTopicIdx !== -1) {
            termMatched = true;
            score += (inTopicIdx === 0 ? 150 : 80);
          }

          const inSubjectIdx = subjectLower.indexOf(term);
          if (inSubjectIdx !== -1) {
            termMatched = true;
            score += (inSubjectIdx === 0 ? 50 : 25);
          }

          if (!isShortQuery) {
            const inTextIdx = textLower.indexOf(term);
            if (inTextIdx !== -1) {
              termMatched = true;
              const count = countOccurrences(textLower, term, 10);
              score += 15 + count * 5;
            }
          }

          if (termMatched) {
            termMatchesCount++;
          }
        }

        if (termMatchesCount > 0) {
          if (termMatchesCount === terms.length) {
            score += 200;
          } else {
            score = score * (termMatchesCount / terms.length);
          }
          matches.push({ item, score });
        }
      }

      // Cap displayed results to top 20 for instant rendering and light DOM footprint
      resultsList = matches.sort((a, b) => b.score - a.score).slice(0, 20).map(r => r.item);
      activeIndex = -1;

      if (resultsList.length === 0) {
        renderNoResults(query);
      } else {
        renderResults(query);
      }
    }

    function renderResults(query: string) {
      resultsContainer!.innerHTML = resultsList.map((item, idx) => {
        const isBlog = item.type === 'blog';
        const isBit = item.type === 'bit';
        const url = isBlog
          ? `/blog/${encodeURIComponent(item.slug)}`
          : isBit
            ? `/bits/${encodeURIComponent(item.slug)}`
            : `/view/${encodeURIComponent(slugify(item.subject))}/${encodeURIComponent(item.slug || item.folderName)}`;
        const highlightedTitle = getSearchTitle(item.title, query);
        const snippet = getSearchSnippet(item.text || item.snippet || '', query);
        const badgeText = isBlog ? 'BLOG' : isBit ? 'BITS' : item.subject;
        
        return `
          <a href="${url}" class="search-modal-result-item" data-astro-prefetch data-search-index="${idx}">
            <div class="search-result-left">
              <span class="search-result-subject">${badgeText}</span>
              <span class="search-result-title">${highlightedTitle}</span>
              <p class="search-result-snippet">${snippet}</p>
            </div>
            <div class="search-result-right">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        `;
      }).join('');
    }

    function updateActiveItem() {
      const items = resultsContainer!.querySelectorAll('.search-modal-result-item');
      items.forEach((item, idx) => {
        if (idx === activeIndex) {
          item.classList.add('active');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('active');
        }
      });
    }

    let debounceTimer: any = null;
    input!.addEventListener('input', function() {
      const q = this.value.trim();
      if (clearBtn) {
        if (q.length > 0) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
      }
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(q);
      }, 100);
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        input!.value = '';
        clearBtn!.classList.add('hidden');
        input!.focus();
        performSearch('');
      });
    }

    // Handle results list click programmatically to avoid layout/propagation conflicts
    resultsContainer.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const link = target.closest('.search-modal-result-item') as HTMLAnchorElement;
      if (link) {
        e.preventDefault();
        const url = link.getAttribute('href');
        if (url) {
          closeModal();
          navigate(url);
        }
      }
    });

    // Modal click triggers (delegated to document so it survives Astro page-swapping)
    const handleDocumentClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      
      if (target.closest('#nav-search-btn') || target.closest('#homepage-search-trigger')) {
        e.preventDefault();
        openModal();
      }
      
      if (backdrop!.classList.contains('open') && target === backdrop) {
        closeModal();
      }
    };

    const handlePointerOver = (e: PointerEvent) => {
      const target = e.target as HTMLElement;
      if (target.closest('#nav-search-btn') || target.closest('#homepage-search-trigger')) {
        fetchSearchIndex();
      }
    };

    const handleFocusIn = (e: FocusEvent) => {
      const target = e.target as HTMLElement;
      if (target.closest('#nav-search-btn') || target.closest('#homepage-search-trigger')) {
        fetchSearchIndex();
      }
    };

    const handleKeyDown = (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (backdrop!.classList.contains('open')) {
          closeModal();
        } else {
          openModal();
        }
      }

      if (e.key === 'Escape' && backdrop!.classList.contains('open')) {
        e.preventDefault();
        closeModal();
      }

      if (backdrop!.classList.contains('open') && resultsList.length > 0) {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIndex = (activeIndex + 1) % resultsList.length;
          updateActiveItem();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIndex = (activeIndex - 1 + resultsList.length) % resultsList.length;
          updateActiveItem();
        } else if (e.key === 'Enter') {
          if (activeIndex !== -1) {
            e.preventDefault();
            const activeItem = resultsContainer!.querySelector(`.search-modal-result-item[data-search-index="${activeIndex}"]`) as HTMLAnchorElement;
            if (activeItem) {
              const url = activeItem.getAttribute('href');
              if (url) {
                closeModal();
                navigate(url);
              }
            }
          }
        }
      }
    };

    document.addEventListener('click', handleDocumentClick);
    document.addEventListener('pointerover', handlePointerOver, { passive: true });
    document.addEventListener('focusin', handleFocusIn, { passive: true });
    document.addEventListener('keydown', handleKeyDown);

    // Clean up event listeners on page swap to prevent leaks
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('click', handleDocumentClick);
      document.removeEventListener('pointerover', handlePointerOver);
      document.removeEventListener('focusin', handleFocusIn);
      document.removeEventListener('keydown', handleKeyDown);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initSearch);
</script>
