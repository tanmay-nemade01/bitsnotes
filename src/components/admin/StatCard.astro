---
/**
 * StatCard — compact metric tile used on the Overview and Analytics pages.
 * The value is populated client-side via the element `id`.
 */
interface Props {
  id: string;
  label: string;
  hint?: string;
  tone?: 'default' | 'accent' | 'warning' | 'danger';
}

const { id, label, hint, tone = 'default' } = Astro.props;

const toneClass = {
  default: 'text-[var(--text)]',
  accent: 'text-[var(--accent)]',
  warning: 'text-[var(--warning)]',
  danger: 'text-[var(--danger)]',
}[tone];
---

<div class="border border-[var(--border)] rounded-[var(--r-md)] p-5 bg-[var(--bg-elevated)] shadow-sm hover:shadow-md transition-shadow">
  <h3 class="text-[11px] font-semibold text-[var(--text-muted)] uppercase tracking-wider">{label}</h3>
  <p id={id} class={`mt-2 text-3xl font-bold font-display tabular-nums ${toneClass}`}>—</p>
  {hint && <p class="mt-1 text-[11px] text-[var(--text-faint)]">{hint}</p>}
</div>
