---
/**
 * AdminSidebar — persistent left navigation for the admin shell.
 *
 * Groups features so the list scales as new admin capabilities are added.
 * "Coming soon" items are rendered as disabled buttons (never links) so they
 * can't be navigated to before they exist.
 */
const path = Astro.url.pathname;

const icons = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5"/>',
  tag: '<path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L3 13V3h10l7.59 7.59a2 2 0 0 1 0 2.82z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.5 1-1a5.5 5.5 0 0 0 0-7.8z"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  spark: '<path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5 10.1 11.9 4.5 10l5.6-1.4z"/>',
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 14l3-3 3 3 5-6"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  mail: '<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="m22 6-10 7L2 6"/>',
  cog: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
} as const;

type IconName = keyof typeof icons;

interface NavItem {
  href?: string;
  label: string;
  icon: IconName;
  soon?: boolean;
  /** Match this path exactly (used for the Overview root link). */
  exact?: boolean;
}

interface NavGroup {
  label?: string;
  items: NavItem[];
}

const groups: NavGroup[] = [
  {
    items: [{ href: '/backstage', label: 'Overview', icon: 'home', exact: true }],
  },
  {
    label: 'Content',
    items: [
      { href: '/backstage/tags', label: 'Subjects & Tags', icon: 'tag' },
      { label: 'Lecture Notes', icon: 'book', soon: true },
      { label: 'Blog Posts', icon: 'pen', soon: true },
      { label: 'Bits', icon: 'spark', soon: true },
    ],
  },
  {
    label: 'Community',
    items: [
      { href: '/backstage/comments', label: 'Comments', icon: 'chat' },
      { href: '/backstage/supporters', label: 'Supporters', icon: 'heart' },
    ],
  },
  {
    label: 'Insights',
    items: [
      { href: '/backstage/analytics', label: 'Analytics', icon: 'chart' },
      { label: 'Audit Log', icon: 'shield', soon: true },
    ],
  },
  {
    label: 'Audience',
    items: [
      { label: 'Users', icon: 'users', soon: true },
      { label: 'Newsletter', icon: 'mail', soon: true },
    ],
  },
  {
    label: 'System',
    items: [{ label: 'Settings', icon: 'cog', soon: true }],
  },
];

function isActive(item: NavItem): boolean {
  if (!item.href) return false;
  if (item.exact) return path === item.href || path === item.href + '/';
  return path === item.href || path.startsWith(item.href + '/');
}
---

<nav class="flex flex-col gap-5 text-sm" aria-label="Admin sections">
  {groups.map((group) => (
    <div class="space-y-1">
      {group.label && (
        <p class="px-3 text-[10px] font-bold uppercase tracking-wider text-[var(--text-faint)]">{group.label}</p>
      )}
      {group.items.map((item) =>
        item.soon ? (
          <button
            type="button"
            disabled
            aria-disabled="true"
            title="Coming soon"
            class="w-full flex items-center gap-2.5 px-3 py-2 rounded-[var(--r-sm)] text-left text-[var(--text-faint)] cursor-not-allowed"
          >
            <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[item.icon]} />
            <span class="flex-1 truncate">{item.label}</span>
            <span class="shrink-0 rounded-full border border-[var(--border)] bg-[var(--bg-subtle)] px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide">Soon</span>
          </button>
        ) : (
          <a
            href={item.href}
            aria-current={isActive(item) ? 'page' : undefined}
            class:list={[
              'flex items-center gap-2.5 px-3 py-2 rounded-[var(--r-sm)] transition-colors no-underline',
              isActive(item)
                ? 'bg-[var(--accent-subtle)] text-[var(--accent)] font-semibold'
                : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]',
            ]}
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[item.icon]} />
            <span class="flex-1 truncate">{item.label}</span>
          </a>
        ),
      )}
    </div>
  ))}
</nav>
