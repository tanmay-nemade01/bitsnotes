---
import { BIT_REACTION_EMOJIS } from '../../lib/bitReactions';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="bit-reactions" data-bit-reactions data-bit-slug={slug}>
  {BIT_REACTION_EMOJIS.map((emoji) => (
    <button
      type="button"
      class="bit-reaction-chip"
      data-emoji={emoji}
      aria-pressed="false"
      aria-label={`React with ${emoji}`}
    >
      <span aria-hidden="true">{emoji}</span>
      <span class="bit-reaction-count" hidden></span>
    </button>
  ))}
</div>
