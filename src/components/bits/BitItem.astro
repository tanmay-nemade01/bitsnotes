---
import type { Bit } from '../../utils/bitsLoader';
import { bitImageSrc } from '../../utils/bitsLoader';
import BitReactions from './BitReactions.astro';

interface Props {
  bit: Bit;
  permalink?: boolean;
}

const { bit, permalink = false } = Astro.props;
const fm = bit.frontmatter;
const href = `/bits/${bit.slug}`;
const displayDate = fm.publishedAt
  ? new Date(fm.publishedAt).toLocaleString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
    })
  : '';

const linkUrl = fm.link?.url ?? '';
const isExternal = /^https?:\/\//i.test(linkUrl) && !/bitsnotes\.com/i.test(linkUrl);
---

<article class="bit-item" id={bit.slug}>
  <div class="bit-item__meta">
    {permalink ? (
      <time class="bit-item__time" datetime={fm.publishedAt}>{displayDate}</time>
    ) : (
      <a class="bit-item__time" href={href}>
        <time datetime={fm.publishedAt}>{displayDate}</time>
      </a>
    )}
  </div>

  {fm.title && <h2 class="bit-item__title">{fm.title}</h2>}

  {fm.text && <p class="bit-item__text">{fm.text}</p>}

  {bit.html && <div class="bit-item__html" set:html={bit.html} />}

  {bit.svgMarkup ? (
    <div
      class="bit-item__svg"
      role="img"
      aria-label={fm.imageAlt || ''}
      set:html={bit.svgMarkup}
    />
  ) : fm.image ? (
    <img
      class="bit-item__image"
      src={bit.imageUrl || bitImageSrc(bit.slug, fm.image)}
      alt={fm.imageAlt || ''}
    />
  ) : null}

  {fm.link && (
    <a
      class="bit-link-card"
      href={fm.link.url}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      target={isExternal ? '_blank' : undefined}
    >
      {fm.link.source && <span class="bit-link-card__source">{fm.link.source}</span>}
      <span class="bit-link-card__title">{fm.link.title}</span>
    </a>
  )}

  <BitReactions slug={bit.slug} />
</article>
