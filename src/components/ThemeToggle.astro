---
// ThemeToggle.astro — Light / Dark / System switcher
// Dispatches `bitsnotes:theme-changed` so other components (Turnstile, etc.)
// can re-render. No page reload; persists in localStorage.
const options = [
  { value: 'light', label: 'Light', icon: 'M12 3v2m0 14v2m9-9h2M3 12h2m13.364-6.364l1.414 1.414M5.222 18.778l1.414 1.414M18.778 18.778l-1.414 1.414M5.222 5.222l-1.414 1.414M12 8a4 4 0 100 8 4 4 0 000-8z' },
  { value: 'dark', label: 'Dark', icon: 'M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z' },
  { value: 'system', label: 'System', icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v9a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm6 13h4m-2 3v-3' },
];
---

<div class="theme-toggle" role="group" aria-label="Color theme">
  {options.map((o) => (
    <button
      type="button"
      class="theme-toggle__btn"
      data-theme-value={o.value}
      aria-label={`${o.label} theme`}
      aria-pressed="false"
      title={`${o.label} theme`}
    >
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
        <path d={o.icon} />
      </svg>
    </button>
  ))}
</div>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
  }
  .theme-toggle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: none;
    border-radius: calc(var(--r-md) - 2px);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .theme-toggle__btn:hover {
    color: var(--text);
    background: var(--bg-elevated);
  }
  .theme-toggle__btn[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .theme-toggle__btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }
</style>

<script>
  const STORAGE_KEY = 'bitsnotes-theme';

  function currentPref() {
    try { return localStorage.getItem(STORAGE_KEY) || 'system'; } catch (e) { return 'system'; }
  }

  function sync() {
    const pref = currentPref();
    document.querySelectorAll('.theme-toggle').forEach((group) => {
      group.querySelectorAll('.theme-toggle__btn').forEach((btn) => {
        if (btn instanceof HTMLElement) {
          btn.setAttribute('aria-pressed', String(btn.dataset.themeValue === pref));
        }
      });
    });
  }

  function apply(pref: string) {
    try { localStorage.setItem(STORAGE_KEY, pref); } catch (e) {}
    const resolved = pref === 'system'
      ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      : pref;
    const root = document.documentElement;
    root.dataset.theme = resolved;
    root.style.colorScheme = resolved;
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', resolved === 'dark' ? '#16140F' : '#FAF9F6');
    sync();
    window.dispatchEvent(new CustomEvent('bitsnotes:theme-changed', { detail: { theme: pref, resolved: resolved } }));
  }

  // Use event delegation on document so it works for all toggles, including those added dynamically
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.theme-toggle__btn');
    if (btn instanceof HTMLElement) {
      apply(btn.dataset.themeValue || 'system');
    }
  });

  // Run on initial load and every subsequent page swap / load from ClientRouter
  document.addEventListener('astro:page-load', sync);
  window.addEventListener('bitsnotes:theme-changed', sync);
</script>
