---
/**
 * CollectionPicker.astro — Dropdown popover for choosing a bookmark collection.
 * Rendered server-side, activated client-side.
 */
---

<div class="collection-picker-popover hidden fixed bg-[var(--bg-elevated)] border border-[var(--border)] rounded-[var(--r-md)] shadow-lg py-1 z-[60] min-w-[160px]">
  <div class="px-3 py-1.5 text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider">Save to</div>
  <div id="collection-picker-items" class="max-h-48 overflow-y-auto">
    <!-- Populated by JS -->
  </div>
  <div class="border-t border-[var(--border)] mt-1 pt-1">
    <button type="button" id="collection-picker-new" class="w-full text-left px-3 py-1.5 text-xs text-[var(--accent)] hover:bg-[var(--bg-subtle)] transition-colors">
      + New collection
    </button>
  </div>
</div>
