---
import type { BlogPost } from '../../utils/blogLoader';

interface Props {
  currentSlug: string;
  tags: string[];
  allPosts: BlogPost[];
}

const { currentSlug, tags, allPosts } = Astro.props;

const otherPosts = allPosts.filter((p) => p.slug !== currentSlug);

const related = otherPosts
  .sort((a, b) => {
    const aOverlap = a.frontmatter.tags?.filter((t) => tags.includes(t)).length ?? 0;
    const bOverlap = b.frontmatter.tags?.filter((t) => tags.includes(t)).length ?? 0;
    return bOverlap - aOverlap;
  })
  .slice(0, 3);

import BlogPostCard from './BlogPostCard.astro';
---

{related.length > 0 && (
  <div class="blog-related">
    <h2>Related Posts</h2>
    <div class="blog-related__grid">
      {related.map((p) => <BlogPostCard post={p} compact />)}
    </div>
  </div>
)}
