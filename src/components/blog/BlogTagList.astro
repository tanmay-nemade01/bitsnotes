---
interface Props {
  tags: string[];
  activeTag?: string;
}

const { tags, activeTag } = Astro.props;
---

<div class="blog-tag-list">
  <span class="blog-tag-list__heading">Tags:</span>
  {tags.map((tag: string) => (
    <a
      href={`/blog/tag/${tag}`}
      class={`blog-tag${activeTag === tag ? ' blog-tag--active' : ''}`}
    >
      {tag}
    </a>
  ))}
</div>
