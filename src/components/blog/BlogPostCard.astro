---
import type { BlogPost } from '../../utils/blogLoader';

interface Props {
  post: BlogPost;
  featured?: boolean;
  compact?: boolean;
}

const { post, featured = false, compact = false } = Astro.props;
const { frontmatter } = post;

const displayDate = new Date(frontmatter.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={`/blog/${post.slug}`}
  class={`blog-card${featured ? ' blog-card--featured' : ''}`}
>
  {featured && <span class="blog-featured-badge">Featured</span>}

  <h3 class="blog-card__title">{frontmatter.title}</h3>

  {!compact && (
    <p class="blog-card__description">{frontmatter.description}</p>
  )}

  <div class="blog-card__meta">
    <time datetime={frontmatter.publishedAt}>{displayDate}</time>
  </div>
</a>
