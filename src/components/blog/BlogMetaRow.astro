---
interface Props {
  publishedAt: string;
  readingTime?: number;
  updatedAt?: string;
  tags?: string[];
}

const { publishedAt, readingTime, updatedAt, tags } = Astro.props;

const displayDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class="blog-meta">
  <time datetime={publishedAt}>{displayDate}</time>

  {readingTime && (
    <>
      <span class="blog-meta__dot">·</span>
      <span>{readingTime} min read</span>
    </>
  )}

  {updatedAt && updatedAt !== publishedAt && (
    <>
      <span class="blog-meta__dot">·</span>
      <span>Updated {new Date(updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
    </>
  )}

  {tags && tags.length > 0 && (
    <>
      <span class="blog-meta__dot">·</span>
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag: string) => (
          <a href={`/blog/tag/${tag}`} class="blog-tag">{tag}</a>
        ))}
      </div>
    </>
  )}
</div>
