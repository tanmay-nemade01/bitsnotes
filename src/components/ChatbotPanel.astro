---
import '../styles/chatbot.css';
---

<!-- Floating Action Group Container -->
<div id="bn-floating-actions-container">
  <!-- Collapsible Secondary Quick Actions Menu -->
  <div id="bn-quick-actions-group" class="quick-actions-group">
    <div id="bn-quick-actions-menu" class="quick-actions-menu">
      <button type="button" id="bn-quick-top-btn" class="quick-action-item" title="Go to top">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
        <span>Go to top</span>
      </button>
      <button type="button" id="bn-quick-comments-btn" class="quick-action-item" title="Comments">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
        </svg>
        <span>Comments</span>
      </button>
    </div>
    <button type="button" id="bn-quick-actions-toggle" class="quick-actions-toggle" aria-label="Quick Actions" title="Quick Actions">
      <svg class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
      </svg>
    </button>
  </div>

  <!-- Primary Action: Chatbot FAB (Always Visible & Prominent) -->
  <button id="bn-chatbot-fab" aria-label="Ask AI Doubts" title="Ask AI Doubts">
    <span class="fab-icon-wrapper">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M7.5 19.5L3 21l1.5-4.5A9 9 0 1 1 21 12c0 4.97-4.03 9-9 9a8.95 8.95 0 0 1-4.5-1.2z"/>
        <path d="M12 7.5l.8 1.6 1.6.8-1.6.8-.8 1.6-.8-1.6-1.6-.8 1.6-.8z"/>
        <path d="M16.5 13.5l.4.8.8.4-.8.4-.4.8-.4-.8-.8-.4.8-.4z"/>
      </svg>
    </span>
    <span class="fab-text">Ask AI Doubts</span>
  </button>
</div>

<!-- Chatbot Drawer Panel -->
<div id="bn-chatbot-panel" role="region" aria-label="AI Study Assistant">
  
  <!-- ================= VIEW 1: MAIN CHAT CONVERSATION VIEW ================= -->
  <div id="bn-chat-view-main" class="bn-chat-view active">
    <!-- Header -->
    <div class="bn-chat-header">
      <div class="bn-chat-header-info">
        <div class="bn-chat-icon">🤖</div>
        <div class="bn-chat-title-group">
          <h3>BitsNotes AI Assistant</h3>
          <span id="bn-chat-subject-label">Subject Notes Assistant</span>
        </div>
        <span id="bn-chat-usage-badge" class="bn-chat-usage-badge hidden" title="Messages remaining today"></span>
      </div>
      <div class="bn-chat-header-actions">
        <button type="button" id="bn-chat-clear-btn" class="bn-chat-btn-icon" title="Clear conversation and start fresh" aria-label="Clear conversation">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </button>
        <button type="button" id="bn-chat-config-btn" class="bn-chat-btn-icon" title="Chatbot Account & Usage" aria-label="Account and usage info">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </button>
        <button type="button" id="bn-chat-close-btn" class="bn-chat-btn-icon" title="Close Panel">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages List -->
    <div id="bn-chatbot-messages" class="bn-chat-messages">
      <!-- Messages injected by JS -->
    </div>

    <!-- Textbook companion toggle -->
    <div class="bn-textbook-toggle-row">
      <label class="bn-textbook-toggle" title="Pull a short excerpt from the subject textbook when it adds depth beyond the lecture notes">
        <input type="checkbox" id="bn-textbook-toggle" checked />
        <span>📖 Include textbook</span>
      </label>
    </div>

    <!-- Input Area -->
    <form id="bn-chatbot-form" class="bn-chat-input-area">
      <textarea
        id="bn-chatbot-input"
        class="bn-chat-input"
        placeholder="Ask about this lecture..."
        rows="1"
      ></textarea>
      <button type="submit" id="bn-chatbot-send" class="bn-chat-send-btn" title="Send message">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3 21l18-9L3 3l3 9zm0 0h75"></path>
        </svg>
      </button>
    </form>
  </div>

  <!-- ================= VIEW 2: IN-DRAWER SETTINGS & CONFIG VIEW ================= -->
  <div id="bn-chat-view-settings" class="bn-chat-view">
    <!-- Header with Back Navigation -->
    <div class="bn-chat-header">
      <div class="flex items-center gap-2">
        <button type="button" id="bn-chat-back-btn" class="bn-chat-btn-icon" title="Back to Chat">
          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <div class="bn-chat-title-group">
          <h3>BitsNotes AI Account</h3>
          <span>Usage and access status</span>
        </div>
      </div>
      <button type="button" id="bn-chat-close-btn-settings" class="bn-chat-btn-icon" title="Close Panel">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- ─── BitsNotes Account Panel ─── -->
    <div id="bn-mode-bitsnotes" class="flex-1 flex flex-col overflow-hidden">
      <div class="bn-chat-settings-body flex-1 overflow-y-auto p-4 flex flex-col gap-4" style="scrollbar-width:thin">

        <!-- Logged-in state -->
        <div id="bn-bitsnotes-logged-in" class="hidden">
          <div class="bn-bitsnotes-status-card">
            <div class="bn-bitsnotes-status-icon">✅</div>
            <div class="bn-bitsnotes-status-content">
              <span class="bn-bitsnotes-status-title">Ready to Chat</span>
              <p class="bn-bitsnotes-status-desc">Signed in as <strong id="bn-bitsnotes-username"></strong></p>
            </div>
          </div>

          <div class="bn-usage-counter">
            <div class="bn-usage-bar-container">
              <div id="bn-usage-bar" class="bn-usage-bar" style="width: 0%"></div>
            </div>
            <div class="bn-usage-text">
              <span><strong id="bn-usage-remaining">20</strong> messages remaining today</span>
              <span id="bn-usage-detail" class="bn-usage-detail">0 / 20 used</span>
            </div>
          </div>

          <div class="bn-info-card">
            <div class="bn-info-card-icon">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="bn-info-card-content">
              <span class="bn-info-card-title">Free AI Study Assistant</span>
              <p class="bn-info-card-desc">Powered by BitsNotes — 20 messages per day. Ask questions about your lecture notes anytime.</p>
            </div>
          </div>
        </div>

        <!-- Logged-out state -->
        <div id="bn-bitsnotes-logged-out">
          <div class="bn-login-prompt-card">
            <div class="bn-login-prompt-icon">🔐</div>
            <h4>Sign in to use AI Chat</h4>
            <p>Get <strong>20 free AI messages per day</strong> to ask questions about your lecture notes. Sign in with Google or GitHub — it takes 5 seconds.</p>
            <a href="/auth/signin" class="bn-btn bn-btn-primary bn-login-btn">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
              </svg>
              Sign In to BitsNotes
            </a>
          </div>
        </div>
      </div>

      <div id="bn-bitsnotes-footer" class="bn-chat-settings-footer p-3.5 bg-[var(--bg-subtle)] border-t border-[var(--border)] flex items-center gap-2 justify-end hidden">
        <button type="button" id="bn-bitsnotes-start-btn" class="bn-btn bn-btn-primary flex-1">
          Start Chatting
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Backdrop Scrim -->
<div id="bn-chatbot-backdrop" class="bn-chatbot-backdrop"></div>

<script is:inline defer src="/chatbot.js"></script>
