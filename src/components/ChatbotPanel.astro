---
import '../styles/chatbot.css';
---

<!-- Floating Action Group Container -->
<div id="bn-floating-actions-container">
  <!-- Collapsible Secondary Quick Actions Menu -->
  <div id="bn-quick-actions-group" class="quick-actions-group">
    <div id="bn-quick-actions-menu" class="quick-actions-menu">
      <button type="button" id="bn-quick-top-btn" class="quick-action-item" title="Go to top">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
        <span>Go to top</span>
      </button>
      <button type="button" id="bn-quick-comments-btn" class="quick-action-item" title="Comments">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
        </svg>
        <span>Comments</span>
      </button>
    </div>
    <button type="button" id="bn-quick-actions-toggle" class="quick-actions-toggle" aria-label="Quick Actions" title="Quick Actions">
      <svg class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
      </svg>
    </button>
  </div>

  <!-- Primary Action: Chatbot FAB (Always Visible & Prominent) -->
  <button id="bn-chatbot-fab" aria-label="Ask AI Doubts" title="Ask AI Doubts">
    <span class="fab-icon-wrapper">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M7.5 19.5L3 21l1.5-4.5A9 9 0 1 1 21 12c0 4.97-4.03 9-9 9a8.95 8.95 0 0 1-4.5-1.2z"/>
        <path d="M12 7.5l.8 1.6 1.6.8-1.6.8-.8 1.6-.8-1.6-1.6-.8 1.6-.8z"/>
        <path d="M16.5 13.5l.4.8.8.4-.8.4-.4.8-.4-.8-.8-.4.8-.4z"/>
      </svg>
      <span id="bn-chatbot-badge" class="fab-badge hidden" title="API Key configured for this session"></span>
    </span>
    <span class="fab-text">Ask AI Doubts</span>
  </button>
</div>

<!-- Chatbot Drawer Panel -->
<div id="bn-chatbot-panel" role="region" aria-label="AI Study Assistant">
  
  <!-- ================= VIEW 1: MAIN CHAT CONVERSATION VIEW ================= -->
  <div id="bn-chat-view-main" class="bn-chat-view active">
    <!-- Header -->
    <div class="bn-chat-header">
      <div class="bn-chat-header-info">
        <div class="bn-chat-icon">🤖</div>
        <div class="bn-chat-title-group">
          <h3>BitsNotes AI Assistant</h3>
          <span id="bn-chat-subject-label">Subject Notes Assistant</span>
        </div>
      </div>
      <div class="bn-chat-header-actions">
        <button type="button" id="bn-chat-clear-btn" class="bn-chat-btn-icon" title="Clear conversation and start fresh" aria-label="Clear conversation">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </button>
        <button type="button" id="bn-chat-config-btn" class="bn-chat-btn-icon" title="API Key Settings">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </button>
        <button type="button" id="bn-chat-close-btn" class="bn-chat-btn-icon" title="Close Panel">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages List -->
    <div id="bn-chatbot-messages" class="bn-chat-messages">
      <!-- Messages injected by JS -->
    </div>

    <!-- Input Area -->
    <form id="bn-chatbot-form" class="bn-chat-input-area">
      <textarea
        id="bn-chatbot-input"
        class="bn-chat-input"
        placeholder="Ask about this lecture..."
        rows="1"
      ></textarea>
      <button type="submit" id="bn-chatbot-send" class="bn-chat-send-btn" title="Send message">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3 21l18-9L3 3l3 9zm0 0h75"></path>
        </svg>
      </button>
    </form>
  </div>

  <!-- ================= VIEW 2: IN-DRAWER SETTINGS & CONFIG VIEW ================= -->
  <div id="bn-chat-view-settings" class="bn-chat-view">
    <!-- Header with Back Navigation -->
    <div class="bn-chat-header">
      <div class="flex items-center gap-2">
        <button type="button" id="bn-chat-back-btn" class="bn-chat-btn-icon" title="Back to Chat">
          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <div class="bn-chat-title-group">
          <h3>Configure AI Key</h3>
          <span>Select Provider &amp; API Key</span>
        </div>
      </div>
      <button type="button" id="bn-chat-close-btn-settings" class="bn-chat-btn-icon" title="Close Panel">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Scrollable Settings Form Body -->
    <form id="bn-chatbot-config-form" class="bn-chat-settings-form flex-1 flex flex-col overflow-hidden">
      <div class="bn-chat-settings-body flex-1 overflow-y-auto p-4 flex flex-col gap-4" style="scrollbar-width:thin">
        <div class="bn-form-group">
          <label for="bn-provider-preset">AI Provider Preset</label>
          <select id="bn-provider-preset" class="bn-form-select">
            <optgroup label="Popular Global Providers">
              <option value="gemini" selected>Google Gemini (generativelanguage.googleapis.com)</option>
              <option value="deepseek">DeepSeek (api.deepseek.com)</option>
              <option value="openai">OpenAI (api.openai.com)</option>
              <option value="groq">Groq (api.groq.com)</option>
              <option value="openrouter">OpenRouter (openrouter.ai)</option>
              <option value="xai">xAI / Grok (api.x.ai)</option>
            </optgroup>
            <optgroup label="Chinese AI Providers">
              <option value="kimi">Kimi / Moonshot AI (api.moonshot.cn)</option>
              <option value="glm">Zhipu GLM (open.bigmodel.cn)</option>
              <option value="minimax">MiniMax / Mimi (api.minimax.chat)</option>
              <option value="qwen">Qwen / Alibaba DashScope (dashscope.aliyuncs.com)</option>
              <option value="siliconflow">SiliconFlow / 硅基流动 (api.siliconflow.cn)</option>
              <option value="yi">Yi / 01.AI / 零一万物 (api.lingyiwanwu.com)</option>
              <option value="stepfun">StepFun / 阶跃星辰 (api.stepfun.com)</option>
              <option value="baichuan">Baichuan / 百川智能 (api.baichuan-ai.com)</option>
            </optgroup>
            <optgroup label="Cloud & Open-Source Hosting">
              <option value="together">Together AI (api.together.xyz)</option>
              <option value="mistral">Mistral AI (api.mistral.ai)</option>
              <option value="perplexity">Perplexity AI (api.perplexity.ai)</option>
              <option value="cerebras">Cerebras (api.cerebras.ai)</option>
              <option value="fireworks">Fireworks AI (api.fireworks.ai)</option>
              <option value="sambanova">SambaNova (api.sambanova.ai)</option>
              <option value="huggingface">Hugging Face Router (router.huggingface.co)</option>
            </optgroup>
            <optgroup label="Local Models">
              <option value="ollama">Ollama (Local - localhost:11434)</option>
              <option value="lmstudio">LM Studio (Local - localhost:1234)</option>
            </optgroup>
            <optgroup label="Custom">
              <option value="__custom__">-- Custom / Other Endpoint --</option>
            </optgroup>
          </select>
        </div>

        <div class="bn-form-group">
          <label for="bn-api-url-input">API Endpoint URL (OpenAI-Compatible)</label>
          <input
            type="url"
            id="bn-api-url-input"
            class="bn-form-input"
            value="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
            placeholder="e.g. https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
            required
          />
        </div>

        <div class="bn-form-group">
          <label for="bn-api-key-input">API Key</label>
          <input
            type="password"
            id="bn-api-key-input"
            class="bn-form-input"
            placeholder="Enter API key for selected provider..."
            required
            autocomplete="off"
          />
        </div>

        <div class="bn-form-group">
          <div class="flex items-center justify-between mb-1">
            <label for="bn-model-name-input">Model Name</label>
            <button type="button" id="bn-fetch-models-btn" class="text-xs text-[var(--accent)] font-medium hover:underline">
              ⚡ Auto-fetch models
            </button>
          </div>
          <div id="bn-model-select-wrapper">
            <select id="bn-model-select" class="bn-form-select hidden"></select>
          </div>
          <input
            type="text"
            id="bn-model-name-input"
            class="bn-form-input"
            value=""
            placeholder="Enter model name (or fetch live models using API key)..."
            required
          />
          <span id="bn-model-status" class="text-[11px] text-[var(--text-muted)] mt-1 block">
            🔑 Enter API key above to fetch live models from provider, or enter model name manually.
          </span>
        </div>

        <div class="bn-checkbox-row">
          <input type="checkbox" id="bn-remember-key" />
          <label for="bn-remember-key">
            Remember key for this session (until tab closes)
          </label>
        </div>

        <div class="bn-info-cards-group">
          <div class="bn-info-card">
            <div class="bn-info-card-icon">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="bn-info-card-content">
              <span class="bn-info-card-title">OpenAI-Compatible API Support</span>
              <p class="bn-info-card-desc">Choose any provider preset (Gemini, DeepSeek, Kimi, GLM, MiniMax, Qwen, OpenAI, Groq, Ollama, etc.) or enter a custom endpoint URL.</p>
            </div>
          </div>

          <div class="bn-info-card">
            <div class="bn-info-card-icon">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div class="bn-info-card-content">
              <span class="bn-info-card-title">Security &amp; Privacy First</span>
              <p class="bn-info-card-desc">Your API key is sent directly from your browser to your specified provider. BitsNotes servers never store or see your key.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="bn-chat-settings-footer p-3.5 bg-[var(--bg-subtle)] border-t border-[var(--border)] flex items-center gap-2 justify-end">
        <button type="button" id="bn-clear-key-btn" class="bn-btn bn-btn-secondary text-red-600 hidden">
          Clear Key
        </button>
        <button type="submit" class="bn-btn bn-btn-primary flex-1">
          Save &amp; Start Chat
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Mobile Backdrop Scrim -->
<div id="bn-chatbot-backdrop" class="bn-chatbot-backdrop"></div>

<script is:inline src="/chatbot.js"></script>
