---
/**
 * ProgressBar.astro — Small horizontal progress bar.
 * Props: pct (0-100), label
 */
interface Props {
  pct: number;
  label?: string;
}

const { pct, label } = Astro.props;
const clampedPct = Math.min(100, Math.max(0, Math.round(pct)));
---

<div class="flex items-center gap-2 w-full">
  <div class="flex-1 h-1.5 bg-[var(--bg-subtle)] rounded-full overflow-hidden" role="progressbar" aria-valuenow={clampedPct} aria-valuemin="0" aria-valuemax="100">
    <div
      class="h-full rounded-full transition-all duration-500 ease-out"
      style={`width: ${clampedPct}%; background-color: var(--accent);`}
    ></div>
  </div>
  {label && <span class="text-[10px] text-[var(--text-faint)] tabular-nums shrink-0">{label}</span>}
</div>
